@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<!-- Ambient particles for dark mode -->
<div class="ambient-particles" id="ambientParticles"></div>

<div class="galaxy-layout">
    <!-- ==================== GALAXY SIDEBAR ==================== -->
    <aside class="galaxy-sidebar" id="galaxySidebar">
        <div class="galaxy-logo-area">
            <div class="galaxy-logo-icon">
                <img src="/images/logo.png" alt="NYX CRM Logo" />
            </div>
            <div>
                <div class="galaxy-logo-text">NYX CRM</div>
                <div class="galaxy-logo-sub">OPERACIONES</div>
            </div>
        </div>

        <div class="sidebar-section-label" style="margin-top: 0;">ESPACIO DE TRABAJO</div>
        
        <NavMenu />

        <div class="sidebar-section-label" style="margin-top: auto;">CUENTA</div>
        
        <!-- Sidebar Footer -->
        <div style="position: relative; z-index: 2;">
            <AuthorizeView>
                <Authorized>
                    <div class="galaxy-nav-item" style="cursor: default; margin-bottom: 6px;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div style="width: 32px; height: 32px; background: linear-gradient(135deg, var(--accent), var(--indigo)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 0.8rem; flex-shrink: 0;">
                                @(context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                            </div>
                            <span style="color: #E2E8F0; font-size: 0.8rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@context.User.Identity?.Name</span>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>

            <NavLink class="galaxy-nav-item" href="/profile" title="Perfil & Accesibilidad">
                <div><i class="bi bi-gear-fill" style="margin-right: 12px; font-size: 1.05rem; width: 20px; text-align: center;"></i> Configuración</div>
            </NavLink>
            <NavLink class="galaxy-nav-item" href="/logout-endpoint" title="Cerrar Sesión" style="color: #FCA5A5;">
                <div><i class="bi bi-box-arrow-right" style="margin-right: 12px; font-size: 1.05rem; width: 20px; text-align: center;"></i> Cerrar Sesión</div>
            </NavLink>
        </div>


    </aside>

    <!-- ==================== MAIN ==================== -->
    <main class="galaxy-main-content">
        <!-- Top header -->
        <div class="galaxy-page-header" style="display:flex; justify-content:space-between; align-items:flex-start;">
            <div>
                <div class="galaxy-page-label">
                    — @string.Join(" · ", _breadcrumbs).ToUpper()
                </div>
                <h1 class="galaxy-page-title">@_currentTitle</h1>
                <p class="galaxy-page-desc">@_currentDesc</p>
            </div>
            <div style="display:flex; gap:10px; align-items:center; flex-shrink:0;">
                <button type="button" class="btn-ghost-galaxy btn-icon-galaxy d-md-none" @onclick="ToggleMobileSidebar" title="Menú">
                    <i class="bi bi-list"></i>
                </button>
                <div style="width:1px; height:28px; background:var(--border-galaxy); margin:0 4px;"></div>
                <CRM.WebFrontend.Client.Components.NotificationBell />
                <!-- Theme Toggle -->
                <button class="theme-toggle" onclick="window.galaxyTheme.toggleTheme()" title="Cambiar modo claro/oscuro">
                    <i class="bi bi-moon-stars-fill icon-moon"></i>
                    <i class="bi bi-sun-fill icon-sun"></i>
                </button>
            </div>
        </div>

        @if (_mobileSidebarOpen)
        {
            <div class="mobile-sidebar-backdrop d-md-none" @onclick="ToggleMobileSidebar"></div>
            <aside class="mobile-sidebar-drawer d-md-none">
                <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <img src="/images/logo.png" alt="NYX CRM Logo" style="width: 32px; height: 32px; object-fit: contain;" />
                        <span class="fw-bold text-primary fs-6">NYX CRM</span>
                    </div>
                    <button type="button" class="btn-close" @onclick="ToggleMobileSidebar"></button>
                </div>
                <div class="p-3 overflow-y-auto flex-grow-1" style="max-height: calc(100vh - 120px);">
                    <NavMenu />
                </div>
                <div class="p-3 border-top bg-light mt-auto">
                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div style="width: 32px; height: 32px; background: #E1F5FE; color: #003B5C; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.85rem;">
                                    @(context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                </div>
                                <span class="small fw-bold text-dark text-truncate">@context.User.Identity?.Name</span>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                    <div class="d-flex gap-2">
                        <NavLink href="/settings" class="btn btn-sm btn-outline-secondary w-50" @onclick="ToggleMobileSidebar">Configuración</NavLink>
                        <NavLink href="/logout-endpoint" class="btn btn-sm btn-outline-danger w-50" @onclick="ToggleMobileSidebar">Salir</NavLink>
                    </div>
                </div>
            </aside>
        }

        <!-- Dynamic Page Body -->
        <div style="flex: 1; overflow-y: auto;">
            @Body
        </div>

        <MudThemeProvider Theme="_customTheme" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />
    </main>
</div>

<style>
    /* Mobile sidebar styles */
    .mobile-sidebar-backdrop {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(0, 0, 0, 0.5); z-index: 1050; backdrop-filter: blur(2px);
    }
    .mobile-sidebar-drawer {
        position: fixed; top: 0; left: 0; width: 280px; max-width: 85vw;
        height: 100vh; background: #ffffff; z-index: 1060;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.18);
        display: flex; flex-direction: column;
        animation: slideInLeft 0.22s ease-out;
    }
    @@keyframes slideInLeft {
        from { transform: translateX(-100%); }
        to { transform: translateX(0); }
    }
</style>

@code {
    private bool _sidebarExpanded = false;
    private bool _mobileSidebarOpen = false;
    private List<string> _breadcrumbs = new();
    private string _currentTitle = "Dashboard";
    private string _currentDesc = "";

    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#003B5C",
            Secondary = "#005F8D",
            AppbarBackground = "#003B5C",
            Background = "#F4F6F9",
            Surface = "#FFFFFF",
            TextPrimary = "#1D1F21",
            TextSecondary = "#5F6368",
            ActionDefault = "#003B5C",
            Info = "#005F8D",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444"
        }
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        UpdateBreadcrumbs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("galaxyTheme.init");
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileSidebarOpen = false;
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    private void UpdateBreadcrumbs()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = relativePath.Split('?', '#')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);
        
        _breadcrumbs.Clear();
        _breadcrumbs.Add("Inicio");
        
        foreach (var seg in segments)
        {
            var clean = seg.ToLower() switch
            {
                "backoffice" => "Backoffice",
                "supervisor" => "Supervisor",
                "asesor" => "Asesor",
                "admin" => "Administración",
                "kb" => "Base de Conocimientos",
                "activations" => "Activaciones",
                "reports" => "Métricas y Reportes",
                "dashboard" => "Dashboard",
                "orders" => "Ventas",
                "new" => "Nueva Orden",
                "preventas" => "Pre-Ventas",
                "commissions" => "Comisiones",
                "equipo" => "Rendimiento de Equipo",
                "alertas" => "Alertas Activas",
                "incidents" => "Incidencias",
                "fields" => "Campos de Usuario",
                _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(seg.Replace("-", " "))
            };
            _breadcrumbs.Add(clean);
        }
        
        if (_breadcrumbs.Count == 1)
        {
            _breadcrumbs.Add("Dashboard");
        }

        // Derive page title and description from route
        var lastSegment = segments.LastOrDefault()?.ToLower() ?? "";
        var parentSegment = segments.Length >= 2 ? segments[^2].ToLower() : "";

        (_currentTitle, _currentDesc) = (lastSegment, parentSegment) switch
        {
            ("orders", "asesor") => ("Bandeja del Asesor", "Visualiza y gestiona las ventas y pedidos bajo tu custodia en tiempo real."),
            ("new", "orders") => ("Nueva Orden", "Inicia el proceso de registro de una nueva venta."),
            ("preventas", _) => ("Mis Pre-Ventas", "Gestiona y haz seguimiento a tus pre-ventas y leads."),
            ("comisiones", _) => ("Comisiones", "Visualiza el detalle de tus comisiones."),
            ("dashboard", "supervisor") => ("Kanban Ventas", "Vista de tablero Kanban para supervisión de ventas."),
            ("supervisor", _) => ("Dashboard Supervisor", "Panel de supervisión y monitoreo de equipo."),
            ("equipo", _) => ("Rendimiento de Equipo", "Métricas y análisis del rendimiento del equipo."),
            ("alertas", _) => ("Alertas Activas", "Monitorea alertas activas del sistema."),
            ("reports", _) => ("Métricas y Reportes", "Informes y análisis operativos."),
            ("incidents", _) => ("Incidencias", "Gestión de incidencias."),
            ("activations", _) => ("Activaciones", "Gestión de activaciones de servicios."),
            ("approvals", _) => ("Bandeja de Aprobaciones", "Revisión y firma de aprobaciones SOX."),
            ("admin", _) => ("Panel Admin", "Administración del sistema."),
            ("usuarios", _) => ("Usuarios & Roles", "Control de acceso y perfiles de usuario."),
            ("estados", _) => ("Flujos & Canvas", "Diseño de flujos operativos."),
            ("profile", _) => ("Perfil & Accesibilidad", "Configura tu perfil y preferencias."),
            ("settings", _) => ("Configuración", "Ajustes del sistema."),
            ("kb", _) => ("Base de Conocimientos", "Documentación y recursos."),
            _ => (_breadcrumbs.LastOrDefault() ?? "Dashboard", "")
        };
    }

    private void ToggleSidebar()
    {
        _sidebarExpanded = !_sidebarExpanded;
    }

    private void ToggleMobileSidebar()
    {
        _mobileSidebarOpen = !_mobileSidebarOpen;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
