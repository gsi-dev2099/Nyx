@using MudBlazor
@inject NavigationManager Navigation

@if (isVisible)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%); border-left: 5px solid #003B5C !important;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0 shadow-sm" style="width: 48px; height: 48px; background: linear-gradient(135deg, #003B5C 0%, #0284c7 100%);">
                        <MudIcon Icon="@Icons.Material.Filled.WavingHand" Size="Size.Medium" />
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">¡Bienvenido al panel del Asesor!</h5>
                        <p class="text-muted small mb-0">Guía rápida de inicio para gestionar tus ventas, pre-ventas y clientes asignados.</p>
                    </div>
                </div>
                <button type="button" 
                        class="btn-close ms-2" 
                        aria-label="Cerrar guía de bienvenida" 
                        @onclick="Dismiss" 
                        title="Ocultar esta guía"></button>
            </div>

            <div class="row g-3 my-2">
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 shadow-xs border h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge rounded-pill bg-primary" style="font-size: 0.75rem;">Paso 1</span>
                                <strong class="small text-dark">Pre-Ventas y Prospectos</strong>
                            </div>
                            <p class="text-muted extra-small mb-0" style="font-size: 0.8rem; line-height: 1.4;">
                                Registra llamadas de prospección y lleva el historial de contacto en la bandeja de Pre-Ventas.
                            </p>
                        </div>
                        <div class="mt-3">
                            <a href="/asesor/preventas" class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-semibold" style="font-size: 0.78rem;">
                                Ir a Pre-Ventas &rarr;
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 shadow-xs border h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge rounded-pill bg-success" style="font-size: 0.75rem;">Paso 2</span>
                                <strong class="small text-dark">Generar Nueva Orden</strong>
                            </div>
                            <p class="text-muted extra-small mb-0" style="font-size: 0.8rem; line-height: 1.4;">
                                Contrata servicios completando formularios dinámicos con validación sintáctica de DNI e IBAN.
                            </p>
                        </div>
                        <div class="mt-3">
                            <a href="/asesor/orders/new" class="btn btn-primary btn-sm rounded-pill w-100 fw-semibold shadow-xs" style="font-size: 0.78rem;">
                                + Nueva Orden &rarr;
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 shadow-xs border h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge rounded-pill bg-info text-dark" style="font-size: 0.75rem;">Paso 3</span>
                                <strong class="small text-dark">Base de Conocimiento (KB)</strong>
                            </div>
                            <p class="text-muted extra-small mb-0" style="font-size: 0.8rem; line-height: 1.4;">
                                Consulta artículos, promociones y procedimientos de campañas para resolver dudas en llamadas.
                            </p>
                        </div>
                        <div class="mt-3">
                            <a href="/kb" class="btn btn-outline-secondary btn-sm rounded-pill w-100 fw-semibold" style="font-size: 0.78rem;">
                                Ver KB &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-2 pt-2 border-top">
                <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none" @onclick="Dismiss">
                    Entendido, ocultar guía de inicio
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isVisible = true;

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    private async Task Dismiss()
    {
        isVisible = false;
        if (OnDismiss.HasDelegate)
        {
            await OnDismiss.InvokeAsync();
        }
    }
}
