@using Microsoft.AspNetCore.Components

<style>
    .skeleton-shimmer {
        background: linear-gradient(90deg, #f0f2f5 25%, #e2e8f0 37%, #f0f2f5 63%);
        background-size: 400% 100%;
        animation: skeleton-shimmer-anim 1.4s ease infinite;
        border-radius: 6px;
        display: inline-block;
        height: 1.1rem;
    }
    @@keyframes skeleton-shimmer-anim {
        0% { background-position: 100% 50%; }
        100% { background-position: 0 50%; }
    }
</style>

@for (int i = 0; i < Rows; i++)
{
    <tr>
        @for (int j = 0; j < Columns; j++)
        {
            var widthPct = GetWidth(j);
            <td class="py-3 px-3 align-middle">
                <div class="skeleton-shimmer" style="width: @(widthPct)%;"></div>
            </td>
        }
    </tr>
}

@code {
    [Parameter] public int Rows { get; set; } = 5;
    [Parameter] public int Columns { get; set; } = 6;

    private int GetWidth(int columnIndex)
    {
        return (columnIndex % 4) switch
        {
            0 => 50,
            1 => 85,
            2 => 65,
            _ => 40
        };
    }
}
