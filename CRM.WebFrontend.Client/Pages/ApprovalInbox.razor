@page "/engines/approvals"
@page "/approvals"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Text.Json
@attribute [Authorize(Roles = "SUPERVISOR,BACKOFFICE,COORDINADOR,ADMIN_CRM")]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Bandeja de Aprobaciones SOX / ISO 27001 — NYX CRM</PageTitle>

<style>
    .approval-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }

    .approval-header {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 20px;
        padding: 24px 28px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
        margin-bottom: 24px;
    }

    .request-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 16px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
        transition: all 0.2s ease;
    }

    .request-card:hover {
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
        border-color: #CBD5E1;
    }

    .pill-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-pending { background: #FEF3C7; color: #92400E; }
    .status-approved { background: #E6F4EA; color: #065F46; }
    .status-rejected { background: #FEE2E2; color: #991B1B; }

    .filter-btn {
        font-size: 12px;
        font-weight: 700;
        padding: 6px 16px;
        border-radius: 20px;
        border: 1px solid #CBD5E1;
        background: #ffffff;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s;
    }

    .filter-btn.active {
        background: #0F172A;
        color: #ffffff;
        border-color: #0F172A;
    }
</style>

<div class="approval-wrap">
    <!-- Header -->
    <div class="approval-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-shield-check text-primary fs-4"></i>
                <h4 class="fw-bold text-dark m-0">Bandeja de Aprobaciones SOX / ISO 27001</h4>
                <span class="badge bg-dark text-white rounded-pill px-2 py-1" style="font-size:10px;">NYX.APPROVALENGINE</span>
            </div>
            <p class="text-muted small m-0">
                Gestión directa de solicitudes pendientes de autorización jerárquica. Rol actual: <strong>@_userRole</strong> (ID @_userId).
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold" @onclick="LoadRequests">
                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Bandeja
            </button>
        </div>
    </div>

    <!-- Filter Pills Bar -->
    <div class="d-flex align-items-center gap-2 mb-4">
        <button class="filter-btn @(_statusFilter == "PENDING" ? "active" : "")" @onclick='() => SetFilter("PENDING")'>
            ⏳ Pendientes (@_requests.Count(r => r.Status == "PENDING"))
        </button>
        <button class="filter-btn @(_statusFilter == "APPROVED" ? "active" : "")" @onclick='() => SetFilter("APPROVED")'>
            ✓ Aprobadas (@_requests.Count(r => r.Status == "APPROVED"))
        </button>
        <button class="filter-btn @(_statusFilter == "REJECTED" ? "active" : "")" @onclick='() => SetFilter("REJECTED")'>
            ✗ Rechazadas (@_requests.Count(r => r.Status == "REJECTED"))
        </button>
        <button class="filter-btn @(_statusFilter == "ALL" ? "active" : "")" @onclick='() => SetFilter("ALL")'>
            Todas (@_requests.Count)
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_feedbackMsg))
    {
        <div class="alert @(_msgIsError ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi @(_msgIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @_feedbackMsg
            <button type="button" class="btn-close" @onclick='() => _feedbackMsg = ""'></button>
        </div>
    }

    <!-- Content List -->
    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-dark" role="status"></div>
            <p class="text-muted small mt-2">Cargando solicitudes de aprobación...</p>
        </div>
    }
    else if (!FilteredRequests.Any())
    {
        <div class="card border-0 rounded-4 p-5 text-center bg-white shadow-sm">
            <i class="bi bi-inbox fs-1 text-muted mb-2"></i>
            <h5 class="fw-bold text-dark">No hay solicitudes en esta categoría</h5>
            <p class="text-muted small m-0">No se registran solicitudes de aprobación que requieran tu firma en este momento.</p>
        </div>
    }
    else
    {
        @foreach (var req in FilteredRequests)
        {
            <div class="request-card">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <span class="fw-bold text-dark fs-5">Solicitud #@req.IdRequest</span>
                            <span class="pill-badge @(req.Status == "APPROVED" ? "status-approved" : (req.Status == "REJECTED" ? "status-rejected" : "status-pending"))">
                                @req.Status
                            </span>
                            <span class="badge bg-primary text-white rounded-pill px-3 py-1">
                                <i class="bi bi-people-fill me-1"></i>Involucra: @(string.IsNullOrEmpty(req.TargetRoles) ? "SUPERVISOR, BACKOFFICE" : req.TargetRoles)
                            </span>
                        </div>
                        <div class="text-muted small">
                            Política: <strong>@(string.IsNullOrEmpty(req.PolicyCode) ? "CP_VALIDACION_SOX" : req.PolicyCode)</strong> | 
                            Entidad Target: <code>@req.EntityType #@req.EntityId</code>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-dark rounded-pill px-3 py-1">Firma SOX — Paso @req.CurrentStep</span>
                        <div class="text-muted small mt-1">@req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>

                <!-- DETALLE COMPLETO DEL FLUJO DEL CHECKPOINT -->
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-4">
                            <div class="small text-muted">Cartera / Campaña:</div>
                            <div class="fw-bold text-dark"><i class="bi bi-briefcase me-1 text-primary"></i>@(string.IsNullOrEmpty(req.Portfolio) ? "TELECOM_VODAFONE" : req.Portfolio) / @(string.IsNullOrEmpty(req.Campaign) ? "VODAFONE_LEYASH" : req.Campaign)</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="small text-muted">Proveedor Destino:</div>
                            <div class="fw-bold text-dark"><i class="bi bi-building me-1 text-success"></i>@(string.IsNullOrEmpty(req.Provider) ? "AGENDO / WIKITY" : req.Provider)</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="small text-muted">Mecanismo de Gobierno:</div>
                            <div>
                                @if (req.FinalizesCycle)
                                {
                                    <span class="badge bg-danger text-white rounded-pill px-2">⛔ FINALIZA CICLO (Cierre Definitivo)</span>
                                }
                                else if (req.BlocksAdvance)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-2">🔒 BLOQUEA AVANCE DE ETAPA</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-white rounded-pill px-2">ℹ️ REGISTRO INFORMATIVO</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (req.Status == "PENDING")
                {
                    <div class="border-top pt-3 mt-2">
                        <label class="form-label small fw-bold text-dark">Justificación o Comentario de Firma SOX (Requerido para Pista de Auditoría ISO 27001)</label>
                        <div class="row g-2">
                            <div class="col-12 col-md-8">
                                <input type="text" class="form-control form-control-sm rounded-3" placeholder="Ingresa motivo o sustento de la decisión de aprobación/rechazo..." @bind="req.ReasonInput" />
                            </div>
                            <div class="col-6 col-md-2">
                                <button class="btn btn-sm btn-success w-100 fw-bold rounded-pill" @onclick='() => ProcessDecision(req, "APPROVED")'>
                                    ✓ Aprobar
                                </button>
                            </div>
                            <div class="col-6 col-md-2">
                                <button class="btn btn-sm btn-danger w-100 fw-bold rounded-pill" @onclick='() => ProcessDecision(req, "REJECTED")'>
                                    ✗ Rechazar
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private long _userId = 9;
    private string _userRole = "SUPERVISOR";
    private string _statusFilter = "PENDING";
    private List<ApprovalReqVm> _requests = new();
    private string _feedbackMsg = "";
    private bool _msgIsError = false;

    private IEnumerable<ApprovalReqVm> FilteredRequests
    {
        get
        {
            if (_statusFilter == "ALL") return _requests;
            return _requests.Where(r => r.Status == _statusFilter);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var roleClaim = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (!string.IsNullOrEmpty(roleClaim)) _userRole = roleClaim;

            var idClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (long.TryParse(idClaim, out var parsedId)) _userId = parsedId;
            else if (_userRole == "SUPERVISOR") _userId = 9; // Fallback Supervisor cnaranjo
        }

        await LoadRequests();
    }

    private void SetFilter(string f) { _statusFilter = f; }

    private async Task LoadRequests()
    {
        _loading = true;
        _feedbackMsg = "";
        try
        {
            var baseUri = NavManager.BaseUri.TrimEnd('/');
            var result = await Http.GetFromJsonAsync<List<ApprovalReqVm>>($"{baseUri}/api/engines/approval/pending?approverId={_userId}&approverRole={_userRole}");
            _requests = result ?? new();
        }
        catch (Exception ex)
        {
            _requests = new();
            Console.WriteLine($"[ApprovalInbox] Error loading pending approvals: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ProcessDecision(ApprovalReqVm req, string decision)
    {
        _feedbackMsg = "";
        var reason = string.IsNullOrWhiteSpace(req.ReasonInput) ? $"Decisión registrada vía Bandeja SOX por {_userRole}" : req.ReasonInput.Trim();

        try
        {
            var baseUri = NavManager.BaseUri.TrimEnd('/');
            var payload = new { decidedBy = _userId, decision, reason };
            var response = await Http.PostAsJsonAsync($"{baseUri}/api/approval/requests/{req.IdRequest}/decide", payload);

            if (response.IsSuccessStatusCode)
            {
                _msgIsError = false;
                _feedbackMsg = $"✓ Solicitud #{req.IdRequest} marcada como '{decision}' exitosamente.";
                await LoadRequests();
            }
            else
            {
                var errJson = await response.Content.ReadFromJsonAsync<JsonElement>();
                _msgIsError = true;
                _feedbackMsg = errJson.TryGetProperty("error", out var e) ? $"🛑 SOX/ISO 27001: {e.GetString()}" : "No se pudo procesar la decisión.";
            }
        }
        catch (Exception ex)
        {
            _msgIsError = true;
            _feedbackMsg = $"Error enviando decisión: {ex.Message}";
        }
    }

    private class ApprovalReqVm
    {
        public long IdRequest { get; set; }
        public long IdPolicy { get; set; }
        public string PolicyCode { get; set; } = string.Empty;
        public string EntityType { get; set; } = string.Empty;
        public long EntityId { get; set; }
        public string Status { get; set; } = "PENDING";
        public short CurrentStep { get; set; }
        public DateTime CreatedAt { get; set; }
        public string ReasonInput { get; set; } = string.Empty;
        public string TargetRoles { get; set; } = "SUPERVISOR, BACKOFFICE";
        public string Portfolio { get; set; } = "TELECOM_VODAFONE";
        public string Campaign { get; set; } = "VODAFONE_LEYASH";
        public string Provider { get; set; } = "AGENDO / WIKITY";
        public bool BlocksAdvance { get; set; } = true;
        public bool FinalizesCycle { get; set; } = false;
    }
}
