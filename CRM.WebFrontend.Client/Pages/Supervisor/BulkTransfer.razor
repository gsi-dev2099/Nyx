@page "/supervisor/bulk-transfer"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using System.Text.Json
@using MudBlazor
@attribute [Authorize(Roles = "SUPERVISOR,COORDINADOR")]

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Envío Masivo al BAC - Supervisor</PageTitle>

<div class="container-fluid py-4">
    @* ───── Header ───── *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary mb-1">Envío Masivo al BAC</h2>
            <p class="text-muted mb-0">Selecciona las ventas en Revisión Supervisor que deseas transferir al Backoffice.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <button class="btn btn-outline-secondary rounded-pill px-4" @onclick='() => NavManager.NavigateTo("/supervisor/dashboard")'>
                Volver al Kanban
            </button>
        </div>
    </div>

    @* ───── Panel de Acciones ───── *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold text-muted small">Asignar a Analista BAC</label>
                    <select class="form-select rounded-3" @bind="selectedBacUserId">
                        <option value="0">-- Seleccione un usuario de Backoffice --</option>
                        @foreach (var bac in backofficeUsers)
                        {
                            <option value="@bac.Id">@bac.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small">Comentario de Transferencia (Opcional)</label>
                    <input type="text" class="form-control rounded-3" @bind="transferComment" placeholder="Ej: Revisado y conforme..." />
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary rounded-pill px-4 w-100" 
                            disabled="@(SelectedCount == 0 || selectedBacUserId == 0)"
                            @onclick="ShowConfirmation">
                        Transferir (@SelectedCount)
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ───── Tabla de Órdenes ───── *@
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4 py-3" style="width: 50px;">
                                <input class="form-check-input" type="checkbox" 
                                       checked="@IsAllSelected" 
                                       @onchange="ToggleAll" />
                            </th>
                            <th class="py-3">ID</th>
                            <th class="py-3">Fecha</th>
                            <th class="py-3">Campaña</th>
                            <th class="py-3">Cliente</th>
                            <th class="py-3">Asesor</th>
                            <th class="py-3">Días Transcurridos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                    Cargando ventas...
                                </td>
                            </tr>
                        }
                        else if (!orders.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    No hay ventas en estado de Revisión Supervisor para transferir.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in orders)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <input class="form-check-input" type="checkbox" 
                                               checked="@order.IsSelected" 
                                               @onchange="@((ChangeEventArgs e) => ToggleOrder(order, (bool)e.Value!))" />
                                    </td>
                                    <td class="py-3 fw-bold text-primary">#@order.IdOrder</td>
                                    <td class="py-3">@order.SalesDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border">@order.CampaignName</span>
                                    </td>
                                    <td class="py-3 fw-medium">@order.ClientName</td>
                                    <td class="py-3">@order.AdvisorName</td>
                                    <td class="py-3">
                                        <span class="badge @(order.DaysElapsed > 3 ? "bg-danger" : "bg-warning text-dark") rounded-pill">
                                            @order.DaysElapsed días
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ───── Modal de Confirmación / Transferencia / Éxito ───── *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                @if (transferPhase == "confirm")
                {
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold text-primary">Confirmar Transferencia</h5>
                        <button type="button" class="btn-close" @onclick="CloseConfirmation"></button>
                    </div>
                    <div class="modal-body py-4 text-center">
                        <div class="mb-3">
                            <span style="font-size: 3rem;">📤</span>
                        </div>
                        <p class="fs-5 mb-1">Se transferirán <strong>@SelectedCount</strong> órdenes al BAC.</p>
                        <p class="text-muted small">
                            Analista destino: <strong>@(backofficeUsers.FirstOrDefault(b => b.Id == selectedBacUserId)?.Name)</strong>
                        </p>
                    </div>
                    <div class="modal-footer border-top-0 pt-0 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseConfirmation">Cancelar</button>
                        <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="ExecuteTransfer">
                            Confirmar Envío
                        </button>
                    </div>
                }
                else if (transferPhase == "transferring")
                {
                    <div class="modal-body py-5 text-center">
                        <div class="mb-4">
                            <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
                        </div>
                        <p class="fs-5 fw-bold text-primary mb-1">Transfiriendo...</p>
                        <p class="text-muted small">Enviando @SelectedCount órdenes al Backoffice</p>
                    </div>
                }
                else if (transferPhase == "success")
                {
                    <div class="modal-body py-5 text-center">
                        <div class="mb-3 success-check-container">
                            <svg class="success-checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" style="width: 72px; height: 72px;">
                                <circle class="success-checkmark-circle" cx="26" cy="26" r="25" fill="none" stroke="#22c55e" stroke-width="2"/>
                                <path class="success-checkmark-check" fill="none" stroke="#22c55e" stroke-width="3" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
                            </svg>
                        </div>
                        <p class="fs-4 fw-bold text-success mb-1">¡Transferido!</p>
                        <p class="text-muted small">Las órdenes fueron enviadas exitosamente al BAC</p>
                        <p class="text-muted small">Redirigiendo al Kanban...</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .success-checkmark-circle {
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        animation: stroke-anim 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }
    .success-checkmark-check {
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: stroke-anim 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.4s forwards;
    }
    @@keyframes stroke-anim {
        100% {
            stroke-dashoffset: 0;
        }
    }
    .success-check-container {
        animation: scale-in 0.3s ease-out;
    }
    @@keyframes scale-in {
        0% { transform: scale(0); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    public class CampaignLookup { 
        [System.Text.Json.Serialization.JsonPropertyName("id")] public int Id { get; set; } 
        [System.Text.Json.Serialization.JsonPropertyName("name")] public string Name { get; set; } = ""; 
    }
    public class StatusDto { 
        [System.Text.Json.Serialization.JsonPropertyName("id")] public long Id { get; set; } 
        [System.Text.Json.Serialization.JsonPropertyName("name")] public string Name { get; set; } = ""; 
        [System.Text.Json.Serialization.JsonPropertyName("color")] public string? Color { get; set; } 
    }
    public class UserDto { 
        [System.Text.Json.Serialization.JsonPropertyName("id")] public long Id { get; set; } 
        [System.Text.Json.Serialization.JsonPropertyName("name")] public string Name { get; set; } = ""; 
    }
    
    public class SelectableOrder
    {
        [System.Text.Json.Serialization.JsonPropertyName("idOrder")] public long IdOrder { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("idLead")] public long IdLead { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("idCmpg")] public long IdCmpg { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("idUser")] public long IdUser { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("idStatus")] public long? IdStatus { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("salesDate")] public DateTime SalesDate { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("clientName")] public string ClientName { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("campaignName")] public string CampaignName { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("statusName")] public string StatusName { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("advisorName")] public string AdvisorName { get; set; } = "";
        public int DaysElapsed => (DateTime.UtcNow - SalesDate).Days;
        public bool IsSelected { get; set; }
    }

    private bool isLoading = true;
    private bool isTransferring = false;
    private bool showModal = false;
    private string transferPhase = "confirm"; // confirm, transferring, success
    
    private List<SelectableOrder> orders = new();
    private List<UserDto> backofficeUsers = new();
    private long selectedBacUserId = 0;
    private string transferComment = "";

    private int SelectedCount => orders.Count(o => o.IsSelected);
    private bool IsAllSelected => orders.Any() && orders.All(o => o.IsSelected);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            var client = HttpClientFactory.CreateClient("BackendApi");

            // 1. Cargar usuarios BAC
            try
            {
                var bacResult = await client.GetFromJsonAsync<List<UserDto>>("/api/campaigns/advisors?role=BACKOFFICE");
                if (bacResult != null) backofficeUsers = bacResult;
            }
            catch (Exception ex) { 
                Console.WriteLine($"Error BAC: {ex.Message}");
            }

            // 2. Cargar Asesores (para nombres)
            List<UserDto> advisors = new();
            try
            {
                var advResult = await client.GetFromJsonAsync<List<UserDto>>("/api/campaigns/advisors?role=ASESOR");
                if (advResult != null) advisors = advResult;
            }
            catch (Exception ex) { 
                Console.WriteLine($"Error ASESOR: {ex.Message}");
            }

            // 3. Cargar Campañas
            List<CampaignLookup> campaigns = new();
            var cmpgResult = await client.GetFromJsonAsync<List<CampaignLookup>>("/api/campaigns");
            if (cmpgResult != null) campaigns = cmpgResult;

            // 4. Cargar Estados (para saber cuál es Revisión Supervisor)
            List<StatusDto> statuses = new();
            var statResult = await client.GetFromJsonAsync<List<StatusDto>>("/api/campaigns/1/statuses");
            if (statResult != null) statuses = statResult;

            // 5. Cargar órdenes del equipo
            var pagedResult = await client.GetFromJsonAsync<CRM.WebFrontend.Client.Models.PagedResult<SelectableOrder>>("/api/supervisor/orders?page=1&pageSize=1000");
            var ordersResult = pagedResult?.Items?.ToList() ?? new List<SelectableOrder>();
            
            if (ordersResult != null && ordersResult.Count > 0)
            {
                ordersResult = ordersResult.Where(x => x.IdLead != 99998).ToList();
                
                // Filtrar por estado "REVISION_SUPERVISOR" o similar (ID 2 típicamente o por nombre)
                var revStatus = statuses.FirstOrDefault(s => s.Name.Contains("SUPERVISOR", StringComparison.OrdinalIgnoreCase));
                long targetStatusId = revStatus?.Id ?? 2;

                var filtered = ordersResult.Where(o => o.IdStatus == targetStatusId).ToList();

                // Enriquecer con nombres
                foreach (var o in filtered)
                {
                    o.CampaignName = campaigns.FirstOrDefault(c => c.Id == o.IdCmpg)?.Name ?? "Desconocida";
                    o.StatusName = revStatus?.Name ?? "Revisión Supervisor";
                    
                    var adv = advisors.FirstOrDefault(a => a.Id == o.IdUser);
                    o.AdvisorName = adv != null && !string.IsNullOrWhiteSpace(adv.Name) ? adv.Name : $"Asesor {o.IdUser}";
                    o.ClientName = !string.IsNullOrEmpty(o.ClientName) ? o.ClientName : "";
                }

                // Fetch lead names concurrently
                var uniqueLeadIds = filtered.Where(o => string.IsNullOrEmpty(o.ClientName)).Select(o => o.IdLead).Distinct().ToList();
                var leadTasks = uniqueLeadIds.Select(async leadId => 
                {
                    try
                    {
                        var lead = await client.GetFromJsonAsync<TempLeadDto>($"/api/leads/{leadId}");
                        if (lead != null)
                        {
                            var fullName = !string.IsNullOrWhiteSpace(lead.FullName) ? lead.FullName : $"{lead.FirstName} {lead.LastName}";
                            if (!string.IsNullOrWhiteSpace(fullName)) return new { Id = leadId, Name = fullName.Trim() };
                        }
                    }
                    catch { }
                    return new { Id = leadId, Name = $"Cliente no registrado" };
                });
                
                var leadNames = await Task.WhenAll(leadTasks);
                var leadDict = leadNames.ToDictionary(k => k.Id, v => v.Name);

                foreach (var o in filtered)
                {
                    if (string.IsNullOrEmpty(o.ClientName))
                    {
                        if (leadDict.TryGetValue(o.IdLead, out var name)) o.ClientName = name;
                        else o.ClientName = $"Cliente no registrado";
                    }
                }

                orders = filtered;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        foreach (var order in orders)
        {
            order.IsSelected = isChecked;
        }
    }

    private void ToggleOrder(SelectableOrder order, bool isChecked)
    {
        order.IsSelected = isChecked;
    }

    private void ShowConfirmation()
    {
        if (SelectedCount > 0 && selectedBacUserId > 0)
        {
            showModal = true;
        }
    }

    private void CloseConfirmation()
    {
        if (!isTransferring)
        {
            showModal = false;
            transferPhase = "confirm";
        }
    }

    private async Task ExecuteTransfer()
    {
        var selectedOrderIds = orders.Where(o => o.IsSelected).Select(o => o.IdOrder).ToArray();
        
        if (selectedOrderIds.Length == 0 || selectedBacUserId == 0) return;

        isTransferring = true;
        transferPhase = "transferring";
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var payload = new
            {
                OrderIds = selectedOrderIds,
                BackofficeUserId = selectedBacUserId,
                Comment = string.IsNullOrWhiteSpace(transferComment) ? "Enviado masivamente al BAC desde Dashboard" : transferComment
            };

            var response = await client.PostAsJsonAsync("/api/supervisor/bulk-transfer", payload);

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadFromJsonAsync<JsonElement>();
                var details = content.GetProperty("details");
                int successCount = details.GetProperty("successfulCount").GetInt32();
                int failedCount = details.GetProperty("failedCount").GetInt32();

                // Show success phase with check animation
                transferPhase = "success";
                StateHasChanged();
                
                // Wait for user to see the success animation
                await Task.Delay(2000);
                
                if (failedCount > 0)
                {
                    Snackbar.Add($"{successCount} enviadas OK, {failedCount} con error.", Severity.Warning);
                }
                else
                {
                    Snackbar.Add($"{successCount} enviadas OK.", Severity.Success);
                }

                await Task.Delay(1000); // Wait a bit to read the snackbar
                
                showModal = false;
                transferPhase = "confirm";
                
                // Redirect to Kanban
                NavManager.NavigateTo("/supervisor/dashboard");
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<JsonElement>();
                string msg = error.TryGetProperty("message", out var m) ? m.GetString() ?? "Error desconocido" : "Error desconocido";
                
                if (error.TryGetProperty("details", out var details))
                {
                    int failedCount = details.GetProperty("failedCount").GetInt32();
                    msg = $"{msg} (Fallaron {failedCount})";
                }

                Snackbar.Add($"No se pudieron transferir las órdenes: {msg}", Severity.Error);
                showModal = false;
                transferPhase = "confirm";
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
            showModal = false;
            transferPhase = "confirm";
        }
        finally
        {
            isTransferring = false;
        }
    }

    private class TempLeadDto
    {
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? FullName { get; set; }
    }
}
