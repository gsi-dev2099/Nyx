    private int _selectedModalStageIndex = -1;
    private List<StageCheckpointModalVm> _cachedCheckpoints = new();

    private void SelectModalStageIndex(int index)
    {
        _selectedModalStageIndex = index;
    }

    private List<StageCheckpointModalVm> GetCheckpointsForStageIndex(int stageIdx)
    {
        if (_selectedTimelineOrder == null) return new();
        var flowId = ResolveFlowIdForOrder(_selectedTimelineOrder);
        var stagesForFlow = _stageObjects.Where(s => s.IdFlow == flowId).OrderBy(s => s.OrderIndex).ToList();
        if (!stagesForFlow.Any())
        {
            stagesForFlow = _stageObjects.Where(s => s.IdFlow == 1).OrderBy(s => s.OrderIndex).ToList();
        }
        if (stageIdx < 0 || stageIdx >= stagesForFlow.Count) return new();
        long stageId = stagesForFlow[stageIdx].IdStage;
        return _cachedCheckpoints.Where(c => c.TriggerStageId == stageId).ToList();
    }

    private async Task LoadCheckpointsAndStepsAsync()
    {
        try
        {
            var client = await GetAuthenticatedClient();
            var fullCatalog = await client.GetFromJsonAsync<List<FullCatalogItemApiDto>>("/api/engines/flow/catalogs/full");

            if (fullCatalog != null && fullCatalog.Any())
            {
                _cachedCheckpoints = fullCatalog.Select(c => new StageCheckpointModalVm
                {
                    IdCheckpoint = c.IdCheckpoint,
                    Code = c.Code,
                    Name = c.Name,
                    TriggerStageId = c.TriggerStageId,
                    BlocksAdvance = c.BlocksAdvance,
                    RollbackToStage = c.RollbackToStage,
                    Steps = (c.Steps ?? new List<CheckpointStepApiDto>()).Select(s => new CheckpointStepModalVm
                    {
                        IdStep = s.IdStep,
                        StepOrder = s.StepOrder,
                        Instruction = !string.IsNullOrWhiteSpace(s.Instruction) ? s.Instruction : s.Name,
                        IsRequired = s.IsRequired,
                        IsCompleted = false
                    }).ToList()
                }).ToList();
            }
            else
            {
                var catalog = await client.GetFromJsonAsync<List<CatalogItemApiDto>>("/api/engines/flow/catalogs");
                if (catalog != null)
                {
                    _cachedCheckpoints = catalog.Select(c => new StageCheckpointModalVm
                    {
                        IdCheckpoint = c.IdCheckpoint,
                        Code = c.Code,
                        Name = c.Name,
                        TriggerStageId = c.TriggerStageId,
                        BlocksAdvance = c.BlocksAdvance,
                        RollbackToStage = c.RollbackToStage
                    }).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SupervisorDashboard] Error en LoadCheckpointsAndStepsAsync: {ex.Message}");
        }
    }
