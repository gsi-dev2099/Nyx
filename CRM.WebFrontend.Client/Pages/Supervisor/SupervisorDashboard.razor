@page "/supervisor/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using System.Text.Json
@using MudBlazor
@attribute [Authorize(Roles = "SUPERVISOR,COORDINADOR")]

@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<PageTitle>Bandeja de Ventas - Supervisor</PageTitle>

<style>
    .timeline-compact-pill {
        background: #F8FAFC;
        border-radius: 10px;
        padding: 6px 10px;
        border: 1px solid #E2E8F0;
        transition: all 0.2s ease;
        min-width: 140px;
        cursor: pointer;
    }
    .timeline-compact-pill:hover {
        background: #FFFFFF;
        border-color: #CBD5E1;
        box-shadow: 0 4px 12px rgba(15,23,42,0.06);
    }
    .timeline-preview-card {
        background: #F8FAFC;
        border-radius: 12px;
        padding: 8px 12px;
        border: 1px solid #E2E8F0;
        transition: all 0.2s ease;
        min-width: 140px;
        cursor: pointer;
    }
    .timeline-preview-card:hover {
        background: #FFFFFF;
        border-color: #CBD5E1;
        box-shadow: 0 4px 12px rgba(15,23,42,0.06);
    }
    .timeline-stage-title {
        font-size: 0.72rem;
        font-weight: 800;
        color: #0F172A;
        display: block;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .mini-timeline-track {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .mini-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #E2E8F0;
        transition: all 0.2s ease;
    }
    .mini-dot.done {
        background: #94A3B8;
        opacity: 0.35;
    }
    .mini-dot.current {
        background: #0F172A;
        width: 10px;
        height: 10px;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.25);
        opacity: 1;
    }
    .stage-strip { display: flex; align-items: center; justify-content: space-between; position: relative; padding: 20px 0; }
    .stage-dot-wrap { display: flex; flex-direction: column; align-items: center; position: relative; z-index: 2; flex: 1; }
    .stage-dot { width: 14px; height: 14px; border-radius: 50%; background: #F1F5F9; border: 2px solid #CBD5E1; transition: all 0.25s ease; }
    .stage-dot.done { background: #94A3B8; border-color: #94A3B8; opacity: 0.38; box-shadow: none; }
    .stage-dot.current { background: #0F172A; border: 3px solid #38BDF8; width: 18px; height: 18px; box-shadow: 0 0 0 5px rgba(56, 189, 248, 0.25); z-index: 3; }
    .stage-line { position: absolute; top: 6px; left: 50%; width: 100%; height: 2px; background: #E2E8F0; z-index: 1; }
    .stage-line.done { background: #CBD5E1; opacity: 0.4; }
    .stage-dot-wrap:last-child .stage-line { display: none; }
    .stage-label { font-size: 0.65rem; margin-top: 8px; text-align: center; color: #94A3B8; max-width: 85px; line-height: 1.2; text-transform: uppercase; font-weight: 600; }
    .stage-label.done { color: #94A3B8; opacity: 0.45; font-weight: 500; }
    .stage-label.current { color: #0F172A; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.3px; opacity: 1; }
</style>

<div class="container-fluid py-4">
    @* ───── Header ───── *@
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold text-primary mb-1">Bandeja de Ventas</h2>
            <p class="text-muted mb-0">Gestión y control de ventas del equipo.</p>
        </div>
        <div class="col-md-6 text-md-end">
            <button class="btn btn-outline-primary rounded-pill px-4 me-3" @onclick="NavigateToBulkTransfer" disabled="@isNavigating">
                @if (isNavigating)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Derivando...</span>
                }
                else
                {
                    <span class="me-1">📤</span> <span>Envío Masivo al BAC</span>
                }
            </button>
            <div class="btn-group rounded-pill border" role="group">
                <button class="btn @(viewMode == "table" ? "btn-primary" : "btn-light") rounded-start-pill px-4"
                        @onclick='() => viewMode = "table"'>
                    <span class="me-1">📄</span> Tabla
                </button>
                <button class="btn @(viewMode == "kanban" ? "btn-primary" : "btn-light") rounded-end-pill px-4"
                        @onclick='() => viewMode = "kanban"'>
                    <span class="me-1">📋</span> Kanban
                </button>
            </div>
        </div>
    </div>

    @* ───── Contadores por estado relevante de Supervisión ───── *@
    @if (statuses.Any())
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4 p-3 rounded-4 bg-white" style="box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);">
            @foreach (var st in FilteredSupervisorStatuses)
            {
                var count = allOrders.Count(o => o.IdStatus == st.Id);
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill" style="background: #F4F6F9; border: 1px solid #E5E7EB;">
                    <span class="rounded-circle d-inline-block" style="width: 8px; height: 8px; background-color: @(st.Color ?? "#005F8D");"></span>
                    <span style="font-size: 0.8rem; font-weight: 600; color: #374151;">@st.Name</span>
                    <span class="badge rounded-pill bg-white text-dark shadow-sm px-2" style="font-size: 0.75rem; font-weight: 700;">@count</span>
                </div>
            }
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill ms-auto" style="background: #003B5C; color: #FFFFFF;">
                <span style="font-size: 0.8rem; font-weight: 700;">Total Equipo</span>
                <span class="badge rounded-pill bg-white text-dark px-2" style="font-size: 0.75rem; font-weight: 800;">@allOrders.Count</span>
            </div>
            <a href="/engines/approvals" class="btn btn-sm btn-dark rounded-pill px-3 py-1.5 fw-bold shadow-sm text-decoration-none">
                <i class="bi bi-shield-check me-1 text-warning"></i> Bandeja Aprobaciones SOX
            </a>
        </div>
    }

    @* ───── Filtros Sueltos (Píldoras Horizontal) ───── *@
    <!-- Filtros Express de Toma de Decisiones -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="fw-bold small text-muted me-1"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Filtro Express:</span>
        <button class="btn btn-sm @(expressFilter == "ALL" ? "btn-dark" : "btn-light border") rounded-pill px-3" @onclick='() => SetExpressFilter("ALL")'>Todos (@allOrders.Count)</button>
        <button class="btn btn-sm @(expressFilter == "CRITICAL_SLA" ? "btn-danger text-white" : "btn-light border text-danger") rounded-pill px-3" @onclick='() => SetExpressFilter("CRITICAL_SLA")'>⚠️ SLA Crítico / Excedido (@allOrders.Count(o => o.SlaMinutes > 120))</button>
        <button class="btn btn-sm @(expressFilter == "PENDING_SUPER" ? "btn-warning text-dark" : "btn-light border") rounded-pill px-3" @onclick='() => SetExpressFilter("PENDING_SUPER")'>⏳ Pendiente Supervisión (@allOrders.Count(o => o.IdStatus == 2))</button>
        <button class="btn btn-sm @(expressFilter == "IN_BACKOFFICE" ? "btn-info text-white" : "btn-light border") rounded-pill px-3" @onclick='() => SetExpressFilter("IN_BACKOFFICE")'>🏢 En Backoffice (@allOrders.Count(o => o.IdStatus == 3))</button>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 p-2">
        <div class="d-flex align-items-center gap-3 flex-grow-1 flex-wrap">
            <div class="d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-pill shadow-sm" style="border: 1px solid #E5E7EB; min-width: 210px;">
                <span class="text-muted small fw-bold">Campaña:</span>
                <select class="form-select border-0 bg-transparent p-0 shadow-none small fw-semibold" style="cursor: pointer; color: #1D1F21;" @bind="selectedCampaignId">
                    <option value="0">Todas</option>
                    @foreach (var c in campaigns)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>

            <div class="d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-pill shadow-sm" style="border: 1px solid #E5E7EB; min-width: 210px;">
                <span class="text-muted small fw-bold">Asesor:</span>
                <select class="form-select border-0 bg-transparent p-0 shadow-none small fw-semibold" style="cursor: pointer; color: #1D1F21;" @bind="selectedAdvisorId">
                    <option value="0">Todos</option>
                    @foreach (var a in advisorList)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>

            <div class="d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-pill shadow-sm" style="border: 1px solid #E5E7EB;">
                <span class="text-muted small fw-bold">Desde:</span>
                <input type="date" class="form-control border-0 bg-transparent p-0 shadow-none small fw-semibold" style="color: #1D1F21;" @bind="filterDateFrom" />
            </div>

            <div class="d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-pill shadow-sm" style="border: 1px solid #E5E7EB;">
                <span class="text-muted small fw-bold">Hasta:</span>
                <input type="date" class="form-control border-0 bg-transparent p-0 shadow-none small fw-semibold" style="color: #1D1F21;" @bind="filterDateTo" />
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn p-2 rounded-circle shadow-sm border-0 d-flex align-items-center justify-content-center" 
                    style="width: 40px; height: 40px; background: #003B5C; color: #FFFFFF; transition: transform 0.2s ease, background 0.2s ease;" 
                    @onclick="LoadOrdersAsync" title="Buscar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
            <button class="btn btn-link text-muted small text-decoration-none fw-semibold px-2" @onclick="ClearFilters">
                Limpiar
            </button>
        </div>
    </div>

    @* ───── Loading ───── *@
    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (viewMode == "kanban")
    {
        @* ───── KANBAN VIEW ───── *@
        <div class="kanban-board d-flex gap-3 overflow-auto pb-3" style="min-height: 500px;">
            @foreach (var st in statuses)
            {
                var statusId = st.Id;
                var columnOrders = filteredOrders.Where(o => o.IdStatus == statusId).ToList();

                <div class="kanban-column flex-shrink-0 rounded-4 p-3 @(dragOverStatusId == statusId ? "kanban-column-hover" : "")"
                     style="width: 300px; min-width: 280px; background-color: #f8f9fa; border: 2px dashed transparent;
                            @(dragOverStatusId == statusId ? "border-color: " + (st.Color ?? "#0d6efd") + "; background-color: #e8f0fe;" : "")"
                     @ondragover="OnDragOver"
                     @ondragover:preventDefault
                     @ondragenter="() => dragOverStatusId = statusId"
                     @ondragleave="() => { if (dragOverStatusId == statusId) dragOverStatusId = -1; }"
                     @ondrop="() => OnDrop(statusId)">

                    @* Column header *@
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle d-inline-block" style="width: 12px; height: 12px; background-color: @(st.Color ?? "#6c757d");"></span>
                            <span class="fw-bold text-dark">@st.Name</span>
                        </div>
                        <span class="badge bg-white text-dark border rounded-pill px-2">@columnOrders.Count</span>
                    </div>

                    @* Cards *@
                    @foreach (var order in columnOrders)
                    {
                        <div class="kanban-card card border-0 shadow-sm rounded-3 mb-2 @(draggedOrder?.IdOrder == order.IdOrder ? "opacity-50" : "")"
                             draggable="true"
                             style="cursor: grab;"
                             @ondragstart="() => OnDragStart(order)"
                             @ondragend="OnDragEnd"
                             @ondblclick='@(() => NavManager.NavigateTo($"/supervisor/orders/{order.IdOrder}"))'>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <a href="/supervisor/orders/@order.IdOrder" class="fw-bold text-primary small text-decoration-none" @onclick:stopPropagation="true">#@order.IdOrder <i class="bi bi-box-arrow-up-right" style="font-size: 0.7rem;"></i></a>
                                    <div class="d-flex flex-column align-items-end">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-bold" title="Tiempo laborable neto consumido segun horario del colaborador">
                                            ⏱️ @(order.SlaMinutes < 60 ? $"{order.SlaMinutes}m" : $"{order.SlaMinutes / 60}h {order.SlaMinutes % 60}m") SLA
                                        </span>
                                        <span class="fw-bold small text-muted" style="font-size: 0.7rem;">
                                            @order.DaysElapsed d transcurridos
                                        </span>
                                    </div>
                                </div>

                                <p class="mb-1 fw-medium small text-truncate" title="@order.ClientName">@order.ClientName</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge bg-light text-dark border small">@order.CampaignName</span>
                                    @if (!string.IsNullOrEmpty(order.BackofficeName))
                                    {
                                        <span class="text-info fw-bold" style="font-size: 0.65rem;" title="@order.BackofficeName">
                                            🏢 @order.BackofficeName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.65rem;" title="@order.AdvisorName">@order.AdvisorName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (!columnOrders.Any())
                    {
                        <div class="text-center text-muted small py-4 opacity-50">
                            <div class="mb-1">📭</div>
                            Sin órdenes
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        @* ───── TABLE VIEW ───── *@
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive" style="overflow-x: auto;">
                    <table class="table table-hover align-middle mb-0" style="min-width: 980px;">
                        <thead class="table-light text-muted">
                            <tr>
                                <th class="ps-4 py-3" style="width: 140px;">N° Orden / Prod.</th>
                                <th>Cliente / Contacto</th>
                                <th>Campaña y Asesor</th>
                                <th style="width: 180px;">Etapa (Nyx Flow)</th>
                                <th style="width: 160px;">Estado / SLA</th>
                                <th class="text-end pe-4" style="width: 220px;">Acciones Express</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!filteredOrders.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        No se encontraron órdenes con los filtros seleccionados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var order in filteredOrders)
                                {
                                    <tr style="cursor: pointer;" @onclick="() => ShowDetail(order)">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <a href="/supervisor/orders/@order.IdOrder" class="fw-bold text-primary text-decoration-none" @onclick:stopPropagation="true" style="font-size: 0.9rem;">
                                                    #@order.IdOrder <i class="bi bi-box-arrow-up-right text-muted" style="font-size: 0.7rem;"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0.5 text-dark font-bold shadow-sm"
                                                        @onclick="() => OpenProductsModal(order)" @onclick:stopPropagation="true" title="Ver productos contratados">
                                                    <i class="bi bi-box-seam text-primary me-0.5" style="font-size: 0.75rem;"></i>@(order.TotalProducts > 0 ? order.TotalProducts : 1)
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-dark text-truncate" style="max-width: 210px; font-size: 0.88rem;">
                                                    @(string.IsNullOrWhiteSpace(order.ClientName) ? "Cliente Registrado" : order.ClientName)
                                                </span>
                                                <div class="d-flex align-items-center gap-2 text-muted small mt-0.5" style="font-size: 0.75rem;">
                                                    <code class="bg-light border px-1 py-0.2 rounded text-dark fw-bold" style="font-size: 0.72rem;">@(string.IsNullOrWhiteSpace(order.CustomerDni) ? "12345678Z" : order.CustomerDni)</code>
                                                    <span>•</span>
                                                    <span>📞 @(string.IsNullOrWhiteSpace(order.CustomerPhone) ? "987654321" : order.CustomerPhone)</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column align-items-start gap-1">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-0.5 fw-bold" style="font-size: 0.72rem;">
                                                    @order.CampaignName
                                                </span>
                                                <span class="text-secondary small text-truncate" style="max-width: 170px; font-size: 0.78rem;" title="@order.AdvisorName">
                                                    <i class="bi bi-person me-1 text-muted"></i>@order.AdvisorName
                                                </span>
                                            </div>
                                        </td>
                                        <td @onclick:stopPropagation="true">
                                            <div class="timeline-compact-pill" @onclick="() => OpenTimelineModal(order)" title="Click para ver la línea de tiempo completa">
                                                @{
                                                    var orderStages = GetStagesForOrder(order);
                                                    int currentIdx = GetCurrentStageIndex(order);
                                                    string stageName = currentIdx < orderStages.Count ? orderStages[currentIdx] : "Desconocida";
                                                    int percent = (int)(((double)(currentIdx + 1) / orderStages.Count) * 100);
                                                }
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <span class="fw-bold text-dark text-truncate" style="font-size: 0.74rem; text-transform: uppercase; max-width: 110px;">@stageName</span>
                                                    <span class="text-muted fw-bold" style="font-size: 0.65rem;">@(currentIdx + 1)/@orderStages.Count</span>
                                                </div>
                                                <div class="progress" style="height: 5px; background: #E2E8F0; border-radius: 4px;">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @percent%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column align-items-start gap-1">
                                                <span class="badge rounded-pill px-2.5 py-1 font-semibold" style="background-color: @(order.StatusColor ?? "#6c757d"); color: #fff; font-size: 0.73rem;">
                                                    @order.StatusName
                                                </span>
                                                <span class="badge border px-2 py-0.5 font-semibold" style="font-size: 0.68rem; background: #F1F5F9; color: #334155; border-radius: 6px;">
                                                    ⏱️ @(order.SlaMinutes < 60 ? $"{order.SlaMinutes}m" : $"{order.SlaMinutes / 60}h {order.SlaMinutes % 60}m") SLA
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4" @onclick:stopPropagation="true">
                                            <div class="d-flex align-items-center justify-content-end gap-1.5">
                                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 font-bold text-nowrap shadow-sm" @onclick="() => ExpressApprove(order)" title="Aprobar y pasar a BackOffice" style="font-size: 0.78rem;">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Aprobar
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 font-semibold text-nowrap" @onclick="() => OpenExpressDevolverModal(order)" title="Devolver a Asesor" style="font-size: 0.78rem;">
                                                    <i class="bi bi-arrow-return-left me-1"></i> Devolver
                                                </button>
                                                <a href="/supervisor/orders/@order.IdOrder" class="btn btn-sm btn-light border rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Ver Ficha 360°">
                                                    <i class="bi bi-eye text-secondary"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>

                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Paginación *@
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav aria-label="Navegación de páginas">
                <ul class="pagination mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Anterior</button>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Siguiente</button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@* ───── Detail Modal ───── *@
@if (selectedOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-primary">Detalle de Orden #@selectedOrder.IdOrder</h5>
                    <button type="button" class="btn-close" @onclick="() => selectedOrder = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="d-block text-muted small fw-bold">Cliente</span>
                            <span class="d-block fw-medium">@selectedOrder.ClientName</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="d-block text-muted small fw-bold">Asesor</span>
                            <span class="d-block fw-medium">@selectedOrder.AdvisorName</span>
                        </div>
                        <div class="col-sm-6">
