<!-- Modal: Línea de Tiempo Completa de la Etapa con Checkpoints y Pasos -->
@if (_selectedTimelineOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-primary-subtle text-primary fw-bold mb-1">Progreso y Checkpoints Nyx Flow</span>
                        <h5 class="modal-title fw-bold text-dark">Orden #@_selectedTimelineOrder.IdOrder — @_selectedTimelineOrder.ClientName</h5>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseTimelineModal"></button>
                </div>
                <div class="modal-body p-4 pt-2">
                    <p class="text-muted small mb-3">Haz clic en cualquier hito de la línea de tiempo para inspeccionar los checkpoints y pasos de esa etapa.</p>
                    
                    <div class="bg-light p-3 rounded-4 border mb-3">
                        <div class="stage-strip w-100">
                            @{
                                var modalStages = GetStagesForOrder(_selectedTimelineOrder);
                                int currentIdx = GetCurrentStageIndex(_selectedTimelineOrder);
                                int activeStageIdx = _selectedModalStageIndex >= 0 ? _selectedModalStageIndex : currentIdx;
                            }
                            @for (int i = 0; i < modalStages.Count; i++)
                            {
                                var stageIndex = i;
                                var stage = modalStages[i];
                                bool isDone = i < currentIdx;
                                bool isCurrent = i == currentIdx;
                                bool isSelected = i == activeStageIdx;

                                <div class="stage-dot-wrap" style="cursor:pointer;" @onclick="() => SelectModalStageIndex(stageIndex)" title="Ver checkpoints de @stage">
                                    <div class="stage-line @(isDone ? "done" : "")"></div>
                                    <div class="stage-dot @(isDone ? "done" : "") @(isCurrent ? "current" : "") @(isSelected ? "border-primary" : "")" style="@(isSelected && !isCurrent ? "border-width:3px; transform:scale(1.2);" : "")"></div>
                                    <div class="stage-label @(isDone ? "done" : "") @(isCurrent ? "current" : "") @(isSelected ? "text-primary fw-bold" : "")">@stage</div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- DESGLOSE DE CHECKPOINTS Y PASOS -->
                    @{
                        string activeStageName = activeStageIdx < modalStages.Count ? modalStages[activeStageIdx] : "Etapa";
                        var stageCheckpoints = GetCheckpointsForStageIndex(activeStageIdx);
                    }
                    <div class="p-3 bg-white rounded-3 border shadow-sm">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <div>
                                <span class="badge @(activeStageIdx == currentIdx ? "bg-primary text-white" : activeStageIdx < currentIdx ? "bg-success bg-opacity-10 text-success" : "bg-light text-muted border") rounded-pill px-3 mb-1" style="font-size:10px;">
                                    @(activeStageIdx == currentIdx ? "📍 Etapa Actual Activa" : activeStageIdx < currentIdx ? "✓ Etapa Superada" : "Etapa Futura")
                                </span>
                                <h6 class="fw-bold text-dark mb-0">📌 Checkpoints y Pasos: Etapa #@(activeStageIdx + 1) — @activeStageName</h6>
                            </div>
                            <span class="badge bg-light text-dark border rounded-pill px-3">@stageCheckpoints.Count checkpoints</span>
                        </div>

                        @if (!stageCheckpoints.Any())
                        {
                            <div class="text-center py-4 bg-light rounded-3">
                                <i class="bi bi-info-circle text-muted fs-4 d-block mb-1"></i>
                                <span class="text-muted small fw-semibold">No hay checkpoints obligatorios registrados para la etapa <strong>@activeStageName</strong>.</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var cp in stageCheckpoints)
                                {
                                    <div class="card border mb-2 shadow-sm rounded-3 overflow-hidden @(cp.Status == "APROBADO" ? "border-success" : cp.Status == "RECHAZADO" ? "border-danger" : "border-secondary border-opacity-25")">
                                        <!-- Header Segmentado del Checkpoint -->
                                        <div class="card-header d-flex align-items-center justify-content-between py-2.5 px-3 @(cp.Status == "APROBADO" ? "bg-success bg-opacity-10" : cp.Status == "RECHAZADO" ? "bg-danger bg-opacity-10" : "bg-light")">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-dark text-white rounded-pill px-2.5" style="font-size:11px;">@cp.Code</span>
                                                <strong class="text-dark small me-2">@cp.Name</strong>
                                                @if (cp.BlocksAdvance)
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2" style="font-size:10px;">🛑 Bloqueante</span>
                                                }
                                                @if (!string.IsNullOrEmpty(cp.RollbackToStage))
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 rounded-pill px-2" style="font-size:10px;">↶ Retrocede a @cp.RollbackToStage</span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (cp.Status == "APROBADO")
                                                {
                                                    <span class="badge bg-success text-white rounded-pill px-3 py-1" style="font-size:11px;"><i class="bi bi-check-circle-fill me-1"></i> Checkpoint Aprobado</span>
                                                }
                                                else if (cp.Status == "RECHAZADO")
                                                {
                                                    <span class="badge bg-danger text-white rounded-pill px-3 py-1" style="font-size:11px;"><i class="bi bi-x-circle-fill me-1"></i> Checkpoint Rechazado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-3 py-1" style="font-size:11px;"><i class="bi bi-clock me-1"></i> Pendiente</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Cuerpo del Checkpoint: Pasos Secuenciales + Acciones Integradas -->
                                        <div class="card-body p-3">
                                            @if (cp.Steps != null && cp.Steps.Any())
                                            {
                                                <div class="mb-3">
                                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                                        <span class="fw-bold text-secondary" style="font-size:11px;">📋 Pasos Secuenciales del Checkpoint:</span>
                                                        <span class="badge bg-light text-dark border rounded-pill" style="font-size:10px;">@cp.CompletedStepsCount / @cp.Steps.Count Pasos</span>
                                                    </div>
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var step in cp.Steps)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between p-2 rounded border @(step.IsCompleted ? "bg-success bg-opacity-10 border-success border-opacity-25" : "bg-white border-secondary border-opacity-20")" style="font-size:0.83rem;">
                                                                <div class="d-flex align-items-center gap-2.5">
                                                                    <input type="checkbox" class="form-check-input mt-0 cursor-pointer" checked="@step.IsCompleted" @onchange="e => ToggleStepCompletion(cp, step, (bool)(e.Value ?? false))" />
                                                                    <span class="@(step.IsCompleted ? "text-decoration-line-through text-success fw-medium" : "fw-semibold text-dark")">
                                                                        <strong>Paso @step.StepOrder:</strong> @step.Instruction
                                                                    </span>
                                                                </div>
                                                                @if (step.IsRequired)
                                                                {
                                                                    <span class="badge @(step.IsCompleted ? "bg-success text-white" : "bg-danger bg-opacity-10 text-danger") rounded-pill px-2" style="font-size:9px;">
                                                                        @(step.IsCompleted ? "Completado" : "Obligatorio")
                                                                    </span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small fst-italic mb-3" style="font-size:11px;">
                                                    <i class="bi bi-info-circle me-1"></i> Checkpoint directo de avance general (sin pasos secundarios).
                                                </p>
                                            }

                                            <!-- Acciones Directas de Aprobación/Rechazo por Checkpoint -->
                                            @{
                                                bool hasUnfinishedRequired = cp.Steps.Any(s => s.IsRequired && !s.IsCompleted);
                                            }
                                            <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-10">
                                                <div>
                                                    <span class="text-muted small" style="font-size:11px;">Aprobación de @cp.Code:</span>
                                                    @if (hasUnfinishedRequired)
                                                    {
                                                        <small class="text-danger ms-2" style="font-size:10px;">
                                                            (@cp.Steps.Count(s => s.IsRequired && !s.IsCompleted) paso(s) obligatorio(s) pendiente(s))
                                                        </small>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size:11px;" @onclick="() => RejectCheckpoint(cp)">
                                                        <i class="bi bi-x-lg me-1"></i> Rechazar / KO
                                                    </button>
                                                    <button type="button" class="btn btn-sm @(cp.Status == "APROBADO" ? "btn-success text-white" : "btn-outline-success") rounded-pill px-3 py-1" 
                                                            style="font-size:11px;" 
                                                            disabled="@hasUnfinishedRequired"
                                                            title="@(hasUnfinishedRequired ? "Completa todos los pasos obligatorios antes de aprobar" : "")"
                                                            @onclick="() => ApproveCheckpoint(cp)">
                                                        <i class="bi bi-check-lg me-1"></i> Aprobar Checkpoint
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 font-semibold" @onclick="CloseTimelineModal">Cerrar</button>
                    <a href="/supervisor/orders/@_selectedTimelineOrder.IdOrder" class="btn btn-primary rounded-pill px-4 font-semibold shadow-sm text-decoration-none">Ir a la Ficha 360°</a>
                </div>
            </div>
        </div>
    </div>
}

