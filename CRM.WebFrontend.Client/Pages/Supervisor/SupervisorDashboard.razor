@code {
    // ── DTOs ──
    public class TeamOrderDto
    {
        public long IdOrder { get; set; }
        public long IdLead { get; set; }
        public long IdCmpg { get; set; }
        public long IdUser { get; set; }
        public long? IdStatus { get; set; }
        public long? IdSubstatus { get; set; }
        public long? CustodyUserId { get; set; }
        public DateTime SalesDate { get; set; }
        public string ClientName { get; set; } = "";
        public string CampaignName { get; set; } = "";
        public string StatusName { get; set; } = "";
        public string? StatusColor { get; set; }
        public string AdvisorName { get; set; } = "";
        public string BackofficeName { get; set; } = "";
        public int SlaMinutes { get; set; }
        public int DaysElapsed => (DateTime.UtcNow - SalesDate).Days;
        public string? CustomerDni { get; set; }
        public string? CustomerPhone { get; set; }
        public int TotalProducts { get; set; } = 1;
    }


    public class StatusDto { public int Id { get; set; } public string Name { get; set; } = ""; public string? Color { get; set; } }
    public class CampaignLookup { public int Id { get; set; } public string Name { get; set; } = ""; }
    public class AdvisorLookup { public long Id { get; set; } public string Name { get; set; } = ""; }

    public class AdvisorDto { public long Id { get; set; } public string Name { get; set; } = ""; }

    // ── State ──
    private string viewMode = "table";
    private bool isLoading = true;
    private bool isUpdatingStatus = false;
    private bool isNavigating = false;
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalCount = 0;
    private int totalPages = 0;

    private TeamOrderDto? _selectedTimelineOrder;
    private TeamOrderDto? _selectedProductsOrder;

    private async Task OpenTimelineModal(TeamOrderDto order)
    {
        _selectedTimelineOrder = order;
        _selectedModalStageIndex = GetCurrentStageIndex(order);

        try
        {
            var client = await GetAuthenticatedClient();
            var flowInstance = await client.GetFromJsonAsync<FlowInstanceWithCheckpointsApiDto>(
                $"/api/engines/flow/instances/by-entity/order/{order.IdOrder}");

            if (flowInstance != null)
            {
                // Cargar SOLO las etapas del flujo de esta orden
                var stagesForFlow = await client.GetFromJsonAsync<List<StageVmDash>>(
                    $"/api/engines/flow/stages?flowId={flowInstance.IdFlow}");

                if (stagesForFlow != null && stagesForFlow.Any())
                {
                    _stageObjects = stagesForFlow.OrderBy(s => s.OrderIndex).ToList();
                    // Usar currentStageId del motor, no id_status del CRM
                    _selectedModalStageIndex = _stageObjects
                        .FindIndex(s => s.IdStage == flowInstance.CurrentStageId);
                }
                else
                {
                    var flowStages = _stageObjects.Where(s => s.IdFlow == flowInstance.IdFlow).OrderBy(s => s.OrderIndex).ToList();
                    if (flowStages.Any())
                    {
                        _selectedModalStageIndex = flowStages.FindIndex(s => s.IdStage == flowInstance.CurrentStageId);
                    }
                }

                await LoadCheckpointInstancesForOrder(order.IdOrder);
            }
            else
            {
                await LoadCheckpointInstancesForOrder(order.IdOrder);
            }
        }
        catch
        {
            await LoadCheckpointInstancesForOrder(order.IdOrder);
        }

        if (!_cachedCheckpoints.Any())
        {
            await LoadCheckpointsAndStepsAsync();
        }
    }
    private void CloseTimelineModal()
    {
        _selectedTimelineOrder = null;
        _selectedModalStageIndex = -1;
    }

    private void OpenProductsModal(TeamOrderDto order) => _selectedProductsOrder = order;
    private void CloseProductsModal() => _selectedProductsOrder = null;

    private List<StageVmDash> _stageObjects = new();
    private List<string> _stages = new();

    private async Task LoadStagesFromApi()
    {
        try
        {
            var client = await GetAuthenticatedClient();
            var stageVms = await client.GetFromJsonAsync<List<StageVmDash>>("/api/engines/flow/stages");
            if (stageVms != null && stageVms.Any())
            {
                _stageObjects = stageVms.OrderBy(s => s.IdFlow).ThenBy(s => s.OrderIndex).ToList();
                _stages = _stageObjects.Where(s => s.IdFlow == 1).Select(s => s.Name).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SupervisorDashboard] Error cargando etapas: {ex.Message}");
        }
    }

