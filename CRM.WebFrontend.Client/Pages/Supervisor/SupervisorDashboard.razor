                    @* Quick status change from modal filtered by workflow transition rules *@
                    <hr class="my-3" />
                    <div>
                        <label class="form-label fw-bold small text-muted">Transiciones Permitidas para esta Venta (Flujo Supervisor):</label>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            @{
                                var allowedStatuses = GetAllowedTargetStatuses(selectedOrder.IdStatus);
                            }
                            @if (allowedStatuses.Any())
                            {
                                @foreach (var st in allowedStatuses)
                                {
                                    var targetStatusId = st.Id;
                                    <button class="btn btn-sm rounded-pill px-3 shadow-sm"
                                            style="background-color: @(st.Color ?? "#6c757d"); color: #fff; border: none;"
                                            disabled="@isUpdatingStatus"
                                            @onclick="() => ChangeOrderStatus(selectedOrder, targetStatusId)">
                                        ➡️ @st.Name
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border p-2 small">No hay más transiciones de estado válidas desde el estado actual.</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                    <a href="/supervisor/orders/@selectedOrder.IdOrder" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Ver Ficha Completa 360°
                    </a>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="() => selectedOrder = null">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

