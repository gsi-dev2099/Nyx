    private IEnumerable<StatusDto> GetAllowedTargetStatuses(long? currentStatusId)
    {
        if (!currentStatusId.HasValue) return Enumerable.Empty<StatusDto>();

        var allowedIds = currentStatusId.Value switch
        {
            2 => new long[] { 1, 3, 13 }, // En revisión supervisor -> Borrador/Devuelto, En BackOffice, Cancelado
            1 => new long[] { 2 },       // Borrador -> En revisión supervisor
            3 => new long[] { 2 },       // En BackOffice -> En revisión supervisor
            10 => new long[] { 3 },      // Enviado KO -> En BackOffice
            11 => new long[] { 3 },      // En incidencia -> En BackOffice
            12 => new long[] { 4 },      // Auditoría KO -> En gestión
            4 => new long[] { 13 },      // En gestión -> Cancelado
            7 => new long[] { 8 },       // Contrato enviado -> Contrato firmado
            9 => new long[] { 14 },      // Activado -> Baja
            _ => new long[] { 1, 2, 3 }  // Fallback seguro
        };

        return statuses.Where(s => allowedIds.Contains(s.Id) && s.Id != currentStatusId.Value);
    }

