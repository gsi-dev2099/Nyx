    // ── Lifecycle ──
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            await LoadStagesFromApi();
            await LoadCheckpointsAndStepsAsync();
            var client = await GetAuthenticatedClient();

            // Load global advisors list
            try
            {
                var advResult = await client.GetFromJsonAsync<List<AdvisorDto>>("/api/campaigns/advisors");
                if (advResult != null) globalAdvisors = advResult;
            }
            catch { /* fallback to empty */ }

            // Load backoffice users for name resolution
            try
            {
                var bacResult = await client.GetFromJsonAsync<List<AdvisorDto>>("/api/campaigns/advisors?role=BACKOFFICE");
                if (bacResult != null) backofficeUsers = bacResult;
            }
            catch { /* fallback to empty */ }

            // Load campaigns
            var cmpgResult = await client.GetFromJsonAsync<List<CampaignLookup>>("/api/campaigns");
            if (cmpgResult != null) campaigns = cmpgResult;

            // Load statuses from campaign 1 as default
            if (campaigns.Any())
            {
                selectedCampaignId = campaigns.First().Id;
                await LoadStatusesAsync(selectedCampaignId);
            }

            // Load team orders & checkpoints
            await LoadCheckpointsAndStepsAsync();
            await LoadOrdersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al inicializar: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStatusesAsync(int campaignId)
    {
        try
        {
            var client = await GetAuthenticatedClient();
            var result = await client.GetFromJsonAsync<List<StatusDto>>($"/api/campaigns/{campaignId}/statuses");
            if (result != null) statuses = result;
        }
        catch { /* keep existing statuses */ }
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        try
        {
            if (selectedCampaignId > 0)
            {
                await LoadStatusesAsync(selectedCampaignId);
            }

            var client = await GetAuthenticatedClient();

            var query = $"/api/supervisor/orders?page={currentPage}&pageSize={pageSize}&";
            if (selectedCampaignId > 0) query += $"campaignId={selectedCampaignId}&";
            if (filterDateFrom.HasValue) query += $"dateFrom={filterDateFrom.Value:yyyy-MM-dd}&";
            if (filterDateTo.HasValue) query += $"dateTo={filterDateTo.Value:yyyy-MM-dd}&";

            var pagedResult = await client.GetFromJsonAsync<CRM.WebFrontend.Client.Models.PagedResult<TeamOrderDto>>(query.TrimEnd('&', '?'));
            if (pagedResult != null)
            {
                totalCount = pagedResult.TotalCount;
                totalPages = pagedResult.TotalPages;
                var result = pagedResult.Items.Where(x => x.IdLead != 99998).ToList();
                
                // Enrich with campaign names
                foreach (var o in result)
                {
                    o.CampaignName = campaigns.FirstOrDefault(c => c.Id == o.IdCmpg)?.Name ?? "Desconocida";
                    var matchedStatus = statuses.FirstOrDefault(s => s.Id == o.IdStatus);
                    o.StatusName = matchedStatus?.Name ?? "Sin estado";
                    o.StatusColor = matchedStatus?.Color ?? "#6c757d";
                    
                    var adv = globalAdvisors.FirstOrDefault(a => a.Id == o.IdUser);
                    o.AdvisorName = adv != null && !string.IsNullOrWhiteSpace(adv.Name) ? adv.Name : $"Asesor {o.IdUser}";
                    
                    // Resolve backoffice analyst name when custody is assigned
                    if (o.CustodyUserId.HasValue && o.CustodyUserId.Value > 0)
                    {
                        var bac = backofficeUsers.FirstOrDefault(b => b.Id == o.CustodyUserId.Value);
                        o.BackofficeName = bac != null && !string.IsNullOrWhiteSpace(bac.Name) ? bac.Name : "";
                    }
                    
                    o.ClientName = !string.IsNullOrEmpty(o.ClientName) ? o.ClientName : "";
                }

                // Fetch lead names concurrently
                var uniqueLeadIds = result.Where(o => string.IsNullOrEmpty(o.ClientName)).Select(o => o.IdLead).Distinct().ToList();
                var leadTasks = uniqueLeadIds.Select(async leadId => 
                {
                    try
                    {
                        var lead = await client.GetFromJsonAsync<TempLeadDto>($"/api/leads/{leadId}");
                        if (lead != null)
                        {
                            var fullName = !string.IsNullOrWhiteSpace(lead.FullName) ? lead.FullName : $"{lead.FirstName} {lead.LastName}";
                            if (!string.IsNullOrWhiteSpace(fullName)) return new { Id = leadId, Name = fullName.Trim() };
                        }
                    }
                    catch { }
                    return new { Id = leadId, Name = $"Cliente no registrado" };
                });
                
                var leadNames = await Task.WhenAll(leadTasks);
                var leadDict = leadNames.ToDictionary(k => k.Id, v => v.Name);

                foreach (var o in result)
                {
                    if (string.IsNullOrEmpty(o.ClientName))
                    {
                        if (leadDict.TryGetValue(o.IdLead, out var name)) o.ClientName = name;
                        else o.ClientName = $"Cliente no registrado";
                    }
                }

                allOrders = result;

                // Build advisor list from the orders (only real advisors, no backoffice)
                advisorList = allOrders
                    .GroupBy(o => o.IdUser)
                    .Select(g => new AdvisorLookup { Id = g.Key, Name = g.First().AdvisorName })
                    .OrderBy(a => a.Name)
                    .ToList();

                ApplyLocalFilters();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar órdenes: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFiltersLocal() => ApplyLocalFilters();

    private void ApplyLocalFilters()
    {
        var temp = allOrders.AsEnumerable();

        if (selectedAdvisorId > 0)
        {
            temp = temp.Where(o => 
                (o.CustodyUserId.HasValue && o.CustodyUserId > 0 ? o.CustodyUserId.Value : o.IdUser) == selectedAdvisorId
            );
        }

        if (expressFilter == "CRITICAL_SLA")
        {
            temp = temp.Where(o => o.SlaMinutes > 120);
        }
        else if (expressFilter == "PENDING_SUPER")
        {
            temp = temp.Where(o => o.IdStatus == 2);
        }
        else if (expressFilter == "IN_BACKOFFICE")
        {
            temp = temp.Where(o => o.IdStatus == 3);
        }

        filteredOrders = temp.ToList();
    }



