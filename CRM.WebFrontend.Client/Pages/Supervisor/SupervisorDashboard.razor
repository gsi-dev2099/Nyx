    private async Task<HttpClient> GetAuthenticatedClient()
    {
        var client = HttpClientFactory.CreateClient("BackendApi");
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("access_token")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        return client;
    }

    private async Task ChangeOrderStatus(TeamOrderDto order, long targetStatusId)
    {
        isUpdatingStatus = true;
        var previousStatusId = order.IdStatus;
        var targetStatus = statuses.FirstOrDefault(s => s.Id == targetStatusId);

        try
        {
            var client = await GetAuthenticatedClient();
            var payload = new { toStatusId = targetStatusId, comment = $"Movido desde Kanban Supervisor" };
            var response = await client.PatchAsJsonAsync($"/api/orders/{order.IdOrder}/status", payload);

            if (response.IsSuccessStatusCode)
            {
                // Update locally
                order.IdStatus = targetStatusId;
                order.StatusName = targetStatus?.Name ?? "Sin estado";
                order.StatusColor = targetStatus?.Color ?? "#6c757d";
                ApplyLocalFilters();
                Snackbar.Add($"Orden #{order.IdOrder} movida a \"{targetStatus?.Name}\"", Severity.Success);
                selectedOrder = null; // close modal if open
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al cambiar estado: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isUpdatingStatus = false;
        }
    }

