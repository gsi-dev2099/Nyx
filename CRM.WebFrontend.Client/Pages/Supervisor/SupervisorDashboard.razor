    private async Task LoadCheckpointInstancesForOrder(long orderId)
    {
        try
        {
            var client = await GetAuthenticatedClient();
            var flowInstance = await client.GetFromJsonAsync<FlowInstanceWithCheckpointsApiDto>($"/api/engines/flow/instances/by-entity/order/{orderId}");
            if (flowInstance?.CheckpointInstances != null)
            {
                foreach (var cpVm in _cachedCheckpoints)
                {
                    var match = flowInstance.CheckpointInstances
                        .FirstOrDefault(ci => ci.IdCheckpoint == cpVm.IdCheckpoint && (ci.Status == "PENDING" || ci.Status == "SUBSANADO" || ci.Status == "KO" || ci.Status == "SCHEDULED"));
                    
                    if (match != null)
                    {
                        cpVm.IdCpInstance = match.IdCpInstance;
                        cpVm.Status = match.Status == "SUBSANADO" ? "APROBADO" : (match.Status == "KO" ? "RECHAZADO" : "PENDIENTE");

                        // Cargar progreso de pasos si la instancia existe
                        try
                        {
                            var stepProgress = await client.GetFromJsonAsync<List<StepProgressApiDto>>($"/api/engines/flow/checkpoints/instances/{match.IdCpInstance}/steps");
                            if (stepProgress != null)
                            {
                                var completedMap = stepProgress.ToDictionary(sp => sp.IdStep, sp => sp.IsCompleted);
                                foreach (var step in cpVm.Steps)
                                {
                                    if (completedMap.TryGetValue(step.IdStep, out var isComp))
                                    {
                                        step.IsCompleted = isComp;
                                    }
                                }
                            }
                        }
                        catch { }
                    }
                    else
                    {
                        cpVm.IdCpInstance = null;
                        cpVm.Status = "PENDIENTE";
                        foreach (var step in cpVm.Steps) step.IsCompleted = false;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SupervisorDashboard] Error cargando instancias de orden #{orderId}: {ex.Message}");
        }
    }

    private async Task ToggleStepCompletion(StageCheckpointModalVm cp, CheckpointStepModalVm step, bool isCompleted)
    {
        step.IsCompleted = isCompleted;
        if (cp.IdCpInstance.HasValue)
        {
            try
            {
                var client = await GetAuthenticatedClient();
                var actorId = await GetCurrentUserIdAsync();
                await client.PostAsJsonAsync(
                    $"/api/engines/flow/checkpoints/instances/{cp.IdCpInstance.Value}/steps/{step.IdStep}/toggle",
                    new { isCompleted, actorId }
                );
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SupervisorDashboard] Error toggling step #{step.IdStep}: {ex.Message}");
            }
        }

        if (cp.AreAllRequiredStepsCompleted && cp.Status == "PENDIENTE")
        {
            cp.Status = "APROBADO";
        }
        else if (!cp.AreAllRequiredStepsCompleted && cp.Status == "APROBADO")
        {
            cp.Status = "PENDIENTE";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApproveCheckpoint(StageCheckpointModalVm cp)
    {
        if (cp.Steps.Any(s => s.IsRequired && !s.IsCompleted))
        {
            Snackbar.Add("⚠ Hay pasos obligatorios sin completar. Marca todos los pasos obligatorios antes de aprobar.", Severity.Warning);
            return;
        }

        if (!cp.IdCpInstance.HasValue)
        {
            Snackbar.Add("Este checkpoint no tiene una instancia activa para esta orden en el motor de flujos.", Severity.Warning);
            return;
        }

        try
        {
            var client = await GetAuthenticatedClient();
            var actorId = await GetCurrentUserIdAsync();
            var response = await client.PostAsJsonAsync(
                $"/api/engines/flow/instances/{cp.IdCpInstance.Value}/resolve",
                new { status = "SUBSANADO", actorId }
            );

            if (response.IsSuccessStatusCode)
            {
                cp.Status = "APROBADO";
                foreach (var s in cp.Steps) s.IsCompleted = true;
                Snackbar.Add($"Checkpoint {cp.Code} aprobado y subsanado correctamente.", Severity.Success);
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al aprobar checkpoint: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RejectCheckpoint(StageCheckpointModalVm cp)
    {
        if (!cp.IdCpInstance.HasValue)
        {
            Snackbar.Add("Este checkpoint no tiene una instancia activa para esta orden.", Severity.Warning);
            return;
        }

        try
        {
            var client = await GetAuthenticatedClient();
            var actorId = await GetCurrentUserIdAsync();
            var response = await client.PostAsJsonAsync(
                $"/api/engines/flow/instances/{cp.IdCpInstance.Value}/resolve",
                new { status = "KO", actorId }
            );

            if (response.IsSuccessStatusCode)
            {
                cp.Status = "RECHAZADO";
                Snackbar.Add($"Checkpoint {cp.Code} marcado como Rechazado (KO). Se han evaluado reglas y posibles retrocesos.", Severity.Info);
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al rechazar checkpoint: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

