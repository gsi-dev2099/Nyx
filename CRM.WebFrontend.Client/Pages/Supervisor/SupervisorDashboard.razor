    private static long ResolveFlowIdForOrder(TeamOrderDto? order)
    {
        if (order == null) return 1;
        if (order.IdCmpg is >= 1 and <= 5) return 2; // Vodafone, Lowi, Yoigo, MasMovil, Orange
        var cmpgName = order.CampaignName ?? "";
        if (cmpgName.Contains("VODAFONE", StringComparison.OrdinalIgnoreCase) ||
            cmpgName.Contains("LOWI", StringComparison.OrdinalIgnoreCase) ||
            cmpgName.Contains("YOIGO", StringComparison.OrdinalIgnoreCase) ||
            cmpgName.Contains("MASMOVIL", StringComparison.OrdinalIgnoreCase) ||
            cmpgName.Contains("ORANGE", StringComparison.OrdinalIgnoreCase) ||
            cmpgName.Contains("TELECOM", StringComparison.OrdinalIgnoreCase))
            return 2;
        return 1;
    }

    private List<string> GetStagesForOrder(TeamOrderDto? order)
    {
        if (order == null || !_stageObjects.Any()) return _stages.Any() ? _stages : new List<string> { "Preventa", "Venta Creada", "Gestión Inicial", "Validación Interna", "Envío Proveedor", "Validación Externa", "Firma", "Tramitación", "Activación", "Postventa", "Cerrada" };

        var flowId = ResolveFlowIdForOrder(order);
        var filtered = _stageObjects
            .Where(s => s.IdFlow == flowId)
            .OrderBy(s => s.OrderIndex)
            .Select(s => s.Name)
            .ToList();

        if (!filtered.Any())
        {
            filtered = _stageObjects.Where(s => s.IdFlow == 1).OrderBy(s => s.OrderIndex).Select(s => s.Name).ToList();
        }

        return filtered.Any() ? filtered : _stages;
    }

    private static readonly Dictionary<long, long> _statusStageMap = new()
    {
        { 1, 1 },   // Borrador -> Preventa (Stage 1)
        { 2, 3 },   // En revisión supervisor -> Gestión Inicial (Stage 3)
        { 3, 4 },   // En BackOffice -> Validación Interna (Stage 4)
        { 4, 3 },   // En gestión -> Gestión Inicial (Stage 3)
        { 5, 5 },   // Enviado al proveedor -> Envío Proveedor (Stage 5)
        { 6, 6 },   // Validado por proveedor -> Validación Externa (Stage 6)
        { 7, 7 },   // Contrato enviado -> Firma (Stage 7)
        { 8, 7 },   // Contrato firmado -> Firma (Stage 7)
        { 9, 9 },   // Activado -> Activación (Stage 9)
        { 10, 4 },  // Enviado KO -> Validación Interna (Stage 4)
        { 11, 4 },  // En incidencia -> Validación Interna (Stage 4)
        { 12, 4 },  // Auditoría KO -> Validación Interna (Stage 4)
        { 13, 11 }, // Cancelado -> Cerrada (Stage 11)
        { 14, 11 }, // Baja -> Cerrada (Stage 11)
        { 15, 9 }   // Reportado -> Activación (Stage 9)
    };

    private int GetCurrentStageIndex(TeamOrderDto? order)
    {
        if (order == null) return 0;
        var orderStages = GetStagesForOrder(order);
        if (!orderStages.Any()) return 0;

        var flowId = ResolveFlowIdForOrder(order);

        if (order.IdStatus.HasValue && _statusStageMap.TryGetValue(order.IdStatus.Value, out var targetStageId))
        {
            var effectiveTargetStageId = (flowId == 2 && targetStageId <= 11) ? targetStageId + 11 : targetStageId;
            var matchObj = _stageObjects.FirstOrDefault(s => s.IdStage == effectiveTargetStageId || (s.IdFlow == flowId && s.OrderIndex == targetStageId));
            if (matchObj != null)
            {
                var idx = orderStages.IndexOf(matchObj.Name);
                if (idx >= 0) return idx;
            }
        }

        if (!string.IsNullOrEmpty(order.StatusName))
        {
            var matchObj = _stageObjects.FirstOrDefault(s =>
                s.IdFlow == flowId && (
                s.StageCode.Equals(order.StatusName, StringComparison.OrdinalIgnoreCase) ||
                s.Name.Equals(order.StatusName, StringComparison.OrdinalIgnoreCase)));
            if (matchObj != null)
            {
                var idx = orderStages.IndexOf(matchObj.Name);
                if (idx >= 0) return idx;
            }
        }

        return 0;
    }


