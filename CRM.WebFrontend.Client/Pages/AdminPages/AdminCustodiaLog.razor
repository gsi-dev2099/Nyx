@page "/admin/custodia-log"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMIN_CRM,SUPERVISOR,BACKOFFICE")]
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@using MudBlazor

<PageTitle>Log Forense de Custodia - NYX CRM</PageTitle>

<style>
    .admin-header { background: #ffffff; border-radius: 20px; padding: 22px 28px; box-shadow: 0 4px 24px rgba(29,38,57,0.06); margin-bottom: 1.5rem; }
    .table-modern thead th { background: #F8FAFC; color: #64748B; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 12px 16px; border-bottom: 1px solid #E2E8F0; }
    .table-modern tbody td { padding: 12px 16px; font-size: 0.85rem; color: #1E293B; vertical-align: middle; border-bottom: 1px solid #F1F5F9; }
    .custody-arrow { font-size: 1.1rem; color: #2563EB; font-weight: bold; }
</style>

<div class="container-fluid py-4">
    <div class="admin-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i> Trazabilidad Forense de Custodia de Órdenes</h1>
            <p class="text-muted small mb-0">Auditoría inmutable de transferencias, derivaciones y cambios de mano de órdenes entre colaboradores.</p>
        </div>
        <div class="d-flex gap-2">
            <input type="text" class="form-control rounded-pill px-3" style="width:250px;" placeholder="🔍 Buscar por ID Orden..." @bind="_searchOrder" />
            <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="RefreshLogs"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
        </div>
    </div>

    <!-- Tabla Forense -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID Orden</th>
                        <th>Custodio Anterior</th>
                        <th class="text-center">Flujo</th>
                        <th>Nuevo Custodio</th>
                        <th>Motivo / Razón de Transferencia</th>
                        <th class="text-end pe-4">Fecha / Hora</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in FilteredLogs)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary font-monospace">#@log.IdOrder</td>
                            <td>
                                <div class="fw-semibold text-dark">@(log.FromUsername ?? "Sistema / Auto")</div>
                                <div class="text-muted small">@(log.FromRole ?? (log.FromUserId.HasValue ? $"ID: #{log.FromUserId}" : "Auto"))</div>
                            </td>
                            <td class="text-center">
                                <i class="bi bi-arrow-right-circle-fill custody-arrow"></i>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@log.ToUsername</div>
                                <div class="text-muted small">ID: #@log.ToUserId</div>
                            </td>
                            <td class="text-secondary small">
                                <span class="badge bg-light text-dark border me-1">@(log.TransferType ?? "Derivación")</span>
                                @(log.Comment ?? "Asignación estándar por flujo de campaña")
                            </td>
                            <td class="text-end pe-4 text-muted small">
                                @log.Register.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                        </tr>
                    }
                    @if (!FilteredLogs.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">No se encontraron registros de custodia.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string _searchOrder = "";
    private List<CustodyLogDto> _logs = new();

    public class CustodyLogDto
    {
        public long IdLog { get; set; }
        public long IdOrder { get; set; }
        public long? FromUserId { get; set; }
        public string? FromUsername { get; set; }
        public long? ToUserId { get; set; }
        public string? ToUsername { get; set; }
        public string? FromRole { get; set; }
        public string? ToRole { get; set; }
        public string? TransferType { get; set; }
        public long? IdStatusAt { get; set; }
        public string? Comment { get; set; }
        public bool IsBulk { get; set; }
        public DateTime Register { get; set; } = DateTime.Now;
    }

    private IEnumerable<CustodyLogDto> FilteredLogs => string.IsNullOrWhiteSpace(_searchOrder)
        ? _logs
        : _logs.Where(x => x.IdOrder.ToString().Contains(_searchOrder));

    protected override async Task OnInitializedAsync() => await RefreshLogs();

    private async Task RefreshLogs()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var logs = await client.GetFromJsonAsync<List<CustodyLogDto>>("/api/maintenance/custody-logs");
            if (logs != null && logs.Any()) _logs = logs;
            else LoadMockLogs();
        }
        catch { LoadMockLogs(); }
    }

    private void LoadMockLogs()
    {
        _logs = new List<CustodyLogDto>
        {
            new() { IdLog = 1, IdOrder = 10452, FromUserId = 12, FromUsername = "asesor_juan", ToUserId = 45, ToUsername = "super_maria", TransferType = "Manual", Comment = "Revisión por scoring dudoso en contrato", Register = DateTime.Now.AddMinutes(-25) },
            new() { IdLog = 2, IdOrder = 10450, FromUserId = 45, FromUsername = "super_maria", ToUserId = 88, ToUsername = "back_pedro", TransferType = "Flujo", Comment = "Validación técnica aprobada, pase a BO", Register = DateTime.Now.AddHours(-2) },
            new() { IdLog = 3, IdOrder = 10448, FromUserId = null, FromUsername = "Sistema Auto-Routing", ToUserId = 12, ToUsername = "asesor_juan", TransferType = "Auto", Comment = "Asignación inicial por carga de campaña", Register = DateTime.Now.AddHours(-5) },
            new() { IdLog = 4, IdOrder = 10441, FromUserId = 15, FromUsername = "asesor_carlos", ToUserId = 12, ToUsername = "asesor_juan", TransferType = "Manual", Comment = "Transferencia manual entre asesores por cobertura", Register = DateTime.Now.AddDays(-1) },
        };
    }
}
