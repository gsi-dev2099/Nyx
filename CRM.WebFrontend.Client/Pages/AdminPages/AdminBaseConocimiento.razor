@page "/admin/kb"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@using MudBlazor

<PageTitle>Base de Conocimiento - NYX CRM</PageTitle>

<style>
    .admin-header { background: #ffffff; border-radius: 20px; padding: 22px 28px; box-shadow: 0 4px 24px rgba(29,38,57,0.06); margin-bottom: 1.5rem; }
    .btn-admin { background: #1D2639; color: #fff; border-radius: 12px; font-weight: 600; border: none; }
    .btn-admin:hover { background: #2563EB; color: #fff; }
    .kb-card { background: #fff; border-radius: 18px; box-shadow: 0 4px 20px rgba(29,38,57,0.06); padding: 22px; margin-bottom: 1rem; border: 2px solid transparent; transition: all 0.2s; cursor: pointer; }
    .kb-card:hover { border-color: #2563EB; box-shadow: 0 8px 24px rgba(37,99,235,0.12); }
    .cat-btn { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 10px 16px; margin-bottom: 8px; width: 100%; text-align: left; transition: all 0.18s; }
    .cat-btn:hover { border-color: #2563EB; background: #EFF6FF; }
    .cat-btn.active { border-color: #2563EB; background: #2563EB; color: #fff; }
</style>

<div class="container-fluid py-4">
    <div class="admin-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1"><i class="bi bi-book-fill text-primary me-2"></i> Central de Base de Conocimiento</h1>
            <p class="text-muted small mb-0">Artículos técnicos, guías operativas de venta y solución de incidencias vinculadas a campañas y estados.</p>
        </div>
        <div class="d-flex gap-2">
            <input type="text" class="form-control rounded-pill px-4" style="min-width:300px;" placeholder="🔍 Buscar por palabra clave, estado o guía..." @bind="_search" @oninput="OnSearch" />
            <button class="btn btn-admin px-4 py-2" @onclick="NewArticle"><i class="bi bi-plus-circle-fill me-2"></i> Nuevo Artículo</button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Categorías -->
        <div class="col-md-3">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-folder2-open me-2"></i> Categorías Operativas</h6>
            <button class="cat-btn @(_selectedCategory == null ? "active" : "")" @onclick="() => SelectCategory(null)">
                <div class="d-flex align-items-center justify-content-between">
                    <span>Todas las Guías</span>
                    <span class="badge bg-light text-dark border rounded-pill">@_articles.Count</span>
                </div>
            </button>
            @foreach (var cat in _categories)
            {
                <button class="cat-btn @(_selectedCategory == cat ? "active" : "")" @onclick="() => SelectCategory(cat)">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>@cat</span>
                        <span class="badge bg-light text-dark border rounded-pill">@_articles.Count(x => x.Category == cat)</span>
                    </div>
                </button>
            }
        </div>

        <!-- Lista de Artículos -->
        <div class="col-md-9">
            @if (_selectedArticle != null)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill mb-3" style="width:fit-content;" @onclick="() => _selectedArticle = null">
                        <i class="bi bi-arrow-left me-1"></i> Volver a la lista
                    </button>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3">@_selectedArticle.Category</span>
                        <span class="badge bg-light text-dark border">Campaña: @_selectedArticle.Campaign</span>
                    </div>
                    <h3 class="fw-bold text-dark mb-3">@_selectedArticle.Title</h3>
                    <div class="p-3 bg-light rounded-3 mb-4 text-secondary leading-relaxed" style="white-space:pre-line;">
                        @_selectedArticle.Content
                    </div>
                    <div class="d-flex align-items-center justify-content-between border-top pt-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-muted small"><i class="bi bi-hand-thumbs-up text-success me-1"></i> @_selectedArticle.HelpfulVotes útil(es)</span>
                            <span class="text-muted small"><i class="bi bi-eye me-1"></i> @_selectedArticle.Views vistas</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-success rounded-pill px-3" @onclick="VoteHelpful"><i class="bi bi-hand-thumbs-up me-1"></i> ¿Fue útil?</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var art in FilteredArticles)
                    {
                        <div class="col-md-6">
                            <div class="kb-card" @onclick="() => ReadArticle(art)">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill">@art.Category</span>
                                    <span class="text-muted small">@art.Campaign</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-2">@art.Title</h6>
                                <p class="text-muted small mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">@art.Summary</p>
                                <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top">
                                    <span><i class="bi bi-hand-thumbs-up text-success me-1"></i> @art.HelpfulVotes</span>
                                    <span class="text-primary fw-semibold">Leer Guía <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </div>
                        </div>
                    }
                    @if (!FilteredArticles.Any())
                    {
                        <div class="col-12 text-center text-muted py-5">
                            <i class="bi bi-search fs-1 mb-3"></i>
                            <p>No se encontraron artículos que coincidan con la búsqueda.</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _search = "";
    private string? _selectedCategory;
    private List<string> _categories = new() { "Script de Ventas", "Manejo de Objeciones", "Validación y Contratos", "Incidencias Operador", "Políticas RGPD" };
    private List<ArticleDto> _articles = new();
    private ArticleDto? _selectedArticle;

    public class ArticleDto
    {
        public long Id { get; set; }
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public string Campaign { get; set; } = "";
        public string Summary { get; set; } = "";
        public string Content { get; set; } = "";
        public int HelpfulVotes { get; set; }
        public int Views { get; set; }
    }

    private IEnumerable<ArticleDto> FilteredArticles => _articles
        .Where(a => _selectedCategory == null || a.Category == _selectedCategory)
        .Where(a => string.IsNullOrWhiteSpace(_search) || a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || a.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase));

    public class CategoryDto { public long IdCategory { get; set; } public string Name { get; set; } = ""; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var cats = await client.GetFromJsonAsync<List<CategoryDto>>("/api/kb/categories");
            if (cats != null && cats.Any()) _categories = cats.Select(c => c.Name).ToList();

            var articles = await client.GetFromJsonAsync<List<ArticleDto>>("/api/kb/articles");
            if (articles != null && articles.Any()) _articles = articles;
            else LoadMockArticles();
        }
        catch { LoadMockArticles(); }
    }

    private void LoadMockArticles()
    {
        _articles = new List<ArticleDto>
        {
            new() { Id = 1, Title = "Script de Argumentación Fibra 600Mb Residencial", Category = "Script de Ventas", Campaign = "Fibra Hogar", Summary = "Pasos para explicar la instalación simétrica, router Wi-Fi 6 y sin permanencia excesiva.", Content = "1. Saludo y sondeo de cobertura.\n2. Explicar velocidad simétrica 600Mb ideal para múltiples dispositivos.\n3. Destacar precio promocional de 6 meses.\n4. Lectura de contrato obligatorio.", HelpfulVotes = 42, Views = 310 },
            new() { Id = 2, Title = "Manejo de Objeción: «Tengo permanencia con otro operador»", Category = "Manejo de Objeciones", Campaign = "General", Summary = "Argumentos comerciales para ofrecer el bono de penalización o instalación diferida.", Content = "Informar al cliente sobre la posibilidad de programar la fecha de portabilidad exactamente el día que vence su contrato previo para evitar penalizaciones.", HelpfulVotes = 38, Views = 285 },
            new() { Id = 3, Title = "Guía de Validación de Documentos DNI / NIE / CIF", Category = "Validación y Contratos", Campaign = "General", Summary = "Validación de vigencia de documentos y comprobación de titulares en scoring.", Content = "Verificar que el documento no esté caducado. Para extranjeros con NIE, adjuntar pasaporte si no figura la firma visible.", HelpfulVotes = 55, Views = 420 },
            new() { Id = 4, Title = "Resolución de Incidencia: Error M6 Titular Incorrecto", Category = "Incidencias Operador", Campaign = "Empresas Pro", Summary = "Pasos para subsanar rechazo de portabilidad por divergencia de titular en el sistema del proveedor.", Content = "Verificar en la factura anterior del cliente la razón social exacta y el CIF titular para reenviar el pedido a la mesa de BO.", HelpfulVotes = 29, Views = 190 },
        };
    }

    private void SelectCategory(string? cat) { _selectedCategory = cat; _selectedArticle = null; }
    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";
    private void ReadArticle(ArticleDto art) { art.Views++; _selectedArticle = art; }
    private void VoteHelpful() { if (_selectedArticle != null) { _selectedArticle.HelpfulVotes++; Snackbar.Add("¡Gracias por tu valoración!", Severity.Success); } }
    private void NewArticle() { Snackbar.Add("Editor de artículos abierto.", Severity.Info); }
}
