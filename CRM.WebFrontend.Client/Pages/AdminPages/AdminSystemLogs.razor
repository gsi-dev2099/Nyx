@page "/admin/system-logs"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMIN_CRM")]
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@using MudBlazor

<PageTitle>Logs de Auditoría del Sistema - NYX CRM</PageTitle>

<style>
    .admin-header { background: #ffffff; border-radius: 20px; padding: 22px 28px; box-shadow: 0 4px 24px rgba(29,38,57,0.06); margin-bottom: 1.5rem; }
    .table-modern thead th { background: #F8FAFC; color: #64748B; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 12px 16px; border-bottom: 1px solid #E2E8F0; }
    .table-modern tbody td { padding: 12px 16px; font-size: 0.85rem; color: #1E293B; vertical-align: middle; border-bottom: 1px solid #F1F5F9; }
</style>

<div class="container-fluid py-4">
    <div class="admin-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1"><i class="bi bi-journal-code text-primary me-2"></i> Logs de Auditoría y Seguridad del Sistema</h1>
            <p class="text-muted small mb-0">Registro en tiempo real de operaciones administrativas, logins, IP, módulo y cambios de configuración.</p>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="RefreshAudit"><i class="bi bi-arrow-clockwise me-1"></i> Actualizar Logs</button>
    </div>

    <!-- Tabla Logs -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID Audit</th>
                        <th>Actor / Cambiado por</th>
                        <th>Operación</th>
                        <th>Tabla Afectada</th>
                        <th>IP Cliente</th>
                        <th>Nuevo Valor (preview)</th>
                        <th class="text-end pe-4">Fecha / Hora</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr>
                            <td class="ps-4 font-monospace text-muted small">#@log.IdAudit</td>
                            <td class="fw-bold text-dark">@(log.ChangedBy ?? "Sistema")</td>
                            <td>
                                <span class="badge @GetOperationBadge(log.Operation) rounded-pill px-3">@log.Operation</span>
                            </td>
                            <td><span class="badge bg-light text-dark border small font-monospace">@log.SchemaName.@log.TableName</span></td>
                            <td class="font-monospace small text-secondary">@(log.ClientIp ?? "127.0.0.1")</td>
                            <td class="text-secondary small" style="max-width:200px; overflow:hidden; text-overflow:ellipsis;">
                                @if (!string.IsNullOrEmpty(log.NewValue))
                                {
                                    <span title="@log.NewValue">&#128196; @log.NewValue[..Math.Min(log.NewValue.Length, 60)]@(log.NewValue.Length > 60 ? "..." : "")</span>
                                }
                                else { <span class="text-muted">&#8212;</span> }
                            </td>
                            <td class="text-end pe-4 text-muted small">@log.Register.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<AuditLogDto> _logs = new();

    public class AuditLogDto
    {
        public long IdAudit { get; set; }
        public string SchemaName { get; set; } = "";
        public string TableName { get; set; } = "";
        public string Operation { get; set; } = "";
        public string? RecordId { get; set; }
        public string? OldValue { get; set; }
        public string? NewValue { get; set; }
        public string? ChangedBy { get; set; }
        public string? ClientIp { get; set; }
        public DateTime Register { get; set; } = DateTime.Now;
    }

    protected override async Task OnInitializedAsync() => await RefreshAudit();

    private async Task RefreshAudit()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var logs = await client.GetFromJsonAsync<List<AuditLogDto>>("/api/maintenance/system-logs");
            if (logs != null && logs.Any()) _logs = logs;
            else LoadMockLogs();
        }
        catch { LoadMockLogs(); }
    }

    private void LoadMockLogs()
    {
        _logs = new List<AuditLogDto>
        {
            new() { IdAudit = 1001, ChangedBy = "admin_crm", Operation = "UPDATE", SchemaName = "access_control", TableName = "role", RecordId = "5", NewValue = "{\"is_active\": true}", ClientIp = "192.168.1.45", Register = DateTime.Now.AddMinutes(-5) },
            new() { IdAudit = 1002, ChangedBy = "admin_crm", Operation = "INSERT", SchemaName = "sales_service", TableName = "order_status", RecordId = "16", NewValue = "{\"name\": \"Nuevo Estado\"}", ClientIp = "192.168.1.45", Register = DateTime.Now.AddMinutes(-18) },
            new() { IdAudit = 1003, ChangedBy = "super_maria", Operation = "UPDATE", SchemaName = "sales_service", TableName = "sales_order", RecordId = "10452", NewValue = "{\"id_status\": 4}", ClientIp = "192.168.1.88", Register = DateTime.Now.AddMinutes(-40) },
            new() { IdAudit = 1004, ChangedBy = "admin_crm", Operation = "DELETE", SchemaName = "maintenance", TableName = "provider_status_mapping", RecordId = "12", OldValue = "{\"id_provider\": 2}", ClientIp = "192.168.1.45", Register = DateTime.Now.AddHours(-3) },
        };
    }

    private string GetOperationBadge(string op) => op switch
    {
        "INSERT" => "bg-success-subtle text-success",
        "DELETE" => "bg-danger-subtle text-danger",
        "SELECT" => "bg-primary-subtle text-primary",
        _ => "bg-warning-subtle text-warning"
    };
}
