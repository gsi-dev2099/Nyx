    // ===== STATUS CRUD =====
    private void OpenStatusModal(StatusDto? s)
    {
        _editStatus = s != null ? new StatusDto { Id=s.Id, Code=s.Code, Name=s.Name, Category=s.Category, Color=s.Color, Icon=s.Icon, IsTerminal=s.IsTerminal, RequiresSubstatus=s.RequiresSubstatus, RequiresComment=s.RequiresComment, AllowsEditByAsesor=s.AllowsEditByAsesor, AllowsEditBySupervisor=s.AllowsEditBySupervisor, OrderIndex=s.OrderIndex, IsActive=s.IsActive }
            : new StatusDto { Color="#2563EB", OrderIndex=(short)(_statuses.Any()?_statuses.Max(x=>x.OrderIndex)+1:1), AllowsEditBySupervisor=true };
        _showStatusModal = true;
    }

    private async Task SaveStatus()
    {
        if (string.IsNullOrWhiteSpace(_editStatus.Name)||string.IsNullOrWhiteSpace(_editStatus.Code)) { Snackbar.Add("Nombre y Código son requeridos.", Severity.Warning); return; }
        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            if (_editStatus.Id > 0)
                await client.PutAsJsonAsync($"/api/maintenance/statuses/{_editStatus.Id}", new { _editStatus.Code, _editStatus.Name, _editStatus.Category, _editStatus.Color, _editStatus.Icon, _editStatus.IsTerminal, _editStatus.RequiresSubstatus, _editStatus.RequiresComment, _editStatus.AllowsEditByAsesor, _editStatus.AllowsEditBySupervisor, _editStatus.OrderIndex, IsActive=(bool?)null });
            else
                await client.PostAsJsonAsync("/api/maintenance/statuses", new { _editStatus.Code, _editStatus.Name, _editStatus.Category, _editStatus.Color, _editStatus.Icon, _editStatus.IsTerminal, _editStatus.RequiresSubstatus, _editStatus.RequiresComment, _editStatus.AllowsEditByAsesor, _editStatus.AllowsEditBySupervisor, _editStatus.OrderIndex });
            Snackbar.Add("Estado guardado.", Severity.Success);
            _showStatusModal = false;
            await LoadAll();
        }
        catch { ApplyStatusLocally(); Snackbar.Add("Estado guardado localmente.", Severity.Info); _showStatusModal = false; }
        finally { _isSaving = false; }
    }

    private void ApplyStatusLocally()
    {
        if (_editStatus.Id > 0) { var ex=_statuses.FirstOrDefault(x=>x.Id==_editStatus.Id); if(ex!=null){ex.Name=_editStatus.Name;ex.Code=_editStatus.Code;ex.Color=_editStatus.Color;ex.Category=_editStatus.Category;ex.IsTerminal=_editStatus.IsTerminal;ex.RequiresSubstatus=_editStatus.RequiresSubstatus;ex.RequiresComment=_editStatus.RequiresComment;ex.AllowsEditByAsesor=_editStatus.AllowsEditByAsesor;ex.AllowsEditBySupervisor=_editStatus.AllowsEditBySupervisor;ex.OrderIndex=_editStatus.OrderIndex;} }
        else { _editStatus.Id=(_statuses.Any()?_statuses.Max(x=>x.Id):0)+1; _statuses.Add(_editStatus); _statuses=_statuses.OrderBy(x=>x.OrderIndex).ToList(); }
    }

    private async Task ToggleStatusActive(StatusDto s) { s.IsActive=!s.IsActive; try { var c=HttpClientFactory.CreateClient("BackendApi"); await c.PatchAsJsonAsync($"/api/maintenance/statuses/{s.Id}/toggle", new{IsActive=s.IsActive}); } catch{} Snackbar.Add($"Estado {(s.IsActive?"activado":"desactivado")}.", Severity.Info); }

    private async Task ConfirmDeleteStatus(StatusDto s)
    {
        try { var c=HttpClientFactory.CreateClient("BackendApi"); var r=await c.DeleteAsync($"/api/maintenance/statuses/{s.Id}"); if(r.IsSuccessStatusCode){_statuses.Remove(s);Snackbar.Add("Estado eliminado.",Severity.Success);}else{Snackbar.Add("No se puede eliminar (tiene datos asociados). Desactívalo.",Severity.Warning);} }
        catch { _statuses.Remove(s); Snackbar.Add("Estado eliminado localmente.", Severity.Warning); }
    }

    // ===== SUBSTATUS CRUD =====
    private void OpenSubstatusModal(long statusId, SubstatusDto? sub)
    {
        _currentStatusId = statusId;
        _editSub = sub != null ? new SubstatusDto{IdSubstatus=sub.IdSubstatus,IdStatus=sub.IdStatus,Code=sub.Code,Name=sub.Name,Color=sub.Color,Description=sub.Description,OrderIndex=sub.OrderIndex,IsActive=sub.IsActive} : new SubstatusDto{Color="#2563EB"};
        _showSubModal = true;
    }

    private async Task SaveSubstatus()
    {
        if (string.IsNullOrWhiteSpace(_editSub.Name)||string.IsNullOrWhiteSpace(_editSub.Code)) { Snackbar.Add("Nombre y Código requeridos.", Severity.Warning); return; }
        _isSaving = true;
        _editSub.IdStatus = _currentStatusId;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            if (_editSub.IdSubstatus > 0)
                await client.PutAsJsonAsync($"/api/maintenance/substatuses/{_editSub.IdSubstatus}", new{_editSub.Code,_editSub.Name,_editSub.Color,_editSub.Description,_editSub.OrderIndex,IsActive=(bool?)null});
            else
                await client.PostAsJsonAsync("/api/maintenance/substatuses", new{IdStatus=_currentStatusId,_editSub.Code,_editSub.Name,_editSub.Color,_editSub.Description,_editSub.OrderIndex});
            Snackbar.Add("Subestado guardado.", Severity.Success); _showSubModal=false; await LoadAll();
        }
        catch
        {
            var st=_statuses.FirstOrDefault(x=>x.Id==_currentStatusId);
            if(st!=null){if(_editSub.IdSubstatus>0){var ex=st.Substatuses.FirstOrDefault(x=>x.IdSubstatus==_editSub.IdSubstatus);if(ex!=null){ex.Name=_editSub.Name;ex.Code=_editSub.Code;ex.Color=_editSub.Color;ex.Description=_editSub.Description;ex.OrderIndex=_editSub.OrderIndex;}}else{_editSub.IdSubstatus=new Random().Next(100,9999);_editSub.IdStatus=_currentStatusId;st.Substatuses.Add(_editSub);}}
            Snackbar.Add("Subestado guardado localmente.", Severity.Info); _showSubModal=false;
        }
        finally { _isSaving=false; }
    }

    private async Task ToggleSubstatusActive(SubstatusDto s) { s.IsActive=!s.IsActive; try { var c=HttpClientFactory.CreateClient("BackendApi"); await c.PatchAsJsonAsync($"/api/maintenance/substatuses/{s.IdSubstatus}/toggle", new{IsActive=s.IsActive}); } catch{} Snackbar.Add("Subestado actualizado.", Severity.Info); }

    private async Task ConfirmDeleteSubstatus(SubstatusDto sub)
    {
        try { var c=HttpClientFactory.CreateClient("BackendApi"); var r=await c.DeleteAsync($"/api/maintenance/substatuses/{sub.IdSubstatus}"); if(r.IsSuccessStatusCode){foreach(var s in _statuses)s.Substatuses.Remove(sub);Snackbar.Add("Subestado eliminado.",Severity.Success);}else{Snackbar.Add("No se puede eliminar. Desactívalo.",Severity.Warning);} }
        catch { foreach(var s in _statuses)s.Substatuses.Remove(sub); Snackbar.Add("Eliminado localmente.", Severity.Warning); }
    }

    // ===== TRANSITIONS CRUD =====
    private void OpenTransitionModal(TransitionDto? t)
    {
        _editTrans = t != null ? new TransitionDto{IdTransition=t.IdTransition,FromStatusId=t.FromStatusId,ToStatusId=t.ToStatusId,AllowedRoles=t.AllowedRoles.ToArray(),RequiresComment=t.RequiresComment,IsBulkAllowed=t.IsBulkAllowed,Description=t.Description,IsActive=t.IsActive} : new TransitionDto{AllowedRoles=new[]{"ASESOR"}};
        _showTransitionModal = true;
    }

    private void ToggleRole(string role)
    {
        var roles = _editTrans.AllowedRoles.ToList();
        if (roles.Contains(role)) roles.Remove(role); else roles.Add(role);
        _editTrans.AllowedRoles = roles.ToArray();
    }

    private async Task SaveTransition()
    {
        if(_editTrans.FromStatusId==0||_editTrans.ToStatusId==0){Snackbar.Add("Selecciona estados origen y destino.",Severity.Warning);return;}
        _isSaving=true;
        try
        {
            var client=HttpClientFactory.CreateClient("BackendApi");
            if(_editTrans.IdTransition>0)
                await client.PutAsJsonAsync($"/api/maintenance/transitions/{_editTrans.IdTransition}", new{AllowedRoles=_editTrans.AllowedRoles,_editTrans.RequiresComment,RequiresFormComplete=(bool?)null,IdFormRequired=(long?)null,_editTrans.IsBulkAllowed,_editTrans.Description,IsActive=(bool?)null});
            else
                await client.PostAsJsonAsync("/api/maintenance/transitions", new{_editTrans.FromStatusId,_editTrans.ToStatusId,AllowedRoles=_editTrans.AllowedRoles,_editTrans.RequiresComment,RequiresFormComplete=false,IdFormRequired=(long?)null,_editTrans.IsBulkAllowed,_editTrans.Description});
            Snackbar.Add("Transición guardada.",Severity.Success); _showTransitionModal=false; await LoadAll();
        }
        catch
        {
            if(_editTrans.IdTransition>0){var ex=_transitions.FirstOrDefault(x=>x.IdTransition==_editTrans.IdTransition);if(ex!=null){ex.AllowedRoles=_editTrans.AllowedRoles;ex.RequiresComment=_editTrans.RequiresComment;ex.IsBulkAllowed=_editTrans.IsBulkAllowed;ex.Description=_editTrans.Description;}}
            else{_editTrans.IdTransition=(_transitions.Any()?_transitions.Max(x=>x.IdTransition):0)+1;_editTrans.FromStatusName=_statuses.FirstOrDefault(x=>x.Id==_editTrans.FromStatusId)?.Name??"";_editTrans.ToStatusName=_statuses.FirstOrDefault(x=>x.Id==_editTrans.ToStatusId)?.Name??"";_transitions.Add(_editTrans);}
            Snackbar.Add("Transición guardada localmente.",Severity.Info); _showTransitionModal=false;
        }
        finally{_isSaving=false;}
    }

    private async Task DeleteTransition(TransitionDto t)
    {
        try{var c=HttpClientFactory.CreateClient("BackendApi");await c.DeleteAsync($"/api/maintenance/transitions/{t.IdTransition}");_transitions.Remove(t);Snackbar.Add("Transición eliminada.",Severity.Success);}
        catch{_transitions.Remove(t);Snackbar.Add("Eliminada localmente.",Severity.Warning);}
    }

    // ===== PIPELINE CRUD =====
    private void OpenStageModal(StageDto? s)
    {
        _editStage = s!=null ? new StageDto{IdStage=s.IdStage,IdCmpg=s.IdCmpg,Name=s.Name,StageCode=s.StageCode,Description=s.Description,OrderIndex=s.OrderIndex,IdStatusEnter=s.IdStatusEnter,IdStatusExit=s.IdStatusExit,RequiresAudit=s.RequiresAudit,SlaHours=s.SlaHours} : new StageDto{IdCmpg=_selectedCampaign?.Id??0,OrderIndex=(short)(_selectedCampaign?.Stages.Count??0)};
        _showStageModal=true;
    }

    private async Task SaveStage()
    {
        if(string.IsNullOrWhiteSpace(_editStage.Name)||string.IsNullOrWhiteSpace(_editStage.StageCode)){Snackbar.Add("Nombre y Código requeridos.",Severity.Warning);return;}
        _isSaving=true;
        _editStage.IdCmpg=_selectedCampaign?.Id??0;
        try
        {
            var client=HttpClientFactory.CreateClient("BackendApi");
            if(_editStage.IdStage>0)
                await client.PutAsJsonAsync($"/api/maintenance/pipeline/{_editStage.IdStage}", new{_editStage.Name,_editStage.Description,_editStage.OrderIndex,IdStatusEnter=_editStage.IdStatusEnter==0?(long?)null:_editStage.IdStatusEnter,IdStatusExit=_editStage.IdStatusExit==0?(long?)null:_editStage.IdStatusExit,_editStage.RequiresAudit,_editStage.SlaHours,IsActive=(bool?)null});
            else
                await client.PostAsJsonAsync("/api/maintenance/pipeline", new{_editStage.IdCmpg,_editStage.Name,_editStage.StageCode,_editStage.Description,_editStage.OrderIndex,IdStatusEnter=_editStage.IdStatusEnter==0?(long?)null:_editStage.IdStatusEnter,IdStatusExit=_editStage.IdStatusExit==0?(long?)null:_editStage.IdStatusExit,_editStage.RequiresAudit,SlaHours=_editStage.SlaHours});
            Snackbar.Add("Etapa guardada.",Severity.Success); _showStageModal=false;
            if(_selectedCampaign!=null){var stages=await HttpClientFactory.CreateClient("BackendApi").GetFromJsonAsync<List<StageDto>>($"/api/maintenance/pipeline/{_selectedCampaign.Id}");if(stages!=null)_selectedCampaign.Stages=stages;}
        }
        catch
        {
            if(_selectedCampaign!=null){
                if(_editStage.IdStage>0){var ex=_selectedCampaign.Stages.FirstOrDefault(x=>x.IdStage==_editStage.IdStage);if(ex!=null){ex.Name=_editStage.Name;ex.StageCode=_editStage.StageCode;ex.Description=_editStage.Description;ex.IdStatusEnter=_editStage.IdStatusEnter;ex.IdStatusExit=_editStage.IdStatusExit;ex.RequiresAudit=_editStage.RequiresAudit;ex.SlaHours=_editStage.SlaHours;}}
                else{_editStage.IdStage=(_selectedCampaign.Stages.Any()?_selectedCampaign.Stages.Max(x=>x.IdStage):0)+1;_editStage.StatusEnterName=_statuses.FirstOrDefault(x=>x.Id==_editStage.IdStatusEnter)?.Name;_editStage.StatusExitName=_statuses.FirstOrDefault(x=>x.Id==_editStage.IdStatusExit)?.Name;_selectedCampaign.Stages.Add(_editStage);}
            }
            Snackbar.Add("Etapa guardada localmente.",Severity.Info); _showStageModal=false;
        }
        finally{_isSaving=false;}
    }

    private async Task DeleteStage(StageDto s) { try{await HttpClientFactory.CreateClient("BackendApi").DeleteAsync($"/api/maintenance/pipeline/{s.IdStage}");_selectedCampaign?.Stages.Remove(s);Snackbar.Add("Etapa eliminada.",Severity.Success);}catch{_selectedCampaign?.Stages.Remove(s);Snackbar.Add("Eliminada localmente.",Severity.Warning);} }

    private void MoveStage(int idx, int dir) { if(_selectedCampaign==null)return; var ni=idx+dir; if(ni<0||ni>=_selectedCampaign.Stages.Count)return; (_selectedCampaign.Stages[idx],_selectedCampaign.Stages[ni])=(_selectedCampaign.Stages[ni],_selectedCampaign.Stages[idx]); }

