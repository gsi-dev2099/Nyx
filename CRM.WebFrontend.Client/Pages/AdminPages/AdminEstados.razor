    private string GetCategoryClass(string cat) => cat switch
    {
        "WON" => "bg-success text-white",
        "ON_HOLD" => "bg-warning text-dark",
        "CANCELLED" or "LOST" => "bg-secondary text-white",
        _ => "bg-primary-subtle text-primary"
    };
