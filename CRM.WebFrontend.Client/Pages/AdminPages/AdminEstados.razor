@code {
    private int _activeTab = 0;
    private bool _isLoading = true, _isSaving = false;
    private bool _showStatusModal, _showSubModal, _showTransitionModal, _showStageModal, _showMappingModal;
    private HashSet<long> _expanded = new();

    // Data
    private List<StatusDto> _statuses = new();
    private List<TransitionDto> _transitions = new();
    private List<CampaignPipelineDto> _campaigns = new();
    private List<MappingDto> _mappings = new();
    private List<ProviderDto> _providers = new();
    private CampaignPipelineDto? _selectedCampaign;

    // Edit buffers
    private StatusDto _editStatus = new();
    private SubstatusDto _editSub = new();
    private TransitionDto _editTrans = new();
    private StageDto _editStage = new();
    private MappingDto _editMapping = new();
    private long _currentStatusId;

    // DTOs
    public class SubstatusDto { public long IdSubstatus{get;set;} public long IdStatus{get;set;} public string Code{get;set;}=""; public string Name{get;set;}=""; public string? Color{get;set;} public string? Description{get;set;} public short OrderIndex{get;set;} public bool IsActive{get;set;}=true; }
    public class StatusDto { public long Id{get;set;} public string Code{get;set;}=""; public string Name{get;set;}=""; public string Category{get;set;}="IN_PROGRESS"; public string? Color{get;set;}="#2563EB"; public string? Icon{get;set;} public bool IsTerminal{get;set;} public bool RequiresSubstatus{get;set;} public bool RequiresComment{get;set;} public bool AllowsEditByAsesor{get;set;} public bool AllowsEditBySupervisor{get;set;}=true; public short OrderIndex{get;set;} public bool IsActive{get;set;}=true; public List<SubstatusDto> Substatuses{get;set;}=new(); }
    public class TransitionDto { public long IdTransition{get;set;} public long FromStatusId{get;set;} public long ToStatusId{get;set;} public string FromStatusName{get;set;}=""; public string ToStatusName{get;set;}=""; public string[] AllowedRoles{get;set;}=Array.Empty<string>(); public bool RequiresComment{get;set;} public bool RequiresFormComplete{get;set;} public long? IdFormRequired{get;set;} public bool IsBulkAllowed{get;set;} public string? Description{get;set;} public bool IsActive{get;set;}=true; }
    public class StageDto { public long IdStage{get;set;} public long IdCmpg{get;set;} public string Name{get;set;}=""; public string StageCode{get;set;}=""; public string? Description{get;set;} public short OrderIndex{get;set;} public long? IdStatusEnter{get;set;} public long? IdStatusExit{get;set;} public string? StatusEnterName{get;set;} public string? StatusExitName{get;set;} public bool RequiresAudit{get;set;} public short? SlaHours{get;set;} public bool IsActive{get;set;}=true; }
    public class CampaignPipelineDto { public long Id{get;set;} public string Name{get;set;}=""; public List<StageDto> Stages{get;set;}=new(); }
    public class MappingDto { public long IdMapping{get;set;} public long IdProvider{get;set;} public string ProviderName{get;set;}=""; public string ProviderStatusCode{get;set;}=""; public string? ProviderStatusName{get;set;} public long InternalStatusId{get;set;} public string InternalStatusName{get;set;}=""; public long? InternalSubstatusId{get;set;} public string? InternalSubstatusName{get;set;} public bool AutoUpdate{get;set;} public long? CreatesIncidentId{get;set;} public short Priority{get;set;}=3; public string? Notes{get;set;} public bool IsActive{get;set;}=true; }
    public class ProviderDto { public long IdProvider{get;set;} public string Name{get;set;}=""; public string Code{get;set;}=""; public string IntegrationType{get;set;}="MANUAL"; public bool IsActive{get;set;}=true; }

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        _isLoading = true;
        var client = HttpClientFactory.CreateClient("BackendApi");
        try
        {
            // Estados + subestados
            var statuses = await client.GetFromJsonAsync<List<dynamic>>("/api/maintenance/statuses");
            var substatuses = await client.GetFromJsonAsync<List<SubstatusDto>>("/api/maintenance/substatuses");
            if (statuses != null)
            {
                _statuses = statuses.Select(s => new StatusDto
                {
                    Id = (long)s.id, Code = (string)s.code, Name = (string)s.name,
                    Category = (string)s.category, Color = (string?)s.color, Icon = (string?)s.icon,
                    IsTerminal = (bool)s.isTerminal, RequiresSubstatus = (bool)s.requiresSubstatus,
                    RequiresComment = (bool)s.requiresComment, AllowsEditByAsesor = (bool)s.allowsEditByAsesor,
                    AllowsEditBySupervisor = (bool)s.allowsEditBySupervisor, OrderIndex = (short)(int)s.orderIndex,
                    IsActive = (bool)s.isActive
                }).ToList();
            }
            if (substatuses != null)
            {
                foreach (var sub in substatuses)
                {
                    var st = _statuses.FirstOrDefault(s => s.Id == sub.IdStatus);
                    st?.Substatuses.Add(sub);
                }
            }
            // Transiciones
            var trans = await client.GetFromJsonAsync<List<TransitionDto>>("/api/maintenance/transitions");
            if (trans != null) _transitions = trans;
            // Campañas
            var camps = await client.GetFromJsonAsync<List<dynamic>>("/api/maintenance/campaigns");
            if (camps != null)
            {
                _campaigns = camps.Select(c => new CampaignPipelineDto { Id = (long)c.id, Name = (string)c.name }).ToList();
            }
            // Proveedores
            var provs = await client.GetFromJsonAsync<List<ProviderDto>>("/api/maintenance/providers");
            if (provs != null) _providers = provs;
            // Mapeos
            var maps = await client.GetFromJsonAsync<List<MappingDto>>("/api/maintenance/provider-mappings");
            if (maps != null) _mappings = maps;
        }
        catch
        {
            LoadMockData();
        }
        finally { _isLoading = false; }
    }

    private void LoadMockData()
    {
        _statuses = new List<StatusDto>
        {
            new(){Id=1,Code="BORRADOR",Name="Borrador",Category="IN_PROGRESS",Color="#94A3B8",OrderIndex=1,IsActive=true,AllowsEditByAsesor=true,AllowsEditBySupervisor=true,Substatuses=new()},
            new(){Id=2,Code="REVISION_SUPERVISOR",Name="En revisión supervisor",Category="IN_PROGRESS",Color="#F59E0B",OrderIndex=2,IsActive=true,AllowsEditBySupervisor=true,Substatuses=new()},
            new(){Id=4,Code="EN_GESTION",Name="En gestión",Category="IN_PROGRESS",Color="#8B5CF6",OrderIndex=4,IsActive=true,RequiresSubstatus=true,
                Substatuses=new List<SubstatusDto>{
                    new(){IdSubstatus=3,IdStatus=4,Code="LLAMADA_VALIDACION",Name="Llamada de validación",OrderIndex=1,IsActive=true},
                    new(){IdSubstatus=2,IdStatus=4,Code="PENDIENTE_DOCUMENTOS",Name="Pendiente documentos",OrderIndex=2,IsActive=true},
                    new(){IdSubstatus=1,IdStatus=4,Code="PENDIENTE_FIRMA",Name="Pendiente firma",OrderIndex=3,IsActive=true},
                }},
            new(){Id=9,Code="ACTIVADO",Name="Activado",Category="WON",Color="#16A34A",IsTerminal=true,OrderIndex=9,IsActive=true,Substatuses=new()},
            new(){Id=10,Code="ENVIADO_KO",Name="Enviado KO",Category="ON_HOLD",Color="#EF4444",OrderIndex=10,IsActive=true,RequiresSubstatus=true,
                Substatuses=new List<SubstatusDto>{
                    new(){IdSubstatus=10,IdStatus=10,Code="DATOS_INVALIDOS",Name="Datos inválidos",OrderIndex=1,IsActive=true},
                    new(){IdSubstatus=9,IdStatus=10,Code="SCORING",Name="Cliente con scoring",OrderIndex=2,IsActive=true},
                    new(){IdSubstatus=8,IdStatus=10,Code="RECHAZADO_PROVEEDOR",Name="Rechazado por proveedor",OrderIndex=3,IsActive=true},
