@page "/admin/estados"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMIN_CRM")]
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@using MudBlazor

<PageTitle>Estados y Flujos - NYX CRM</PageTitle>

<style>
    .admin-header { background:#fff; border-radius:20px; padding:22px 28px; box-shadow:0 4px 24px rgba(29,38,57,.06); margin-bottom:1.5rem; }
    .btn-admin { background:#1D2639; color:#fff; border-radius:12px; font-weight:700; border:none; transition:background .18s; }
    .btn-admin:hover { background:#2563EB; color:#fff; }
    .catalog-tab { background:none; border:none; font-weight:700; font-size:.85rem; color:#94A3B8; padding:10px 20px; border-radius:12px; transition:all .18s; white-space:nowrap; }
    .catalog-tab.active { background:#EFF6FF; color:#2563EB; }
    .catalog-tab:hover:not(.active) { background:#F8FAFC; color:#475569; }
    .tab-bar { background:#F1F5F9; border-radius:16px; padding:4px; display:flex; gap:2px; overflow-x:auto; margin-bottom:1.5rem; width:fit-content; }

    /* TAB 1 — ESTADOS */
    .estado-card { background:#fff; border-radius:16px; box-shadow:0 2px 16px rgba(29,38,57,.06); margin-bottom:14px; overflow:hidden; transition:box-shadow .2s; }
    .estado-card:hover { box-shadow:0 6px 24px rgba(29,38,57,.12); }
    .estado-hdr { display:flex; align-items:center; gap:12px; padding:14px 18px; background:#fff; border:none; width:100%; cursor:pointer; }
    .color-dot { width:13px; height:13px; border-radius:50%; flex-shrink:0; border:2px solid rgba(0,0,0,.08); }
    .flag-chip { font-size:.68rem; font-weight:700; padding:2px 7px; border-radius:8px; white-space:nowrap; }
    .flag-yes { background:#DCFCE7; color:#16A34A; }
    .flag-no  { background:#F1F5F9; color:#94A3B8; }
    .flag-warn { background:#FEF3C7; color:#B45309; }
    .code-badge { font-size:.72rem; font-weight:800; padding:2px 8px; border-radius:6px; background:#EFF6FF; color:#1D4ED8; font-family:monospace; }
    .sub-row { display:flex; align-items:center; gap:10px; padding:9px 18px 9px 52px; border-top:1px solid #F1F5F9; background:#FAFBFC; }
    .sub-row:hover { background:#EFF6FF; }
    .add-sub-zone { padding:9px 18px 9px 52px; border-top:1px dashed #CBD5E1; background:#FAFBFC; }
    .expand-chevron { transition:transform .2s; color:#94A3B8; }
    .expand-chevron.open { transform:rotate(90deg); }
    .category-badge { font-size:.7rem; font-weight:700; padding:2px 8px; border-radius:20px; }

    /* TAB 2 — TRANSICIONES */
    .trans-table thead th { background:#F8FAFC; color:#64748B; font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.4px; padding:11px 14px; border-bottom:1px solid #E2E8F0; }
    .trans-table tbody td { padding:11px 14px; font-size:.85rem; color:#1E293B; border-bottom:1px solid #F1F5F9; vertical-align:middle; }
    .trans-table tbody tr:hover { background:#F8FAFC; }
    .arrow-pill { display:inline-flex; align-items:center; gap:6px; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:20px; padding:4px 12px; font-size:.8rem; }
    .role-tag { font-size:.68rem; font-weight:700; padding:2px 8px; border-radius:20px; background:#EFF6FF; color:#1D4ED8; }

    /* TAB 3 — PIPELINE */
    .pipeline-camp-btn { border-radius:12px; border:2px solid transparent; padding:10px 16px; background:#fff; box-shadow:0 2px 8px rgba(29,38,57,.05); cursor:pointer; transition:all .18s; text-align:left; }
    .pipeline-camp-btn.active { border-color:#2563EB; background:#EFF6FF; }
    .pipeline-camp-btn:hover:not(.active) { border-color:#BFDBFE; }
    .stage-card { background:#fff; border-radius:14px; border:1px solid #E2E8F0; padding:14px 18px; margin-bottom:10px; display:flex; align-items:flex-start; gap:14px; }
    .stage-index { width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,#2563EB,#1D2639); color:#fff; font-weight:800; font-size:.78rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px; }

    /* TAB 4 — PROVEEDORES */
    .provider-sect { background:#fff; border-radius:16px; box-shadow:0 2px 14px rgba(29,38,57,.06); overflow:hidden; margin-bottom:1.5rem; }
    .auto-badge { font-size:.68rem; font-weight:800; padding:2px 8px; border-radius:20px; background:#DCFCE7; color:#16A34A; }
    .manual-badge { font-size:.68rem; font-weight:800; padding:2px 8px; border-radius:20px; background:#F1F5F9; color:#64748B; }

    /* General */
    .modal-card { background:#fff; border-radius:24px; box-shadow:0 20px 60px rgba(15,23,42,.2); max-height:92vh; overflow-y:auto; }
    .modal-overlay { position:fixed; inset:0; background:rgba(15,23,42,.6); backdrop-filter:blur(4px); z-index:1050; display:flex; align-items:center; justify-content:center; padding:20px; }
    .form-label { font-size:.78rem; font-weight:700; color:#64748B; margin-bottom:4px; }
    .section-lbl { font-size:.68rem; font-weight:800; text-transform:uppercase; letter-spacing:.7px; color:#94A3B8; margin-bottom:8px; }
</style>

<div class="container-fluid py-4">
    <div class="admin-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Estados, Flujos y Proveedores</h1>
            <p class="text-muted small mb-0">Control total del ciclo de vida de las ventas: estados, transiciones, pipelines por campaña y homologación de proveedores.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-primary rounded-pill px-4" @onclick='() => Nav.NavigateTo("/admin/fichas")'>
                <i class="bi bi-layout-text-sidebar-reverse me-2"></i>Ir al Diseñador de Fichas
            </button>
            @if (_activeTab == 0)
            {
                <button class="btn btn-admin px-4 py-2" @onclick="() => OpenStatusModal(null)"><i class="bi bi-plus-circle-fill me-2"></i>Nuevo Estado</button>
            }
            else if (_activeTab == 1)
            {
                <button class="btn btn-admin px-4 py-2" @onclick="() => OpenTransitionModal(null)"><i class="bi bi-plus-circle-fill me-2"></i>Nueva Transición</button>
            }
            else if (_activeTab == 2 && _selectedCampaign != null)
            {
                <button class="btn btn-admin px-4 py-2" @onclick="() => OpenStageModal(null)"><i class="bi bi-plus-circle-fill me-2"></i>Nueva Etapa</button>
            }
            else if (_activeTab == 3)
            {
                <button class="btn btn-admin px-4 py-2" @onclick="() => OpenMappingModal(null)"><i class="bi bi-plus-circle-fill me-2"></i>Nuevo Mapeo</button>
            }
        </div>
    </div>

    <!-- Tabs -->
    <div class="tab-bar mb-4">
        <button class="catalog-tab @(_activeTab==0?"active":"")" @onclick="() => SetTab(0)">
            <i class="bi bi-diagram-2 me-2"></i>Estados Globales
        </button>
        <button class="catalog-tab @(_activeTab==1?"active":"")" @onclick="() => SetTab(1)">
            <i class="bi bi-arrow-left-right me-2"></i>Transiciones
        </button>
        <button class="catalog-tab @(_activeTab==2?"active":"")" @onclick="() => SetTab(2)">
            <i class="bi bi-megaphone me-2"></i>Pipeline por Campaña
        </button>
        <button class="catalog-tab @(_activeTab==3?"active":"")" @onclick="() => SetTab(3)">
            <i class="bi bi-plug me-2"></i>Mapeo de Proveedores
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="text-muted mt-3">Cargando...</p></div>
    }

    <!-- ===== TAB 0: ESTADOS GLOBALES ===== -->
    @if (!_isLoading && _activeTab == 0)
    {
        @foreach (var s in _statuses)
        {
            <div class="estado-card">
                <button class="estado-hdr" @onclick="() => ToggleExpand(s.Id)">
                    <i class="bi bi-chevron-right expand-chevron @(_expanded.Contains(s.Id)?"open":"")"></i>
                    <span class="color-dot" style="background:@(s.Color??"#94A3B8");"></span>
                    <div class="text-start flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="fw-bold text-dark">@s.Name</span>
                            <span class="code-badge">@s.Code</span>
                            <span class="category-badge @GetCategoryClass(s.Category)">@s.Category</span>
                            @if (s.IsTerminal) { <span class="flag-chip flag-warn">TERMINAL</span> }
                        </div>
                        <div class="d-flex gap-2 mt-1 flex-wrap">
                            <span class="flag-chip @(s.RequiresSubstatus?"flag-yes":"flag-no")" title="Requiere subestado">
                                <i class="bi bi-@(s.RequiresSubstatus?"check":"dash")"></i> Req. Subestado
                            </span>
                            <span class="flag-chip @(s.RequiresComment?"flag-yes":"flag-no")" title="Requiere comentario">
                                <i class="bi bi-@(s.RequiresComment?"check":"dash")"></i> Req. Comentario
                            </span>
                            <span class="flag-chip @(s.AllowsEditByAsesor?"flag-yes":"flag-no")" title="Asesor puede editar">
                                <i class="bi bi-@(s.AllowsEditByAsesor?"check":"dash")"></i> Asesor edita
                            </span>
                            <span class="flag-chip @(s.AllowsEditBySupervisor?"flag-yes":"flag-no")" title="Supervisor puede editar">
                                <i class="bi bi-@(s.AllowsEditBySupervisor?"check":"dash")"></i> Supervisor edita
                            </span>
                            <span class="flag-chip flag-no">Orden: @s.OrderIndex</span>
                            <span class="text-muted" style="font-size:.72rem;">@(s.Substatuses.Count) subestado(s)</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2" @onclick:stopPropagation="true">
                        <div class="form-check form-switch mb-0" title="Activo">
                            <input class="form-check-input" type="checkbox" checked="@s.IsActive" @onchange="async () => await ToggleStatusActive(s)" />
                        </div>
                        <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => OpenStatusModal(s)">
                            <i class="bi bi-pencil-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => ConfirmDeleteStatus(s)">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </div>
                </button>

                @if (_expanded.Contains(s.Id))
                {
                    @if (s.Substatuses.Any())
                    {
                        @foreach (var sub in s.Substatuses)
                        {
                            <div class="sub-row">
                                <span class="text-muted">↳</span>
                                @if (!string.IsNullOrEmpty(sub.Color))
                                {
                                    <span class="color-dot" style="background:@sub.Color;width:10px;height:10px;"></span>
                                }
                                <span class="fw-semibold small flex-grow-1">@sub.Name</span>
                                <span class="code-badge me-2">@sub.Code</span>
                                <span class="text-muted" style="font-size:.75rem; max-width:180px; overflow:hidden; text-overflow:ellipsis;">@(sub.Description ?? "—")</span>
                                <span class="flag-no flag-chip ms-2">Orden: @sub.OrderIndex</span>
                                <div class="form-check form-switch mb-0 ms-2">
                                    <input class="form-check-input" type="checkbox" checked="@sub.IsActive" @onchange="async () => await ToggleSubstatusActive(sub)" />
                                </div>
                                <button class="btn btn-sm btn-outline-primary rounded-pill ms-1" @onclick="() => OpenSubstatusModal(s.Id, sub)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill ms-1" @onclick="() => ConfirmDeleteSubstatus(sub)">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="sub-row text-muted small"><i class="bi bi-info-circle me-2"></i>Sin subestados aún.</div>
                    }
                    <div class="add-sub-zone">
                        <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => OpenSubstatusModal(s.Id, null)">
                            <i class="bi bi-plus-circle me-1"></i> Agregar Subestado
                        </button>
                    </div>
                }
            </div>
        }
        @if (!_statuses.Any()) { <div class="text-center py-5 text-muted"><i class="bi bi-diagram-3 d-block fs-1 mb-3"></i>No hay estados configurados.</div> }
    }

    <!-- ===== TAB 1: TRANSICIONES ===== -->
    @if (!_isLoading && _activeTab == 1)
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover trans-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Transición</th>
                            <th>Roles Permitidos</th>
                            <th class="text-center">Req. Comentario</th>
                            <th class="text-center">Cambio Masivo</th>
                            <th class="text-center">Activo</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _transitions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="arrow-pill">
                                        <span class="fw-bold">@t.FromStatusName</span>
                                        <i class="bi bi-arrow-right text-primary"></i>
                                        <span class="fw-bold text-primary">@t.ToStatusName</span>
                                    </div>
                                </td>
                                <td>
                                    @if (t.AllowedRoles != null)
                                    {
                                        @foreach (var r in t.AllowedRoles)
                                        {
                                            <span class="role-tag me-1">@r</span>
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    <i class="bi bi-@(t.RequiresComment?"check-circle-fill text-success":"dash-circle text-muted")"></i>
                                </td>
                                <td class="text-center">
                                    <i class="bi bi-@(t.IsBulkAllowed?"check-circle-fill text-success":"dash-circle text-muted")"></i>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block mb-0">
                                        <input class="form-check-input" type="checkbox" checked="@t.IsActive" @onchange="() => ToggleTransitionActive(t)" />
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill me-1" @onclick="() => OpenTransitionModal(t)"><i class="bi bi-pencil-fill"></i></button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => DeleteTransition(t)"><i class="bi bi-trash3-fill"></i></button>
                                </td>
                            </tr>
                        }
                        @if (!_transitions.Any()) { <tr><td colspan="6" class="text-center py-5 text-muted">No hay transiciones configuradas.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ===== TAB 2: PIPELINE POR CAMPAÑA ===== -->
    @if (!_isLoading && _activeTab == 2)
    {
        <div class="row g-4">
            <div class="col-md-3">
                <p class="section-lbl">Selecciona Campaña</p>
                @foreach (var c in _campaigns)
                {
                    <button class="pipeline-camp-btn w-100 mb-2 @(_selectedCampaign?.Id==c.Id?"active":"")" @onclick="() => SelectCampaign(c)">
                        <div class="fw-bold small text-dark">@c.Name</div>
                        <div class="text-muted" style="font-size:.72rem;">@c.Stages.Count etapa(s)</div>
                    </button>
                }
            </div>
            <div class="col-md-9">
                @if (_selectedCampaign == null)
                {
                    <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                        <i class="bi bi-megaphone fs-1 mb-3"></i>
                        <p class="small">Selecciona una campaña para ver su pipeline.</p>
                    </div>
                }
                else
                {
                    <p class="section-lbl">Pipeline: <span class="text-primary">@_selectedCampaign.Name</span></p>
                    @if (!_selectedCampaign.Stages.Any())
                    {
                        <div class="text-center text-muted py-4"><i class="bi bi-diagram-3 d-block fs-1 mb-2"></i>Sin etapas. Agrega la primera.</div>
                    }
                    @for (int i = 0; i < _selectedCampaign.Stages.Count; i++)
                    {
                        var stage = _selectedCampaign.Stages[i];
                        var idx = i;
                        <div class="stage-card">
                            <div class="stage-index">@(i+1)</div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold text-dark">@stage.Name</span>
                                    <span class="code-badge">@stage.StageCode</span>
                                    @if (stage.RequiresAudit) { <span class="flag-chip flag-warn">AUDITORÍA</span> }
                                    @if (stage.SlaHours.HasValue) { <span class="flag-chip flag-no">SLA @stage.SlaHours h</span> }
                                </div>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    @if (!string.IsNullOrEmpty(stage.StatusEnterName))
                                    {
                                        <span class="text-muted small"><i class="bi bi-box-arrow-in-right me-1 text-success"></i>Entra: <strong>@stage.StatusEnterName</strong></span>
                                    }
                                    @if (!string.IsNullOrEmpty(stage.StatusExitName))
                                    {
                                        <span class="text-muted small ms-2"><i class="bi bi-box-arrow-right me-1 text-danger"></i>Sale: <strong>@stage.StatusExitName</strong></span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(stage.Description)) { <div class="text-muted small mt-1">@stage.Description</div> }
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <button class="btn btn-sm p-0" style="color:#94A3B8;" @onclick="() => MoveStage(idx,-1)" disabled="@(idx==0)"><i class="bi bi-chevron-up"></i></button>
                                <button class="btn btn-sm p-0" style="color:#94A3B8;" @onclick="() => MoveStage(idx,1)" disabled="@(idx==_selectedCampaign.Stages.Count-1)"><i class="bi bi-chevron-down"></i></button>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => OpenStageModal(stage)"><i class="bi bi-pencil-fill"></i></button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => DeleteStage(stage)"><i class="bi bi-trash3-fill"></i></button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- ===== TAB 3: MAPEO DE PROVEEDORES ===== -->
    @if (!_isLoading && _activeTab == 3)
    {
        @foreach (var grp in _mappings.GroupBy(m => m.ProviderName).OrderBy(g => g.Key))
        {
            <div class="provider-sect mb-4">
                <div class="px-4 py-3 d-flex align-items-center justify-content-between" style="background:linear-gradient(135deg,#1D2639,#2563EB);border-radius:16px 16px 0 0;">
                    <div>
                        <span class="fw-bold text-white">@grp.Key</span>
                        <span class="text-white-50 small ms-2">@grp.Count() mapeo(s)</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover trans-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Código Proveedor</th>
                                <th>Nombre Proveedor</th>
                                <th>Estado Interno</th>
                                <th>Subestado</th>
                                <th class="text-center">Auto-Update</th>
                                <th class="text-center">Genera Incidencia</th>
                                <th class="text-center">Prio.</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in grp)
                            {
                                <tr>
                                    <td class="ps-4"><code class="text-primary fw-bold">@m.ProviderStatusCode</code></td>
                                    <td class="text-secondary small">@(m.ProviderStatusName ?? "—")</td>
                                    <td><span class="fw-semibold">@m.InternalStatusName</span></td>
                                    <td class="text-muted small">@(m.InternalSubstatusName ?? "—")</td>
                                    <td class="text-center">
                                        @if (m.AutoUpdate) { <span class="auto-badge">AUTO</span> } else { <span class="manual-badge">MANUAL</span> }
                                    </td>
                                    <td class="text-center">
                                        @if (m.CreatesIncidentId.HasValue) { <span class="flag-chip flag-warn"><i class="bi bi-exclamation-triangle"></i> Sí</span> } else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@m.Priority</span></td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill me-1" @onclick="() => OpenMappingModal(m)"><i class="bi bi-pencil-fill"></i></button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => DeleteMapping(m)"><i class="bi bi-trash3-fill"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (!_mappings.Any()) { <div class="text-center py-5 text-muted"><i class="bi bi-plug d-block fs-1 mb-3"></i>No hay mapeos de proveedores configurados.</div> }
    }
</div>

<!-- ===== MODAL ESTADO ===== -->
@if (_showStatusModal)
{
    <div class="modal-overlay" @onclick="() => _showStatusModal=false">
        <div class="modal-card" style="width:600px;" @onclick:stopPropagation="true">
            <div class="px-4 pt-4 pb-2 d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0"><i class="bi bi-diagram-2 text-primary me-2"></i>@(_editStatus.Id>0?"Editar":"Nuevo") Estado</h5>
                <button class="btn-close" @onclick="() => _showStatusModal=false"></button>
            </div>
            <div class="px-4 pb-2">
                <div class="row g-3">
                    <div class="col-8"><label class="form-label">Nombre *</label><input class="form-control rounded-3" @bind="_editStatus.Name" placeholder="Ej. En Validación" /></div>
                    <div class="col-4"><label class="form-label">Código *</label><input class="form-control rounded-3 text-uppercase" @bind="_editStatus.Code" placeholder="VALID" maxlength="50" /></div>
                    <div class="col-6">
                        <label class="form-label">Categoría *</label>
                        <select class="form-select rounded-3" @bind="_editStatus.Category">
                            <option value="IN_PROGRESS">IN_PROGRESS (En curso)</option>
                            <option value="WON">WON (Ganado)</option>
                            <option value="ON_HOLD">ON_HOLD (En pausa)</option>
                            <option value="CANCELLED">CANCELLED (Cancelado)</option>
                            <option value="LOST">LOST (Perdido)</option>
                        </select>
                    </div>
                    <div class="col-4">
