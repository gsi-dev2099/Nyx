@code {
    private string searchFilter = string.Empty;
    private bool loadingHealth = false;
    private bool enginesAllHealthy = false;

    protected override async Task OnInitializedAsync()
    {
        await RefreshEnginesHealth();
    }

    private async Task RefreshEnginesHealth()
    {
        loadingHealth = true;
        try
        {
            var baseUri = Nav.BaseUri.TrimEnd('/');
            var status = await Http.GetFromJsonAsync<EngineStatusVm>($"{baseUri}/api/engines/status");
            if (status?.Engines != null && status.Engines.Any())
            {
                enginesAllHealthy = status.Engines.All(e => e.IsHealthy);
            }
            else
            {
                enginesAllHealthy = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminDashboard] Error checking engines health: {ex.Message}");
            enginesAllHealthy = false;
        }
        finally
        {
            loadingHealth = false;
        }
    }

    private bool MatchesSearch(string title, string description)
    {
        if (string.IsNullOrWhiteSpace(searchFilter)) return true;
        var term = searchFilter.Trim().ToLowerInvariant();
        return title.ToLowerInvariant().Contains(term) || description.ToLowerInvariant().Contains(term);
    }

    private bool IsVisibleCategory(string categoryKey)
    {
        if (string.IsNullOrWhiteSpace(searchFilter)) return true;
        
        switch (categoryKey)
        {
            case "usuarios":
                return MatchesSearch("Control de Usuarios", "") || MatchesSearch("Roles y Permisos RBAC", "");
            case "operativa":
                return MatchesSearch("Estados y Flujos", "") || MatchesSearch("Diseñador Canvas de Fichas", "") || MatchesSearch("Campañas y Catálogo", "");
            case "motores":
                return MatchesSearch("Nyx Engines Hub", "") || MatchesSearch("Checkpoints & Aprobaciones", "") || MatchesSearch("Políticas SLA", "") || MatchesSearch("Auditoría SHA-512", "");
            case "auditoria":
                return MatchesSearch("Auditoría de Calidad", "") || MatchesSearch("Liquidación Comisiones", "") || MatchesSearch("Log Forense Custodia", "") || MatchesSearch("Logs del Sistema", "") || MatchesSearch("Base de Conocimiento", "") || MatchesSearch("Mantenimiento SLA", "");
            default:
                return true;
        }
    }

    private class EngineStatusVm
    {
        public DateTime Timestamp { get; set; }
        public List<EngineItemVm>? Engines { get; set; }
    }

    private class EngineItemVm
    {
        public string Name { get; set; } = string.Empty;
        public int Port { get; set; }
        public string Database { get; set; } = string.Empty;
        public bool IsHealthy { get; set; }
    }
}
