@page "/asesor/orders/new"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using CRM.WebFrontend.Client.Models
@using CRM.WebFrontend.Client.Helpers
@using System.Text.RegularExpressions
@using MudBlazor
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "ASESOR")]

<PageTitle>Nueva Orden - Asesor</PageTitle>

<div class="container-fluid max-w-4xl mx-auto py-4">
    <div class="d-flex align-items-center mb-4">
        <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Class="me-3 text-primary" Style="font-size: 2rem;" />
        <h2 class="fw-bold mb-0">Generar Nueva Orden</h2>
    </div>

    @if (isLoadingInitialData)
    {
        <div class="d-flex justify-content-center p-5">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <!-- Paso 1: Selección de Cliente y Campaña -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-4">1. Selección de Cliente y Campaña</h5>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="select-lead" class="form-label fw-bold">Cliente (Lead)</label>
                        <select id="select-lead" class="form-select form-select-lg rounded-3" @bind="selectedLeadId" aria-label="Seleccionar Cliente Lead">
                            <option value="0" disabled selected="@(selectedLeadId == 0)">-- Selecciona un cliente --</option>
                            @foreach (var l in leads)
                            {
                                <option value="@l.IdLead">@l.FirstName @l.LastName</option>
                            }
                        </select>
                    </div>
                    
                    <div class="col-md-6">
                        <label for="select-campaign" class="form-label fw-bold">Campaña</label>
                        <select id="select-campaign" class="form-select form-select-lg rounded-3" value="@selectedCampaignId" @onchange="OnCampaignSelected" aria-label="Seleccionar Campaña">
                            <option value="0" disabled>-- Selecciona una campaña --</option>
                            @foreach (var cmpg in campaigns)
                            {
                                <option value="@cmpg.Id">@cmpg.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Paso 2: Formulario Dinámico -->
        @if (isLoadingSchema)
        {
            <div class="d-flex justify-content-center p-5">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
            </div>
        }
        else if (formSchema != null && formSchema.Fields.Any())
        {
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4">2. Datos de la Orden</h5>
                    
                    <EditForm Model="formSchema" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        
                        <div class="row g-4">
                            @foreach (var field in formSchema.Fields)
                            {
                                var fieldId = $"field-{field.IdFld}";
                                var errorId = $"error-{field.IdFld}";
                                var helpId = $"help-{field.IdFld}";

                                <div class="col-md-6 mb-3">
                                    <label for="@fieldId" class="form-label fw-bold text-secondary d-flex align-items-center mb-1">
                                        @field.Label
                                        @if (field.IsRequired)
                                        {
                                            <span class="text-danger ms-1" aria-hidden="true">*</span>
                                        }
                                        @if (!string.IsNullOrEmpty(GetValidationTitle(field)))
                                        {
                                            <MudTooltip Text="@GetValidationTitle(field)" Placement="Placement.Top">
                                                <i class="bi bi-info-circle ms-2 text-primary cursor-pointer" aria-hidden="true"></i>
                                            </MudTooltip>
                                        }
                                    </label>
                                    
                                    @if (!string.IsNullOrEmpty(field.HelpText))
                                    {
                                        <div id="@helpId" class="form-text text-muted mb-2"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="me-1"/>@field.HelpText</div>
                                    }

                                    @if (field.FieldType == "select")
                                    {
                                        <select id="@fieldId"
                                                class="form-select rounded-3 @(fieldValidationErrors.ContainsKey(field.IdFld) ? "is-invalid border-danger" : "")"
                                                value="@field.Value"
                                                @onchange="@((ChangeEventArgs e) => OnFieldValueInput(field, e.Value?.ToString()))"
                                                required="@field.IsRequired"
                                                aria-describedby="@($"{helpId} {errorId}")">
                                            <option value="">-- Selecciona --</option>
                                            @if (!string.IsNullOrEmpty(field.Options))
                                            {
                                                try {
                                                    var opts = System.Text.Json.JsonSerializer.Deserialize<List<string>>(field.Options);
                                                    if(opts != null) {
                                                        foreach(var opt in opts) {
                                                            <option value="@opt">@opt</option>
                                                        }
                                                    }
                                                } catch {
                                                    @foreach(var opt in field.Options.Split(',')) {
                                                        <option value="@opt.Trim()">@opt.Trim()</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    }
                                    else if (field.FieldType == "date")
                                    {
                                        <input type="date"
                                               id="@fieldId"
                                               class="form-control rounded-3 @(fieldValidationErrors.ContainsKey(field.IdFld) ? "is-invalid border-danger" : "")"
                                               value="@field.Value"
                                               @onchange="@((ChangeEventArgs e) => OnFieldValueInput(field, e.Value?.ToString()))"
                                               required="@field.IsRequired"
                                               aria-describedby="@($"{helpId} {errorId}")" />
                                    }
                                    else if (field.FieldType == "file")
                                    {
                                        <InputFile id="@fieldId" class="form-control rounded-3" OnChange="@(e => OnFileChange(field, e))" required="@field.IsRequired" aria-describedby="@helpId" />
                                    }
                                    else
                                    {
                                        <input type="text" 
                                               id="@fieldId"
                                               class="form-control rounded-3 @(fieldValidationErrors.ContainsKey(field.IdFld) ? "is-invalid border-danger" : "")" 
                                               placeholder="@field.Placeholder"
                                               value="@field.Value"
                                               @oninput="@((ChangeEventArgs e) => OnFieldValueInput(field, e.Value?.ToString()))"
                                               required="@field.IsRequired" 
                                               pattern="@GetValidationPattern(field)"
                                               title="@GetValidationTitle(field)"
                                               aria-describedby="@($"{helpId} {errorId}")" />
                                    }

                                    @if (fieldValidationErrors.ContainsKey(field.IdFld))
                                    {
                                        <div id="@errorId" class="text-danger small mt-1 fw-bold" role="alert">
                                            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Class="me-1" />
                                            @fieldValidationErrors[field.IdFld]
                                        </div>
                                    }
                                    
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-light rounded-pill px-4 w-100 w-sm-auto" @onclick="ConfirmCancelAsync" disabled="@isSaving">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 d-flex align-items-center justify-content-center w-100 w-sm-auto" disabled="@(isSaving || fieldValidationErrors.Any())">
                                @if (isSaving)
                                {
                                    <MudProgressCircular Class="me-2" Size="Size.Small" Color="Color.Surface" Indeterminate="true" />
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Save" Class="me-2" Size="Size.Small" />
                                    <span>Guardar Orden</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
        else if (selectedCampaignId > 0 && !isLoadingSchema)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="rounded-4">
                No hay un formulario configurado para esta campaña.
            </MudAlert>
        }
    }
</div>

@code {
    private bool isLoadingInitialData = true;
    private bool isLoadingSchema = false;
    private bool isSaving = false;
    private int currentUserId = 0;

    public class LeadSimpleDto
    {
        public long IdLead { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
    }

    private List<CampaignDto> campaigns = new();
    private List<OrderStatusDto> statuses = new();
    private List<LeadSimpleDto> leads = new();
    
    private int selectedCampaignId = 0;
    private int selectedStatusId = 0;
    private long selectedLeadId = 0;

    private FormSchemaDto? formSchema = null;

    [Parameter] [SupplyParameterFromQuery]
    public long? LeadId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Extraer userId del JWT
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdStr = user.FindFirst("id_user")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdStr, out int uid))
            {
                currentUserId = uid;
            }
        }

        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var result = await client.GetFromJsonAsync<List<CampaignDto>>("/api/campaigns");
            if (result != null)
            {
                campaigns = result;
            }
            
            var leadsResult = await client.GetFromJsonAsync<List<LeadSimpleDto>>("/api/leads");
            if (leadsResult != null)
            {
                leads = leadsResult;
            }

            if (LeadId.HasValue && LeadId.Value > 0)
            {
                selectedLeadId = LeadId.Value;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar campañas: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingInitialData = false;
        }
    }

    private async Task OnCampaignSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedCampaignId = id;
            selectedStatusId = 1; // La etapa inicial por defecto siempre es 1 (BORRADOR / En gestión)
            formSchema = null;
            if (selectedCampaignId > 0)
            {
                await LoadFormSchemaAsync();
            }
            StateHasChanged();
        }
    }

    private async Task LoadFormSchemaAsync()
    {
        if (selectedCampaignId > 0)
        {
            isLoadingSchema = true;
            formSchema = null;
            try
            {
                var client = HttpClientFactory.CreateClient("BackendApi");
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var token = authState.User.FindFirst("access_token")?.Value;
                if (!string.IsNullOrEmpty(token))
                {
                    client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                }
                
                // 1. Obtener plantillas para la campaña en su etapa inicial (stage 1)
                var templatesResponse = await client.GetAsync($"/api/forms/campaign/{selectedCampaignId}/stage/{selectedStatusId}");
                
                if (templatesResponse.IsSuccessStatusCode)
                {
                    var templates = await templatesResponse.Content.ReadFromJsonAsync<List<FormTemplateDto>>();
                    var firstTemplate = templates?.FirstOrDefault();
                    
                    if (firstTemplate != null)
                    {
                        // 2. Obtener campos para la plantilla
                        var fieldsResponse = await client.GetAsync($"/api/forms/{firstTemplate.IdForm}/fields");
                        if (fieldsResponse.IsSuccessStatusCode)
                        {
                            var fields = await fieldsResponse.Content.ReadFromJsonAsync<List<FormFieldDto>>();
                            if (fields != null && fields.Any())
                            {
                                formSchema = new FormSchemaDto 
                                {
                                    IdForm = firstTemplate.IdForm,
                                    Name = firstTemplate.Name,
                                    Fields = fields
                                };
                            }
                        }
                    }
                }
                
                if (formSchema == null)
                {
                    Snackbar.Add("No hay campos dinámicos configurados para esta campaña.", Severity.Info);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error de red al cargar el formulario: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoadingSchema = false;
                StateHasChanged();
            }
        }
    }

    private void OnFileChange(FormFieldDto field, InputFileChangeEventArgs e)
    {
        field.Value = e.File.Name; // Mock file name saving for now
    }

    private string? GetValidationPattern(FormFieldDto field)
    {
        if (!string.IsNullOrEmpty(field.ValidationRegex))
        {
            return field.ValidationRegex;
        }

        // Predefined validations via HTML5 pattern matching for client-side
        return field.ValidationType switch
        {
            "DNI_ES" => "^[0-9]{8}[TRWAGMYFPDXBNJZSQVHLCKE]$",
            "NIE_ES" => "^[XYZ][0-9]{7}[TRWAGMYFPDXBNJZSQVHLCKE]$",
            "PHONE_ES" => "^[6789][0-9]{8}$",
            "CUPS_ENERGY" => "^ES[0-9]{20}[A-Z]{2}$",
            "IBAN" => "^ES[0-9]{22}$",
            _ => null
        };
    }

    private string? GetValidationTitle(FormFieldDto field)
    {
        return field.ValidationType switch
        {
            "DNI_ES" => "Debe ser un DNI válido (8 números y 1 letra mayúscula con Módulo 23)",
            "NIE_ES" => "Debe ser un NIE válido (empieza con X, Y o Z)",
            "PHONE_ES" => "Debe ser un teléfono español de 9 dígitos",
            "CUPS_ENERGY" => "Debe ser un código CUPS válido (empieza por ES)",
            "IBAN" => "Debe ser un IBAN español válido de 24 caracteres (Módulo 97)",
            _ => field.IsRequired ? "Este campo es requerido" : null
        };
    }

    private Dictionary<long, string> fieldValidationErrors = new();

    private bool ValidateField(FormFieldDto field)
    {
        fieldValidationErrors.Remove(field.IdFld);

        if (field.IsRequired && string.IsNullOrWhiteSpace(field.Value))
        {
            fieldValidationErrors[field.IdFld] = "Este campo es requerido.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(field.Value))
        {
            string valType = field.ValidationType ?? "";
            string key = field.FieldKey ?? "";
            string label = field.Label ?? "";

            bool isDniField = valType.StartsWith("DNI", StringComparison.OrdinalIgnoreCase)
                           || valType.StartsWith("NIE", StringComparison.OrdinalIgnoreCase)
                           || key.Contains("dni", StringComparison.OrdinalIgnoreCase)
                           || key.Contains("nie", StringComparison.OrdinalIgnoreCase)
                           || key.Contains("documento", StringComparison.OrdinalIgnoreCase)
                           || key.Contains("nif", StringComparison.OrdinalIgnoreCase)
                           || label.Contains("DNI", StringComparison.OrdinalIgnoreCase)
                           || label.Contains("NIE", StringComparison.OrdinalIgnoreCase)
                           || label.Contains("Documento", StringComparison.OrdinalIgnoreCase);

            bool isIbanField = valType.Equals("IBAN", StringComparison.OrdinalIgnoreCase)
                            || key.Contains("iban", StringComparison.OrdinalIgnoreCase)
                            || key.Contains("cuenta", StringComparison.OrdinalIgnoreCase)
                            || label.Contains("IBAN", StringComparison.OrdinalIgnoreCase)
                            || label.Contains("Cuenta", StringComparison.OrdinalIgnoreCase);

            bool isPhoneField = valType.Contains("PHONE", StringComparison.OrdinalIgnoreCase)
                             || key.Contains("telef", StringComparison.OrdinalIgnoreCase)
                             || key.Contains("phone", StringComparison.OrdinalIgnoreCase)
                             || key.Contains("movil", StringComparison.OrdinalIgnoreCase)
                             || label.Contains("Teléfono", StringComparison.OrdinalIgnoreCase)
                             || label.Contains("Telefono", StringComparison.OrdinalIgnoreCase);

            if (isDniField)
            {
                if (!ValidationHelper.ValidateDni(field.Value))
                {
                    fieldValidationErrors[field.IdFld] = "DNI/NIE no es válido (letra de control incorrecta según Módulo 23 de España, ej. 12345678Z).";
                    return false;
                }
            }
            else if (isIbanField)
            {
                if (!ValidationHelper.ValidateIban(field.Value))
                {
                    fieldValidationErrors[field.IdFld] = "IBAN no es válido. Debe tener 24 caracteres empezando por ES y cumplir Módulo 97 (ej. ES9121000418450200051332).";
                    return false;
                }
            }
            else if (isPhoneField)
            {
                if (!ValidationHelper.ValidatePhone(field.Value))
                {
                    fieldValidationErrors[field.IdFld] = "Teléfono de España no válido (debe tener 9 dígitos empezando por 6, 7, 8 o 9).";
                    return false;
                }
            }
            else if (!string.IsNullOrEmpty(field.ValidationRegex))
            {
                try
                {
                    if (!Regex.IsMatch(field.Value, field.ValidationRegex))
                    {
                        fieldValidationErrors[field.IdFld] = "El formato ingresado no es válido.";
                        return false;
                    }
                }
                catch {}
            }
        }

        return true;
    }

    private void OnFieldValueInput(FormFieldDto field, string? value)
    {
        field.Value = value ?? string.Empty;
        ValidateField(field);
    }

    private class OrderDataSubmitDto
    {
        public long IdFld { get; set; }
        public string? ValueText { get; set; }
    }

    private async Task HandleSubmit()
    {
        if (formSchema == null) return;
        
        if (selectedLeadId == 0)
        {
            Snackbar.Add("Debes seleccionar un cliente (Lead) para la orden.", Severity.Warning);
            return;
        }

        bool hasValidationErrors = false;
        fieldValidationErrors.Clear();
        foreach (var field in formSchema.Fields)
        {
            if (!ValidateField(field))
            {
                hasValidationErrors = true;
            }
        }
        
        if (hasValidationErrors || fieldValidationErrors.Any())
        {
            Snackbar.Add("Por favor corrige los errores del formulario resaltados en rojo antes de guardar.", Severity.Error);
            StateHasChanged();
            return;
        }

        isSaving = true;
        try
        {
            var createOrderDto = new
            {
                idLead = selectedLeadId,
                idCmpg = selectedCampaignId,
                idUser = currentUserId,
                ownerUserId = currentUserId,
                custodyUserId = currentUserId,
                idStatus = selectedStatusId,
                status = "BORRADOR"
            };

            var client = HttpClientFactory.CreateClient("BackendApi");
            
            // 1. Create the base order
            var response = await client.PostAsJsonAsync("/api/orders", createOrderDto);

            if (response.IsSuccessStatusCode)
            {
                long newOrderId = 0;
                var responseString = await response.Content.ReadAsStringAsync();
                
                try
                {
                    var jsonDoc = System.Text.Json.JsonDocument.Parse(responseString);
                    if (jsonDoc.RootElement.TryGetProperty("idOrder", out var idProp) && idProp.TryGetInt64(out long parsedId))
                    {
                        newOrderId = parsedId;
                    }
                }
                catch { /* Ignore parsing errors */ }

                if (newOrderId > 0)
                {
                    // 2. Save the dynamic form data
                    var fieldsData = formSchema.Fields.Select(f => new OrderDataSubmitDto
                    {
                        IdFld = f.IdFld,
                        ValueText = f.Value
                    }).ToList();

                    var formDataResponse = await client.PostAsJsonAsync($"/api/forms/order/{newOrderId}/template/{formSchema.IdForm}", fieldsData);
                    
                    if (!formDataResponse.IsSuccessStatusCode)
                    {
                        var errorContent = await formDataResponse.Content.ReadAsStringAsync();
                        string errorDetail = $"Error {formDataResponse.StatusCode}";
                        try
                        {
                            using var errDoc = System.Text.Json.JsonDocument.Parse(errorContent);
                            if (errDoc.RootElement.TryGetProperty("message", out var msgElement))
                            {
                                errorDetail = msgElement.GetString() ?? errorDetail;
                            }
                        }
                        catch
                        {
                            if (!string.IsNullOrWhiteSpace(errorContent)) errorDetail = errorContent;
                        }

                        Snackbar.Add($"Orden #{newOrderId} creada, pero falló al guardar los datos del formulario: {errorDetail}", Severity.Error);
                        return;
                    }
                }
                
                Snackbar.Add($"Orden #{newOrderId} creada y formulario guardado exitosamente.", Severity.Success);
                Navigation.NavigateTo("/asesor/orders");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al crear la orden: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmCancelAsync()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "¿Descartar Nueva Orden?",
            Message = "¿Estás seguro de que deseas cancelar? Todos los datos ingresados en esta orden se perderán.",
            YesText = "Sí, cancelar",
            NoText = "Volver a la orden"
        });

        if (result == true)
        {
            Navigation.NavigateTo("/asesor/orders");
        }
    }
}
