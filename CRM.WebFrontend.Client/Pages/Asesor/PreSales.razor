@page "/asesor/preventas"
@rendermode InteractiveServer
@using CRM.WebFrontend.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Mis Pre-Ventas - Asesor</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Mis Pre-Ventas</h2>
            <p class="text-muted mb-0">Gestiona y haz seguimiento a tus pre-ventas y leads.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenNewModal">
            <i class="bi bi-plus-lg me-2"></i> + Nueva Pre-Venta
        </button>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm border-0 rounded-4 mb-4" role="search" aria-label="Filtros de búsqueda de pre-ventas">
        <div class="card-body p-3">
            <div class="row row-cols-1 row-cols-md-3 g-3 align-items-end">
                <div class="col">
                    <label for="filter-operator" class="form-label small text-muted fw-bold">Filtrar por Operador</label>
                    <input type="text" id="filter-operator" class="form-control" placeholder="Ej. Movistar" @bind="filterOperator" @bind:event="oninput" aria-label="Filtrar por Operador" />
                </div>
                <div class="col">
                    <label for="filter-coverage" class="form-label small text-muted fw-bold">Estado de Cobertura</label>
                    <select id="filter-coverage" class="form-select" @bind="filterCoverage" @bind:event="onchange" aria-label="Filtrar por Estado de Cobertura">
                        <option value="">Todos</option>
                        <option value="SI">Con Cobertura (SI)</option>
                        <option value="NO">Sin Cobertura (NO)</option>
                        <option value="PENDIENTE">Pendiente</option>
                    </select>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-secondary w-100" @onclick="ApplyFilters">Buscar</button>
                </div>
            </div>
        </div>
    </div>

    @if (hasApiError)
    {
        <ApiErrorBanner Title="Error al cargar las pre-ventas" Message="@apiErrorMessage" OnRetry="LoadPreSalesAsync" />
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted fw-bold text-nowrap">N° Pre-Venta</th>
                                <th class="border-0 px-4 py-3 text-muted fw-bold text-nowrap">Cliente</th>
                                <th class="border-0 px-4 py-3 text-muted fw-bold text-nowrap">Teléfono</th>
                                <th class="border-0 px-4 py-3 text-muted fw-bold text-nowrap">Operador / Notas</th>
                                <th class="border-0 px-4 py-3 text-muted fw-bold text-nowrap">Cobertura</th>
                                <th class="border-0 px-4 py-3 text-muted fw-bold text-end text-nowrap">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <LoadingSkeletonTable Rows="5" Columns="6" />
                            }
                            else if (pagedPreSales != null && pagedPreSales.Any())
                            {
                                @foreach (var preSale in pagedPreSales)
                                {
                                    <tr class="cursor-pointer">
                                        <td class="px-4 py-3 text-nowrap">
                                            <span class="text-primary fw-bold">#@preSale.IdPresale</span>
                                            @if (preSale.OwnerUserId != preSale.CurrentUserId || !string.IsNullOrEmpty(preSale.OwnerUserName))
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning rounded-pill px-2 py-1 ms-1" title="Pre-Venta derivada / referida por @(string.IsNullOrEmpty(preSale.OwnerUserName) ? $"ID #{preSale.OwnerUserId}" : preSale.OwnerUserName)">
                                                    <i class="bi bi-person-badge text-warning me-1"></i> Referido de: @(string.IsNullOrEmpty(preSale.OwnerUserName) ? $"#{preSale.OwnerUserId}" : preSale.OwnerUserName)
                                                </span>
                                            }
                                            <br/>
                                            <small class="text-muted">@preSale.Register.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td class="px-4 py-3 text-dark text-nowrap">
                                            @(string.IsNullOrWhiteSpace(preSale.FirstName) && string.IsNullOrWhiteSpace(preSale.LastName) ? "Sin nombre" : $"{preSale.FirstName} {preSale.LastName}".Trim())
                                        </td>
                                        <td class="px-4 py-3 fw-bold text-dark text-nowrap">
                                            @preSale.Phone
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="badge bg-light text-dark border mb-1">@preSale.Operator</span><br/>
                                            <small class="text-muted" style="max-width: 200px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                @preSale.Notes
                                            </small>
                                        </td>
                                        <td class="px-4 py-3 text-nowrap">
                                            @if (IsCovered(preSale.CoverageStatus))
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">Con Cobertura</span>
                                            }
                                            else if (IsNoCoverage(preSale.CoverageStatus))
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2">Sin Cobertura</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-2">Pendiente</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-end text-nowrap" @onclick:stopPropagation="true">
                                            <div class="btn-group">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 me-1" @onclick="() => OpenCallModal(preSale.IdPresale)" title="Registrar llamada">
                                                    <i class="bi bi-telephone-fill me-1"></i> Llamada
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning rounded-pill px-2.5 me-1 text-dark" @onclick="() => OpenAssignModal(preSale.IdPresale)" title="Derivar a otro asesor del equipo">
                                                    <i class="bi bi-person-fill-gear me-1"></i> Derivar
                                                </button>
                                                <button class="btn btn-sm btn-success text-white rounded-pill px-3 shadow-sm" @onclick="() => ConvertToOrder(preSale.IdPresale)" title="Convertir esta Pre-Venta a Orden de Venta" disabled="@isSaving">
                                                    <i class="bi bi-cart-check-fill me-1"></i> Convertir a Venta
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="p-0 border-0">
                                        <EmptyState Icon="bi bi-telephone-x" 
                                                    Title="No hay pre-ventas registradas" 
                                                    Description="No se encontraron registros de pre-venta con los filtros aplicados. Puedes agregar una nueva pre-venta." 
                                                    ActionButtonText="Nueva Pre-Venta" 
                                                    ActionIcon="bi bi-plus-lg" 
                                                    Action="OpenNewModal" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 border-top">
                        <span class="text-muted small">Mostrando @(((currentPage - 1) * pageSize) + 1) a @Math.Min(currentPage * pageSize, filteredPreSales.Count) de @filteredPreSales.Count</span>
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage == 1)" @onclick="PreviousPage">
                                Anterior
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage == totalPages)" @onclick="NextPage">
                                Siguiente
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modal: Nueva Pre-Venta -->
@if (showNewModal)
{
    <div class="modal fade show d-block bg-dark bg-opacity-50" tabindex="-1" role="dialog" aria-labelledby="modal-new-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 id="modal-new-title" class="modal-title fw-bold">Registrar Nueva Pre-Venta</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="ConfirmCloseNewModalAsync"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="presale-phone" class="form-label fw-bold small">Teléfono</label>
                        <input type="text" id="presale-phone" class="form-control" @bind="newPreSale.Phone" placeholder="Número de teléfono" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="presale-fname" class="form-label fw-bold small">Nombre</label>
                            <input type="text" id="presale-fname" class="form-control" @bind="newPreSale.FirstName" />
                        </div>
                        <div class="col-6">
                            <label for="presale-lname" class="form-label fw-bold small">Apellido</label>
                            <input type="text" id="presale-lname" class="form-control" @bind="newPreSale.LastName" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="presale-operator" class="form-label fw-bold small">Operador Actual</label>
                        <input type="text" id="presale-operator" class="form-control" @bind="newPreSale.Operator" placeholder="Ej. Movistar, Orange..." />
                    </div>
                    <div class="mb-3">
                        <label for="presale-coverage" class="form-label fw-bold small">Estado de Cobertura</label>
                        <select id="presale-coverage" class="form-select" @bind="newPreSale.CoverageStatus">
                            <option value="PENDIENTE">Pendiente</option>
                            <option value="SI">Sí, validado</option>
                            <option value="NO">No hay cobertura</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="presale-notes" class="form-label fw-bold small">Oferta Tentativa / Notas</label>
                        <textarea id="presale-notes" class="form-control" rows="2" @bind="newPreSale.Notes" placeholder="Interesado en fibra 1Gb..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" @onclick="ConfirmCloseNewModalAsync" disabled="@isSaving">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="SaveNewPreSale" disabled="@(isSaving || isSuccessNew)">
                        @if(isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Guardando...</span> }
                        else if(isSuccessNew) { <i class="bi bi-check-circle-fill me-2"></i><span>¡Creado!</span> }
                        else { <span>Crear Pre-Venta</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Registrar Llamada y Copiar Número -->
@if (showCallModal)
{
    <div class="modal fade show d-block bg-dark bg-opacity-50" tabindex="-1" role="dialog" aria-labelledby="modal-call-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 id="modal-call-title" class="modal-title fw-bold text-dark">
                            <i class="bi bi-telephone-outbound-fill text-primary me-2"></i> Llamada al Cliente
                        </h5>
                        <p class="text-muted small mb-0">Pre-Venta #@selectedPreSaleId — @(selectedPreSaleObj != null ? $"{selectedPreSaleObj.FirstName} {selectedPreSaleObj.LastName}".Trim() : "Cliente")</p>
                    </div>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseCallModal"></button>
                </div>
                <div class="modal-body py-3">
                    <!-- Selector / Copiado de Números Registrados -->
                    <div class="p-3 rounded-4 mb-3" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
                        <label class="form-label fw-bold small text-secondary mb-2 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-phone me-1"></i> Teléfono(s) Registrado(s)</span>
                            <span class="badge bg-primary-subtle text-primary font-monospace">@selectedPhones.Count número(s)</span>
                        </label>
                        @if (selectedPhones.Any())
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var ph in selectedPhones)
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2.5 rounded-3 bg-white border @(activeSelectedPhone == ph ? "border-primary bg-primary-subtle bg-opacity-10" : "")">
                                        <div class="d-flex align-items-center gap-2 cursor-pointer" @onclick="() => SelectPhoneToCall(ph)">
                                            <input class="form-check-input mt-0" type="radio" name="phoneSelect" checked="@(activeSelectedPhone == ph)" @onchange="() => SelectPhoneToCall(ph)" />
                                            <div>
                                                <span class="fw-bold font-monospace text-dark fs-6 d-block">@ph.Number</span>
                                                <small class="text-muted">@ph.Label</small>
                                            </div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => CopyToClipboard(ph.Number)">
                                            <i class="bi bi-clipboard me-1"></i> Copiar
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small py-2 text-center">No hay números telefónicos registrados en esta pre-venta.</div>
                        }
                    </div>

                    <!-- Presets Rápidos de Notas -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary mb-2">Resultado / Nota Rápida</label>
                        <div class="d-flex flex-wrap gap-1.5 mb-2">
                            <button type="button" class="btn btn-sm btn-light border rounded-pill small" @onclick='() => SetQuickNote("Contactado: Cliente interesado, solicita información adicional.")'>👍 Interesado</button>
                            <button type="button" class="btn btn-sm btn-light border rounded-pill small" @onclick='() => SetQuickNote("No contesta: Intento de llamada sin respuesta.")'>📵 No contesta</button>
                            <button type="button" class="btn btn-sm btn-light border rounded-pill small" @onclick='() => SetQuickNote("Volver a llamar: Cliente solicita ser contactado en otro horario.")'>⏰ Reagendar</button>
                            <button type="button" class="btn btn-sm btn-light border rounded-pill small" @onclick='() => SetQuickNote("Número no válido / Fuera de servicio.")'>❌ No Válido</button>
                        </div>
                        <textarea id="call-notes" class="form-control rounded-3" rows="3" @bind="callNotes" placeholder="Escribe detalles de la conversación..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" @onclick="CloseCallModal" disabled="@isSaving">Cancelar</button>
                    <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm" @onclick="SaveCall" disabled="@(isSaving || isSuccessCall)">
                        @if(isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Guardando...</span> }
                        else if(isSuccessCall) { <i class="bi bi-check-circle-fill me-2"></i><span>¡Registrado!</span> }
                        else { <span><i class="bi bi-telephone-fill me-1"></i> Registrar Bitácora</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Derivar Asesor -->
@if (showAssignModal)
{
    <div class="modal fade show d-block bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Derivar a otro Asesor</h5>
                    <button type="button" class="btn-close" @onclick="CloseAssignModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Traslada la pre-venta #@selectedPreSaleId a otro agente.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Nuevo Asesor</label>
                        <select class="form-select rounded-3" @bind="assignUserId">
                            <option value="0" disabled>-- Selecciona un asesor --</option>
                            @foreach (var adv in advisors)
                            {
                                <option value="@adv.Id">@adv.Name</option>
                            }
                        </select>
                        <div class="form-text">Selecciona el asesor de destino para transferir la pre-venta.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Contexto de la Derivación</label>
                        <textarea class="form-control" rows="2" @bind="assignContext" placeholder="Motivo de la transferencia..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" @onclick="CloseAssignModal" disabled="@isSaving">Cancelar</button>
                    <button type="button" class="btn btn-warning rounded-pill px-4 text-dark" @onclick="SaveAssign" disabled="@(isSaving || isSuccessAssign)">
                        @if(isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Transfiriendo...</span> }
                        else if(isSuccessAssign) { <i class="bi bi-check-circle-fill me-2"></i><span>¡Transferido!</span> }
                        else { <span>Transferir</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .cursor-pointer { cursor: pointer; }
    .cursor-pointer:hover { background-color: #f8f9fa !important; }
</style>

@code {
    private List<PreSaleDto> allPreSales = new();
    private List<PreSaleDto> filteredPreSales = new();
    private List<PreSaleDto> pagedPreSales = new();
    
    private bool isLoading = true;
    private bool hasApiError = false;
    private string apiErrorMessage = string.Empty;
    private bool isSaving = false;
    private int currentUserId = 0;

    // Paginación
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)filteredPreSales.Count / pageSize);

    // Filtros
    private string filterOperator = "";
    private string filterCoverage = "";

    // Modales y Estados
    private bool showNewModal = false;
    private bool showCallModal = false;
    private bool showAssignModal = false;
    
    private bool isSuccessNew = false;
    private bool isSuccessCall = false;
    private bool isSuccessAssign = false;
    
    private PreSaleDto newPreSale = new() { CoverageStatus = "PENDIENTE" };
    private long selectedPreSaleId = 0;
    private PreSaleDto? selectedPreSaleObj;
    private string callNotes = "";
    private int assignUserId = 0;
    private string assignContext = "";

    public class PhoneOptionItem
    {
        public string Number { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private List<PhoneOptionItem> selectedPhones = new();
    private PhoneOptionItem? activeSelectedPhone;

    private List<AdvisorLookupDto> advisors = new();

    public class AdvisorLookupDto 
    { 
        public int Id { get; set; } 
        public string Name { get; set; } = string.Empty; 
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var idUserClaim = user.FindFirst(c => c.Type == "id_user" || c.Type == System.Security.Claims.ClaimTypes.NameIdentifier);
            if (idUserClaim != null && int.TryParse(idUserClaim.Value, out int uid))
            {
                currentUserId = uid;
            }
        }
        await LoadAdvisorsAsync();
        await LoadPreSalesAsync();
    }

    private async Task LoadAdvisorsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var result = await client.GetFromJsonAsync<List<AdvisorLookupDto>>("/api/campaigns/advisors");
            if (result != null)
            {
                advisors = result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading advisors: {ex.Message}");
        }
    }

    private async Task LoadPreSalesAsync()
    {
        isLoading = true;
        hasApiError = false;
        apiErrorMessage = string.Empty;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var result = await client.GetFromJsonAsync<List<PreSaleDto>>($"/api/presales?userId={currentUserId}");
            
            if (result != null)
            {
                // Filtrar solo las pre-ventas activas (no convertidas ni terminales)
                allPreSales = result
                    .Where(p => p.IdStatus != 3) // Excluir estado 3 (CONVERTIDO)
                    .OrderByDescending(p => p.Register)
                    .ToList();
                ApplyFilters();
            }

        }
        catch (Exception ex)
        {
            hasApiError = true;
            apiErrorMessage = "No se pudieron obtener las pre-ventas desde la API. Por favor comprueba si el servicio backend está activo.";
            Snackbar.Add($"Error al cargar pre-ventas: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var temp = allPreSales.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filterOperator))
            temp = temp.Where(p => p.Operator != null && p.Operator.Contains(filterOperator, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filterCoverage))
        {
            if (filterCoverage == "SI")
            {
                temp = temp.Where(p => IsCovered(p.CoverageStatus));
            }
            else if (filterCoverage == "NO")
            {
                temp = temp.Where(p => IsNoCoverage(p.CoverageStatus));
            }
            else if (filterCoverage == "PENDIENTE")
            {
                temp = temp.Where(p => !IsCovered(p.CoverageStatus) && !IsNoCoverage(p.CoverageStatus));
            }
        }

        filteredPreSales = temp.ToList();
        currentPage = 1;
        UpdatePagedPreSales();
    }

    private void UpdatePagedPreSales()
    {
        pagedPreSales = filteredPreSales
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void PreviousPage()
    {
        if (currentPage > 1) { currentPage--; UpdatePagedPreSales(); }
    }

    private void NextPage()
    {
        if (currentPage < totalPages) { currentPage++; UpdatePagedPreSales(); }
    }

    // --- Lógica de Nueva Pre-Venta ---
    private void OpenNewModal()
    {
        newPreSale = new() { 
            CoverageStatus = "PENDIENTE", 
            CurrentUserId = currentUserId, 
            OwnerUserId = currentUserId,
            IdCmpg = 1, // Por defecto campaña 1
            IdStatus = 1 // Por defecto estado 1 (ej. Pendiente/Nuevo)
        };
        showNewModal = true;
    }
    private void CloseNewModal() => showNewModal = false;
    
    private async Task ConfirmCloseNewModalAsync()
    {
        if (!string.IsNullOrWhiteSpace(newPreSale.Phone) || !string.IsNullOrWhiteSpace(newPreSale.FirstName))
        {
            bool? result = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
            {
                Title = "¿Descartar Pre-Venta?",
                Message = "¿Estás seguro de cancelar? Se perderán los datos ingresados en el formulario.",
                YesText = "Sí, descartar",
                NoText = "Continuar editando"
            });

            if (result != true) return;
        }
        showNewModal = false;
    }
    
    private async Task SaveNewPreSale()
    {
        isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.PostAsJsonAsync("/api/presales", newPreSale);
            if (response.IsSuccessStatusCode)
            {
                isSuccessNew = true;
                StateHasChanged();
                await Task.Delay(1500);
                Snackbar.Add("Pre-Venta registrada correctamente.", Severity.Success);
                showNewModal = false;
                isSuccessNew = false;
                await LoadPreSalesAsync(); // Recargar datos
            }
            else
            {
                Snackbar.Add("Error al registrar pre-venta.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    // --- Lógica de Registrar Llamada con Selección de Teléfono ---
    private void OpenCallModal(long id)
    {
        selectedPreSaleId = id;
        selectedPreSaleObj = allPreSales.FirstOrDefault(x => x.IdPresale == id);
        callNotes = "";
        selectedPhones.Clear();

        if (selectedPreSaleObj != null)
        {
            if (!string.IsNullOrWhiteSpace(selectedPreSaleObj.Phone))
            {
                var parts = selectedPreSaleObj.Phone.Split(new[] { ',', '/', ';' }, StringSplitOptions.RemoveEmptyEntries);
                int idx = 1;
                foreach (var p in parts)
                {
                    var trimmed = p.Trim();
                    if (!string.IsNullOrWhiteSpace(trimmed))
                    {
                        selectedPhones.Add(new PhoneOptionItem { Number = trimmed, Label = parts.Length > 1 ? $"Teléfono registrado #{idx++}" : "Teléfono Principal" });
                    }
                }
            }

            if (!string.IsNullOrWhiteSpace(selectedPreSaleObj.SecondaryPhone))
            {
                var trimmed = selectedPreSaleObj.SecondaryPhone.Trim();
                if (!selectedPhones.Any(x => x.Number == trimmed))
                {
                    selectedPhones.Add(new PhoneOptionItem { Number = trimmed, Label = "Teléfono Secundario / Trabajo" });
                }
            }
        }

        if (!selectedPhones.Any())
        {
            selectedPhones.Add(new PhoneOptionItem { Number = "Sin teléfono", Label = "No registrado" });
        }

        activeSelectedPhone = selectedPhones.FirstOrDefault();
        showCallModal = true;
    }

    private void SelectPhoneToCall(PhoneOptionItem item)
    {
        activeSelectedPhone = item;
    }

    private async Task CopyToClipboard(string number)
    {
        if (string.IsNullOrWhiteSpace(number) || number == "Sin teléfono") return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", number);
            Snackbar.Add($"¡Teléfono «{number}» copiado al portapapeles!", Severity.Success);
        }
        catch
        {
            Snackbar.Add($"Número: {number} (Selecciona para copiar)", Severity.Info);
        }
    }

