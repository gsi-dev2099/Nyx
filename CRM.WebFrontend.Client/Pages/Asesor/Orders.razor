@page "/asesor/orders"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ASESOR")]
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@using System.Net.Http.Json
@using MudBlazor
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Bandeja del Asesor - NYX CRM</PageTitle>

<div>
    <!-- KPI Cards -->
    <div class="kpi-grid">
        <div class="kpi-card-galaxy kpi-card-galaxy--hero">
            <div class="kpi-label-galaxy" style="position:relative; z-index:2;">PEDIDOS EN CUSTODIA</div>
            <div style="display:flex; align-items:baseline; position:relative; z-index:2;">
                <span class="kpi-value-galaxy">@allOrders.Count</span>
                <span class="kpi-unit-galaxy">activas hoy</span>
            </div>
            <div class="kpi-detail-galaxy" style="position:relative; z-index:2;"><i class="bi bi-activity me-1"></i>Órdenes bajo tu custodia</div>
        </div>
        <div class="kpi-card-galaxy">
            <div class="kpi-label-galaxy">VENTAS APROBADAS</div>
            <div style="display:flex; align-items:baseline;">
                <span class="kpi-value-galaxy">@CalculateApprovedToday()</span>
                <span class="kpi-unit-galaxy">aprobadas</span>
            </div>
            <div class="kpi-detail-galaxy"><i class="bi bi-check-circle me-1"></i>Con estado aprobado</div>
            <div class="kpi-bar-galaxy" style="background: var(--success-galaxy);"></div>
        </div>
        <div class="kpi-card-galaxy">
            <div class="kpi-label-galaxy">CAMPAÑAS ACTIVAS</div>
            <div style="display:flex; align-items:baseline;">
                <span class="kpi-value-galaxy">@filterCampaigns.Count</span>
                <span class="kpi-unit-galaxy">campañas</span>
            </div>
            <div class="kpi-detail-galaxy"><i class="bi bi-megaphone me-1"></i>Campañas disponibles</div>
            <div class="kpi-bar-galaxy" style="background: var(--indigo);"></div>
        </div>
        <div class="kpi-card-galaxy">
            <div class="kpi-label-galaxy">ESTADOS ACTIVOS</div>
            <div style="display:flex; align-items:baseline;">
                <span class="kpi-value-galaxy">@filterStatuses.Count</span>
                <span class="kpi-unit-galaxy">estados</span>
            </div>
            <div class="kpi-detail-galaxy"><i class="bi bi-tags me-1"></i>Flujo operativo</div>
            <div class="kpi-bar-galaxy" style="background: var(--accent);"></div>
        </div>
    </div>

    <!-- Filters -->
    <div class="galaxy-table-container" style="margin-bottom: 1.5rem; animation-delay: 0.1s;">
        <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end;">
            <div style="flex: 1; min-width: 160px;">
                <label for="filter-campaign" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: var(--text-secondary-galaxy); margin-bottom: 4px; display: block;">Campaña</label>
                <select id="filter-campaign" class="galaxy-filter-select" style="width: 100%;" @bind="filterCampaignId">
                    <option value="">Todas</option>
                    @foreach (var c in filterCampaigns)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div style="flex: 1; min-width: 160px;">
                <label for="filter-status" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: var(--text-secondary-galaxy); margin-bottom: 4px; display: block;">Estado</label>
                <select id="filter-status" class="galaxy-filter-select" style="width: 100%;" @bind="filterStatusId">
                    <option value="">Todos</option>
                    @foreach (var s in filterStatuses)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div style="flex: 1; min-width: 160px;">
                <label for="filter-date-from" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: var(--text-secondary-galaxy); margin-bottom: 4px; display: block;">Desde</label>
                <input type="date" id="filter-date-from" class="galaxy-search-field" style="width: 100%; padding-left: 12px;" @bind="filterDateFrom" />
            </div>
            <div style="display: flex; gap: 8px; align-self: flex-end;">
                <button type="button" class="btn-accent-galaxy" @onclick="ApplyFilters">
                    <i class="bi bi-search me-1"></i> Filtrar
                </button>
                <button type="button" class="btn-ghost-galaxy" @onclick="ClearFilters">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    @if (hasApiError)
    {
        <ApiErrorBanner Title="Error al cargar las órdenes" Message="@apiErrorMessage" OnRetry="LoadOrdersAsync" />
    }
    else
    {
        <!-- Table Card -->
        <div class="galaxy-table-container">
            <div class="galaxy-table-toolbar">
                <div style="display:flex; align-items:center; gap:10px;">
                    <h5 style="margin:0; font-size:1rem; font-weight:800; color: var(--text-primary-galaxy);">Órdenes recientes</h5>
                    <span class="galaxy-visible-count">@pagedOrders.Count visibles</span>
                </div>
            </div>

            <table class="galaxy-order-table">
                <thead>
                    <tr>
                        <th>N° Orden</th>
                        <th>Cliente</th>
                        <th>Campaña</th>
                        <th>Estado</th>
                        <th>Substatus</th>
                        <th>Fecha Venta</th>
                        <th>Días SLA</th>
                        <th style="text-align:center;">Ficha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <LoadingSkeletonTable Rows="5" Columns="8" />
                    }
                    else if (!pagedOrders.Any())
                    {
                        <tr>
                            <td colspan="8" class="p-0 border-0">
                                <EmptyState Icon="bi bi-inbox" 
                                            Title="No se encontraron órdenes" 
                                            Description="No hay ventas registradas con los filtros seleccionados. Genera una nueva orden para comenzar." 
                                            ActionButtonText="Generar Nueva Orden" 
                                            ActionIcon="bi bi-plus-circle" 
                                            Action='() => NavigationManager.NavigateTo("/asesor/orders/new")' />
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowIndex = 0;
                        foreach (var order in pagedOrders)
                        {
                            var rowClass = rowIndex % 2 == 0 ? "galaxy-row-white" : "galaxy-row-slate";
                            <tr class="@rowClass" @onclick="() => GoToDetail(order.IdOrder)">
                                <td>
                                    <div class="galaxy-order-id">#@order.IdOrder</div>
                                    <div class="galaxy-order-date">@order.SalesDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td style="font-weight: 600;">@order.ClientName</td>
                                <td>
                                    <span class="galaxy-campaign-pill">@order.CampaignName</span>
                                </td>
                                <td>
                                    <span class="galaxy-status-dynamic" style="background-color: color-mix(in srgb, @(order.StatusColor ?? "#6c757d") 15%, transparent); color: @(order.StatusColor ?? "#6c757d"); border: 1px solid @(order.StatusColor ?? "#6c757d")33;">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; background-color: @(order.StatusColor ?? "#6c757d"); display: inline-block;"></span>
                                        @order.StatusName
                                    </span>
                                </td>
                                <td style="color: var(--text-secondary-galaxy); font-size: 0.82rem;">@(string.IsNullOrEmpty(order.SubstatusName) ? "-" : order.SubstatusName)</td>
                                <td style="white-space: nowrap; color: var(--text-secondary-galaxy); font-size: 0.82rem;">@order.SalesDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @{
                                        var slaClass = order.DaysElapsed > 5 ? "galaxy-sla-danger" : order.DaysElapsed > 2 ? "galaxy-sla-warning" : "galaxy-sla-ok";
                                    }
                                    <span class="galaxy-sla-badge @slaClass">
                                        <i class="bi bi-clock-history"></i> @order.DaysElapsed @(order.DaysElapsed == 1 ? "día" : "días")
                                    </span>
                                </td>
                                <td style="text-align:center;" @onclick:stopPropagation="true">
                                    <button type="button" class="galaxy-ficha-btn" title="Ver Detalle" @onclick="() => GoToDetail(order.IdOrder)">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                </td>
                            </tr>
                            rowIndex++;
                        }
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="galaxy-pagination">
                    <span class="text-muted">Página <strong>@currentPage</strong> de <strong>@totalPages</strong></span>
                    <div style="display: flex; gap: 8px;">
                        <button class="galaxy-page-btn" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">Anterior</button>
                        <button class="galaxy-page-btn" disabled="@(currentPage == totalPages)" @onclick="() => ChangePage(currentPage + 1)">Siguiente</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (selectedOrder != null)
{
    <div class="galaxy-modal-overlay open" @onclick="CloseDetail">
        <div class="galaxy-modal-card" style="width: 720px;" @onclick:stopPropagation="true">
            <div class="galaxy-modal-header">
                <div>
                    <span class="galaxy-modal-badge">Orden de Venta</span>
                    <h4 style="font-weight:800; color:var(--text-primary-galaxy); margin:0;">Detalle de Orden #@selectedOrder.IdOrder</h4>
                </div>
                <button class="galaxy-modal-close" @onclick="CloseDetail"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="galaxy-modal-body">
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
                    <div>
                        <span style="display: block; color: var(--text-secondary-galaxy); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Cliente</span>
                        <span style="font-weight: 700; color: var(--text-primary-galaxy);">@selectedOrder.ClientName</span>
                    </div>
                    <div>
                        <span style="display: block; color: var(--text-secondary-galaxy); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Campaña</span>
                        <span style="color: var(--text-secondary-galaxy);">@selectedOrder.CampaignName</span>
                    </div>
                    <div>
                        <span style="display: block; color: var(--text-secondary-galaxy); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Estado Actual</span>
                        <span class="galaxy-status-dynamic" style="background-color: color-mix(in srgb, @(selectedOrder.StatusColor ?? "#6c757d") 15%, transparent); color: @(selectedOrder.StatusColor ?? "#6c757d"); border: 1px solid @(selectedOrder.StatusColor ?? "#6c757d")33;">
                            @selectedOrder.StatusName
                        </span>
                    </div>
                    <div>
                        <span style="display: block; color: var(--text-secondary-galaxy); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Substatus</span>
                        <span>@(string.IsNullOrEmpty(selectedOrder.SubstatusName) ? "Sin substatus" : selectedOrder.SubstatusName)</span>
                    </div>
                    <div>
                        <span style="display: block; color: var(--text-secondary-galaxy); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Fecha de Registro</span>
                        <span>@selectedOrder.SalesDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                    <div>
                        <span style="display: block; color: var(--text-secondary-galaxy); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Tiempo Transcurrido</span>
                        @{
                            var detailSlaClass = selectedOrder.DaysElapsed > 5 ? "galaxy-sla-danger" : "galaxy-sla-ok";
                        }
                        <span class="galaxy-sla-badge @detailSlaClass">
                            @selectedOrder.DaysElapsed días transcurridos
                        </span>
                    </div>
                </div>
            </div>
            <div class="galaxy-modal-footer">
                <button class="btn-ghost-galaxy" @onclick="CloseDetail">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    public class SalesOrderListDto
    {
        public long IdOrder { get; set; }
        public long IdCmpg { get; set; }
        public long? IdStatus { get; set; }
        public long IdLead { get; set; }
        public string ClientName { get; set; } = "";
        public string CampaignName { get; set; } = "";
        public string StatusName { get; set; } = "";
        public string? StatusColor { get; set; }
        public string? SubstatusName { get; set; }
        public DateTime SalesDate { get; set; }
        public int DaysElapsed { get; set; }
    }

    public class LeadDto
    {
        public long IdLead { get; set; }
        public string? FullName { get; set; }
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
    }

    public class LookupDto { public long Id { get; set; } public string Name { get; set; } = ""; public string? Color { get; set; } }

    private List<SalesOrderListDto> allOrders = new();
    private List<SalesOrderListDto> pagedOrders = new();
    private SalesOrderListDto? selectedOrder;
    
    private List<LookupDto> filterStatuses = new();
    private List<LookupDto> filterCampaigns = new();

    private long? filterStatusId;
    private long? filterCampaignId;
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;

    private int currentPage = 1;
    private int pageSize = 8;
    private int totalPages = 1;

    private bool isLoading = true;
    private bool hasApiError = false;
    private string apiErrorMessage = string.Empty;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var idClaim = user.FindFirst("id_user")?.Value ?? user.FindFirst("sub")?.Value;
            if (int.TryParse(idClaim, out int uid))
            {
                currentUserId = uid;
            }

            await LoadFilterOptionsAsync();
            await LoadOrdersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing Asesor Orders: {ex.Message}");
        }
    }

    private async Task LoadFilterOptionsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var campaignList = await client.GetFromJsonAsync<List<LookupDto>>("/api/campaigns");
            if (campaignList != null) filterCampaigns = campaignList;

            var statusList = await client.GetFromJsonAsync<List<LookupDto>>("/api/statuses");
            if (statusList != null) filterStatuses = statusList;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Nota: Opciones de filtro dinámicas en modo fallback: {ex.Message}");
        }
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        hasApiError = false;
        apiErrorMessage = string.Empty;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            
            var query = $"/api/orders?userId={currentUserId}&page={currentPage}&pageSize={pageSize}";
            if (filterStatusId.HasValue) query += $"&statusId={filterStatusId}";
            if (filterCampaignId.HasValue) query += $"&campaignId={filterCampaignId}";
            if (filterDateFrom.HasValue) query += $"&dateFrom={filterDateFrom.Value:yyyy-MM-dd}";
            if (filterDateTo.HasValue) query += $"&dateTo={filterDateTo.Value:yyyy-MM-dd}";

            var pagedResult = await client.GetFromJsonAsync<CRM.WebFrontend.Client.Models.PagedResult<SalesOrderListDto>>(query);
            if (pagedResult != null)
            {
                totalPages = pagedResult.TotalPages;
                var result = pagedResult.Items.Where(x => x.IdLead != 99998).ToList();

                foreach (var o in result)
                {
                    o.CampaignName = filterCampaigns.FirstOrDefault(c => c.Id == o.IdCmpg)?.Name ?? "Desconocida";
                    var matchedStatus = filterStatuses.FirstOrDefault(s => s.Id == o.IdStatus);
                    o.StatusName = matchedStatus?.Name ?? "Por Asignar";
                    o.StatusColor = matchedStatus?.Color ?? "#6c757d";
                    o.ClientName = !string.IsNullOrEmpty(o.ClientName) ? o.ClientName : $"Cliente Lead #{o.IdLead}";
                }

                // Fetch real lead names from Lead API
                var uniqueLeadIds = result.Select(o => o.IdLead).Distinct().ToList();
                var leadTasks = uniqueLeadIds.Select(async leadId => 
                {
                    try 
                    {
                        var lead = await client.GetFromJsonAsync<LeadDto>($"/api/leads/{leadId}");
                        if (lead != null)
                        {
                            var leadName = !string.IsNullOrEmpty(lead.FullName) ? lead.FullName : $"{lead.FirstName} {lead.LastName}".Trim();
                            if (!string.IsNullOrEmpty(leadName)) return new { Id = leadId, Name = leadName };
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error obteniendo nombre de lead: {ex.Message}");
                    }
                    return new { Id = leadId, Name = $"Cliente no registrado" };
                });
                
                var leadResults = await Task.WhenAll(leadTasks);
                var leadDict = leadResults.ToDictionary(k => k.Id, v => v.Name);

                foreach (var order in result)
                {
                    if (leadDict.TryGetValue(order.IdLead, out var name))
                    {
                        order.ClientName = name;
                    }
                    else
                    {
                        order.ClientName = $"Cliente no registrado";
                    }
                }

                allOrders = result;
                UpdatePagedOrders();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching orders: {ex.Message}");
            hasApiError = true;
            apiErrorMessage = "No se pudieron obtener las órdenes de venta desde el servidor. Por favor verifica si el servicio backend está activo.";
            Snackbar.Add("Error de conexión con la API al obtener órdenes.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private decimal CalculateTotalCustodyValue()
    {
        return allOrders.Count * 2128.75m;
    }

    private int CalculateApprovedToday()
    {
        return allOrders.Count(o => o.StatusName.Contains("Aprobad", StringComparison.OrdinalIgnoreCase) || o.StatusName.Contains("Venta", StringComparison.OrdinalIgnoreCase) || o.IdStatus == 1 || o.IdStatus == 2);
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadOrdersAsync();
    }

    private async Task ClearFilters()
    {
        filterStatusId = null;
        filterCampaignId = null;
        filterDateFrom = null;
        filterDateTo = null;
        currentPage = 1;
        await LoadOrdersAsync();
    }

    private void UpdatePagedOrders()
    {
        pagedOrders = allOrders;
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= totalPages)
        {
            currentPage = newPage;
            await LoadOrdersAsync();
        }
    }

    private void GoToDetail(long idOrder)
    {
        selectedOrder = allOrders.FirstOrDefault(o => o.IdOrder == idOrder);
    }
    
    private void CloseDetail()
    {
        selectedOrder = null;
    }
}
