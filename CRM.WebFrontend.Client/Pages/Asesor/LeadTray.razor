@page "/leads/tray"
@using CRM.WebFrontend.Client.Models.Leads
@using CRM.WebFrontend.Client.Services
@using CRM.WebFrontend.Client.Components.UI
@inject ILeadService LeadService

<div class="container mt-4">
    <h2 class="mb-4">Bolsa de Trabajo de Leads</h2>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <ApiErrorBanner ErrorMessage="@_errorMessage" />
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Documento</th>
                    <th>Fecha Registro</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                <Virtualize ItemsProvider="@LoadLeads" Context="lead">
                    <ItemContent>
                        <tr>
                            <td>@(string.IsNullOrEmpty(lead.FullName) ? $"{lead.FirstName} {lead.LastName}" : lead.FullName)</td>
                            <td>@lead.Email</td>
                            <td>@lead.Phone</td>
                            <td>@lead.DocumentNumber</td>
                            <td>@lead.Register.ToLocalTime().ToString("g")</td>
                            <td>
                                <button class="btn btn-primary btn-sm" @onclick="() => TakeCustodyAsync(lead.IdLead)">
                                    Asignarme
                                </button>
                            </td>
                        </tr>
                    </ItemContent>
                    <Placeholder>
                        <LoadingSkeletonTable />
                    </Placeholder>
                </Virtualize>
            </tbody>
        </table>
    </div>

    @if (_isEmpty)
    {
        <EmptyState Message="No hay leads en la bolsa de trabajo en este momento." />
    }
</div>

@code {
    private string? _errorMessage;
    private bool _isEmpty = false;

    private async ValueTask<ItemsProviderResult<LeadResponse>> LoadLeads(ItemsProviderRequest request)
    {
        _errorMessage = null;
        try
        {
            // Virtualize Request provides StartIndex and Count. We map to Page and Limit.
            int page = (request.StartIndex / request.Count) + 1;
            int limit = request.Count;

            var leads = await LeadService.GetLeadsAsync(page, limit);
            var items = leads.ToList();
            
            _isEmpty = request.StartIndex == 0 && items.Count == 0;
            StateHasChanged();

            // TotalItemCount is an estimate or real count. If the API doesn't provide total count, 
            // we simulate a rolling limit by adding +1 page if there are elements returned.
            int totalItems = request.StartIndex + items.Count + (items.Count == limit ? limit : 0);

            return new ItemsProviderResult<LeadResponse>(items, totalItems);
        }
        catch (RateLimitException ex)
        {
            _errorMessage = ex.Message;
            return new ItemsProviderResult<LeadResponse>(Enumerable.Empty<LeadResponse>(), 0);
        }
        catch (Exception ex)
        {
            _errorMessage = "Error de conexión con el servidor.";
            Console.WriteLine(ex);
            return new ItemsProviderResult<LeadResponse>(Enumerable.Empty<LeadResponse>(), 0);
        }
    }

    private async Task TakeCustodyAsync(long idLead)
    {
        _errorMessage = null;
        try
        {
            var success = await LeadService.TakeCustodyAsync(idLead);
            if (success)
            {
                // In a real app we'd trigger a refresh or show success toast.
                _errorMessage = "Lead asignado correctamente. Actualice la página (por ahora).";
            }
        }
        catch (RateLimitException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = "Error al intentar asignar el lead.";
            Console.WriteLine(ex);
        }
    }
}
