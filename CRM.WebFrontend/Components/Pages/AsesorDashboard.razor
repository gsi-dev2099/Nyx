                new() { IdStage = 15, Name = "Validación Interna", OrderIndex = 4 },
                new() { IdStage = 16, Name = "Envío Proveedor", OrderIndex = 5 },
                new() { IdStage = 17, Name = "Validación Externa", OrderIndex = 6 },
                new() { IdStage = 18, Name = "Firma", OrderIndex = 7 },
                new() { IdStage = 19, Name = "Tramitación", OrderIndex = 8 },
                new() { IdStage = 20, Name = "Activación", OrderIndex = 9 },
                new() { IdStage = 21, Name = "Postventa", OrderIndex = 10 },
                new() { IdStage = 22, Name = "Cerrada", OrderIndex = 11 }
            };
        }

        long currentStageId = 12; // Preventa por defecto
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var flowInstResponse = await client.GetAsync($"/api/engines/flow/instances/by-entity/lead_presale/{ps.IdPresale}/detail");
