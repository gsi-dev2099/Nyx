    private string GetShortName(long cpId, string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return $"CP #{cpId}";
        var clean = fullName
            .Replace("Preventa — ", "")
            .Replace("Venta Creada — ", "")
            .Replace("Gestión Inicial — ", "")
            .Replace("Validación Interna — ", "")
            .Replace("Envío Proveedor — ", "")
            .Replace("Validación Externa — ", "")
            .Replace("Firma — ", "")
            .Replace("Tramitación — ", "")
            .Replace("Activación — ", "")
            .Replace("Postventa — ", "")
            .Trim();
        if (clean.Length > 22) return clean.Substring(0, 20) + "...";
        return clean;
    }

    private string GetIconForCp(long cpId)
    {
        if (cpId == 11) return "bi-file-earmark-check-fill";
        if (cpId == 12 || cpId == 13 || cpId == 14) return "bi-telephone-fill";
        if (cpId == 15) return "bi-shield-exclamation";
        if (cpId == 75) return "bi-arrow-repeat";
        if (cpId == 76) return "bi-stars";
        if (cpId == 16) return "bi-person-vcard-fill";
        if (cpId == 79 || cpId == 18 || cpId == 80 || cpId == 23) return "bi-calculator-fill";
        if (cpId == 77) return "bi-geo-alt-fill";
        if (cpId == 78) return "bi-shield-shaded";
        if (cpId == 19) return "bi-person-check-fill";
        if (cpId >= 45 && cpId <= 50) return "bi-pen-fill";
        if (cpId >= 51 && cpId <= 57) return "bi-tools";
        if (cpId >= 58 && cpId <= 63) return "bi-broadcast-pin";
        if (cpId == 24 || cpId == 72) return "bi-headset";
        return "bi-check2-circle";
    }

    private CheckpointWindowVm GetCheckpointWindow(PreSaleDto ps, bool isOwner, bool isPendingAccept, bool canCall1, bool canCall2, bool canCall3)
    {
        bool hasGlobalPermission = isOwner || (ps.CurrentUserId == _currentUserId && (ps.AssignmentStatus == "ACCEPTED" || ps.AssignmentStatus == "NONE"));
        string? generalAssignedName = (ps.CurrentUserId != ps.OwnerUserId) ? ps.CurrentUserName : null;

        _leadFlowInstances.TryGetValue(ps.IdPresale, out var flowInst);

        // 1. Si aún no ha cargado la instancia del FlowEngine
        if (flowInst == null)
        {
            return new CheckpointWindowVm
            {
                TotalSteps = 1,
                CurrentStepNum = 1,
                Current = new CheckpointWindowItem
                {
                    Id = 12,
                    Name = "Sincronizando...",
                    ShortName = "Sincronizando",
                    Icon = "bi-arrow-repeat",
                    IsCompleted = false,
                    IsCallable = false
                }
            };
        }

        // 2. Si el flujo está cerrado o el lead está descartado / KO definitivo
        if (flowInst.Status == "CLOSED" || ps.IsClosed || ps.IdStatus == 4 || ps.DiscardedAt != null || !string.IsNullOrEmpty(ps.DiscardReason))
        {
            var lastKoCp = flowInst.Checkpoints.LastOrDefault(c => c.Status == "KO" || c.Status == "RESOLVED") ?? flowInst.Checkpoints.LastOrDefault();
            int closedCpId = (int)(lastKoCp?.IdCheckpoint ?? 12);
            string cpName = lastKoCp?.Name ?? $"Checkpoint #{closedCpId}";
            string shortName = GetShortName(closedCpId, cpName);
            string closedReason = ps.DiscardReason ?? "KO / No Contesta";

            return new CheckpointWindowVm
            {
                TotalSteps = 1,
                CurrentStepNum = 1,
                Current = new CheckpointWindowItem
                {
                    Id = closedCpId,
                    Name = $"{cpName} — Cerrado por {closedReason}",
                    ShortName = $"{shortName} ({closedReason})",
                    Icon = "bi-x-circle-fill text-danger",
                    IsCompleted = true,
                    IsCallable = false,
                    IsPendingAccept = false,
                    ConfirmedStepsTooltip = $"Gestión finalizada en {shortName} y cerrada definitivamente por {closedReason}."
                },
                Previous = null,
                Next = null
            };
        }

        // 3. Mapear checkpoints activos entregados por FlowEngine ordenados rigurosamente por Etapa y Orden de Ejecución
        var allCps = flowInst.Checkpoints
            .OrderBy(c => c.OpenedAtStage ?? c.TriggerStageId ?? flowInst.CurrentStageId)
            .ThenBy(c => c.ExecutionOrder)
            .ThenBy(c => c.IdCpInstance)
            .ToList();

        var prevCp = allCps.LastOrDefault(c => c.Status == "APPROVED" || c.Status == "RESOLVED");
        var currCp = allCps.FirstOrDefault(c => c.Status == "PENDING") ?? allCps.LastOrDefault();

        if (currCp == null)
        {
            return new CheckpointWindowVm
            {
                TotalSteps = 1,
                CurrentStepNum = 1,
                Current = new CheckpointWindowItem
                {
                    Id = 11,
                    Name = "Flujo al día",
                    ShortName = "Al Día",
                    Icon = "bi-check2-all text-success",
                    IsCompleted = true,
                    IsCallable = false
                }
            };
        }

        int currIndex = allCps.IndexOf(currCp);

        // Checkpoint Anterior: el inmediatamente previo en la secuencia ordenada
        CheckpointWindowItem? prevItem = null;
        if (currIndex > 0)
        {
            var pCp = allCps[currIndex - 1];
            prevItem = new CheckpointWindowItem
            {
                Id = (int)pCp.IdCheckpoint,
                Name = pCp.Name,
                ShortName = GetShortName(pCp.IdCheckpoint, pCp.Name),
                Icon = GetIconForCp(pCp.IdCheckpoint),
                IsCompleted = pCp.Status == "APPROVED" || pCp.Status == "RESOLVED",
                IsCallable = false,
                IsPendingAccept = false,
                AssignedAdvisorName = generalAssignedName
            };
        }
        else if (prevCp != null && prevCp.IdCpInstance != currCp.IdCpInstance)
        {
            prevItem = new CheckpointWindowItem
            {
                Id = (int)prevCp.IdCheckpoint,
                Name = prevCp.Name,
                ShortName = GetShortName(prevCp.IdCheckpoint, prevCp.Name),
                Icon = GetIconForCp(prevCp.IdCheckpoint),
                IsCompleted = true,
                IsCallable = false,
                IsPendingAccept = false,
                AssignedAdvisorName = generalAssignedName
            };
        }

        // Checkpoint Actual
        int currId = (int)currCp.IdCheckpoint;
        string currName = currCp.Name;
        bool isVentaStage = currId == 16 || currCp.TriggerStageId == 13 || currCp.OpenedAtStage == 13 || currCp.Code == "CP_TEL_016" || flowInst.CurrentStageId >= 13;
        string currShortName = isVentaStage && currId == 16 ? "Ficha Venta" : GetShortName(currId, currName);
        string currIcon = isVentaStage && currId == 16 ? "bi-person-vcard-fill" : GetIconForCp(currId);
        bool isPendingAcc = ps.AssignmentStatus == "PENDING_ACCEPT" && ps.CurrentUserId == _currentUserId;

        var confirmedStepsText = currCp.Steps.Any(s => s.IsCompleted)
            ? "Pasos completados: " + string.Join(" | ", currCp.Steps.Where(s => s.IsCompleted).Select(s => $"\u2713 {s.Name}"))
            : $"Hacer clic para ejecutar {currShortName}";

        var currItem = new CheckpointWindowItem
        {
            Id = isVentaStage && currId == 16 ? 16 : currId,
            Name = currName,
            ShortName = currShortName,
            Icon = currIcon,
            IsCompleted = false,
            IsCallable = hasGlobalPermission && currCp.Status == "PENDING" && !isPendingAcc,
            IsPendingAccept = isPendingAcc,
            AssignedAdvisorName = generalAssignedName,
            ConfirmedStepsTooltip = confirmedStepsText
        };

        // Checkpoint Siguiente: el inmediatamente siguiente en la secuencia ordenada
        CheckpointWindowItem? nextItem = null;
        if (currIndex >= 0 && currIndex < allCps.Count - 1)
        {
            var nCp = allCps[currIndex + 1];
            nextItem = new CheckpointWindowItem
            {
                Id = (int)nCp.IdCheckpoint,
                Name = nCp.Name,
                ShortName = GetShortName(nCp.IdCheckpoint, nCp.Name),
                Icon = GetIconForCp(nCp.IdCheckpoint),
                IsCompleted = false,
                IsCallable = false,
                IsPendingAccept = false,
                AssignedAdvisorName = generalAssignedName
            };
        }

        return new CheckpointWindowVm
        {
            TotalSteps = Math.Max(allCps.Count, 1),
            CurrentStepNum = currIndex >= 0 ? currIndex + 1 : 1,
            Current = currItem,
            Previous = prevItem,
            Next = nextItem
        };
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var idUserClaim = user.FindFirst(c => c.Type == "id_user" || c.Type == System.Security.Claims.ClaimTypes.NameIdentifier);
            if (idUserClaim != null && int.TryParse(idUserClaim.Value, out int uid))
            {
                _currentUserId = uid;
            }
            _currentUserName = user.Identity.Name ?? user.FindFirst("name")?.Value ?? user.FindFirst("preferred_username")?.Value ?? "";
        }

        await LoadDataAsync();

        // Iniciar Polling Reactivo cada 5 segundos para Alertas y Handshakes
        _pollingTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadDataAsync(silent: true);
                StateHasChanged();
            });
        }, null, 5000, 5000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("nyxAlertSystem.checkAndPromptPermissions");
            }
            catch { }
        }
    }

    private async Task LoadDataAsync(bool silent = false)
    {
        if (!silent) _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");

            if (!silent)
            {
                try
                {
                    var stages = await client.GetFromJsonAsync<List<StageLookupDto>>("/api/engines/flow/stages");
                    if (stages != null && stages.Any())
                    {
                        var distinctStages = stages
                            .GroupBy(s => s.OrderIndex)
                            .Select(g => g.Last())
                            .OrderBy(s => s.OrderIndex)
                            .ToList();
                        _flowStages = distinctStages;
                    }
                }
                catch { }

                try
                {
                    var cmpList = await client.GetFromJsonAsync<List<CampaignLookupDto>>("/api/campaigns");
                    if (cmpList != null && cmpList.Any()) _campaigns = cmpList;
                }
                catch { }

                try
                {
                    var advList = await client.GetFromJsonAsync<List<AdvisorLookupDto>>("/api/campaigns/advisors");
                    if (advList != null) _advisors = advList;
                }
                catch { }

                try
                {
                    var catalog = await client.GetFromJsonAsync<List<FullCatalogItemDto>>("/api/engines/flow/catalogs/full");
                    if (catalog != null) _allCheckpointsCatalog = catalog;
                }
                catch { }
            }

            // Consultar Pre-Ventas
            var presales = await client.GetFromJsonAsync<List<PreSaleDto>>($"/api/presales?userId={_currentUserId}");
            if (presales != null)
            {
                _allPreSales = presales.OrderByDescending(p => p.Register).ToList();

                // Sincronizar FlowInstances de las pre-ventas
                if (_allPreSales.Any())
                {
                    var flowTasks = _allPreSales.Select(async ps =>
                    {
                        try
                        {
                            var fi = await client.GetFromJsonAsync<FlowInstanceDetailDto>($"/api/engines/flow/instances/by-entity/lead_presale/{ps.IdPresale}/detail");
                            if (fi != null)
                            {
                                lock (_leadFlowInstances)
                                {
                                    _leadFlowInstances[ps.IdPresale] = fi;
                                }
                            }
                            else
                            {
                                var startResponse = await client.PostAsJsonAsync("/api/engines/flow/instances/start", new 
                                { 
                                    flowCode = "PIPELINE_TELECOM", 
                                    entityType = "lead_presale", 
                                    entityId = ps.IdPresale,
                                    actorId = _currentUserId
                                });
                                if (startResponse.IsSuccessStatusCode)
                                {
                                    var detailRes = await client.GetAsync($"/api/engines/flow/instances/by-entity/lead_presale/{ps.IdPresale}/detail");
                                    if (detailRes.IsSuccessStatusCode)
                                    {
                                        var detail = await detailRes.Content.ReadFromJsonAsync<FlowInstanceDetailDto>();
                                        if (detail != null)
                                        {
                                            var cp11 = detail.Checkpoints.FirstOrDefault(c => c.IdCheckpoint == 11 && c.Status == "PENDING");
                                            if (cp11 != null)
                                            {
                                                await client.PostAsJsonAsync($"/api/engines/flow/checkpoints/instances/{cp11.IdCpInstance}/resolve", new { status = "APPROVED", actorId = _currentUserId });
                                                detail = await client.GetFromJsonAsync<FlowInstanceDetailDto>($"/api/engines/flow/instances/by-entity/lead_presale/{ps.IdPresale}/detail");
                                            }
                                            if (detail != null)
                                            {
                                                lock (_leadFlowInstances)
                                                {
                                                    _leadFlowInstances[ps.IdPresale] = detail;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        catch { }
                    });
                    await Task.WhenAll(flowTasks);
                }
            }

            // Detectar si hay Handshakes Entrantes Pendientes de Aceptación para este Usuario
            var pending = _allPreSales.FirstOrDefault(p => 
                p.CurrentUserId == _currentUserId && 
                p.OwnerUserId != _currentUserId && 
                p.AssignmentStatus == "PENDING_ACCEPT");

            if (pending != null)
            {
                if (_incomingHandshake?.IdPresale != pending.IdPresale)
                {
                    _incomingHandshake = pending;
                    _showRejectReasonInput = false;
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("nyxAlertSystem.playUrgentAlarm");
                        await JSRuntime.InvokeVoidAsync("nyxAlertSystem.startUrgentBlinking", $"⚡ DERIVACIÓN DE #{pending.OwnerUserName}");
                    }
                    catch { }
                }
            }
            else
            {
                if (_incomingHandshake != null)
                {
                    _incomingHandshake = null;
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("nyxAlertSystem.stopUrgentBlinking");
                    }
                    catch { }
                }
            }

            if (!silent)
            {
                try
                {
                    var orders = await SalesOrderService.GetOrdersAsync(_currentUserId);
                    if (orders != null) _orders = orders.OrderByDescending(o => o.Register).ToList();
                }
                catch { }
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            if (!silent) Snackbar.Add($"Error al sincronizar: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (!silent) _isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var temp = _allPreSales.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_filterText))
        {
            var txt = _filterText.Trim();
            temp = temp.Where(p => (p.FirstName != null && p.FirstName.Contains(txt, StringComparison.OrdinalIgnoreCase))
                                || (p.LastName != null && p.LastName.Contains(txt, StringComparison.OrdinalIgnoreCase))
                                || (p.Phone != null && p.Phone.Contains(txt, StringComparison.OrdinalIgnoreCase))
                                || p.IdPresale.ToString().Contains(txt));
        }

        if (_filterCampaignId > 0)
        {
            temp = temp.Where(p => p.IdCmpg == _filterCampaignId);
        }

        if (_filterYear > 0)
        {
            // Filtrar por año usando la fecha de última actividad (o registro si no tiene actividad)
            temp = temp.Where(p => (p.LastActivityAt ?? p.Register).Year == _filterYear);
        }

        if (_filterMonth > 0)
        {
            // Filtrar por mes usando la fecha de última actividad (o registro si no tiene actividad)
            temp = temp.Where(p => (p.LastActivityAt ?? p.Register).Month == _filterMonth);
        }

        // Ordenar por fecha de cambio más reciente descendente
        _filteredPreSales = temp.OrderByDescending(p => p.LastActivityAt ?? p.Register).ToList();
    }

    // --- ACCIONES DE DERIVACIÓN Y HANDSHAKE ---
    private void OpenAssignModal(PreSaleDto ps)
    {
        _selectedPreSale = ps;
        _selectedAssigneeId = 0;
        _assignContext = "";
        _showAssignModal = true;
    }

    private async Task SendHandshakeAssignment()
    {
        if (_selectedPreSale == null || _selectedAssigneeId <= 0) return;
        _isSaving = true;
        try
        {
            int callStep = !_selectedPreSale.Call1Completed ? 1 : !_selectedPreSale.Call2Completed ? 2 : 3;
            var client = HttpClientFactory.CreateClient("BackendApi");
            var payload = new
            {
                ToUserId = _selectedAssigneeId,
                CallStep = callStep,
                Context = _assignContext
            };

            var response = await client.PostAsJsonAsync($"/api/presales/{_selectedPreSale.IdPresale}/assign-step?userId={_currentUserId}", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Derivación enviada con solicitud de confirmación obligatoria.", Severity.Success);
                _showAssignModal = false;
                await LoadDataAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al derivar: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AcceptIncomingHandshake()
    {
        if (_incomingHandshake == null) return;
        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.PostAsJsonAsync($"/api/presales/{_incomingHandshake.IdPresale}/accept-assignment?userId={_currentUserId}", new { });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Gestión aceptada con éxito! Puedes proceder a realizar la llamada.", Severity.Success);
                var acceptedPs = _incomingHandshake;
                _incomingHandshake = null;
                try { await JSRuntime.InvokeVoidAsync("nyxAlertSystem.stopUrgentBlinking"); } catch { }
                await LoadDataAsync();

                // Abrir automáticamente el modal de llamada para máxima agilidad
                int step = !acceptedPs.Call1Completed ? 12 : !acceptedPs.Call2Completed ? 13 : 14;
                string stepName = step == 12 ? "Preventa — 1ª Llamada" : step == 13 ? "Preventa — 2ª Llamada" : "Preventa — 3ª Llamada";
                OpenCheckpointActionModal(acceptedPs, step, stepName);
            }
            else
            {
                Snackbar.Add("Error al aceptar asignación.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void PromptRevertModal(PreSaleDto ps)
    {
        _selectedPreSale = ps;
        _revertContext = "Devolución voluntaria de gestión al propietario original";
        _showRevertModal = true;
    }

    private async Task SubmitRejectAssignment()
    {
        if (_incomingHandshake == null) return;
        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var payload = new { Reason = _rejectReason };
            var response = await client.PostAsJsonAsync($"/api/presales/{_incomingHandshake.IdPresale}/reject-assignment?userId={_currentUserId}", payload);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Derivación rechazada. La pre-venta ha regresado al propietario.", Severity.Info);
                _incomingHandshake = null;
                _showRejectReasonInput = false;
                try { await JSRuntime.InvokeVoidAsync("nyxAlertSystem.stopUrgentBlinking"); } catch { }
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("Error al rechazar asignación.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CancelAssignment(long idPresale)
    {
        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.PostAsJsonAsync($"/api/presales/{idPresale}/cancel-assignment?userId={_currentUserId}", new { });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Derivación cancelada. Has recuperado la titularidad completa.", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al cancelar derivación: {err}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SubmitRevertAssignment()
    {
        if (_selectedPreSale == null) return;
        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var payload = new { Context = _revertContext };
            var response = await client.PostAsJsonAsync($"/api/presales/{_selectedPreSale.IdPresale}/revert-assignment?userId={_currentUserId}", payload);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Gestión devuelta al propietario original con éxito. Toda la bitácora previa se mantiene intacta.", Severity.Success);
                _showRevertModal = false;
                await LoadDataAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al devolver gestión: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
