    private void OnIbanInput(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? "").ToUpper().Replace(" ", "").Replace("-", "");
        
        // Auto-formatear en grupos de 4 (ESXX XXXX XXXX XXXX XXXX XXXX)
        var formatted = "";
        for (int i = 0; i < raw.Length; i++)
        {
            if (i > 0 && i % 4 == 0) formatted += " ";
            formatted += raw[i];
        }
        _ventaForm.Iban = formatted;

        // Auto-detectar banco español a partir del código de 4 dígitos (posiciones 4..7)
        if (raw.StartsWith("ES") && raw.Length >= 8)
        {
            var bankCode = raw.Substring(4, 4);
            var detectedBank = bankCode switch
            {
                "2100" => "CaixaBank",
                "0049" => "Banco Santander",
                "0182" => "BBVA",
                "0081" => "Banco Sabadell",
                "0128" => "Bankinter",
                "1465" => "ING",
                "2103" => "Unicaja",
                _ => null
            };
            if (!string.IsNullOrEmpty(detectedBank))
            {
                _ventaForm.BankName = detectedBank;
            }
        }
    }

    private decimal CalculateMonthlyQuote()
    {
        if (string.IsNullOrWhiteSpace(_ventaForm.TechSpeed)) return 0.00m;

        decimal basePrice = _techSpeedOptions.FirstOrDefault(t => t.Value == _ventaForm.TechSpeed)?.Price ?? 0m;

        if (int.TryParse(_ventaForm.ExtraLines, out int extra) && extra > 0)
        {
            var extraPrice = _extraLinesOptions.FirstOrDefault(e => e.Value == _ventaForm.ExtraLines)?.Price ?? (extra * 10.00m);
            basePrice += extraPrice;
        }

        if (!string.IsNullOrEmpty(_ventaForm.TvPack) && _ventaForm.TvPack != "NONE")
        {
            var tvPrice = _tvPackOptions.FirstOrDefault(t => t.Value == _ventaForm.TvPack)?.Price ?? 0m;
            basePrice += tvPrice;
        }

        return basePrice;
    }

    // Validación Estricta de los 14 Pasos (No se marcan si el campo no tiene valor)
    private bool Step1_DocValid => !string.IsNullOrWhiteSpace(_ventaForm.DocType) && !string.IsNullOrWhiteSpace(_ventaForm.DocNumber) && _ventaForm.DocNumber.Trim().Length >= 6;
    private bool Step2_BirthDateValid => _ventaForm.BirthDate.HasValue;
    private bool Step3_FirstNameValid => !string.IsNullOrWhiteSpace(_ventaForm.FirstName);
    private bool Step4_LastNameValid => !string.IsNullOrWhiteSpace(_ventaForm.LastName);
    private bool Step5_EmailValid => !string.IsNullOrWhiteSpace(_ventaForm.Email) && _ventaForm.Email.Contains("@") && _ventaForm.Email.Contains(".");
    private bool Step6_ClientTypeValid => !string.IsNullOrWhiteSpace(_ventaForm.ClientType);
    private bool Step7_ContractTypeValid => !string.IsNullOrWhiteSpace(_ventaForm.ContractType);
    private bool Step8_CurrentOperatorValid => !string.IsNullOrWhiteSpace(_ventaForm.CurrentOperator);
    private bool Step9_AddressValid => !string.IsNullOrWhiteSpace(_ventaForm.StreetAddress);
    private bool Step10_PostalCityValid => !string.IsNullOrWhiteSpace(_ventaForm.PostalCode) && !string.IsNullOrWhiteSpace(_ventaForm.City);
    private bool Step11_ContactPhoneValid => !string.IsNullOrWhiteSpace(_ventaForm.ContactPhone) && _ventaForm.ContactPhone.Trim().Length >= 9;
    private bool Step12_MainMobileValid => !string.IsNullOrWhiteSpace(_ventaForm.MainMobile) && _ventaForm.MainMobile.Trim().Length >= 9;
    private bool Step13_OfferValid => !string.IsNullOrWhiteSpace(_ventaForm.TargetOperator) && !string.IsNullOrWhiteSpace(_ventaForm.TechSpeed);
    private bool Step14_IbanValid => !string.IsNullOrWhiteSpace(_ventaForm.Iban) && _ventaForm.Iban.Replace(" ", "").Length >= 18;

    private int CompletedVentaStepsCount =>
        (Step1_DocValid ? 1 : 0) +
        (Step2_BirthDateValid ? 1 : 0) +
        (Step3_FirstNameValid ? 1 : 0) +
        (Step4_LastNameValid ? 1 : 0) +
        (Step5_EmailValid ? 1 : 0) +
        (Step6_ClientTypeValid ? 1 : 0) +
        (Step7_ContractTypeValid ? 1 : 0) +
        (Step8_CurrentOperatorValid ? 1 : 0) +
        (Step9_AddressValid ? 1 : 0) +
        (Step10_PostalCityValid ? 1 : 0) +
        (Step11_ContactPhoneValid ? 1 : 0) +
        (Step12_MainMobileValid ? 1 : 0) +
        (Step13_OfferValid ? 1 : 0) +
        (Step14_IbanValid ? 1 : 0);

    private bool IsVentaFormComplete => CompletedVentaStepsCount == 14;

    private async Task SubmitVentaCreadaModal()
    {
        if (!IsVentaFormComplete)
        {
            Snackbar.Add("⚠ Debes completar todos los 14 pasos obligatorios de la Ficha de Venta antes de continuar.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");

            // 1. Guardar log de llamada y datos completados
            var logNote = $"[CP #16 Ficha de Venta Completada (14/14)]: Venta formalizada con cuota mensual de {CalculateMonthlyQuote():F2} €/mes. IBAN: {_ventaForm.Iban}. Operador destino: {_ventaForm.TargetOperator}.";
            await client.PostAsJsonAsync($"/api/presales/{_ventaForm.IdPresale}/calls", new 
            { 
                CallLog = logNote,
                TargetOperator = _ventaForm.TargetOperator,
                CompletedSteps = new[] { "14 pasos de CP #16 verificados y aprobados" },
                Result = "VENTA_FORMALIZADA_OK"
            });

            // 2. Convertir y formalizar pre-venta a lead / orden
            var convertResponse = await client.PostAsJsonAsync($"/api/presales/{_ventaForm.IdPresale}/convert", new { UserId = _currentUserId });

            // 3. Sincronizar en Nyx.FlowEngine
            try
            {
                var flowInstResponse = await client.GetAsync($"/api/engines/flow/instances/by-entity/lead_presale/{_ventaForm.IdPresale}/detail");
                if (flowInstResponse.IsSuccessStatusCode)
                {
                    var flowInst = await flowInstResponse.Content.ReadFromJsonAsync<FlowInstanceDetailDto>();
                    if (flowInst != null)
                    {
                        var cp16Inst = flowInst.Checkpoints.FirstOrDefault(c => c.IdCheckpoint == 16 && c.Status == "PENDING");
                        if (cp16Inst != null)
                        {
                            await client.PostAsJsonAsync($"/api/engines/flow/checkpoints/instances/{cp16Inst.IdCpInstance}/resolve", new
                            {
                                status = "APPROVED",
                                actorId = _currentUserId
                            });
                        }
                    }
                }
            }
            catch { }

            Snackbar.Add("🎉 ¡Ficha de Venta (CP #16) completada y venta creada exitosamente!", Severity.Success);
            _showVentaCreadaModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error formalizando venta: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

