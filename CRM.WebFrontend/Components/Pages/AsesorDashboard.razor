            {
                var flowInst = await flowInstResponse.Content.ReadFromJsonAsync<FlowInstanceDetailDto>();
                if (flowInst != null && flowInst.CurrentStageId > 0)
                {
                    currentStageId = flowInst.CurrentStageId;
                    lock (_leadFlowInstances)
                    {
                        _leadFlowInstances[ps.IdPresale] = flowInst;
                    }
                }
            }
        }
        catch { }

        _activeLeadStageId = currentStageId;
        _selectedStageForTracking = _flowStages.FirstOrDefault(s => s.IdStage == currentStageId) 
            ?? _flowStages.FirstOrDefault(s => s.Name.Equals("Preventa", StringComparison.OrdinalIgnoreCase)) 
            ?? _flowStages.FirstOrDefault();

        SelectStageForTracking(_selectedStageForTracking);
        _showTimelineModal = true;
    }

    private void SelectStageForTracking(StageLookupDto? stage)
    {
        _selectedStageForTracking = stage;
        if (stage != null)
        {
            _stageCheckpoints = _allCheckpointsCatalog
                .Where(c => c.TriggerStageId == stage.IdStage 
                         || (c.StageName != null && c.StageName.Equals(stage.Name, StringComparison.OrdinalIgnoreCase)))
                .OrderBy(c => c.ExecutionOrder)
                .ThenBy(c => c.IdCheckpoint)
                .ToList();
        }
        else
        {
            _stageCheckpoints = new();
        }
    }

    private void ResetToCurrentStage()
    {
        var currentStage = _flowStages.FirstOrDefault(s => s.IdStage == _activeLeadStageId) 
            ?? _flowStages.FirstOrDefault(s => s.Name.Equals("Preventa", StringComparison.OrdinalIgnoreCase)) 
            ?? _flowStages.FirstOrDefault();
        SelectStageForTracking(currentStage);
    }

    private async Task ConvertToOrder(long idPresale)
    {
        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.PostAsJsonAsync($"/api/presales/{idPresale}/convert", new { });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                if (result.TryGetProperty("leadId", out var leadIdElement) && leadIdElement.TryGetInt64(out long leadId))
                {
                    Snackbar.Add("¡Pre-venta convertida a Orden de Venta exitosamente!", Severity.Success);
                    NavigationManager.NavigateTo($"/asesor/orders/new?leadId={leadId}");
                }
                else
                {
                    await LoadDataAsync();
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al convertir: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

