    private void StartMemoAutoRefresh()
    {
        StopMemoAutoRefresh();
        if (!_isEditing || _currentPreSale.IdPresale <= 0) return;

        _memoSyncCts = new System.Threading.CancellationTokenSource();
        var token = _memoSyncCts.Token;

        _ = Task.Run(async () =>
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(1500));
            try
            {
                while (!token.IsCancellationRequested && await periodicTimer.WaitForNextTickAsync(token))
                {
                    if (!_showNewModal || _isSaving) continue;
                    
                    await InvokeAsync(async () =>
                    {
                        if (_showNewModal && !_isSaving)
                        {
                            await RefreshMemoDataAsync();
                        }
                    });
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                Console.WriteLine($"[MemoSync] Error en ciclo de sincronización: {ex.Message}");
            }
        }, token);
    }

    private void StopMemoAutoRefresh()
    {
        try
        {
            _memoSyncCts?.Cancel();
            _memoSyncCts?.Dispose();
        }
        catch { }
        finally
        {
            _memoSyncCts = null;
        }
    }

    private async Task RefreshMemoDataAsync()
    {
        if (_isSyncingMemo || _currentPreSale.IdPresale <= 0 || _isSaving || !_showNewModal) return;
        _isSyncingMemo = true;

        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var remote = await client.GetFromJsonAsync<PreSaleDto>($"/api/presales/{_currentPreSale.IdPresale}");
            if (remote != null)
            {
                bool notesChanged = !string.Equals(_currentPreSale.Notes?.Trim(), remote.Notes?.Trim(), StringComparison.Ordinal);
                bool addressChanged = !string.Equals(_currentPreSale.Address?.Trim(), remote.Address?.Trim(), StringComparison.Ordinal);
                bool provinceChanged = !string.Equals(_currentPreSale.Province?.Trim(), remote.Province?.Trim(), StringComparison.Ordinal);
                bool dniChanged = !string.Equals(_currentPreSale.Dni?.Trim(), remote.Dni?.Trim(), StringComparison.Ordinal);
                bool operatorChanged = !string.Equals(_currentPreSale.Operator?.Trim(), remote.Operator?.Trim(), StringComparison.Ordinal);
                bool targetOperatorChanged = !string.Equals(_currentPreSale.TargetOperator?.Trim(), remote.TargetOperator?.Trim(), StringComparison.Ordinal);
                bool anyFieldChanged = notesChanged || addressChanged || provinceChanged || dniChanged || operatorChanged || targetOperatorChanged;

                if (anyFieldChanged)
                {
                    bool isUserActivelyTyping = (DateTime.Now - _lastUserTypingTime) < TimeSpan.FromSeconds(2);
                    if (!isUserActivelyTyping)
                    {
                        _currentPreSale.Notes = remote.Notes;
                        _currentPreSale.Address = remote.Address;
                        _currentPreSale.Province = remote.Province;
                        _currentPreSale.Dni = remote.Dni;
                        _currentPreSale.Operator = remote.Operator;
                        _currentPreSale.TargetOperator = remote.TargetOperator;
                        _currentPreSale.FirstName = remote.FirstName;
                        _currentPreSale.LastName = remote.LastName;
                        _currentPreSale.Phone = remote.Phone;
                        _currentPreSale.SecondaryPhone = remote.SecondaryPhone;
                        _remoteNotesNotice = "";
                        _pendingRemoteNotes = "";
                        _lastMemoSync = DateTime.Now;
                        StateHasChanged();
                    }
                    else
                    {
                        _pendingRemoteNotes = remote.Notes ?? "";
                        _remoteNotesNotice = "Se detectaron cambios recientes en el servidor.";
                        _lastMemoSync = DateTime.Now;
                        StateHasChanged();
                    }
                }
            }
        }
        catch { }
        finally
        {
            _isSyncingMemo = false;
        }
    }

