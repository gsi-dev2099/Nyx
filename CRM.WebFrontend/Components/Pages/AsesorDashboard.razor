@page "/asesor"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ASESOR")]
@using CRM.WebFrontend.Services
@using CRM.WebFrontend.Client.Models
@inject ISalesOrderService SalesOrderService
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Bandeja del Asesor - NYX CRM</PageTitle>

<style>
    .asesor-hero-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 24px 28px;
        box-shadow: 0 10px 30px -5px rgba(29, 38, 57, 0.05);
        border: none;
    }
    
    .asesor-kpi-card {
        background: rgba(244, 245, 247, 0.85);
        border-radius: 20px;
        padding: 20px;
        border: none;
        box-shadow: 0 4px 12px -2px rgba(29, 38, 57, 0.03);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .asesor-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -4px rgba(29, 38, 57, 0.08);
    }
    
    .kpi-icon-wrapper {
        width: 44px;
        height: 44px;
        border-radius: 16px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        color: #1D2639;
        flex-shrink: 0;
    }

    .asesor-cta-btn {
        background: #1D2639;
        color: #ffffff;
        border-radius: 9999px;
        padding: 10px 20px;
        font-size: 0.85rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        text-decoration: none;
        transition: all 0.25s ease;
        box-shadow: 0 8px 20px -4px rgba(29, 38, 57, 0.25);
    }

    .asesor-cta-btn:hover {
        background: #465975;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 12px 25px -4px rgba(29, 38, 57, 0.35);
    }

    .table-card {
        background: #ffffff;
        border-radius: 24px;
        border: none;
        box-shadow: 0 10px 30px -5px rgba(29, 38, 57, 0.05);
        overflow: hidden;
    }

    .table-modern thead th {
        background: #F8FAFC;
        color: #64748B;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 14px 18px;
        border-bottom: 1px solid #E2E8F0;
    }

    .table-modern tbody tr {
        transition: background-color 0.2s ease;
    }

    .table-modern tbody tr:hover {
        background-color: #F1F5F9;
    }

    .table-modern tbody td {
        padding: 14px 18px;
        font-size: 0.88rem;
        color: #1E293B;
        vertical-align: middle;
        border-bottom: 1px solid #F1F5F9;
    }

    .badge-status {
        border-radius: 9999px;
        padding: 5px 12px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .action-btn-quick {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        border: none;
        background: #F1F5F9;
        color: #475569;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .action-btn-quick:hover {
        background: #1D2639;
        color: #ffffff;
    }

    .nav-tabs-custom .nav-link {
        color: #64748B;
        font-weight: 700;
        font-size: 0.9rem;
        border: none;
        border-bottom: 2px solid transparent;
        border-radius: 0;
        padding: 12px 22px;
        cursor: pointer;
    }

    .nav-tabs-custom .nav-link.active {
        color: #1D2639;
        border-bottom-color: #1D2639;
        background: transparent;
    }

    .product-pill {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 6px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .timeline-preview-card {
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        min-width: 145px;
    }

    .timeline-preview-card:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }
    
    .timeline-stage-title {
        font-size: 0.72rem;
        font-weight: 700;
        color: #1E293B;
        letter-spacing: -0.2px;
        display: block;
        margin-bottom: 8px;
    }

    /* Animated Mini Dots for Preview */
    .mini-timeline-track {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        padding: 4px 0;
        margin-bottom: 6px;
    }
    
    .mini-timeline-track::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 2px;
        background: #E2E8F0;
        transform: translateY(-50%);
        z-index: 1;
        border-radius: 2px;
    }

    .mini-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #CBD5E1;
        z-index: 2;
        position: relative;
        transition: all 0.3s ease;
    }

    .mini-dot.done {
        background: #B98B36;
    }

    .mini-dot.current {
        background: #D9A441;
        box-shadow: 0 0 0 3px rgba(217, 164, 65, 0.3);
        animation: pulse-dot 1.5s infinite;
        transform: scale(1.2);
    }

    @@keyframes pulse-dot {
        0% { box-shadow: 0 0 0 0 rgba(217, 164, 65, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(217, 164, 65, 0); }
        100% { box-shadow: 0 0 0 0 rgba(217, 164, 65, 0); }
    }

    /* Stage Strip Styles from Prototype for Modal */
    .stage-strip { display: flex; align-items: center; justify-content: space-between; position: relative; padding: 20px 0; }
    .stage-dot-wrap { display: flex; flex-direction: column; align-items: center; position: relative; z-index: 2; flex: 1; }
    .stage-dot { width: 14px; height: 14px; border-radius: 50%; background: #F1F5F9; border: 2px solid #CBD5E1; transition: all 0.25s ease; }
    .stage-dot.done { background: #94A3B8; border-color: #94A3B8; opacity: 0.38; box-shadow: none; }
    .stage-dot.current { background: #0F172A; border: 3px solid #38BDF8; width: 18px; height: 18px; box-shadow: 0 0 0 5px rgba(56, 189, 248, 0.25); z-index: 3; }
    .stage-line { position: absolute; top: 6px; left: 50%; width: 100%; height: 2px; background: #E2E8F0; z-index: 1; }
    .stage-line.done { background: #CBD5E1; opacity: 0.4; }
    .stage-dot-wrap:last-child .stage-line { display: none; }
    .stage-label { font-size: 0.65rem; margin-top: 8px; text-align: center; color: #94A3B8; max-width: 85px; line-height: 1.2; text-transform: uppercase; font-weight: 600; }
    .stage-label.done { color: #94A3B8; opacity: 0.45; font-weight: 500; }
    .stage-label.current { color: #0F172A; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.3px; opacity: 1; }
</style>

<div class="container-fluid py-4 space-y-4">
    
    <!-- Hero Banner & Resumen del Asesor (Sin Redirecciones Innecesarias) -->
    <div class="asesor-hero-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="h3 font-extrabold text-dark tracking-tight mb-1" style="color: #1D2639;">Bandeja del Asesor</h1>
                <p class="text-muted small mb-0 font-medium">Gestión unificada e interactiva de Pre-Ventas y Órdenes bajo tu custodia en un solo lugar.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-dark rounded-pill px-3 font-semibold" @onclick="OpenNewPreSaleModal">
                    <i class="bi bi-funnel me-1"></i> + Nueva Pre-Venta
                </button>
                <a href="/asesor/orders/new" class="asesor-cta-btn">
                    <i class="bi bi-plus-lg fs-6"></i>
                    <span>+ Nueva Orden</span>
                </a>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="asesor-kpi-card">
                    <div>
                        <span class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Pre-Ventas Activas</span>
                        <span class="fs-3 fw-bold" style="color: #1D2639;">@_preSalesList.Count</span>
                    </div>
                    <div class="kpi-icon-wrapper">
                        <i class="bi bi-telephone-inbound fs-5" style="color: #2563EB;"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="asesor-kpi-card">
                    <div>
                        <span class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Órdenes en Custodia</span>
                        <span class="fs-3 fw-bold" style="color: #1D2639;">@_orders.Count</span>
                    </div>
                    <div class="kpi-icon-wrapper">
                        <i class="bi bi-box-seam fs-5"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="asesor-kpi-card">
                    <div>
                        <span class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Ventas Aprobadas</span>
                        <span class="fs-3 fw-bold" style="color: #1D2639;">@_orders.Count(o => o.Status == "APPROVED")</span>
                    </div>
                    <div class="kpi-icon-wrapper">
                        <i class="bi bi-check-circle fs-5" style="color: #10B981;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestañas de Filtrado en la Misma Bandeja (Sin Saltos de Página) -->
    <ul class="nav nav-tabs nav-tabs-custom border-bottom mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "todas" ? "active" : "")" @onclick='() => _activeTab = "todas"'>
                <i class="bi bi-grid-fill me-2 text-primary"></i> Todas las Gestiones (@(_orders.Count + _preSalesList.Count))
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "ventas" ? "active" : "")" @onclick='() => _activeTab = "ventas"'>
                <i class="bi bi-cart-check me-2"></i> Mis Órdenes de Venta (@_orders.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "preventas" ? "active" : "")" @onclick='() => _activeTab = "preventas"'>
                <i class="bi bi-funnel me-2"></i> Mis Pre-Ventas (@_preSalesList.Count)
            </button>
        </li>
    </ul>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-dark" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span class="ms-3 text-muted fw-semibold">Cargando datos de la bandeja...</span>
        </div>
    }
    else
    {
        @if (_activeTab == "todas" || _activeTab == "preventas")
        {
            @if (_preSalesList.Any() || _activeTab == "preventas")
            {
                <div class="d-flex align-items-center justify-content-between mb-2 mt-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-funnel-fill text-primary me-2"></i> Pre-Ventas Activas (Etapa 1: Preventa)
                    </h6>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@_preSalesList.Count registradas</span>
                </div>

                <!-- TABLA DE PRE-VENTAS INTEGRADA DIRECTAMENTE EN EL DASHBOARD -->
                <div class="table-card mb-4">
                    <div class="table-responsive">
                        <table class="table table-hover table-modern align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">N° Pre-Venta</th>
                                    <th>DNI Cliente</th>
                                    <th>Cliente</th>
                                    <th>Teléfono</th>
                                    <th>Etapa Nyx Flow</th>
                                    <th>Operador / Notas</th>
                                    <th>Cobertura</th>
                                    <th class="text-end pe-4">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!_preSalesList.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4">
                                            <i class="bi bi-telephone-x text-muted display-6 d-block mb-2"></i>
                                            <h6 class="text-dark fw-bold mb-1">No hay pre-ventas activas</h6>
                                            <p class="text-muted small mb-0">Registra una nueva pre-venta para comenzar.</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var ps in _preSalesList)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold" style="color: #2563EB;">
                                                #@ps.IdPresale<br/>
                                                <small class="text-muted font-normal">@ps.Register.ToString("dd/MM/yyyy")</small>
                                            </td>
                                            <td>
                                                <code class="text-dark fw-bold" style="font-size: 0.82rem;">@(string.IsNullOrWhiteSpace(ps.Dni) ? "12345678Z" : ps.Dni)</code>
                                            </td>
                                            <td class="fw-semibold text-dark">
                                                @(string.IsNullOrWhiteSpace(ps.FirstName) && string.IsNullOrWhiteSpace(ps.LastName) ? "Cliente Interesado" : $"{ps.FirstName} {ps.LastName}".Trim())
                                            </td>
                                            <td class="fw-bold text-secondary">@ps.Phone</td>
                                            <td>
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-bold" style="font-size:0.75rem;">
                                                    📍 #1 — Preventa
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border mb-1">@ps.Operator</span><br/>
                                                <small class="text-muted truncate d-inline-block" style="max-width: 180px;">@ps.Notes</small>
                                            </td>
                                            <td>
                                                <span class="badge @(ps.CoverageStatus == "SI" ? "bg-success-subtle text-success" : ps.CoverageStatus == "NO" ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary") rounded-pill px-3">
                                                    @(ps.CoverageStatus == "SI" ? "Con Cobertura" : ps.CoverageStatus == "NO" ? "Sin Cobertura" : "Pendiente")
                                                </span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="btn-group">
                                                    <button class="btn btn-sm btn-outline-warning rounded-pill px-2.5 me-1 text-dark" @onclick="() => OpenAssignModal(ps.IdPresale)" title="Derivar a otro asesor">
                                                        <i class="bi bi-person-fill-gear me-1"></i> Derivar
                                                    </button>
                                                    <button class="btn btn-sm btn-success text-white rounded-pill px-3 shadow-sm" @onclick="() => ConvertToOrder(ps.IdPresale)" title="Convertir a Orden de Venta">
                                                        <i class="bi bi-cart-check-fill me-1"></i> Convertir a Venta
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (_activeTab == "todas" || _activeTab == "ventas")
        {
            @if (_activeTab == "todas")
            {
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-box-seam-fill text-primary me-2"></i> Órdenes de Venta en Custodia
                    </h6>
                    <span class="badge bg-dark rounded-pill px-3">@_orders.Count órdenes</span>
                </div>
            }

            <!-- TABLA DE VENTAS -->
            <div class="table-card mt-2 mb-4">
                <div class="table-responsive">
                    <table class="table table-hover table-modern align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">N° Orden</th>
                                <th>DNI Cliente</th>
                                <th>Cliente</th>
                                <th>Teléfono</th>
                                <th>Fecha Registro</th>
                                <th>Desglose de Productos</th>
                                <th>Ficha Alterna</th>
                                <th>Estado Proceso</th>
                                <th>Línea de Tiempo</th>
                                <th class="text-end pe-4">Ver Ficha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_orders.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5">
                                        <i class="bi bi-inbox text-muted display-6 d-block mb-2"></i>
                                        <h6 class="text-dark fw-bold mb-1">No tienes órdenes bajo tu custodia actualmente</h6>
                                        <p class="text-muted small mb-0">Comienza creando una pre-venta o nueva orden.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var order in _orders)
                                {
                                    <tr style="cursor: pointer;" @onclick="() => NavigateToDetail(order.IdOrder)">
                                        <td class="ps-4 fw-bold" style="color: #2563EB;">#@order.IdOrder</td>
                                        <td>
                                            <code class="text-dark fw-bold" style="font-size: 0.82rem;">@(string.IsNullOrWhiteSpace(order.CustomerDni) ? "12345678Z" : order.CustomerDni)</code>
                                        </td>
                                        <td class="fw-semibold text-dark">
                                            @(string.IsNullOrWhiteSpace(order.CustomerName) ? "Cliente Registrado" : order.CustomerName)
                                        </td>
                                        <td class="fw-bold text-secondary">
                                            @(string.IsNullOrWhiteSpace(order.CustomerPhone) ? "987654321" : order.CustomerPhone)
                                        </td>
                                        <td class="text-nowrap text-secondary small">@order.SalesDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td @onclick:stopPropagation="true" class="text-center">
                                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 font-bold text-dark shadow-sm" 
                                                    @onclick="() => ShowProductsModal(order)" title="Ver desglose detallado de productos">
                                                <i class="bi bi-box-seam me-1 text-primary"></i> @_getProductBreakdown(order).Count
                                            </button>
                                        </td>
                                        <td>
                                            <span class="badge @(order.IsAlternate ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success-emphasis") rounded-pill px-2.5">
                                                @(order.IsAlternate ? "Perfil Alterno" : "Perfil Estándar")
                                            </span>
                                        </td>
                                        <td>
                                            @if (order.IdStatus == 11 || order.Status == "INCIDENCIA" || (order.Status != null && order.Status.Contains("incidencia", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <span class="badge-status shadow-sm align-self-start" style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #DC2626; font-weight: 800;">
                                                    <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> ⚠️ EN CORRECCIÓN (Incidencia)
                                                </span>
                                            }
                                            else if (order.IdStatus == 2 || order.Status == "REVISION_SUPERVISOR")
                                            {
                                                <span class="badge-status shadow-sm align-self-start" style="background-color: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #D97706; font-weight: 700;">
                                                    <i class="bi bi-search text-warning me-1"></i> EN REVISIÓN SUPERVISOR
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-status align-self-start" style="background-color: @(order.Status == "APPROVED" || order.Status == "Activado" ? "rgba(16,185,129,0.12)" : "rgba(245,158,11,0.12)"); color: @(order.Status == "APPROVED" || order.Status == "Activado" ? "#10B981" : "#D97706");">
                                                    <span style="width: 6px; height: 6px; border-radius: 50%; background-color: @(order.Status == "APPROVED" || order.Status == "Activado" ? "#10B981" : "#D97706"); display: inline-block;"></span>
                                                    @(order.Status ?? "En Verificación")
                                                </span>
                                            }
                                        </td>
                                        <td @onclick:stopPropagation="true">
                                            <div class="timeline-preview-card" @onclick="() => OpenTimelineModal(order)" title="Click para ver la línea de tiempo completa">
                                                @{
                                                    var orderStages = GetStagesForOrder(order);
                                                    int currentIdx = GetCurrentStageIndex(order);
                                                    string stageName = currentIdx < orderStages.Count ? orderStages[currentIdx] : "Desconocida";
                                                }
                                                <span class="timeline-stage-title">@stageName</span>
                                                <div class="mini-timeline-track">
                                                    @for (int i = 0; i < orderStages.Count; i++)
                                                    {
                                                        bool isDone = i < currentIdx;
                                                        bool isCurrent = i == currentIdx;
                                                        <div class="mini-dot @(isDone ? "done" : "") @(isCurrent ? "current" : "")"></div>
                                                    }
                                                </div>
                                                <div class="mt-1 text-end">
                                                    <small class="text-muted" style="font-size: 0.62rem; font-weight: 600;">Etapa @(currentIdx + 1) de @orderStages.Count</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4" @onclick:stopPropagation="true">
                                            <button type="button" class="action-btn-quick" title="Ver Ficha Completa" @onclick="() => NavigateToDetail(order.IdOrder)">
                                                <i class="bi bi-file-earmark-text-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<!-- Modal: Productos Separados Individualmente -->
@if (_selectedProductsOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15,23,42,0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <span class="badge bg-primary-subtle text-primary fw-bold mb-1">Desglose de Productos por Separado</span>
