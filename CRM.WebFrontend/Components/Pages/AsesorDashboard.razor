<!-- Modal: Línea de Tiempo Completa con Checkpoints y Pasos -->
@if (_selectedTimelineOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-primary-subtle text-primary fw-bold mb-1">Progreso y Checkpoints Nyx Flow</span>
                        <h5 class="modal-title fw-bold text-dark">Orden #@_selectedTimelineOrder.IdOrder — @_selectedTimelineOrder.CustomerName</h5>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseTimelineModal"></button>
                </div>
                <div class="modal-body p-4 pt-2">
                    <p class="text-muted small mb-3">Haz clic en cualquier hito de la línea de tiempo para inspeccionar los checkpoints y pasos de esa etapa.</p>
                    
                    <div class="bg-light p-3 rounded-4 border mb-3">
                        <div class="stage-strip w-100">
                            @{
                                var modalStages = GetStagesForOrder(_selectedTimelineOrder);
                                int currentIdx = GetCurrentStageIndex(_selectedTimelineOrder);
                                int activeStageIdx = _selectedModalStageIndex >= 0 ? _selectedModalStageIndex : currentIdx;
                            }
                            @for (int i = 0; i < modalStages.Count; i++)
                            {
                                var stageIndex = i;
                                var stage = modalStages[i];
                                bool isDone = i < currentIdx;
                                bool isCurrent = i == currentIdx;
                                bool isSelected = i == activeStageIdx;

                                <div class="stage-dot-wrap" style="cursor:pointer;" @onclick="() => SelectModalStageIndex(stageIndex)" title="Ver checkpoints de @stage">
                                    <div class="stage-line @(isDone ? "done" : "")"></div>
                                    <div class="stage-dot @(isDone ? "done" : "") @(isCurrent ? "current" : "") @(isSelected ? "border-primary" : "")" style="@(isSelected && !isCurrent ? "border-width:3px; transform:scale(1.2);" : "")"></div>
                                    <div class="stage-label @(isDone ? "done" : "") @(isCurrent ? "current" : "") @(isSelected ? "text-primary fw-bold" : "")">@stage</div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- DESGLOSE DE CHECKPOINTS Y PASOS -->
                    @{
                        string activeStageName = activeStageIdx < modalStages.Count ? modalStages[activeStageIdx] : "Etapa";
                        var stageCheckpoints = GetCheckpointsForStageIndex(activeStageIdx);
                    }
                    <div class="p-3 bg-white rounded-3 border shadow-sm">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <div>
                                <span class="badge @(activeStageIdx == currentIdx ? "bg-primary text-white" : activeStageIdx < currentIdx ? "bg-success bg-opacity-10 text-success" : "bg-light text-muted border") rounded-pill px-3 mb-1" style="font-size:10px;">
                                    @(activeStageIdx == currentIdx ? "📍 Etapa Actual Activa" : activeStageIdx < currentIdx ? "✓ Etapa Superada" : "Etapa Futura")
                                </span>
                                <h6 class="fw-bold text-dark mb-0">📌 Checkpoints y Pasos: Etapa #@(activeStageIdx + 1) — @activeStageName</h6>
                            </div>
                            <span class="badge bg-light text-dark border rounded-pill px-3">@stageCheckpoints.Count checkpoints</span>
                        </div>

                        @if (!stageCheckpoints.Any())
                        {
                            <div class="text-center py-4 bg-light rounded-3">
                                <i class="bi bi-info-circle text-muted fs-4 d-block mb-1"></i>
                                <span class="text-muted small fw-semibold">No hay checkpoints obligatorios registrados en esta etapa.</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var cp in stageCheckpoints)
                                {
                                    <div class="card border mb-2 shadow-sm rounded-3 overflow-hidden @(cp.Status == "APROBADO" ? "border-success" : cp.Status == "RECHAZADO" ? "border-danger" : "border-secondary border-opacity-25")">
                                        <!-- Header Segmentado del Checkpoint -->
                                        <div class="card-header d-flex align-items-center justify-content-between py-2.5 px-3 @(cp.Status == "APROBADO" ? "bg-success bg-opacity-10" : cp.Status == "RECHAZADO" ? "bg-danger bg-opacity-10" : "bg-light")">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-dark text-white rounded-pill px-2.5" style="font-size:11px;">@cp.Code</span>
                                                <strong class="text-dark small me-2">@cp.Name</strong>
                                                @if (cp.BlocksAdvance)
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2" style="font-size:10px;">🛑 Bloqueante</span>
                                                }
                                                @if (!string.IsNullOrEmpty(cp.RollbackToStage))
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 rounded-pill px-2" style="font-size:10px;">↶ Retrocede a @cp.RollbackToStage</span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (cp.Status == "APROBADO")
                                                {
                                                    <span class="badge bg-success text-white rounded-pill px-3 py-1" style="font-size:11px;"><i class="bi bi-check-circle-fill me-1"></i> Checkpoint Aprobado</span>
                                                }
                                                else if (cp.Status == "RECHAZADO")
                                                {
                                                    <span class="badge bg-danger text-white rounded-pill px-3 py-1" style="font-size:11px;"><i class="bi bi-x-circle-fill me-1"></i> Checkpoint Rechazado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-3 py-1" style="font-size:11px;"><i class="bi bi-clock me-1"></i> Pendiente</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Cuerpo del Checkpoint: Pasos Secuenciales + Acciones Integradas -->
                                        <div class="card-body p-3">
                                            @if (cp.Steps != null && cp.Steps.Any())
                                            {
                                                <div class="mb-3">
                                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                                        <span class="fw-bold text-secondary" style="font-size:11px;">📋 Pasos Secuenciales del Checkpoint:</span>
                                                        <span class="badge bg-light text-dark border rounded-pill" style="font-size:10px;">@cp.CompletedStepsCount / @cp.Steps.Count Pasos</span>
                                                    </div>
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var step in cp.Steps)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between p-2 rounded border @(step.IsCompleted ? "bg-success bg-opacity-10 border-success border-opacity-25" : "bg-white border-secondary border-opacity-20")" style="font-size:0.83rem;">
                                                                <div class="d-flex align-items-center gap-2.5">
                                                                    <input type="checkbox" class="form-check-input mt-0 cursor-pointer" checked="@step.IsCompleted" @onchange="e => ToggleStepCompletion(cp, step, (bool)(e.Value ?? false))" />
                                                                    <span class="@(step.IsCompleted ? "text-decoration-line-through text-success fw-medium" : "fw-semibold text-dark")">
                                                                        <strong>Paso @step.StepOrder:</strong> @step.Instruction
                                                                    </span>
                                                                </div>
                                                                @if (step.IsRequired)
                                                                {
                                                                    <span class="badge @(step.IsCompleted ? "bg-success text-white" : "bg-danger bg-opacity-10 text-danger") rounded-pill px-2" style="font-size:9px;">
                                                                        @(step.IsCompleted ? "Completado" : "Obligatorio")
                                                                    </span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small fst-italic mb-3" style="font-size:11px;">
                                                    <i class="bi bi-info-circle me-1"></i> Checkpoint directo de avance general (sin pasos secundarios).
                                                </p>
                                            }

                                            <!-- Acciones Directas de Aprobación/Rechazo por Checkpoint -->
                                            <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-10">
                                                <span class="text-muted small" style="font-size:11px;">Aprobación directa de @cp.Code:</span>
                                                <div class="d-flex align-items-center gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size:11px;" @onclick="() => RejectCheckpoint(cp)">
                                                        <i class="bi bi-x-lg me-1"></i> Rechazar / KO
                                                    </button>
                                                    <button type="button" class="btn btn-sm @(cp.Status == "APROBADO" ? "btn-success text-white" : "btn-outline-success") rounded-pill px-3 py-1" style="font-size:11px;" @onclick="() => ApproveCheckpoint(cp)">
                                                        <i class="bi bi-check-lg me-1"></i> Aprobar Checkpoint
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 font-semibold" @onclick="CloseTimelineModal">Cerrar</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 font-semibold shadow-sm" @onclick="() => NavigateToDetail(_selectedTimelineOrder.IdOrder)">Ver Ficha Completa</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Derivar Asesor -->
@if (_showAssignModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15,23,42,0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Derivar Pre-Venta #@_selectedPreSaleId</h5>
                    <button type="button" class="btn-close" @onclick="CloseAssignModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Asesor Destino</label>
                        <select class="form-select rounded-3" @bind="_assignUserId">
                            <option value="0" disabled>-- Selecciona un asesor --</option>
                            @foreach (var adv in _advisors)
                            {
                                <option value="@adv.Id">@adv.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Contexto / Motivo</label>
                        <textarea class="form-control" rows="2" @bind="_assignContext" placeholder="Motivo de la transferencia..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill" @onclick="CloseAssignModal">Cancelar</button>
                    <button type="button" class="btn btn-warning rounded-pill px-4 text-dark" @onclick="SaveAssign">
                        Transferir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SalesOrderViewModel> _orders = new();
    private List<PreSaleDto> _preSalesList = new();
    private SalesOrderViewModel? _selectedProductsOrder;
    private SalesOrderViewModel? _selectedTimelineOrder;
    private bool _isLoading = true;
    private long _currentUserId;
    private string _username = string.Empty;
    private string _activeTab = "ventas";

    private bool _showAssignModal = false;
    private long _selectedPreSaleId = 0;
    private int _assignUserId = 0;
    private string _assignContext = "";
    private List<AdvisorLookupDto> _advisors = new();

    private async Task OpenTimelineModal(SalesOrderViewModel order)
    {
        _selectedTimelineOrder = order;
        _selectedModalStageIndex = GetCurrentStageIndex(order);
        if (!_cachedCheckpoints.Any())
        {
            await LoadCheckpointsAndStepsAsync();
        }
    }

    private void CloseTimelineModal()
    {
        _selectedTimelineOrder = null;
        _selectedModalStageIndex = -1;
    }

    public class AdvisorLookupDto { public int Id { get; set; } public string Name { get; set; } = ""; }

    public class ProductItemBreakdown
    {
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
    }

    // Etapas cargadas 100% desde nyx_flow.stage vía /api/engines/flow/stages
    private List<StageVmDash> _stageObjects = new();
    private List<string> _stages = new();

    private string GetCampaignNameById(long idCmpg)
    {
        return idCmpg switch
        {
            1 => "TELECOM PRODUCCION",
            2 => "PORTABILIDAD MÓVIL",
            3 => "ALARMAS Y SEGURIDAD",
            4 => "MULTICARTERA PRODUCCION",
            _ => "GENERAL"
        };
    }

    private static long ResolveFlowIdForOrder(SalesOrderViewModel? order)
    {
        if (order == null) return 1;
        if (order.IdCmpg is >= 1 and <= 5) return 2;
        return 1;
    }

    private List<string> GetStagesForOrder(SalesOrderViewModel? order)
    {
        if (order == null || !_stageObjects.Any()) return _stages.Any() ? _stages : new List<string> { "Preventa", "Venta Creada", "Gestión Inicial", "Validación Interna", "Envío Proveedor", "Validación Externa", "Firma", "Tramitación", "Activación", "Postventa", "Cerrada" };

        var flowId = ResolveFlowIdForOrder(order);
        var filtered = _stageObjects
            .Where(s => s.IdFlow == flowId)
            .OrderBy(s => s.OrderIndex)
            .Select(s => s.Name)
            .ToList();

        if (!filtered.Any())
        {
            filtered = _stageObjects.Where(s => s.IdFlow == 1).OrderBy(s => s.OrderIndex).Select(s => s.Name).ToList();
        }

        return filtered.Any() ? filtered : _stages;
    }

    private int GetCurrentStageIndex(SalesOrderViewModel? order)
    {
        if (order == null) return 0;
        var orderStages = GetStagesForOrder(order);
        if (!orderStages.Any()) return 0;

        var flowId = ResolveFlowIdForOrder(order);

        if (!string.IsNullOrEmpty(order.Status))
        {
            var matchObj = _stageObjects.FirstOrDefault(s =>
                s.IdFlow == flowId && (
                s.StageCode.Equals(order.Status, StringComparison.OrdinalIgnoreCase) ||
                s.Name.Equals(order.Status, StringComparison.OrdinalIgnoreCase)));
            if (matchObj != null)
            {
                var idx = orderStages.IndexOf(matchObj.Name);
                if (idx >= 0) return idx;
            }
        }

        if (order.IdStatus == 1) return 0; // Preventa / Venta Creada
        if (order.IdStatus == 2) return Math.Min(1, orderStages.Count - 1);
        if (order.IdStatus == 3) return Math.Min(2, orderStages.Count - 1);
        if (order.IdStatus >= 4) return orderStages.Count - 1;

        return 0;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var subClaim = user.FindFirst("sub") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (subClaim != null && long.TryParse(subClaim.Value, out long parsedId))
        {
            _currentUserId = parsedId;
        }

        _username = user.Identity?.Name ?? "Asesor";

        await LoadStagesFromApi();
        await LoadData();
        await LoadCheckpointsAndStepsAsync();
    }

    private async Task LoadStagesFromApi()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var stageVms = await client.GetFromJsonAsync<List<StageVmDash>>("/api/engines/flow/stages");
            if (stageVms != null && stageVms.Any())
            {
                _stageObjects = stageVms.OrderBy(s => s.IdFlow).ThenBy(s => s.OrderIndex).ToList();
                _stages = _stageObjects.Where(s => s.IdFlow == 1).Select(s => s.Name).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AsesorDashboard] Error cargando etapas desde BD: {ex.Message}");
        }
    }

    private class StageVmDash
    {
        public long IdStage { get; set; }
        public long IdFlow { get; set; }
        public string StageCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int OrderIndex { get; set; }
        public string Portfolio { get; set; } = "GENERAL";
        public string Campaign { get; set; } = "GENERAL";
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");

            // 1. Cargar Órdenes del Asesor
            var allOrders = await SalesOrderService.GetOrdersAsync(userId: _currentUserId);
            _orders = allOrders.ToList();

            // 2. Cargar Pre-Ventas del Asesor directamente en el mismo Dashboard
            var preSalesResponse = await client.GetFromJsonAsync<List<PreSaleDto>>($"/api/presales?userId={_currentUserId}");
            if (preSalesResponse != null)
            {
                _preSalesList = preSalesResponse.Where(p => p.IdStatus != 3).OrderByDescending(p => p.Register).ToList();
            }

            // 3. Cargar Asesores para derivación
            var advList = await client.GetFromJsonAsync<List<AdvisorLookupDto>>("/api/campaigns/advisors");
            if (advList != null) _advisors = advList;

            // 4. Cargar catalog de checkpoints y pasos para modal
            await LoadCheckpointsAndStepsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading advisor data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<ProductItemBreakdown> _getProductBreakdown(SalesOrderViewModel order)
    {
        var items = new List<ProductItemBreakdown>();

        if (order.IdCmpg == 1)
        {
            items.Add(new ProductItemBreakdown { Name = "Fibra Óptica High Speed 600 Mbps", Category = "Conectividad Fija" });
            if (order.TotalProducts > 1)
            {
                items.Add(new ProductItemBreakdown { Name = "Línea Móvil Ilimitada 5G", Category = "Móvil Principal" });
            }
            if (order.TotalProducts > 2)
            {
                items.Add(new ProductItemBreakdown { Name = "Decodificador TV 4K Smart", Category = "Entretenimiento" });
            }
        }
        else
        {
            items.Add(new ProductItemBreakdown { Name = "Plan Móvil Empresarial Pro 5G", Category = "Voz y Datos" });
            if (order.TotalProducts > 1)
            {
                items.Add(new ProductItemBreakdown { Name = "Línea Adicional Roaming Incluido", Category = "Móvil Adicional" });
            }
        }

        return items;
    }

    private void ShowProductsModal(SalesOrderViewModel order)
    {
        _selectedProductsOrder = order;
    }

    private void CloseProductsModal()
    {
        _selectedProductsOrder = null;
    }

    private void NavigateToDetail(long idOrder)
    {
        NavigationManager.NavigateTo($"/asesor/orders/{idOrder}");
    }

    private void OpenNewPreSaleModal()
    {
        NavigationManager.NavigateTo("/asesor/preventas");
    }

    private void OpenAssignModal(long idPresale)
    {
        _selectedPreSaleId = idPresale;
        _showAssignModal = true;
    }

    private void CloseAssignModal() => _showAssignModal = false;

    private async Task SaveAssign()
    {
        if (_assignUserId <= 0) return;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var payload = new { ToUserId = _assignUserId, Context = _assignContext };
            var response = await client.PostAsJsonAsync($"/api/presales/{_selectedPreSaleId}/assign", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Pre-Venta derivada exitosamente.", Severity.Success);
                _showAssignModal = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al derivar: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConvertToOrder(long idPresale)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.PostAsJsonAsync($"/api/presales/{idPresale}/convert", new { });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                if (result.TryGetProperty("leadId", out var leadIdElement) && leadIdElement.TryGetInt64(out long leadId))
                {
                    Snackbar.Add("¡Pre-venta convertida a Venta con éxito!", Severity.Success);
                    NavigationManager.NavigateTo($"/asesor/orders/new?leadId={leadId}");
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    public class CheckpointStepModalVm
    {
        public long IdStep { get; set; }
        public short StepOrder { get; set; }
        public string Instruction { get; set; } = "";
        public bool IsRequired { get; set; }
        public bool IsCompleted { get; set; }
    }

    public class StageCheckpointModalVm
    {
        public long IdCheckpoint { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public long? TriggerStageId { get; set; }
        public bool BlocksAdvance { get; set; }
        public string? RollbackToStage { get; set; }
        public string Status { get; set; } = "PENDIENTE";
        public List<CheckpointStepModalVm> Steps { get; set; } = new();

        public bool AreAllRequiredStepsCompleted => !Steps.Any(s => s.IsRequired) || Steps.Where(s => s.IsRequired).All(s => s.IsCompleted);
        public int CompletedStepsCount => Steps.Count(s => s.IsCompleted);
    }

    private void ToggleStepCompletion(StageCheckpointModalVm cp, CheckpointStepModalVm step, bool isCompleted)
    {
        step.IsCompleted = isCompleted;
        if (cp.AreAllRequiredStepsCompleted && cp.Status == "PENDIENTE")
        {
            cp.Status = "APROBADO";
        }
        else if (!cp.AreAllRequiredStepsCompleted && cp.Status == "APROBADO")
        {
            cp.Status = "PENDIENTE";
        }
    }

    private void ApproveCheckpoint(StageCheckpointModalVm cp)
    {
        foreach (var s in cp.Steps)
        {
            s.IsCompleted = true;
        }
        cp.Status = "APROBADO";
    }

    private void RejectCheckpoint(StageCheckpointModalVm cp)
    {
        cp.Status = "RECHAZADO";
    }

    public class CatalogItemApiDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("idCheckpoint")]
        public long IdCheckpoint { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("code")]
