    private int _selectedModalStageIndex = -1;
    private List<StageCheckpointModalVm> _cachedCheckpoints = new();

    private void SelectModalStageIndex(int index)
    {
        _selectedModalStageIndex = index;
    }

    private List<StageCheckpointModalVm> GetCheckpointsForStageIndex(int stageIdx)
    {
        long stageId = (stageIdx >= 0 && stageIdx < _stageObjects.Count) ? _stageObjects[stageIdx].IdStage : (long)(stageIdx + 1);
        var filtered = _cachedCheckpoints.Where(c => c.TriggerStageId == stageId).ToList();
        
        Console.WriteLine($"[AsesorDashboard] GetCheckpointsForStageIndex: stageIdx={stageIdx}, stageId={stageId}, Total cached={_cachedCheckpoints.Count}, Coincidentes={filtered.Count}");
        
        if (!filtered.Any() && _cachedCheckpoints.Any())
        {
            // Fallback match: if stageId didn't match directly or trigger_stage_id is null/0
            filtered = _cachedCheckpoints.Where(c => c.TriggerStageId == null || c.TriggerStageId == 0 || c.TriggerStageId == stageId).ToList();
            Console.WriteLine($"[AsesorDashboard] Fallback aplicado! Checkpoints retornados={filtered.Count}");
        }

        return filtered;
    }

    private async Task LoadCheckpointsAndStepsAsync()
    {
        try
        {
            Console.WriteLine("[AsesorDashboard] Cargando catálogo de checkpoints desde /api/engines/flow/catalogs...");
            var client = HttpClientFactory.CreateClient("BackendApi");
            var catalog = await client.GetFromJsonAsync<List<CatalogItemApiDto>>("/api/engines/flow/catalogs");
            Console.WriteLine($"[AsesorDashboard] Catálogo recibido de la API: {(catalog != null ? catalog.Count : 0)} items.");

            if (catalog != null)
            {
                var list = new List<StageCheckpointModalVm>();
                foreach (var c in catalog)
                {
                    var vm = new StageCheckpointModalVm
                    {
                        IdCheckpoint = c.IdCheckpoint,
                        Code = c.Code,
                        Name = c.Name,
                        TriggerStageId = c.TriggerStageId,
                        BlocksAdvance = c.BlocksAdvance,
                        RollbackToStage = c.RollbackToStage
                    };
                    try
                    {
                        var steps = await client.GetFromJsonAsync<List<CheckpointStepApiDto>>($"/api/engines/flow/catalogs/{c.IdCheckpoint}/steps");
                        if (steps != null)
                        {
                            vm.Steps = steps.Select(s => new CheckpointStepModalVm
                            {
                                IdStep = s.IdStep,
                                StepOrder = s.StepOrder,
                                Instruction = !string.IsNullOrWhiteSpace(s.Instruction) ? s.Instruction : s.Name,
                                IsRequired = s.IsRequired,
                                IsCompleted = false
                            }).ToList();
                        }
                    }
                    catch (Exception exStep)
                    {
                        Console.WriteLine($"[AsesorDashboard] Warn leyendo pasos de CP #{c.IdCheckpoint}: {exStep.Message}");
                    }

                    list.Add(vm);
                }
                _cachedCheckpoints = list;
                Console.WriteLine($"[AsesorDashboard] Éxito: {_cachedCheckpoints.Count} checkpoints guardados en caché local.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AsesorDashboard] Error crítico en LoadCheckpointsAndStepsAsync: {ex.Message}");
        }
    }
