            _checkpointNotes = "";
        }
        else
        {
            _selectedCheckpointStatus = status;
            _hasExplicitStatusSelection = true;
            _checkpointNotes = note;
        }
    }

    private async Task ResolveCheckpointExecution()
    {
        if (_selectedPreSale == null) return;
        if (IsApprovalResult(_selectedCheckpointStatus) && !CanApproveCheckpoint)
        {
            Snackbar.Add("⚠ Debes completar todos los pasos obligatorios antes de completar y avanzar el checkpoint.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");

            var completedStepsList = _activeExecutionSteps.Where(s => s.IsCompleted).Select(s => $"Paso {s.StepOrder}: {s.Name}").ToList();

            var userObservation = !string.IsNullOrWhiteSpace(_checkpointNotes) ? _checkpointNotes.Trim() : "";
            var logNote = string.IsNullOrWhiteSpace(userObservation)
                ? $"[CP #{_selectedCheckpointId} {_selectedCheckpointName} - Resultado: {_selectedCheckpointStatus}]"
                : $"[CP #{_selectedCheckpointId} {_selectedCheckpointName} - Resultado: {_selectedCheckpointStatus}]: {userObservation}";

            var callLogPayload = new 
            { 
                CallLog = logNote,
                TargetOperator = !string.IsNullOrWhiteSpace(_targetOperatorInput) ? _targetOperatorInput : null,
                CompletedSteps = completedStepsList.AsEnumerable(),
                Result = _selectedCheckpointStatus
            };
            var response = await client.PostAsJsonAsync($"/api/presales/{_selectedPreSale.IdPresale}/calls?userId={_currentUserId}", callLogPayload);
            if (!string.IsNullOrWhiteSpace(_targetOperatorInput))
            {
                _selectedPreSale.TargetOperator = _targetOperatorInput;
            }

            // Si es PENDIENTE (falta llamar / reintento): no cerramos ni avanzamos el checkpoint en FlowEngine
            if (_selectedCheckpointStatus == "PENDIENTE")
            {
                Snackbar.Add("ℹ Llamada registrada como Pendiente. El caso permanece activo para reintentar la llamada.", Severity.Info);
                _showCheckpointModal = false;
                await LoadDataAsync();
                return;
            }

            // Sincronizar en Nyx.FlowEngine si existe instancia de flujo
            try
            {
                var engineStatus = IsApprovalResult(_selectedCheckpointStatus) ? "APPROVED" : "KO";

                var flowInstResponse = await client.GetAsync($"/api/engines/flow/instances/by-entity/lead_presale/{_selectedPreSale.IdPresale}/detail");
                FlowInstanceDetailDto? flowInst = null;
                if (flowInstResponse.IsSuccessStatusCode)
                {
                    flowInst = await flowInstResponse.Content.ReadFromJsonAsync<FlowInstanceDetailDto>();
                }
                else
                {
                    // Si no existe instancia iniciada en FlowEngine, iniciarla con flujo Telecom
                    var startResponse = await client.PostAsJsonAsync("/api/engines/flow/instances/start", new 
                    { 
                        flowCode = "PIPELINE_TELECOM", 
                        entityType = "lead_presale", 
                        entityId = _selectedPreSale.IdPresale,
                        actorId = _currentUserId
                    });
                    if (startResponse.IsSuccessStatusCode)
                    {
                        var detailRes = await client.GetAsync($"/api/engines/flow/instances/by-entity/lead_presale/{_selectedPreSale.IdPresale}/detail");
                        if (detailRes.IsSuccessStatusCode)
                        {
                            flowInst = await detailRes.Content.ReadFromJsonAsync<FlowInstanceDetailDto>();
                        }
                    }
                }

                if (flowInst?.Checkpoints != null)
                {
                    // Resolver ÚNICAMENTE el checkpoint actual
                    var pendingCp = flowInst.Checkpoints.FirstOrDefault(ci => ci.IdCheckpoint == _selectedCheckpointId && ci.Status == "PENDING")
                        ?? flowInst.Checkpoints.FirstOrDefault(ci => ci.Status == "PENDING");
                    if (pendingCp != null)
                    {
                        var resolveRes = await client.PostAsJsonAsync($"/api/engines/flow/checkpoints/instances/{pendingCp.IdCpInstance}/resolve", new { status = engineStatus, actorId = _currentUserId });
                        if (resolveRes.IsSuccessStatusCode)
                        {
                            var resolveDto = await resolveRes.Content.ReadFromJsonAsync<ResolveCheckpointResultDto>();
                            if (resolveDto?.FlowStatus == "CLOSED" || resolveDto?.NextAction == "CYCLE_FINALIZED")
                            {
                                await client.PostAsJsonAsync($"/api/presales/{_selectedPreSale.IdPresale}/discard", new { reason = $"KO en {pendingCp.Name}" });
                                _selectedPreSale.IdStatus = 4;
                                _selectedPreSale.DiscardReason = $"KO en {pendingCp.Name}";
                                _selectedPreSale.DiscardedAt = DateTime.UtcNow;
                            }
                        }
                    }

                    // Re-consultar para actualizar la etapa activa de la entidad
                    var updatedFlowResponse = await client.GetAsync($"/api/engines/flow/instances/by-entity/lead_presale/{_selectedPreSale.IdPresale}/detail");
                    if (updatedFlowResponse.IsSuccessStatusCode)
                    {
                        var updatedFlow = await updatedFlowResponse.Content.ReadFromJsonAsync<FlowInstanceDetailDto>();
                        if (updatedFlow != null)
                        {
                            lock (_leadFlowInstances)
                            {
                                _leadFlowInstances[_selectedPreSale.IdPresale] = updatedFlow;
                            }
                            if (updatedFlow.Status == "CLOSED")
                            {
                                _selectedPreSale.IdStatus = 4;
                            }
                            if (updatedFlow.CurrentStageId > 0)
                            {
                                _activeLeadStageId = updatedFlow.CurrentStageId;
                                _selectedStageForTracking = _flowStages.FirstOrDefault(s => s.IdStage == _activeLeadStageId);
                                SelectStageForTracking(_selectedStageForTracking);
                            }
                        }
                    }
                }
            }
            catch { /* Sincronización transparente */ }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Checkpoint '{_selectedCheckpointName}' registrado con éxito ({_selectedCheckpointStatus}).", Severity.Success);
                _showCheckpointModal = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("Error al registrar checkpoint.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

