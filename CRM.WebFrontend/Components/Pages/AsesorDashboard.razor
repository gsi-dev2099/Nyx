    private string _selectedCheckpointStatus = "PENDIENTE";
    private bool _hasExplicitStatusSelection = false;
    private bool CanApproveCheckpoint => !_activeExecutionSteps.Any(s => s.IsRequired && !s.IsCompleted);
    private int RequiredStepsPendingCount => _activeExecutionSteps.Count(s => s.IsRequired && !s.IsCompleted);

    private void ToggleExecutionStep(CheckpointStepItemDto step)
    {
        step.IsCompleted = !step.IsCompleted;
    }

    private bool IsApprovalResult(string status)
    {
        if (string.IsNullOrEmpty(status)) return false;
        return status == "COMPLETADO" || status == "OK" || status == "APPROVED" || status.Contains("CONFIRMADO") || status.Contains("VENTA");
    }

    private async Task OpenCheckpointActionModal(PreSaleDto ps, int cpId, string cpName)
    {
        if (cpId == 16)
        {
            await OpenVentaCreadaModal(ps);
            return;
        }

        _selectedPreSale = ps;
        _selectedCheckpointId = cpId;
        _selectedCheckpointName = cpName;
        _selectedCheckpointStatus = "PENDIENTE";
        _hasExplicitStatusSelection = false;
        _checkpointNotes = "";
        _targetOperatorInput = ps.TargetOperator ?? "";

        // Cargar pasos operativos reales del catálogo desde FlowEngine
        var cpCatalog = _allCheckpointsCatalog.FirstOrDefault(c => c.IdCheckpoint == cpId || c.Code.EndsWith($"0{cpId}") || c.Code.EndsWith($"{cpId}"));
        if (cpCatalog?.Steps != null && cpCatalog.Steps.Any())
        {
            _activeExecutionSteps = cpCatalog.Steps.Select(s => new CheckpointStepItemDto
            {
                IdStep = s.IdStep,
                IdCheckpoint = s.IdCheckpoint,
                StepOrder = s.StepOrder,
                Name = s.Name,
                Instruction = s.Instruction,
                IsRequired = s.IsRequired,
                IsCompleted = false
            }).ToList();
        }
        else
        {
            try
            {
                var client = HttpClientFactory.CreateClient("BackendApi");
                var apiSteps = await client.GetFromJsonAsync<List<CheckpointStepItemDto>>($"/api/engines/flow/catalogs/{cpId}/steps");
                if (apiSteps != null && apiSteps.Any())
                {
                    _activeExecutionSteps = apiSteps.Select(s => new CheckpointStepItemDto
                    {
                        IdStep = s.IdStep,
                        IdCheckpoint = s.IdCheckpoint,
                        StepOrder = s.StepOrder,
                        Name = s.Name,
                        Instruction = s.Instruction,
                        IsRequired = s.IsRequired,
                        IsCompleted = false
                    }).ToList();
                }
                else
                {
                    _activeExecutionSteps = new List<CheckpointStepItemDto>
                    {
                        new() { StepOrder = 1, Name = $"Ejecutar validación de {cpName}", IsRequired = true, IsCompleted = false }
                    };
                }
            }
            catch
            {
                _activeExecutionSteps = new List<CheckpointStepItemDto>
                {
                    new() { StepOrder = 1, Name = $"Ejecutar validación de {cpName}", IsRequired = true, IsCompleted = false }
                };
            }
        }

