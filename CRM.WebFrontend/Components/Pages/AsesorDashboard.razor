@page "/asesor"
@page "/asesor/dashboard"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ASESOR,ADMIN_CRM,ADMINISTRADOR,SUPERVISOR")]
@using CRM.WebFrontend.Services
@using CRM.WebFrontend.Client.Models
@inject ISalesOrderService SalesOrderService
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Información Principal - Asesor NYX CRM</PageTitle>

<style>
    /* ═══════════════════════════════════════════════════════════════════
       NYX CRM — AAPLY × ACCTUAL DESIGN SYSTEM
       Electric yellow energy + Paper-white clarity
       ═══════════════════════════════════════════════════════════════════ */

    /* ── DESIGN TOKENS ── */
    :root {
        /* Aaply Brand */
        --nyx-yellow: #e6e51e;
        --nyx-yellow-soft: rgba(230, 229, 30, 0.12);
        --nyx-red: #f34646;
        --nyx-blue: #466cf3;
        --nyx-peach: #ff8562;
        --nyx-sunbeam: #fff705;

        /* Acctual Neutrals */
        --nyx-ink: #1e1e1e;
        --nyx-carbon: #0f0f0f;
        --nyx-midnight: #0d111b;
        --nyx-smoke: #666666;
        --nyx-fog: #8d8d8d;
        --nyx-ash: #999999;
        --nyx-mist: #ccd1da;
        --nyx-paper: #ffffff;
        --nyx-snow: #f7fafc;
        --nyx-canvas: #f2f2f2;
        --nyx-hairline: #e6e6e6;

        /* Acctual Accents */
        --nyx-electric: #0098f2;
        --nyx-iris: #6c56fc;
        --nyx-leaf: #5d9c06;
        --nyx-coral: #ff6363;

        /* Semantic */
        --nyx-success: #22c55e;
        --nyx-success-bg: #f0fdf4;
        --nyx-warning: #f59e0b;
        --nyx-warning-bg: #fffbeb;
        --nyx-error: #ef4444;
        --nyx-error-bg: #fef2f2;
        --nyx-info: #0098f2;
        --nyx-info-bg: #eff6ff;

        /* Typography */
        --font-display: 'Poppins', 'Inter', system-ui, -apple-system, sans-serif;
        --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;

        /* Radii (Aaply: 3000px pills, Acctual: 16px cards) */
        --r-pill: 100px;
        --r-card: 16px;
        --r-card-lg: 24px;
        --r-input: 12px;
        --r-tag: 100px;
        --r-full: 50%;

        /* Shadows (Acctual: subtle, single-layer) */
        --shadow-card: 0 1px 3px rgba(10, 13, 20, 0.06);
        --shadow-elevated: 0 4px 12px rgba(10, 13, 20, 0.08);
        --shadow-modal: 0 25px 60px -15px rgba(0, 0, 0, 0.22);
        --shadow-btn: 0 1px 2px rgba(10, 13, 20, 0.08);

        /* Transitions */
        --ease-out: cubic-bezier(0.2, 0, 0, 1);
        --duration: 0.2s;
    }

    /* ── GOOGLE FONTS IMPORT ── */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap');

    /* ── GLOBAL PAGE CANVAS ── */
    .container-fluid.py-4 {
        background: var(--nyx-canvas);
        font-family: var(--font-body);
        color: var(--nyx-ink);
        min-height: 100vh;
    }

    /* ── HERO CARD ── */
    .asesor-hero-card {
        background: var(--nyx-paper);
        border-radius: var(--r-card-lg);
        padding: 28px 32px;
        border: 1px solid var(--nyx-hairline);
        box-shadow: var(--shadow-card);
        position: relative;
        overflow: hidden;
    }
    .asesor-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 320px;
        height: 100%;
        background: radial-gradient(ellipse at top right, var(--nyx-yellow-soft) 0%, transparent 70%);
        pointer-events: none;
    }

    /* ── KPI CARDS ── */
    .asesor-kpi-card {
        background: var(--nyx-paper);
        border-radius: var(--r-card);
        padding: 20px 22px;
        border: 1px solid var(--nyx-hairline);
        box-shadow: var(--shadow-card);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: transform var(--duration) var(--ease-out), box-shadow var(--duration) var(--ease-out);
    }
    .asesor-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-elevated);
    }

    .kpi-icon-wrapper {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--nyx-snow);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--nyx-electric);
        flex-shrink: 0;
        border: 1px solid var(--nyx-hairline);
    }

    /* ── PRIMARY CTA BUTTON (Aaply: Black Pill) ── */
    .asesor-cta-btn {
        background: var(--nyx-carbon);
        color: var(--nyx-paper);
        border-radius: var(--r-pill);
        padding: 10px 24px;
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--duration) var(--ease-out);
        box-shadow: var(--shadow-btn);
        letter-spacing: -0.02em;
    }
    .asesor-cta-btn:hover {
        background: var(--nyx-ink);
        color: var(--nyx-paper);
        transform: translateY(-1px);
        box-shadow: var(--shadow-elevated);
    }

    /* ── YELLOW ACCENT BUTTON (Aaply: Filled Yellow Pill) ── */
    .btn-accent-yellow {
        background: var(--nyx-yellow);
        color: var(--nyx-carbon);
        border-radius: var(--r-pill);
        padding: 8px 20px;
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all var(--duration) var(--ease-out);
        box-shadow: var(--shadow-btn);
    }
    .btn-accent-yellow:hover {
        background: #d4d31b;
        transform: translateY(-1px);
        box-shadow: var(--shadow-elevated);
    }

    /* ── TABLE CARD ── */
    .table-card {
        background: var(--nyx-paper);
        border-radius: var(--r-card-lg);
        border: 1px solid var(--nyx-hairline);
        box-shadow: var(--shadow-card);
        overflow: hidden;
    }

    .table-modern thead th {
        background: var(--nyx-snow);
        color: var(--nyx-smoke);
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 12px 16px;
        border-bottom: 1px solid var(--nyx-hairline);
    }

    .table-modern tbody tr {
        transition: background-color var(--duration) ease;
    }
    .table-modern tbody tr:hover {
        background-color: var(--nyx-snow);
    }

    .table-modern tbody td {
        padding: 12px 16px;
        font-size: 0.84rem;
        color: var(--nyx-ink);
        vertical-align: middle;
        border-bottom: 1px solid rgba(0,0,0,0.04);
        letter-spacing: -0.01em;
    }

    /* ── CHECKPOINT PILLS ── */
    .checkpoint-step-pill {
        padding: 4px 12px;
        border-radius: var(--r-pill);
        font-size: 0.72rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all var(--duration) ease;
        letter-spacing: -0.01em;
    }
    .checkpoint-step-pill.completed {
        background: var(--nyx-success-bg);
        color: #059669;
        border-color: #bbf7d0;
    }
    .checkpoint-step-pill.active {
        background: var(--nyx-info-bg);
        color: var(--nyx-electric);
        border-color: #bfdbfe;
        box-shadow: 0 0 0 2px rgba(0, 152, 242, 0.12);
    }
    .checkpoint-step-pill.pending-accept {
        background: var(--nyx-warning-bg);
        color: #92400e;
        border-color: #fcd34d;
        animation: nyx-pulse 1.8s infinite;
    }
    .checkpoint-step-pill.blocked {
        background: var(--nyx-snow);
        color: var(--nyx-ash);
        border-color: var(--nyx-hairline);
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* ── 3-CHECKPOINT SLIDING WINDOW ── */
    .checkpoint-window-container {
        display: inline-flex;
        align-items: center;
        background: var(--nyx-paper);
        padding: 4px 8px;
        border-radius: var(--r-card);
        border: 1px solid var(--nyx-hairline);
        box-shadow: var(--shadow-card);
        max-width: 100%;
    }

    .cp-window-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    .cp-indicator-tag {
        font-size: 0.58rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        line-height: 1;
    }
    .cp-indicator-tag.prev-tag { color: var(--nyx-success); }
    .cp-indicator-tag.current-tag { color: var(--nyx-electric); }
    .cp-indicator-tag.next-tag { color: var(--nyx-ash); }

    .cp-item-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: var(--r-pill);
        font-size: 0.72rem;
        font-weight: 600;
        border: 1px solid transparent;
        white-space: nowrap;
        transition: all 0.15s ease;
        letter-spacing: -0.01em;
    }
    .cp-item-pill.prev-pill {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        font-weight: 600;
    }
    .cp-item-pill.current-pill.active-pill {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #93c5fd;
        box-shadow: 0 0 0 2px rgba(30, 64, 175, 0.15);
        cursor: pointer;
        font-weight: 700;
    }
    .cp-item-pill.current-pill.active-pill:hover {
        background: #dbeafe;
        transform: translateY(-1px);
        box-shadow: 0 0 0 3px rgba(30, 64, 175, 0.2), 0 4px 8px rgba(30, 64, 175, 0.1);
    }
    .cp-item-pill.current-pill.pending-accept-pill {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fcd34d;
        font-weight: 600;
        animation: nyx-pulse 1.8s infinite;
    }
    .cp-item-pill.current-pill.blocked-pill {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
        cursor: not-allowed;
        font-weight: 600;
    }
    .cp-item-pill.next-pill {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #cbd5e1;
        font-weight: 600;
        opacity: 0.95;
    }

    /* ── TIMELINE RAIL ── */
    .timeline-rail-container {
        position: relative;
        padding: 20px 12px;
        background: var(--nyx-paper);
        border-radius: var(--r-card);
        border: 1px solid var(--nyx-hairline);
        box-shadow: var(--shadow-card);
    }
    .timeline-rail-track {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        position: relative;
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 6px;
    }
    .timeline-step-node {
        flex: 1;
        min-width: 130px;
        padding: 12px 10px;
        border-radius: var(--r-card);
        border: 2px solid var(--nyx-hairline);
        cursor: pointer;
        transition: all var(--duration) var(--ease-out);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        animation: nyx-fadeIn 0.3s var(--ease-out);
        user-select: none;
    }
    .timeline-step-node:hover {
        transform: translateY(-2px);
        border-color: var(--nyx-mist);
    }
    .timeline-step-node.past {
        background: var(--nyx-snow);
        border-color: var(--nyx-mist);
        color: var(--nyx-smoke);
    }
    .timeline-step-node.current {
        background: var(--nyx-carbon);
        border-color: var(--nyx-electric);
        color: var(--nyx-paper);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        transform: scale(1.02);
        z-index: 2;
    }
    .timeline-step-node.future {
        background: var(--nyx-paper);
        border-color: var(--nyx-hairline);
        color: var(--nyx-ash);
        opacity: 0.75;
    }
    .timeline-step-node.selected-stage {
        border-color: var(--nyx-electric) !important;
        box-shadow: 0 0 0 3px rgba(0, 152, 242, 0.2) !important;
    }

    .pulse-indicator {
        width: 8px;
        height: 8px;
        border-radius: var(--r-full);
        background: var(--nyx-electric);
        box-shadow: 0 0 0 0 rgba(0, 152, 242, 0.6);
        animation: nyx-pulse 1.8s infinite;
        display: inline-block;
    }

    /* ── TRACKING CARDS ── */
    .tracking-checkpoint-card {
        background: var(--nyx-paper);
        border-radius: var(--r-card);
        border: 1px solid var(--nyx-hairline);
        padding: 16px 18px;
        transition: all var(--duration) ease;
        box-shadow: var(--shadow-card);
    }
    .tracking-checkpoint-card:hover {
        box-shadow: var(--shadow-elevated);
    }
    .tracking-checkpoint-card.status-completed {
        border-left: 3px solid var(--nyx-success);
        background: var(--nyx-success-bg);
    }
    .tracking-checkpoint-card.status-active {
        border-left: 3px solid var(--nyx-electric);
        background: var(--nyx-info-bg);
        box-shadow: 0 2px 8px rgba(0, 152, 242, 0.06);
    }
    .tracking-checkpoint-card.status-pending {
        border-left: 3px solid var(--nyx-mist);
        opacity: 0.85;
    }

    /* ── KEYFRAMES ── */
    @@keyframes nyx-pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 152, 242, 0.5); }
        70% { transform: scale(1.15); box-shadow: 0 0 0 10px rgba(0, 152, 242, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 152, 242, 0); }
    }
    @@keyframes pulse-animation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 152, 242, 0.7); }
        70% { transform: scale(1.2); box-shadow: 0 0 0 10px rgba(0, 152, 242, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 152, 242, 0); }
    }
    @@keyframes pulse-border {
        0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.6); }
        70% { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); }
        100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
    @@keyframes nyx-fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeInSlide {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ── HANDSHAKE MODAL ── */
    .aggressive-handshake-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(12px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        animation: nyx-fadeIn 0.2s var(--ease-out);
    }
    .aggressive-handshake-box {
        background: var(--nyx-paper);
        border-radius: var(--r-card-lg);
        max-width: 540px;
        width: 100%;
        border: 1px solid var(--nyx-hairline);
        box-shadow: var(--shadow-modal);
        overflow: hidden;
    }
    .handshake-alarm-header {
        background: var(--nyx-carbon);
        border-bottom: 3px solid var(--nyx-electric);
        color: var(--nyx-paper);
        padding: 22px 26px;
    }

    /* ── VENTA CREADA MODAL ── */
    .venta-modal-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(12px);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        overflow-y: auto;
        animation: nyx-fadeIn 0.25s var(--ease-out);
    }
    .venta-modal-box {
        background: var(--nyx-paper);
        border-radius: var(--r-card-lg);
        max-width: 1100px;
        width: 100%;
        max-height: 92vh;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-modal);
        overflow: hidden;
        border: 1px solid var(--nyx-hairline);
    }
    .venta-modal-header {
        background: var(--nyx-paper);
        border-bottom: 1px solid var(--nyx-hairline);
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }
    .venta-modal-body {
        padding: 20px 24px;
        overflow-y: auto;
        flex: 1;
        background: var(--nyx-snow);
    }

    /* ── FORM CARDS (Acctual-style: clean, 16px radius) ── */
    .venta-section-card {
        background: var(--nyx-paper);
        border-radius: var(--r-card);
        border: 1px solid var(--nyx-hairline);
        padding: 18px 20px;
        margin-bottom: 14px;
        box-shadow: var(--shadow-card);
    }
    .venta-section-title {
        font-family: var(--font-display);
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--nyx-ink);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(0,0,0,0.04);
        letter-spacing: -0.02em;
    }
    .venta-field-label {
        font-size: 0.74rem;
        font-weight: 600;
        color: var(--nyx-smoke);
        margin-bottom: 4px;
        display: block;
        letter-spacing: -0.01em;
    }
    .venta-field-input {
        background: var(--nyx-paper);
        border: 1px solid var(--nyx-mist);
        border-radius: var(--r-input);
        font-family: var(--font-body);
        font-size: 0.82rem;
        padding: 8px 12px;
        width: 100%;
        color: var(--nyx-ink);
        transition: border-color var(--duration) ease, box-shadow var(--duration) ease;
        letter-spacing: -0.01em;
    }
    .venta-field-input:focus {
        border-color: var(--nyx-electric);
        box-shadow: 0 0 0 3px rgba(0, 152, 242, 0.12);
        outline: none;
    }
    .venta-field-input::placeholder {
        color: var(--nyx-ash);
    }

    /* ── CHECKLIST ITEMS ── */
    .venta-chk-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.76rem;
        transition: background-color 0.15s ease;
        letter-spacing: -0.01em;
    }
    .venta-chk-item.checked {
        background: var(--nyx-success-bg);
        color: #166534;
        font-weight: 600;
    }
    .venta-chk-item.unchecked {
        color: var(--nyx-fog);
    }
    .venta-chk-icon {
        width: 18px;
        height: 18px;
        border-radius: var(--r-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        flex-shrink: 0;
        margin-top: 1px;
        transition: all var(--duration) ease;
    }
    .venta-chk-icon.checked {
        background: var(--nyx-success);
        color: var(--nyx-paper);
    }
    .venta-chk-icon.unchecked {
        background: var(--nyx-hairline);
        color: var(--nyx-ash);
    }

    /* ── CLOSE BUTTON ── */
    .btn-close-modal {
        width: 32px;
        height: 32px;
        border-radius: var(--r-full);
        background: var(--nyx-snow);
        border: 1px solid var(--nyx-hairline);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--nyx-fog);
        cursor: pointer;
        transition: all var(--duration) ease;
    }
    .btn-close-modal:hover {
        background: var(--nyx-hairline);
        color: var(--nyx-ink);
        transform: scale(1.08);
    }

    /* ── SIMULATION BUTTON (Aaply: Electric Yellow) ── */
    .btn-simulate {
        background: var(--nyx-yellow);
        color: var(--nyx-carbon);
        border-radius: var(--r-pill);
        padding: 8px 18px;
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all var(--duration) var(--ease-out);
        box-shadow: var(--shadow-btn);
        letter-spacing: -0.02em;
    }
    .btn-simulate:hover {
        background: #d4d31b;
        transform: translateY(-1px);
        box-shadow: var(--shadow-elevated);
    }

    /* ── PREVIEW CARD (Acctual: Invoice-style) ── */
    .preview-invoice-card {
        background: var(--nyx-paper);
        border-radius: var(--r-card);
        border: 1px solid var(--nyx-hairline);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
    }
    .preview-invoice-card .eyebrow {
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--nyx-smoke);
    }
    .preview-invoice-card .amount {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--nyx-ink);
        letter-spacing: -0.03em;
        line-height: 1.1;
    }
    .preview-line-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px dashed rgba(0,0,0,0.06);
        font-size: 0.78rem;
    }
    .preview-line-item:last-child {
        border-bottom: none;
    }
    .preview-line-item .label { color: var(--nyx-smoke); }
    .preview-line-item .value { color: var(--nyx-ink); font-weight: 600; }

    /* ── PROGRESS BAR ── */
    .nyx-progress {
        height: 4px;
        border-radius: var(--r-pill);
        background: var(--nyx-hairline);
        overflow: hidden;
    }
    .nyx-progress-bar {
        height: 100%;
        border-radius: var(--r-pill);
        background: var(--nyx-electric);
        transition: width 0.4s var(--ease-out);
    }
    .nyx-progress-bar.complete {
        background: var(--nyx-success);
    }

    /* ── KEYBOARD SHORTCUT BADGE ── */
    .kbd-hint {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 0.65rem;
        color: var(--nyx-fog);
        opacity: 0.7;
    }
    .kbd-hint kbd {
        background: var(--nyx-snow);
        border: 1px solid var(--nyx-hairline);
        border-radius: 4px;
        padding: 1px 5px;
        font-family: var(--font-body);
        font-size: 0.62rem;
        font-weight: 600;
        color: var(--nyx-smoke);
    }

    /* ── BADGE OVERRIDES (Aaply pills) ── */
    .nyx-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: var(--r-pill);
        font-family: var(--font-body);
        font-size: 0.70rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        border: 1px solid transparent;
    }
    .nyx-badge.primary {
        background: var(--nyx-info-bg);
        color: var(--nyx-electric);
        border-color: rgba(0, 152, 242, 0.15);
    }
    .nyx-badge.success {
        background: var(--nyx-success-bg);
        color: #059669;
        border-color: rgba(34, 197, 94, 0.15);
    }
    .nyx-badge.warning {
        background: var(--nyx-warning-bg);
        color: #92400e;
        border-color: rgba(245, 158, 11, 0.15);
    }
    .nyx-badge.neutral {
        background: var(--nyx-snow);
        color: var(--nyx-smoke);
        border-color: var(--nyx-hairline);
    }

    /* ── FILTER BAR ── */
    .nyx-filter-bar {
        background: var(--nyx-paper);
        border-radius: var(--r-card);
        border: 1px solid var(--nyx-hairline);
        padding: 14px 18px;
        box-shadow: var(--shadow-card);
    }
    .nyx-filter-bar .form-select,
    .nyx-filter-bar .form-control {
        border-radius: var(--r-input);
        border-color: var(--nyx-mist);
        font-size: 0.82rem;
        font-family: var(--font-body);
        color: var(--nyx-ink);
        transition: border-color var(--duration) ease;
    }
    .nyx-filter-bar .form-select:focus,
    .nyx-filter-bar .form-control:focus {
        border-color: var(--nyx-electric);
        box-shadow: 0 0 0 3px rgba(0, 152, 242, 0.1);
    }

    /* ── GENERAL OVERRIDES FOR MUD BLAZOR ── */
    .form-select, .form-control {
        font-family: var(--font-body);
    }

    /* ═══════════════════════════════════════════════════════════════════
       NOTA MEMO CON CLIP METÁLICO (Skeumorphism Moderno & Premium)
       ═══════════════════════════════════════════════════════════════════ */
    .memo-modal-box {
        background: #fffdf2;
        background-image: 
            linear-gradient(#f1eee0 1px, transparent 1px),
            linear-gradient(90deg, #f1eee0 1px, transparent 1px);
        background-size: 20px 20px;
        background-position: -1px -1px;
        border-radius: 14px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(217, 119, 6, 0.2);
        position: relative;
        width: 100%;
        max-width: 760px;
        margin: 20px auto;
        padding-top: 14px;
        animation: memoPopIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        border-top: 5px solid #f59e0b;
        overflow: visible;
    }

    @@keyframes memoPopIn {
        0% { transform: scale(0.96) translateY(12px); opacity: 0; }
        100% { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* Clip metálico realista 3D */
    .memo-metallic-clip {
        position: absolute;
        top: -18px;
        left: 42px;
        width: 24px;
        height: 54px;
        border: 4px solid #94a3b8;
        border-bottom: none;
        border-radius: 14px 14px 0 0;
        background: transparent;
        box-shadow: 2px 5px 10px rgba(0, 0, 0, 0.25), inset 1px 1px 2px rgba(255, 255, 255, 0.95);
        z-index: 1050;
        pointer-events: none;
    }
    .memo-metallic-clip::before {
        content: '';
        position: absolute;
        top: 8px;
        left: 3px;
        width: 10px;
        height: 38px;
        border: 3px solid #64748b;
        border-top: none;
        border-radius: 0 0 10px 10px;
        background: transparent;
    }
    .memo-metallic-clip::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: -4px;
        width: 24px;
        height: 4px;
        background: rgba(0, 0, 0, 0.15);
        border-radius: 2px;
        filter: blur(1px);
    }

    /* Cinta / Cabecera de Nota Memo */
    .memo-header {
        padding: 16px 28px 12px 76px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        border-bottom: 1px dashed rgba(217, 119, 6, 0.3);
    }

    .memo-body {
        padding: 24px 28px;
    }

    .memo-card-field {
        background: #ffffff;
        border: 1px solid rgba(217, 119, 6, 0.25);
        border-radius: 10px;
        padding: 18px;
        box-shadow: 0 2px 6px rgba(217, 119, 6, 0.05);
    }

    .memo-card-field .venta-field-label {
        color: #78350f;
        font-weight: 700;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
        display: block;
    }

    .memo-card-field .venta-field-input {
        background: #fffdf5;
        border: 1px solid #fde68a;
        color: #1e1e1e;
        border-radius: 8px;
        font-size: 0.85rem;
    }
    .memo-card-field .venta-field-input:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
        background: #ffffff;
    }

    /* Botón Nota en el Path y Tablas (Etapa 1 - Preventa) */
    .btn-memo-note {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        background: #fef3c7;
        border: 1px solid #f59e0b;
        color: #92400e !important;
        border-radius: var(--r-pill);
        font-weight: 700;
        font-size: 0.76rem;
        cursor: pointer;
        box-shadow: 0 1px 3px rgba(245, 158, 11, 0.2);
        transition: all 0.15s ease;
        text-decoration: none;
    }
    .btn-memo-note:hover {
        background: #fde68a;
        color: #78350f !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(245, 158, 11, 0.35);
    }
    .btn-memo-note i {
        font-size: 0.85rem;
        color: #d97706;
    }

    /* Botón Ficha de Venta en Tablas (Etapa 2 en adelante - Venta Creada / Gestión) */
    .btn-ficha-action {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        background: #ecfdf5;
        border: 1px solid #10b981;
        color: #065f46 !important;
        border-radius: var(--r-pill);
        font-weight: 700;
        font-size: 0.76rem;
        cursor: pointer;
        box-shadow: 0 1px 3px rgba(16, 185, 129, 0.2);
        transition: all 0.15s ease;
        text-decoration: none;
    }
    .btn-ficha-action:hover {
        background: #10b981;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(16, 185, 129, 0.35);
    }
    .btn-ficha-action i {
        font-size: 0.85rem;
        color: #059669;
    }
    .btn-ficha-action:hover i {
        color: #ffffff;
    }

    /* Botón Asignar / Derivar */
    .btn-assign-action {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        background: #fef9c3;
        border: 1px solid #eab308;
        color: #854d0e !important;
        border-radius: var(--r-pill);
        font-weight: 700;
        font-size: 0.76rem;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(234, 179, 8, 0.2);
        transition: all 0.15s ease;
        text-decoration: none;
    }
    .btn-assign-action:hover {
        background: #eab308;
        color: #000000 !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(234, 179, 8, 0.35);
    }

    /* Botón Devolver al Dueño */
    .btn-revert-action {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        background: #fef2f2;
        border: 1px solid #f87171;
        color: #991b1b !important;
        border-radius: var(--r-pill);
        font-weight: 700;
        font-size: 0.76rem;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(239, 68, 68, 0.15);
        transition: all 0.15s ease;
        text-decoration: none;
    }
    .btn-revert-action:hover {
        background: #ef4444;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(239, 68, 68, 0.3);
    }

    /* Pill de Etapa en Tabla */
    .btn-stage-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: var(--r-pill);
        font-family: var(--font-body);
        font-size: 0.76rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid transparent;
        text-decoration: none;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .btn-stage-pill.active {
        background: #eff6ff;
        border-color: #93c5fd;
        color: #1e40af !important;
    }
    .btn-stage-pill.active:hover {
        background: #1e40af;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(30, 64, 175, 0.25);
    }
    .btn-stage-pill.active .stage-tag {
        background: rgba(30, 64, 175, 0.12);
        color: #1e40af;
        padding: 1px 6px;
        border-radius: var(--r-pill);
        font-size: 0.65rem;
        font-weight: 600;
        transition: all 0.15s ease;
    }
    .btn-stage-pill.active:hover .stage-tag {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }

    .btn-stage-pill.closed {
        background: #fef2f2;
        border-color: #fca5a5;
        color: #991b1b !important;
    }
    .btn-stage-pill.closed:hover {
        background: #991b1b;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(153, 27, 27, 0.25);
    }
    .btn-stage-pill.closed .stage-tag {
        background: rgba(153, 27, 27, 0.12);
        color: #991b1b;
        padding: 1px 6px;
        border-radius: var(--r-pill);
        font-size: 0.65rem;
        font-weight: 600;
        transition: all 0.15s ease;
    }
    .btn-stage-pill.closed:hover .stage-tag {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }

    /* Badges de Tabla de Alto Contraste */
    .nyx-table-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: var(--r-pill);
        font-size: 0.70rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.3;
    }
    .nyx-table-badge.primary {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
    }
    .nyx-table-badge.warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fcd34d;
    }
    .nyx-table-badge.info {
        background: #f0f9ff;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }
    .nyx-table-badge.danger {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }
    .nyx-table-badge.secondary {
        background: #f8fafc;
        color: #334155;
        border: 1px solid #cbd5e1;
    }
    .nyx-table-badge.success {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    /* ── RESPONSIVE ADJUSTMENTS ── */
    @@media (max-width: 768px) {
        .asesor-hero-card { padding: 18px 16px; }
        .venta-modal-box, .memo-modal-box { max-width: 100%; border-radius: var(--r-card); }
        .venta-modal-body, .memo-body { padding: 14px 16px; }
    }
</style>

<div class="container-fluid py-4 space-y-4">
    
    <!-- Hero Banner: Información Principal del Asesor -->
    <div class="asesor-hero-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="nyx-badge primary">
                        <i class="bi bi-broadcast-pin"></i> Cartera Telecom &amp; Pipeline
                    </span>
                    <span class="nyx-badge success">
                        <i class="bi bi-lightning-charge-fill"></i> Motor Nyx Flow Activo
                    </span>
                </div>
                <h1 style="font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; color: var(--nyx-ink); letter-spacing: -0.03em; margin-bottom: 4px;">Información Principal del Asesor</h1>
                <p style="font-size: 0.82rem; color: var(--nyx-smoke); margin-bottom: 0; letter-spacing: -0.01em;">Gestión unificada de Pre-Ventas con Checkpoints, Derivación con Confirmación (Handshake) y Control de Reversión.</p>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn-accent-yellow" onclick="window.nyxAlertSystem.requestNotificationPermission()" title="Habilitar o verificar permisos de notificaciones de escritorio">
                    <i class="bi bi-bell-fill"></i>
                    <span>Alertas</span>
                </button>
                <button type="button" class="asesor-cta-btn" @onclick="OpenNewPreSaleModal">
                    <span>+ Nueva Pre-Venta</span>
                </button>
            </div>
        </div>

        <!-- 3 KPI Cards -->
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="asesor-kpi-card">
                    <div>
                        <span style="display: block; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke);">Pre-Ventas Activas</span>
                        <span style="font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; color: var(--nyx-electric); letter-spacing: -0.03em;">@_allPreSales.Count</span>
                    </div>
                    <div class="kpi-icon-wrapper">
                        <i class="bi bi-telephone-inbound fs-5"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="asesor-kpi-card">
                    <div>
                        <span style="display: block; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke);">Ventas Convertidas</span>
                        <span style="font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; color: var(--nyx-leaf); letter-spacing: -0.03em;">@_orders.Count</span>
                    </div>
                    <div class="kpi-icon-wrapper">
                        <i class="bi bi-cart-check fs-5" style="color: var(--nyx-leaf);"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="asesor-kpi-card">
                    <div>
                        <span style="display: block; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke);">Ventas Aprobadas</span>
                        <span style="font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; color: var(--nyx-success); letter-spacing: -0.03em;">@_orders.Count(o => o.Status == "APPROVED")</span>
                    </div>
                    <div class="kpi-icon-wrapper">
                        <i class="bi bi-check-circle-fill fs-5" style="color: var(--nyx-success);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros de Búsqueda y Campaña -->
    <div class="nyx-filter-bar mb-3">
        <div>
            <div class="row row-cols-1 row-cols-md-4 g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-color: var(--nyx-mist); border-radius: var(--r-input) 0 0 var(--r-input);"><i class="bi bi-search" style="color: var(--nyx-fog);"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por cliente, teléfono o #ID..." @bind="_filterText" @bind:event="oninput" style="border-color: var(--nyx-mist); border-radius: 0 var(--r-input) var(--r-input) 0;" />
                    </div>
                </div>
                <div class="col-md-2">
                    <select class="form-select" @bind="_filterCampaignId" @bind:event="onchange">
                        <option value="0">Todas Campañas</option>
                        @foreach (var cmp in _campaigns)
                        {
                            <option value="@cmp.Id">@cmp.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" @bind="_filterStage" @bind:event="onchange">
                        <option value="">Todas Etapas</option>
                        <option value="PREVENTA">Preventa</option>
                        <option value="VENTA_CREADA">Venta Creada</option>
                        <option value="GESTION_INICIAL">Gestión Inicial</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" @bind="_filterYear" @bind:event="onchange">
                        <option value="0">Año</option>
                        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
                        {
                            var yr = y;
                            <option value="@yr">@yr</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <select class="form-select" @bind="_filterMonth" @bind:event="onchange">
                        <option value="0">Mes</option>
                        <option value="1">Ene</option>
                        <option value="2">Feb</option>
                        <option value="3">Mar</option>
                        <option value="4">Abr</option>
                        <option value="5">May</option>
                        <option value="6">Jun</option>
                        <option value="7">Jul</option>
                        <option value="8">Ago</option>
                        <option value="9">Sep</option>
                        <option value="10">Oct</option>
                        <option value="11">Nov</option>
                        <option value="12">Dic</option>
                    </select>
                </div>
                <div class="col-md-1 text-end">
                    <button class="asesor-cta-btn w-100" style="padding: 8px 14px; font-size: 0.78rem;" @onclick="ApplyFilters">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA UNIFICADA DE HISTÓRICO GENERAL DE GESTIÓN -->
    <div class="table-card mb-4">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Histórico General de Gestión</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5">@_filteredPreSales.Count registros</span>
            </div>
            <div class="small text-muted">
                <i class="bi bi-info-circle text-primary me-1"></i> Las transferencias requieren confirmación del receptor. Una vez aceptada, únicamente el asesor receptor que la aceptó puede revertirla al dueño.
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">N° Gestión / Campaña</th>
                        <th>Cliente</th>
                        <th>Teléfono / Operadores</th>
                        <th>Etapa Nyx Flow</th>
                        <th>Flujo Checkpoints (Anterior · Actual · Siguiente)</th>
                        <th>Asesor Propietario</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                <span class="text-muted fw-semibold">Cargando gestiones del asesor...</span>
                            </td>
                        </tr>
                    }
                    else if (!_filteredPreSales.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox text-muted display-6 d-block mb-2"></i>
                                <h6 class="text-dark fw-bold mb-1">No hay registros de gestión</h6>
                                <p class="text-muted small mb-3">Comienza registrando una nueva Pre-Venta en el sistema.</p>
                                <button class="btn btn-primary rounded-pill px-4" @onclick="OpenNewPreSaleModal">
                                    <i class="bi bi-plus-lg me-1"></i> Registrar Pre-Venta
                                </button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ps in _filteredPreSales)
                        {
                            bool isOwner = ps.OwnerUserId == _currentUserId;
                            bool isAssignedToMe = ps.CurrentUserId == _currentUserId && !isOwner;
                            bool isPendingAccept = ps.AssignmentStatus == "PENDING_ACCEPT";
                            bool isAccepted = ps.AssignmentStatus == "ACCEPTED" || ps.AssignmentStatus == "NONE";

                            bool canCall1 = (!ps.AssignedAdvisor1Id.HasValue && isOwner) || (ps.AssignedAdvisor1Id.HasValue && ps.AssignedAdvisor1Id == _currentUserId && isAccepted);
                            bool canCall2 = ps.Call1Completed && ((!ps.AssignedAdvisor2Id.HasValue && isOwner) || (ps.AssignedAdvisor2Id.HasValue && ps.AssignedAdvisor2Id == _currentUserId && isAccepted));
                            bool canCall3 = ps.Call2Completed && ((!ps.AssignedAdvisor3Id.HasValue && isOwner) || (ps.AssignedAdvisor3Id.HasValue && ps.AssignedAdvisor3Id == _currentUserId && isAccepted));

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-1.5">
                                        <span class="text-primary fw-bold fs-6">#@ps.IdPresale</span>
                                        <span class="nyx-table-badge primary">
                                            @(string.IsNullOrEmpty(ps.CampaignName) ? "Campaña General" : ps.CampaignName)
                                        </span>
                                    </div>
                                    <small class="text-muted d-block mt-0.5">
                                        <i class="bi bi-calendar3 me-1"></i> @ps.Register.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>
                                <td>
                                    @if (isAssignedToMe && isPendingAccept)
                                    {
                                        <div class="text-muted fst-italic small">
                                            <i class="bi bi-shield-lock-fill text-warning me-1"></i> Titular Protegido
                                        </div>
                                        <small class="text-muted">DNI: <code class="text-muted">***-***</code></small>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">
                                            @(string.IsNullOrWhiteSpace(ps.FirstName) && string.IsNullOrWhiteSpace(ps.LastName) ? "Cliente Interesado" : $"{ps.FirstName} {ps.LastName}".Trim())
                                        </div>
                                        <small class="text-muted">DNI: <code class="text-dark">@(string.IsNullOrEmpty(ps.Dni) ? "Pendiente" : ps.Dni)</code></small>
                                    }
                                </td>
                                <td>
                                    @if (isAssignedToMe && isPendingAccept)
                                    {
                                        <div class="nyx-table-badge warning font-monospace">
                                            <i class="bi bi-lock-fill me-1"></i> ***-***-*** (Aceptar para ver)
                                        </div>
                                        <small class="text-muted d-block mt-0.5"><i class="bi bi-building me-1"></i> Op: Protegido</small>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark font-monospace"><i class="bi bi-telephone-fill text-success me-1"></i> @ps.Phone</div>
                                        <div class="small d-flex flex-column gap-0.5 mt-0.5" style="font-size: 0.76rem;">
                                            <span class="text-muted"><i class="bi bi-building me-1"></i> Actual: <strong class="text-dark">@(string.IsNullOrEmpty(ps.Operator) ? "No especificado" : ps.Operator)</strong></span>
                                            <span class="text-muted"><i class="bi bi-arrow-right-circle text-primary me-1"></i> A Gestionar: <strong class="text-primary">@(string.IsNullOrEmpty(ps.TargetOperator) ? "Por definir" : ps.TargetOperator)</strong></span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (ps.IsClosed || ps.IdStatus == 4)
                                    {
                                        <button type="button" class="btn-stage-pill closed" @onclick="() => OpenTimelineModal(ps)" title="Gestión cerrada definitivamente por KO. Clic para ver historial completo.">
                                            <i class="bi bi-x-circle-fill"></i>
                                            <span>⛔ Cerrada / KO</span>
                                            <span class="stage-tag">@(ps.DiscardReason ?? "KO")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        _leadFlowInstances.TryGetValue(ps.IdPresale, out var leadFlow);
                                        long leadStageId = leadFlow?.CurrentStageId ?? 12;
                                        var currentStageObj = _flowStages.FirstOrDefault(s => s.IdStage == leadStageId) 
                                            ?? new StageLookupDto { IdStage = leadStageId, Name = (leadStageId == 12 ? "Preventa" : $"Etapa #{leadStageId}"), OrderIndex = (short)(leadStageId == 12 ? 1 : 2) };
                                        int stageOrder = currentStageObj.OrderIndex > 0 ? currentStageObj.OrderIndex : (leadStageId == 12 ? 1 : 2);
                                        <button type="button" class="btn-stage-pill active" @onclick="() => OpenTimelineModal(ps)" title="Abrir Tracking List 360° con todas las etapas y pasos operativos">
                                            <i class="bi bi-diagram-3-fill"></i>
                                            <span>📍 @currentStageObj.Name</span>
                                            <span class="stage-tag">Etapa @stageOrder/11</span>
                                        </button>
                                    }
                                </td>
                                <td>
                                    <!-- Visualizador de Ventana Deslizante (Anterior · Actual · Siguiente) -->
                                    @{
                                        var cpWindow = GetCheckpointWindow(ps, isOwner, isPendingAccept, canCall1, canCall2, canCall3);
                                    }
                                    <div class="checkpoint-window-container d-flex align-items-center gap-1.5 @((ps.IsClosed || ps.IdStatus == 4) ? "border-danger border-opacity-25 bg-danger bg-opacity-10" : "")">
                                        @if (ps.IsClosed || ps.IdStatus == 4)
                                        {
                                            <!-- Solo se muestra el checkpoint donde cerró (sin previos ni siguientes) -->
                                            <div class="cp-window-item current" title="@cpWindow.Current.ConfirmedStepsTooltip">
                                                <span class="cp-indicator-tag text-danger fw-bold"><i class="bi bi-x-circle-fill me-1"></i> 100% CERRADO (KO)</span>
                                                <div class="cp-item-pill current-pill border border-danger border-opacity-50 bg-white text-danger shadow-xs" title="@cpWindow.Current.ConfirmedStepsTooltip">
                                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                                    <span class="fw-bold">@cpWindow.Current.ShortName</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Checkpoint Anterior -->
                                            @if (cpWindow.Previous != null)
                                            {
                                                <div class="cp-window-item prev" title="@($"Checkpoint anterior completado: {cpWindow.Previous.Name}")">
                                                    <span class="cp-indicator-tag prev-tag">Anterior</span>
                                                    <span class="cp-item-pill prev-pill">
                                                        <i class="bi @cpWindow.Previous.Icon text-success"></i>
                                                        <span>@cpWindow.Previous.ShortName</span>
                                                        <i class="bi bi-check2 text-success fw-bold"></i>
                                                    </span>
                                                </div>
                                                <i class="bi bi-chevron-right text-muted small" style="font-size: 0.65rem; opacity: 0.5;"></i>
                                            }

                                            <div class="cp-window-item current" title="@($"Checkpoint en curso: {cpWindow.Current.Name}")">
                                                <span class="cp-indicator-tag current-tag">Actual (@cpWindow.CurrentStepNum/@cpWindow.TotalSteps)</span>
                                                @if (cpWindow.Current.IsPendingAccept)
                                                {
                                                    <div class="cp-item-pill current-pill pending-accept-pill" title="Asignación pendiente de aceptación">
                                                        <i class="bi bi-hourglass-split"></i>
                                                        <span>@cpWindow.Current.ShortName</span>
                                                        <span class="badge bg-warning text-dark rounded-pill py-0 px-1" style="font-size: 0.6rem;">Pend.</span>
                                                    </div>
                                                }
                                                else if (cpWindow.Current.IsCallable)
                                                {
                                                    @if (cpWindow.Current.Id == 16)
                                                    {
                                                        <div class="cp-item-pill current-pill active-pill" @onclick="() => OpenVentaCreadaModal(ps)" title="Abrir Ficha de Venta (CP #16)" style="border-color: #22C55E; background: #F0FDF4; cursor: pointer;">
                                                            <i class="bi bi-file-earmark-text-fill text-success"></i>
                                                            <span class="fw-bold text-success">Ficha Venta</span>
                                                            <span class="badge bg-success text-white rounded-pill py-0.5 px-1.5" style="font-size: 0.62rem;">
                                                                <i class="bi bi-pencil-square"></i> Abrir Ficha
                                                            </span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="cp-item-pill current-pill active-pill" @onclick="() => OpenCheckpointActionModal(ps, cpWindow.Current.Id, cpWindow.Current.Name)" title="@cpWindow.Current.ConfirmedStepsTooltip">
                                                            <i class="bi @cpWindow.Current.Icon text-primary"></i>
                                                            <span class="fw-bold">@cpWindow.Current.ShortName</span>
                                                            <span class="badge bg-primary text-white rounded-pill py-0.5 px-1.5" style="font-size: 0.62rem;">
                                                                <i class="bi bi-play-fill"></i> Ejecutar
                                                            </span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="cp-item-pill current-pill blocked-pill" title="@(string.IsNullOrEmpty(cpWindow.Current.AssignedAdvisorName) ? "Asignado a otro asesor o en espera" : $"Asignado a: {cpWindow.Current.AssignedAdvisorName}")">
                                                        <i class="bi bi-lock-fill text-secondary"></i>
                                                        <span>@cpWindow.Current.ShortName</span>
                                                    </div>
                                                }
                                            </div>
                                            @if (cpWindow.Next != null)
                                            {
                                                <i class="bi bi-chevron-right text-muted small" style="font-size: 0.65rem; opacity: 0.5;"></i>
                                                <div class="cp-window-item next" title="@($"Siguiente checkpoint: {cpWindow.Next.Name}")">
                                                    <span class="cp-indicator-tag next-tag">Siguiente</span>
                                                    <span class="cp-item-pill next-pill">
                                                        <i class="bi @cpWindow.Next.Icon text-muted"></i>
                                                        <span>@cpWindow.Next.ShortName</span>
                                                        <i class="bi bi-lock text-muted" style="font-size: 0.7rem;"></i>
                                                    </span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex align-items-center justify-content-between gap-1">
                                            <div class="d-flex align-items-center gap-1.5">
                                                <i class="bi bi-person-circle text-primary fs-6"></i>
                                                <div>
                                                    <span class="text-dark fw-bold d-block" style="font-size: 0.85rem;">@(string.IsNullOrEmpty(ps.OwnerUserName) ? $"Asesor #{ps.OwnerUserId}" : ps.OwnerUserName)</span>
                                                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">Dueño</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-inline-flex align-items-center justify-content-center shadow-xs" style="width: 26px; height: 26px;" @onclick="() => OpenAssignmentHistoryModal(ps)" title="Ver Historial de Asignaciones, Aceptaciones y Rechazos">
                                                <i class="bi bi-clock-history" style="font-size: 0.8rem;"></i>
                                            </button>
                                        </div>

                                        @if (ps.CurrentUserId != ps.OwnerUserId || ps.AssignedAdvisor1Id.HasValue || ps.AssignedAdvisor2Id.HasValue || ps.AssignedAdvisor3Id.HasValue || ps.AssignmentStatus == "PENDING_ACCEPT" || ps.AssignmentStatus == "REJECTED")
                                        {
                                            <div class="mt-0.5">
                                                @if (ps.AssignmentStatus == "PENDING_ACCEPT")
                                                {
                                                    <span class="nyx-table-badge warning" style="font-size: 0.68rem;">
                                                        <i class="bi bi-hourglass-split"></i> Derivado: @(ps.AssignedAdvisor1Name ?? ps.AssignedAdvisor2Name ?? ps.AssignedAdvisor3Name ?? $"#{ps.CurrentUserId}") (Pendiente)
                                                    </span>
                                                }
                                                else if (ps.AssignmentStatus == "ACCEPTED")
                                                {
                                                    <span class="nyx-table-badge info" style="font-size: 0.68rem;">
                                                        <i class="bi bi-person-check-fill"></i> Asignado: @(ps.CurrentUserName ?? $"#{ps.CurrentUserId}") (Aceptado)
                                                    </span>
                                                }
                                                else if (ps.AssignmentStatus == "REJECTED")
                                                {
                                                    <span class="nyx-table-badge danger" style="font-size: 0.68rem;" title="Motivo: @ps.AssignmentRejectedReason">
                                                        <i class="bi bi-x-circle-fill"></i> Rechazado: @(ps.AssignmentRejectedReason ?? "Sin motivo")
                                                    </span>
                                                }
                                                else if (ps.AssignmentStatus == "REVERTED")
                                                {
                                                    <span class="nyx-table-badge secondary" style="font-size: 0.68rem;">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Revertido al Dueño
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group align-items-center">
                                        @if (ps.IsClosed || ps.IdStatus == 4)
                                        {
                                            <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5" style="font-size: 0.76rem;" title="Gestión finalizada y cerrada al 100% por resultado KO / No Contesta.">
                                                <i class="bi bi-lock-fill"></i> Gestión Finalizada (KO)
                                            </span>
                                        }
                                        else
                                        {
                                            if (isOwner && isPendingAccept)
                                            {
                                                <button class="btn btn-sm btn-danger rounded-pill px-2.5 me-1 text-white shadow-sm" @onclick="() => CancelAssignment(ps.IdPresale)" title="Cancelar la derivación enviada por error (El receptor aún no acepta)">
                                                    <i class="bi bi-x-circle-fill me-1"></i> Cancelar Envío
                                                </button>
                                            }

                                            _leadFlowInstances.TryGetValue(ps.IdPresale, out var leadFlowForAction);
                                            long currentStageIdForAction = leadFlowForAction?.CurrentStageId ?? 12;
                                            bool isStage2OrHigher = currentStageIdForAction >= 13 || ps.IdStatus == 3;

                                            if (isStage2OrHigher)
                                            {
                                                <button type="button" class="btn-ficha-action me-1 shadow-xs" @onclick="() => OpenFichaModal(ps)" title="Ver / Gestionar Ficha de Venta Completa (Toma de Datos, Operadores, Cobertura)">
                                                    <i class="bi bi-file-earmark-text-fill"></i>
                                                    <span>Ficha</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn-memo-note me-1 shadow-xs" @onclick="() => OpenEditModal(ps)" title="Ver / Editar Nota y Datos del Caso">
                                                    <i class="bi bi-sticky-fill"></i>
                                                    <span>Nota</span>
                                                </button>
                                            }

                                            @if (isOwner)
                                            {
                                                @if (ps.AssignmentStatus != "ACCEPTED")
                                                {
                                                    <button class="btn-assign-action me-1 shadow-xs" @onclick="() => OpenAssignModal(ps)" title="Derivar / Asignar con Confirmación Obligatoria">
                                                        <i class="bi bi-people-fill"></i>
                                                        <span>Asignar</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-light text-muted border rounded-pill px-2.5 me-1" disabled title="Transferencia aceptada por el asesor receptor. Sólo el asesor receptor puede revertir la gestión al dueño.">
                                                        <i class="bi bi-lock-fill me-1"></i> Asignado
                                                    </button>
                                                }
                                            }
                                            else if (isAssignedToMe && ps.AssignmentStatus == "ACCEPTED")
                                            {
                                                <button class="btn-revert-action me-1 shadow-xs" @onclick="() => PromptRevertModal(ps)" title="Revertir y Devolver Gestión al Propietario Original (Conserva la bitácora intacta)">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                    <span>Devolver</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-light text-muted border rounded-pill px-2.5 me-1" disabled title="Sólo el dueño puede reasignar">
                                                    <i class="bi bi-lock-fill me-1"></i> Asignar
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL DE DERIVACIÓN ENTRANTE: ESTILO CORPORATIVO Y ATENCIÓN EJECUTIVA -->
<!-- ========================================================================= -->
@if (_incomingHandshake != null && !_tempHideHandshake)
{
    <div class="aggressive-handshake-overlay">
        <div class="aggressive-handshake-box">
            <div class="handshake-alarm-header">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge" style="background: rgba(37, 99, 235, 0.25); color: #93C5FD; border: 1px solid rgba(59, 130, 246, 0.35); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.5px;">
                        <i class="bi bi-arrow-left-right me-1"></i> DERIVACIÓN DE ASESOR
                    </span>
                    <span class="badge" style="background: #1E293B; color: #E2E8F0; font-size: 0.72rem;">
                        <i class="bi bi-clock me-1"></i> Atención Requerida
                    </span>
                </div>
                <h4 class="fw-bold mb-1 text-white" style="letter-spacing: -0.3px;">
                    <i class="bi bi-telephone-inbound-fill text-primary me-2"></i>Nueva Gestión Asignada
                </h4>
                <p class="small mb-0" style="color: #94A3B8;">Confirmación obligatoria para toma de titularidad y atención de llamada.</p>
            </div>

            <div class="p-4">
                <div class="rounded-3 border mb-3 p-3" style="background: #F8FAFC; border-color: #E2E8F0 !important;">
                    <div class="row g-3 small">
                        <div class="col-6">
                            <span class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Pre-Venta ID</span>
                            <strong class="fs-6 font-monospace" style="color: #0F172A;">#@_incomingHandshake.IdPresale</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Asesor Remitente</span>
                            <strong class="fs-6" style="color: #0F172A;"><i class="bi bi-person-circle text-primary me-1"></i>@_incomingHandshake.OwnerUserName</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Campaña / Cartera</span>
                            <span class="badge" style="background: #E2E8F0; color: #1E293B; font-weight: 600;">@(_incomingHandshake.CampaignName ?? "Telecom")</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Paso Operativo</span>
                            <span class="badge" style="background: #DBEAFE; color: #1E40AF; font-weight: 600;">
                                @(!_incomingHandshake.Call1Completed ? "1ª Llamada (1ª Cía)" : !_incomingHandshake.Call2Completed ? "2ª Llamada (2ª Cía)" : "3ª Llamada (3ª Cía)")
                            </span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Operador Actual</span>
                            <strong class="text-dark"><i class="bi bi-building me-1"></i>@(string.IsNullOrEmpty(_incomingHandshake.Operator) ? "No especificado" : _incomingHandshake.Operator)</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Operador a Gestionar</span>
                            <strong class="text-primary"><i class="bi bi-arrow-right-circle me-1"></i>@(string.IsNullOrEmpty(_incomingHandshake.TargetOperator) ? "Por definir" : _incomingHandshake.TargetOperator)</strong>
                        </div>
                        <div class="col-12 pt-2 border-top" style="border-color: #E2E8F0 !important;">
                            <div class="d-flex align-items-center gap-2 p-2 rounded-2" style="background: #EDF2F7; border: 1px solid #CBD5E1;">
                                <i class="bi bi-shield-lock-fill text-secondary fs-5"></i>
                                <div>
                                    <span class="fw-bold d-block text-dark" style="font-size: 0.78rem;">Datos de Contacto y Teléfono Protegidos</span>
                                    <span class="text-muted" style="font-size: 0.72rem;">El número telefónico y detalles del cliente se desbloquearán inmediatamente al pulsar <strong>Aceptar Gestión</strong>.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (_showRejectReasonInput)
                {
                    <div class="mb-3 p-3 rounded-3" style="background: #FEF2F2; border: 1px solid #FECACA;">
                        <label class="form-label fw-bold small text-danger mb-1">Indica el motivo de rechazo (Regresará al propietario):</label>
                        <select class="form-select rounded-2 mb-2" @bind="_rejectReason">
                            <option value="Fuera de turno o descanso">Fuera de turno o descanso</option>
                            <option value="En llamada activa con otro cliente">En llamada activa con otro cliente</option>
                            <option value="No corresponde a mi campaña">No corresponde a mi campaña</option>
                            <option value="Otro motivo operativo">Otro motivo operativo</option>
                        </select>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-light border rounded-2" @onclick="() => _showRejectReasonInput = false">Cancelar</button>
                            <button type="button" class="btn btn-sm btn-danger rounded-2 px-3" @onclick="SubmitRejectAssignment" disabled="@_isSaving">
                                @if(_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Confirmar Rechazo
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-lg rounded-3 py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: #1E40AF; color: #FFFFFF; border: none;" @onclick="AcceptIncomingHandshake" disabled="@_isSaving">
                            @if(_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Aceptar Gestión y Abrir Ficha</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-3 py-2 fw-semibold text-secondary" style="border-color: #CBD5E1;" @onclick="() => _showRejectReasonInput = true" disabled="@_isSaving">
                            <i class="bi bi-x-lg me-1"></i> Rechazar Derivación (Devolver al Propietario)
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- MODAL: DEVOLVER GESTIÓN AL PROPIETARIO ORIGINAL (SOLO ASESOR RECEPTOR) -->
@if (_showRevertModal && _selectedPreSale != null)
{
    <div class="venta-modal-overlay">
        <div class="aggressive-handshake-box">
            <div class="modal-header border-0 pb-2 px-4 pt-4 bg-danger text-white">
                <div>
                    <h5 class="modal-title fw-bold text-white mb-0" style="font-family: var(--font-display); letter-spacing: -0.02em;">
                        <i class="bi bi-arrow-counterclockwise me-2"></i> Devolver Gestión al Propietario
                    </h5>
                    <p class="small text-white-50 mb-0">Pre-Venta #@_selectedPreSale.IdPresale — @_selectedPreSale.FirstName @_selectedPreSale.LastName</p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => _showRevertModal = false" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body p-4" style="background: var(--nyx-paper);">
                <div class="p-3 rounded-3 small d-flex align-items-center gap-2 mb-3" style="background: var(--nyx-info-bg); border: 1px solid rgba(0, 152, 242, 0.2);">
                    <i class="bi bi-info-circle-fill fs-5 flex-shrink-0" style="color: var(--nyx-electric);"></i>
                    <div style="color: var(--nyx-ink);">
                        La gestión de la llamada será devuelta a su propietario original: <strong>@(_selectedPreSale.OwnerUserName ?? $"Asesor #{_selectedPreSale.OwnerUserId}")</strong>. Toda la bitácora de llamadas y notas guardadas se mantendrá <strong>100% intacta e inmutable</strong>.
                    </div>
                </div>
                <div class="mb-3">
                    <label class="venta-field-label">Motivo o Contexto de la Devolución <span class="text-danger">*</span></label>
                    <textarea class="venta-field-input" rows="3" @bind="_revertContext" placeholder="Describe el motivo de la devolución al propietario original (ej. 'Cliente prefiere coordinar con su asesor inicial', 'No hubo contacto tras reintentos', etc.)..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4" style="background: var(--nyx-paper);">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => _showRevertModal = false" disabled="@_isSaving">Cancelar</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" @onclick="SubmitRevertAssignment" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_revertContext))">
                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Devolviendo...</span> }
                    else { <span><i class="bi bi-arrow-counterclockwise me-1"></i> Confirmar Devolución al Dueño</span> }
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL: NOTA DE PRE-VENTA (FORMA DE NOTA CON CLIP METÁLICO) -->
@if (_showNewModal)
{
    <div class="venta-modal-overlay">
        <div class="memo-modal-box" style="max-width: 780px;">
            <!-- Clip Metálico Realista -->
            <div class="memo-metallic-clip" title="Nota sujeta con clip metálico"></div>

            <div class="memo-header">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="nyx-badge warning" style="background: #fef3c7; color: #b45309; border: 1px solid #fde68a;">
                            <i class="bi bi-sticky-fill"></i> @(_isEditing ? $"Nota del Caso" : "Nueva Nota")
                        </span>
                        <span class="nyx-badge neutral font-monospace" style="background: #fdf6b2; color: #723b10;">
                            @(_isEditing ? $"#Pre-Venta {_currentPreSale.IdPresale}" : "1ª Etapa · Preventa")
                        </span>
                        @if (_isEditing)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill d-inline-flex align-items-center gap-1.5 py-0.5 px-2" style="font-size: 0.68rem;" title="Sincronización suave activa en segundo plano">
                                <span class="spinner-grow spinner-grow-sm text-success" style="width: 7px; height: 7px; animation-duration: 2.5s;" role="status"></span>
                                <span>Sincronización en vivo</span>
                            </span>
                        }
                    </div>
                    <h5 style="font-family: var(--font-display); font-weight: 700; color: #78350f; letter-spacing: -0.02em; margin-bottom: 2px;">
                        <i class="bi bi-journal-text me-1 text-warning"></i>
                        @(_isEditing ? $"Nota y Datos de Pre-Venta #{_currentPreSale.IdPresale}" : "Registrar Nueva Nota y Pre-Venta")
                    </h5>
                    <p style="font-size: 0.80rem; color: #92400e; margin-bottom: 0;">
                        Documento colaborativo y compartido. Las notas se actualizan automáticamente en tiempo real entre asesores.
                    </p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseMemoModal" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="memo-body">
                @if (!string.IsNullOrEmpty(_remoteNotesNotice))
                {
                    <div class="alert alert-warning py-1.5 px-3 mb-3 d-flex align-items-center justify-content-between rounded-3 border" style="font-size: 0.76rem;">
                        <div class="d-flex align-items-center gap-1.5">
                            <i class="bi bi-info-circle-fill text-warning"></i>
                            <span>@_remoteNotesNotice</span>
                        </div>
                        <button type="button" class="btn btn-xs btn-warning text-dark fw-bold rounded-pill px-2.5 py-0.5" style="font-size: 0.70rem;" @onclick="ApplyRemoteNotes">
                            Actualizar ahora
                        </button>
                    </div>
                }

                <div class="memo-card-field mb-0">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="venta-field-label">Campaña Comercial <span class="text-danger">*</span></label>
                            <select class="venta-field-input" @bind="_currentPreSale.IdCmpg">
                                @foreach (var cmp in _campaigns)
                                {
                                    <option value="@cmp.Id">@cmp.Name</option>
                                }
                            </select>
                            <div class="text-muted small mt-1" style="font-size: 0.70rem;">Campaña a la que pertenece la oferta.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label">Operador Actual del Cliente</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.Operator" @oninput="OnUserTypingMemo" placeholder="Ej. Movistar, Orange, Vodafone..." />
                            <div class="text-muted small mt-1" style="font-size: 0.70rem;">Compañía que tiene actualmente contratada el cliente.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label">Operador a Gestionar / Ofertar <span class="text-danger">*</span></label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.TargetOperator" @oninput="OnUserTypingMemo" placeholder="Ej. Digi, MásMóvil, Lowi, Finetwork..." />
                            <div class="text-muted small mt-1" style="font-size: 0.70rem;">Compañía / producto que se va a ofertar y tramitar.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label">Teléfono Principal <span class="text-danger">*</span></label>
                            <input type="text" class="venta-field-input font-monospace" @bind="_currentPreSale.Phone" @oninput="OnUserTypingMemo" placeholder="Ej. 611223344" />
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label">Nombre del Titular</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.FirstName" @oninput="OnUserTypingMemo" placeholder="Nombre" />
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label">Apellido del Titular</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.LastName" @oninput="OnUserTypingMemo" placeholder="Apellido" />
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label"><i class="bi bi-card-text text-primary me-1"></i> Documento (DNI / NIE / CIF)</label>
                            <input type="text" class="venta-field-input font-monospace text-uppercase" @bind="_currentPreSale.Dni" @oninput="OnUserTypingMemo" placeholder="Ej. 12345678Z / Y1234567A" />
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label">Teléfono Secundario / Alterno (Opcional)</label>
                            <input type="text" class="venta-field-input font-monospace" @bind="_currentPreSale.SecondaryPhone" @oninput="OnUserTypingMemo" placeholder="Opcional" />
                        </div>
                        <div class="col-md-8">
                            <label class="venta-field-label"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Dirección del Cliente</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.Address" @oninput="OnUserTypingMemo" placeholder="Ej. Calle Mayor 14, 2º B / Av. Principal 123" />
                            <div class="text-muted small mt-1" style="font-size: 0.70rem;">Dirección completa de instalación o contacto del cliente.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="venta-field-label"><i class="bi bi-map-fill text-primary me-1"></i> Población / Provincia</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.Province" @oninput="OnUserTypingMemo" placeholder="Ej. Madrid, Barcelona..." />
                        </div>
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="venta-field-label mb-0"><i class="bi bi-pencil-square text-warning me-1"></i> Notas y Observaciones de la Preventa</label>
                                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning rounded-pill" style="font-size: 0.65rem;">Memo Colaborativo</span>
                            </div>
                            <textarea class="venta-field-input" rows="4" @bind="_currentPreSale.Notes" @oninput="OnUserTypingMemo" placeholder="Escribe observaciones generales, requerimientos u oferta acordada con el cliente..." style="border-left: 4px solid #f59e0b; background: #ffffff;"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="p-3 px-4 border-top d-flex align-items-center justify-content-between gap-2" style="background: rgba(254, 243, 199, 0.4); border-color: rgba(217, 119, 6, 0.2) !important; border-radius: 0 0 14px 14px;">
                <div>
                    @if (_returnToCheckpointModal || _returnToHandshakeModal)
                    {
                        <button type="button" class="btn btn-primary rounded-pill px-3 py-1.5 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" @onclick="ReturnToCallerModal">
                            <i class="bi bi-arrow-left-circle-fill"></i>
                            <span>Regresar a la Llamada</span>
                        </button>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseMemoModal" disabled="@_isSaving">Cancelar</button>
                    <button type="button" class="asesor-cta-btn" style="background: #92400e; color: #ffffff;" @onclick="SavePreSale" disabled="@_isSaving">
                        @if(_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Guardando...</span> }
                        else { <span><i class="bi bi-check2-circle me-1"></i> @(_isEditing ? "Guardar Nota" : "Crear Nota y Pre-Venta")</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL DE FICHA INTEGRAL DEL CLIENTE (ETAPA 2 EN ADELANTE - VENTA CREADA)  -->
<!-- ========================================================================= -->
@if (_showFichaModal && _currentPreSale != null)
{
    <div class="venta-modal-overlay">
        <div class="venta-modal-box" style="max-width: 880px;">
            <!-- Modal Header -->
            <div class="venta-modal-header" style="border-bottom: 2px solid #10b981;">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1.5 flex-wrap">
                        <span class="nyx-table-badge success">
                            <i class="bi bi-file-earmark-text-fill"></i> Ficha Integral del Cliente
                        </span>
                        <span class="nyx-table-badge primary font-monospace">
                            #Pre-Venta @_currentPreSale.IdPresale
                        </span>
                        <span class="nyx-table-badge neutral">
                            <i class="bi bi-person-circle me-1"></i> Dueño: @(string.IsNullOrEmpty(_currentPreSale.OwnerUserName) ? $"Asesor #{_currentPreSale.OwnerUserId}" : _currentPreSale.OwnerUserName)
                        </span>
                    </div>
                    <h4 style="font-family: var(--font-display); font-weight: 700; color: var(--nyx-ink); letter-spacing: -0.03em; margin-bottom: 2px;">
                        Ficha Comercial y Expediente del Cliente
                    </h4>
                    <p style="font-size: 0.80rem; color: var(--nyx-smoke); margin-bottom: 0;">
                        Visualización, actualización y modificación de datos del titular, dirección de instalación, operadores y notas del caso.
                    </p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseFichaModal" title="Cerrar Ficha">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="venta-modal-body">
                <!-- 1. Datos del Titular y Contacto -->
                <div class="venta-section-card">
                    <div class="venta-section-title">
                        <i class="bi bi-person-vcard text-success"></i>
                        <span>1. Datos del Titular y Contacto</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="venta-field-label">Nombre del Titular <span class="text-danger">*</span></label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.FirstName" placeholder="Nombre de pila del titular" />
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label">Apellidos del Titular <span class="text-danger">*</span></label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.LastName" placeholder="Apellidos completos" />
                        </div>
                        <div class="col-md-4">
                            <label class="venta-field-label"><i class="bi bi-card-text text-primary me-1"></i> DNI / NIE / CIF</label>
                            <input type="text" class="venta-field-input font-monospace text-uppercase" @bind="_currentPreSale.Dni" placeholder="Ej. 12345678Z" />
                        </div>
                        <div class="col-md-4">
                            <label class="venta-field-label"><i class="bi bi-telephone-fill text-success me-1"></i> Teléfono Principal <span class="text-danger">*</span></label>
                            <input type="text" class="venta-field-input font-monospace" @bind="_currentPreSale.Phone" placeholder="Ej. 611223344" />
                        </div>
                        <div class="col-md-4">
                            <label class="venta-field-label">Teléfono Secundario (Opcional)</label>
                            <input type="text" class="venta-field-input font-monospace" @bind="_currentPreSale.SecondaryPhone" placeholder="Opcional" />
                        </div>
                        <div class="col-md-8">
                            <label class="venta-field-label"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Dirección Completa de Instalación</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.Address" placeholder="Ej. Calle Mayor 14, 2º B" />
                        </div>
                        <div class="col-md-4">
                            <label class="venta-field-label"><i class="bi bi-map-fill text-primary me-1"></i> Población / Provincia</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.Province" placeholder="Ej. Madrid, Barcelona..." />
                        </div>
                    </div>
                </div>

                <!-- 2. Oferta, Operadores y Cobertura -->
                <div class="venta-section-card">
                    <div class="venta-section-title">
                        <i class="bi bi-diagram-3 text-primary"></i>
                        <span>2. Operadores, Campaña Comercial y Cobertura</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="venta-field-label">Campaña Comercial</label>
                            <select class="venta-field-input" @bind="_currentPreSale.IdCmpg">
                                @foreach (var cmp in _campaigns)
                                {
                                    <option value="@cmp.Id">@cmp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="venta-field-label">Operador Actual del Cliente</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.Operator" placeholder="Ej. Movistar, Orange, Vodafone..." />
                        </div>
                        <div class="col-md-4">
                            <label class="venta-field-label">Operador a Tramitar / Ofertar <span class="text-danger">*</span></label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.TargetOperator" placeholder="Ej. Digi, MásMóvil, Lowi..." />
                        </div>
                        <div class="col-md-6">
                            <label class="venta-field-label"><i class="bi bi-broadcast-pin text-primary me-1"></i> Estado de Cobertura</label>
                            <input type="text" class="venta-field-input" @bind="_currentPreSale.CoverageStatus" placeholder="Ej. DIRECTA FIBRA 1GB, NEBA, SIN COBERTURA..." />
                        </div>
                    </div>
                </div>

                <!-- 3. Observaciones y Notas de la Gestión -->
                <div class="venta-section-card mb-0">
                    <div class="venta-section-title">
                        <i class="bi bi-journal-text text-warning"></i>
                        <span>3. Observaciones y Notas de la Gestión</span>
                    </div>
                    <textarea class="venta-field-input" rows="4" @bind="_currentPreSale.Notes" placeholder="Escribe observaciones, requerimientos del cliente o acuerdos de la gestión..." style="border-left: 4px solid #10b981; background: #ffffff;"></textarea>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="p-3 px-4 border-top d-flex align-items-center justify-content-between gap-2" style="background: var(--nyx-paper);">
                <div>
                    @if (_returnToCheckpointModal)
                    {
                        <button type="button" class="btn btn-primary rounded-pill px-3.5 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" @onclick="ReturnToCallerModal">
                            <i class="bi bi-arrow-left-circle-fill"></i>
                            <span>Regresar a la Gestión</span>
                        </button>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" @onclick="CloseFichaModal" disabled="@_isSaving">Cancelar</button>
                    <button type="button" class="asesor-cta-btn" style="background: #059669; color: #ffffff;" @onclick="SaveFichaAsync" disabled="@_isSaving">
                        @if(_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Guardando...</span> }
                        else { <span><i class="bi bi-check2-circle me-1"></i> Guardar Ficha</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: EJECUTAR CHECKPOINT DE LLAMADA CON PASOS INTERACTIVOS -->
@if (_showCheckpointModal && _selectedPreSale != null)
{
    <div class="venta-modal-overlay">
        <div class="venta-modal-box" style="max-width: 860px;">
            <div class="venta-modal-header">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="nyx-badge primary">
                            <i class="bi bi-play-circle-fill"></i> Ficha de Llamada &amp; Checkpoint
                        </span>
                        <span class="nyx-badge neutral font-monospace">
                            #@_selectedCheckpointId
                        </span>
                        <span class="nyx-badge success font-monospace">
                            Pre-Venta #@_selectedPreSale.IdPresale
                        </span>
                    </div>
                    <h4 style="font-family: var(--font-display); font-weight: 700; color: var(--nyx-ink); letter-spacing: -0.03em; margin-bottom: 2px;">
                        @_selectedCheckpointName
                    </h4>
                    <p style="font-size: 0.80rem; color: var(--nyx-smoke); margin-bottom: 0;">
                        Cliente: <strong style="color: var(--nyx-ink);">@_selectedPreSale.FirstName @_selectedPreSale.LastName</strong> | Tel: <strong style="color: var(--nyx-electric);">@_selectedPreSale.Phone</strong>
                        @if (!string.IsNullOrEmpty(_selectedPreSale.Dni))
                        {
                            <span> | Doc: <strong class="text-primary font-monospace">@_selectedPreSale.Dni</strong></span>
                        }
                        @if (!string.IsNullOrEmpty(_selectedPreSale.Address))
                        {
                            <span> | Dir: <strong class="text-dark">@_selectedPreSale.Address</strong></span>
                        }
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @{
                        _leadFlowInstances.TryGetValue(_selectedPreSale.IdPresale, out var activeFlowForModal);
                        long stageForModal = activeFlowForModal?.CurrentStageId ?? 12;
                        bool isStage2OrHigherForModal = stageForModal >= 13 || _selectedPreSale.IdStatus == 3;
                    }
                    @if (isStage2OrHigherForModal)
                    {
                        <button type="button" class="btn btn-sm btn-success text-white fw-bold rounded-pill px-3 py-1.5 shadow-xs d-inline-flex align-items-center gap-1.5" @onclick="() => OpenFichaFromCallModal(_selectedPreSale)" title="Abrir y consultar o editar la Ficha de Venta del cliente en vivo">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>Ver / Editar Ficha</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 py-1.5 shadow-xs d-inline-flex align-items-center gap-1.5" @onclick="() => OpenMemoFromCallModal(_selectedPreSale)" title="Abrir y consultar o editar la nota y datos de contacto en vivo">
                            <i class="bi bi-sticky-fill"></i>
                            <span>Ver / Editar Nota</span>
                        </button>
                    }
                    <button type="button" class="btn-close-modal" @onclick="() => _showCheckpointModal = false" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <div class="venta-modal-body">
                <!-- Ficha Resumen de Contacto -->
                <div class="venta-section-card">
                    <div class="row g-3 small">
                        <div class="col-md-4">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke); display: block; margin-bottom: 2px;">Teléfono Principal</span>
                            <span class="fs-5 fw-bold font-monospace" style="color: var(--nyx-electric);"><i class="bi bi-telephone-fill me-1" style="color: var(--nyx-leaf);"></i>@_selectedPreSale.Phone</span>
                        </div>
                        <div class="col-md-4">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke); display: block; margin-bottom: 2px;">Documento (DNI/NIE/CIF)</span>
                            <span class="fs-6 fw-bold font-monospace" style="color: var(--nyx-ink);"><i class="bi bi-card-text me-1 text-primary"></i>@(string.IsNullOrEmpty(_selectedPreSale.Dni) ? "No especificado" : _selectedPreSale.Dni)</span>
                        </div>
                        <div class="col-md-4">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke); display: block; margin-bottom: 2px;">Campaña / Cartera</span>
                            <span class="nyx-badge neutral" style="font-size: 0.8rem;">@(_selectedPreSale.CampaignName ?? "Telecom")</span>
                        </div>
                        <div class="col-md-6 pt-2 border-top" style="border-color: var(--nyx-hairline) !important;">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke); display: block;">Dirección del Cliente</span>
                            <strong style="color: var(--nyx-ink);"><i class="bi bi-geo-alt-fill me-1 text-danger"></i>@(string.IsNullOrEmpty(_selectedPreSale.Address) ? "No especificada" : $"{_selectedPreSale.Address} ({_selectedPreSale.Province})")</strong>
                        </div>
                        <div class="col-md-3 pt-2 border-top" style="border-color: var(--nyx-hairline) !important;">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke); display: block;">Operador Actual</span>
                            <strong style="color: var(--nyx-ink);"><i class="bi bi-building me-1"></i>@(string.IsNullOrEmpty(_selectedPreSale.Operator) ? "No especificado" : _selectedPreSale.Operator)</strong>
                        </div>
                        <div class="col-md-3 pt-2 border-top" style="border-color: var(--nyx-hairline) !important;">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke); display: block;">Operador a Gestionar</span>
                            <strong style="color: var(--nyx-electric);"><i class="bi bi-arrow-right-circle me-1"></i>@(string.IsNullOrEmpty(_selectedPreSale.TargetOperator) ? "Por definir" : _selectedPreSale.TargetOperator)</strong>
                        </div>
                    </div>
                </div>

                <!-- Checklist de Pasos a Realizar -->
                <div class="venta-section-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="venta-section-title mb-0 border-0 pb-0">
                            <i class="bi bi-ui-checks" style="color: var(--nyx-electric);"></i>
                            <span>Pasos Operativos a Cumplir (@(_activeExecutionSteps.Count(s => s.IsCompleted))/@_activeExecutionSteps.Count)</span>
                        </div>
                        @if (RequiredStepsPendingCount > 0)
                        {
                            <span class="nyx-badge warning">
                                <i class="bi bi-exclamation-triangle-fill"></i> @RequiredStepsPendingCount obligatorio(s) pendiente(s)
                            </span>
                        }
                        else
                        {
                            <span class="nyx-badge success">
                                <i class="bi bi-check-circle-fill"></i> 100% Pasos Realizados
                            </span>
                        }
                    </div>
                    <p style="font-size: 0.78rem; color: var(--nyx-smoke); margin-bottom: 8px;">Marca los pasos completados durante la llamada según la directiva del checkpoint:</p>
                    
                    <div class="list-group list-group-flush rounded-3 border mb-2">
                        @foreach (var step in _activeExecutionSteps.OrderBy(s => s.StepOrder))
                        {
                            <label class="list-group-item d-flex align-items-center gap-3 py-2.5 px-3 cursor-pointer @(step.IsCompleted ? "bg-success bg-opacity-10" : "bg-white")" style="transition: all 0.15s ease; border-color: var(--nyx-hairline);">
                                <input class="form-check-input flex-shrink-0 m-0" type="checkbox" checked="@step.IsCompleted" @onchange="() => ToggleExecutionStep(step)" style="width: 1.25rem; height: 1.25rem; cursor: pointer;" />
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-dark bg-opacity-10 text-dark rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 0.68rem; font-weight: 700;">
                                            @step.StepOrder
                                        </span>
                                        <span class="fw-semibold @(step.IsCompleted ? "text-success text-decoration-line-through" : "text-dark")" style="font-size: 0.84rem;">
                                            @step.Name
                                        </span>
                                    </div>
                                </div>
                                @if (step.IsRequired)
                                {
                                    <span class="nyx-badge warning" style="font-size: 0.65rem;">Obligatorio</span>
                                }
                            </label>
                        }
                    </div>

                    @if (!CanApproveCheckpoint)
                    {
                        <div class="p-2 rounded-2 small d-flex align-items-center gap-2" style="background: var(--nyx-warning-bg); border: 1px solid rgba(245, 158, 11, 0.2); font-size: 0.76rem; color: #92400e;">
                            <i class="bi bi-lock-fill fs-6"></i>
                            <span><strong>Aprobación protegida:</strong> Completa todos los pasos obligatorios (@RequiredStepsPendingCount pendiente) para habilitar el avance / aprobación.</span>
                        </div>
                    }
                </div>

                <!-- Resultado Estandarizado de la Gestión -->
                <div class="venta-section-card mb-0">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="venta-section-title mb-0 border-0 pb-0">
                            <i class="bi bi-diagram-3" style="color: var(--nyx-electric);"></i>
                            <span>Resultado de la Gestión</span>
                        </div>
                        <span class="nyx-badge @(_selectedCheckpointStatus == "COMPLETADO" ? "success" : _selectedCheckpointStatus == "KO" ? "error" : "warning")">
                            @(_selectedCheckpointStatus == "PENDIENTE" ? (_hasExplicitStatusSelection ? "Seleccionado: PENDIENTE" : "Estado Base (Por Defecto)") : $"Seleccionado: {_selectedCheckpointStatus}")
                        </span>
                    </div>

                    <!-- Panel Visual de Estado (Precargado con Estado Base Pendiente) -->
                    <div class="p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between border @(_selectedCheckpointStatus == "COMPLETADO" ? "bg-success bg-opacity-10 border-success border-opacity-25" : _selectedCheckpointStatus == "KO" ? "bg-danger bg-opacity-10 border-danger border-opacity-25" : "bg-warning bg-opacity-10 border-warning border-opacity-25")" style="animation: fadeIn 0.2s ease;">
                        <div class="d-flex align-items-center gap-2.5">
                            <span class="fs-4">
                                @if (_selectedCheckpointStatus == "COMPLETADO") { <i class="bi bi-check-circle-fill text-success"></i> }
                                else if (_selectedCheckpointStatus == "KO") { <i class="bi bi-x-circle-fill text-danger"></i> }
                                else { <i class="bi bi-hourglass-split text-warning"></i> }
                            </span>
                            <div>
                                <div class="fw-bold" style="font-size: 0.88rem; color: var(--nyx-ink);">
                                    Estado del Checkpoint: 
                                    <span class="@(_selectedCheckpointStatus == "COMPLETADO" ? "text-success" : _selectedCheckpointStatus == "KO" ? "text-danger" : "text-warning")">
                                        @(_selectedCheckpointStatus == "PENDIENTE" ? (_hasExplicitStatusSelection ? "PENDIENTE (EN ESPERA)" : "EN ESPERA (Estado Base · Sin Gestión)") : _selectedCheckpointStatus)
                                    </span>
                                </div>
                                <div class="text-muted" style="font-size: 0.74rem;">
                                    @if (_selectedCheckpointStatus == "COMPLETADO") { <span><i class="bi bi-arrow-right-circle-fill text-success me-1"></i>Acción: <strong>Avanzará al siguiente Checkpoint</strong> en el flujo de trabajo.</span> }
                                    else if (_selectedCheckpointStatus == "KO") { <span><i class="bi bi-x-circle-fill text-danger me-1"></i>Acción: <strong>Cierre definitivo</strong> del expediente por descarte o rechazo.</span> }
                                    else { <span><i class="bi bi-pause-circle-fill text-warning me-1"></i>Acción: <strong>Sin avance ni cierre</strong>. Registra la bitácora del intento y mantiene el checkpoint activo para reintentar la llamada.</span> }
                                </div>
                            </div>
                        </div>
                        <span class="badge @(_selectedCheckpointStatus == "COMPLETADO" ? "bg-success" : _selectedCheckpointStatus == "KO" ? "bg-danger" : "bg-warning text-dark") rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.74rem;">
                            @(_selectedCheckpointStatus == "PENDIENTE" ? (_hasExplicitStatusSelection ? "EN ESPERA" : "ESTADO BASE") : _selectedCheckpointStatus)
                        </span>
                    </div>

                    <!-- BOTONERA DE ACCIÓN DIRECTA: COMPLETADO · OBSERVADO/KO -->
                    <div class="row g-2 mb-3 pt-1">
                        <!-- 1. COMPLETADO (Éxito / Avance de Flujo) -->
                        <div class="col-12 col-md-6">
                            <button type="button" class="btn w-100 py-2.5 rounded-3 fw-bold d-flex flex-column align-items-center justify-content-center gap-1 shadow-xs" 
                                    style="@(CanApproveCheckpoint ? (_selectedCheckpointStatus == "COMPLETADO" ? "background: #16A34A !important; color: #FFFFFF !important; border: 1.5px solid #15803D !important;" : "background: #F0FDF4 !important; color: #166534 !important; border: 1.5px solid #86EFAC !important;") : "background: #F1F5F9 !important; color: #94A3B8 !important; border: 1.5px solid #CBD5E1 !important; opacity: 0.6;")"
                                    disabled="@(!CanApproveCheckpoint)" 
                                    @onclick='() => SetCheckpointResult("COMPLETADO", "Llamada completada con éxito. Requisitos y pasos verificados. Avanza en el flujo.")'>
                                <div class="d-flex align-items-center gap-1.5 fs-6">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Completado</span>
                                </div>
                                <small style="font-size: 0.68rem; font-weight: 500; opacity: 0.9;">Avanza de Checkpoint / Etapa</small>
                            </button>
                        </div>

                        <!-- 2. OBSERVADO / KO (Rechazado / Descarte Definitivo) -->
                        <div class="col-12 col-md-6">
                            <button type="button" class="btn w-100 py-2.5 rounded-3 fw-bold d-flex flex-column align-items-center justify-content-center gap-1 shadow-xs" 
                                    style="@(_selectedCheckpointStatus == "KO" ? "background: #DC2626 !important; color: #FFFFFF !important; border: 1.5px solid #B91C1C !important;" : "background: #FEF2F2 !important; color: #991B1B !important; border: 1.5px solid #FCA5A5 !important;")"
                                    @onclick='() => SetCheckpointResult("KO", "Llamada observada / Cliente rechaza o no cumple requisitos. Cierre definitivo por KO.")'>
                                <div class="d-flex align-items-center gap-1.5 fs-6">
                                    <i class="bi bi-x-circle-fill"></i>
                                    <span>Observado / KO</span>
                                </div>
                                <small style="font-size: 0.68rem; font-weight: 500; opacity: 0.9;">Cierre Definitivo por Descarte</small>
                            </button>
                        </div>
                    </div>

                    @if (_selectedCheckpointId == 75 || _selectedCheckpointId == 15 || _selectedCheckpointName.Contains("Botada", StringComparison.OrdinalIgnoreCase) || _selectedCheckpointName.Contains("Cambio", StringComparison.OrdinalIgnoreCase) || _selectedCheckpointName.Contains("Retenci", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="mb-3 p-2.5 rounded-3 border" style="background: var(--nyx-success-bg); border-color: rgba(34, 197, 94, 0.3) !important;">
                            <label class="venta-field-label text-success" style="font-size: 0.8rem;">
                                <i class="bi bi-building-check me-1"></i> Confirmar Nombre de Compañía / Operador de Cambio:
                            </label>
                            <input type="text" class="venta-field-input" placeholder="Ej: Vodafone, Movistar, Orange, MásMóvil, Digi, etc." @bind="_targetOperatorInput" />
                            <small class="text-muted d-block mt-0.5" style="font-size: 0.72rem;">Se guardará en la ficha del lead como operador de cambio/destino.</small>
                        </div>
                    }

                    <label class="venta-field-label">Detalle / Bitácora de lo Conversado:</label>
                    <textarea class="venta-field-input" rows="3" @bind="_checkpointNotes" placeholder="Escribe observaciones de la llamada, requerimientos u objeciones del cliente..."></textarea>
                </div>
            </div>
            <div class="p-3 px-4 border-top d-flex align-items-center justify-content-end gap-2" style="background: var(--nyx-paper);">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => _showCheckpointModal = false" disabled="@_isSaving">Cancelar</button>
                <button type="button" class="asesor-cta-btn" @onclick="ResolveCheckpointExecution" disabled="@(_isSaving || (IsApprovalResult(_selectedCheckpointStatus) && !CanApproveCheckpoint))">
                    @if(_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Guardando...</span> }
                    else { <span><i class="bi bi-check-lg me-1"></i> Guardar y Procesar Checkpoint</span> }
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL: ASIGNACIÓN PROGRESIVA CON CONFIRMACIÓN OBLIGATORIA (HANDSHAKE) -->
@if (_showAssignModal && _selectedPreSale != null)
{
    <div class="venta-modal-overlay">
        <div class="venta-modal-box" style="max-width: 650px;">
            <div class="venta-modal-header">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="nyx-badge warning">
                            <i class="bi bi-arrow-left-right"></i> Derivación Handshake
                        </span>
                        <span class="nyx-badge neutral font-monospace">
                            Pre-Venta #@_selectedPreSale.IdPresale
                        </span>
                    </div>
                    <h5 style="font-family: var(--font-display); font-weight: 700; color: var(--nyx-ink); letter-spacing: -0.02em; margin-bottom: 2px;">
                        Derivar con Confirmación Obligatoria
                    </h5>
                    <p style="font-size: 0.80rem; color: var(--nyx-smoke); margin-bottom: 0;">
                        El receptor recibirá una alerta interactiva para aceptar o rechazar la titularidad.
                    </p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => _showAssignModal = false" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="venta-modal-body">
                <div class="venta-section-card">
                    <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nyx-smoke); display: block; margin-bottom: 2px;">Paso de llamada actual a derivar</span>
                    <h6 class="fw-bold mb-0" style="color: var(--nyx-electric);">
                        @(!_selectedPreSale.Call1Completed ? "1ª Llamada (1ª Compañía)" : !_selectedPreSale.Call2Completed ? "2ª Llamada (2ª Compañía)" : "3ª Llamada (3ª Compañía)")
                    </h6>
                </div>

                <div class="venta-section-card mb-0">
                    <div class="mb-3">
                        <label class="venta-field-label">Seleccionar Asesor Colaborador <span class="text-danger">*</span></label>
                        <select class="venta-field-input" @bind="_selectedAssigneeId">
                            <option value="0">-- Seleccionar Asesor --</option>
                            @foreach (var adv in _advisors.Where(a => a.Id != _currentUserId))
                            {
                                <option value="@adv.Id">@adv.Name</option>
                            }
                        </select>
                        <div class="text-muted small mt-1" style="font-size: 0.70rem;">Se emitirá una notificación de alta prioridad y sonido de alarma al asesor seleccionado.</div>
                    </div>

                    <div>
                        <label class="venta-field-label">Instrucciones o Contexto para el Asesor</label>
                        <textarea class="venta-field-input" rows="2" @bind="_assignContext" placeholder="Ej. 'Llamar de inmediato, cliente interesado en fibra 300Mb'"></textarea>
                    </div>
                </div>
            </div>
            <div class="p-3 px-4 border-top d-flex align-items-center justify-content-end gap-2" style="background: var(--nyx-paper);">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => _showAssignModal = false" disabled="@_isSaving">Cancelar</button>
                <button type="button" class="btn-accent-yellow px-4" @onclick="SendHandshakeAssignment" disabled="@(_isSaving || _selectedAssigneeId <= 0)">
                    @if(_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    <span><i class="bi bi-send-fill me-1"></i> Enviar Derivación</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL: TRACKING LIST 360° & TIMELINE INTERACTIVO CON PASOS OPERATIVOS -->
@if (_showTimelineModal && _selectedPreSale != null)
{
    <div class="modal fade show d-block bg-dark bg-opacity-60" tabindex="-1" role="dialog" style="backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content rounded-4 border-0 shadow-2xl overflow-hidden" style="max-height: 90vh;">
                <!-- Header con Datos de la Pre-Venta -->
                <div class="modal-header border-0 pb-3 px-4 pt-4" style="background: #0F172A; color: #FFFFFF;">
                    <div class="w-100">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge" style="background: #1E40AF; color: #DBEAFE; font-size: 0.72rem; letter-spacing: 0.5px;">TRACKING LIST 360°</span>
                                <span class="badge bg-light text-dark font-monospace" style="font-size: 0.72rem;">Pre-Venta #@_selectedPreSale.IdPresale</span>
                                <span class="badge" style="background: #1E293B; color: #E2E8F0; font-size: 0.72rem;">
                                    <i class="bi bi-person-fill text-primary me-1"></i>@(string.IsNullOrWhiteSpace(_selectedPreSale.FirstName) ? "Cliente Interesado" : $"{_selectedPreSale.FirstName} {_selectedPreSale.LastName}")
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-sm" @onclick="ResetToCurrentStage" title="Regresar a la etapa actual de la gestión">
                                    <i class="bi bi-arrow-counterclockwise text-info"></i>
                                    <span>Regresar a Etapa Actual</span>
                                </button>
                                <button type="button" class="btn-close btn-close-white ms-2" aria-label="Cerrar" @onclick="() => _showTimelineModal = false"></button>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-3 small text-muted">
                            <span class="text-white"><i class="bi bi-telephone-fill text-success me-1"></i>@_selectedPreSale.Phone</span>
                            <span style="color: #94A3B8;"><i class="bi bi-building me-1"></i>Op. Actual: <strong class="text-white">@(_selectedPreSale.Operator ?? "No esp.")</strong></span>
                            <span style="color: #94A3B8;"><i class="bi bi-arrow-right-circle text-primary me-1"></i>A Gestionar: <strong class="text-info">@(_selectedPreSale.TargetOperator ?? "Por definir")</strong></span>
                            <span style="color: #94A3B8;"><i class="bi bi-flag me-1"></i>Campaña: <strong class="text-white">@(_selectedPreSale.CampaignName ?? "General")</strong></span>
                        </div>
                    </div>
                </div>

                <!-- Línea de Tiempo de Etapas (Horizontal Stepper Rail) -->
                <div class="px-4 py-3 border-bottom" style="background: #F8FAFC;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase fw-bold text-secondary" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="bi bi-bezier2 me-1 text-primary"></i> Etapas Nyx Flow (Haz clic para explorar checkpoints)
                        </span>
                        <span class="badge bg-light text-secondary border rounded-pill" style="font-size: 0.72rem;">
                            Etapa Visualizada: <strong class="text-dark">@(_selectedStageForTracking?.Name ?? "Preventa")</strong>
                        </span>
                    </div>

                    <div class="timeline-rail-track">
                        @foreach (var stage in _flowStages)
                        {
                            bool isLeadClosed = _selectedPreSale.IsClosed || _selectedPreSale.IdStatus == 4;
                            bool isCurrentLeadStage = stage.IdStage == _activeLeadStageId;
                            bool isSelected = _selectedStageForTracking?.IdStage == stage.IdStage;
                            var currentStageObj = _flowStages.FirstOrDefault(s => s.IdStage == _activeLeadStageId);
                            bool isPast = currentStageObj != null && stage.OrderIndex < currentStageObj.OrderIndex;

                            <div class="timeline-step-node @(isCurrentLeadStage ? (isLeadClosed ? "border-danger bg-danger bg-opacity-10" : "current") : isPast ? "completed" : "future") @(isSelected ? "selected-stage" : "")" @onclick="() => SelectStageForTracking(stage)">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge @(isCurrentLeadStage ? (isLeadClosed ? "bg-danger text-white" : "bg-info text-dark") : isPast ? "bg-success text-white" : "bg-light text-secondary") rounded-pill font-monospace" style="font-size: 0.68rem;">
                                        #@stage.OrderIndex
                                    </span>
                                    @if (isCurrentLeadStage)
                                    {
                                        if (isLeadClosed)
                                        {
                                            <i class="bi bi-x-circle-fill text-danger" style="font-size: 0.85rem;" title="Etapa Cerrada por KO"></i>
                                        }
                                        else
                                        {
                                            <span class="pulse-indicator" title="Etapa Activa de la Gestión"></span>
                                        }
                                    }
                                    else if (isPast)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" style="font-size: 0.8rem;"></i>
                                    }
                                </div>
                                <div class="fw-bold text-truncate" style="font-size: 0.84rem;" title="@stage.Name">
                                    @stage.Name
                                </div>
                                <small class="d-block mt-1 @(isCurrentLeadStage ? (isLeadClosed ? "text-danger fw-bold" : "text-light text-opacity-75") : isPast ? "text-success" : "text-muted")" style="font-size: 0.68rem;">
                                    @(isCurrentLeadStage ? (isLeadClosed ? "⛔ Cerrada (KO)" : "📍 Etapa Activa") : isPast ? "✓ Completada" : "Explorar CP")
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tracking List: Checkpoints y Pasos a Realizar de la Etapa Seleccionada -->
                <div class="modal-body px-4 py-3" style="background: #F1F5F9;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-list-task text-primary me-2"></i>Checkpoints en Etapa: @(_selectedStageForTracking?.Name ?? "Preventa")
                            </h5>
                            <p class="text-muted small mb-0">Listado íntegro de checkpoints gobernados por el motor Nyx Flow y sus pasos a realizar.</p>
                        </div>
                        <span class="badge bg-dark rounded-pill px-3 py-1.5 font-monospace">
                            @_stageCheckpoints.Count checkpoints
                        </span>
                    </div>

                    @if (!_stageCheckpoints.Any())
                    {
                        <div class="text-center py-5 bg-white rounded-4 border">
                            <i class="bi bi-inbox text-muted display-6 d-block mb-2"></i>
                            <h6 class="fw-bold text-dark">No hay checkpoints activos registrados para esta etapa</h6>
                            <p class="text-muted small mb-0">Los checkpoints se cargan dinámicamente desde <code>nyx_flow.checkpoint_catalog</code>.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @{
                                _leadFlowInstances.TryGetValue(_selectedPreSale.IdPresale, out var trackingFlow);
                                bool isLeadClosedGlobal = trackingFlow?.Status == "CLOSED" || _selectedPreSale.IsClosed || _selectedPreSale.IdStatus == 4;
                            }
                            @foreach (var cp in _stageCheckpoints)
                            {
                                var cpInst = trackingFlow?.Checkpoints?.FirstOrDefault(ci => ci.IdCheckpoint == cp.IdCheckpoint);
                                bool isCompleted = cpInst != null && (cpInst.Status == "APPROVED" || cpInst.Status == "RESOLVED");
                                bool isCpKo = cpInst != null && cpInst.Status == "KO";
                                bool isActiveCall = cpInst != null && cpInst.Status == "PENDING";
                                if (cpInst == null && trackingFlow != null)
                                {
                                    isCompleted = trackingFlow.CurrentStageId > (cp.TriggerStageId ?? 12);
                                }

                                <div class="tracking-checkpoint-card @(isCpKo ? "border border-danger border-2 bg-danger bg-opacity-10 shadow-xs" : isCompleted ? "status-completed" : isActiveCall ? "status-active" : isLeadClosedGlobal ? "opacity-50" : "status-pending")">
                                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-2">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge @(isCpKo ? "bg-danger text-white" : "bg-dark text-white") font-monospace px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">@cp.Code</span>
                                            <h6 class="fw-bold @(isCpKo ? "text-danger" : "text-dark") mb-0" style="font-size: 0.95rem;">@cp.Name</h6>
                                            <span class="badge @(cp.BlocksAdvance ? "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" : "bg-light text-muted border") rounded-pill" style="font-size: 0.68rem;">
                                                @(cp.BlocksAdvance ? "Bloqueante" : "Informativo")
                                            </span>
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill" style="font-size: 0.68rem;">
                                                <i class="bi bi-person-badge me-1"></i>@(cp.OwnerDept ?? "Asesor Comercial")
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (isCpKo)
                                            {
                                                <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">
                                                    <i class="bi bi-x-circle-fill me-1"></i> CERRADO POR KO (@(_selectedPreSale.DiscardReason ?? "No Contesta"))
                                                </span>
                                            }
                                            else if (isCompleted)
                                            {
                                                <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">
                                                    <i class="bi bi-check-circle-fill me-1"></i> COMPLETADO
                                                </span>
                                            }
                                            else if (isActiveCall)
                                            {
                                                <span class="badge bg-primary bg-opacity-15 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">
                                                    <i class="bi bi-lightning-charge-fill me-1"></i> EN CURSO / DISPONIBLE
                                                </span>
                                                @if (cp.IdCheckpoint == 16)
                                                {
                                                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1" @onclick="() => { _showTimelineModal = false; OpenVentaCreadaModal(_selectedPreSale); }">
                                                        <i class="bi bi-file-earmark-text-fill"></i>
                                                        <span>Ficha de Venta</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1" @onclick="() => { _showTimelineModal = false; OpenCheckpointActionModal(_selectedPreSale, (int)cp.IdCheckpoint, cp.Name); }">
                                                        <i class="bi bi-telephone-fill"></i>
                                                        <span>Ejecutar</span>
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-1.5" style="font-size: 0.75rem;">
                                                    <i class="bi bi-clock-history me-1"></i> PENDIENTE
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(cp.Description))
                                    {
                                        <p class="text-muted small mb-2.5" style="font-size: 0.82rem;">@cp.Description</p>
                                    }

                                    <!-- Lista de Pasos a Realizar (checkpoint_step) -->
                                    <div class="mt-2 pt-2 border-top" style="border-color: #F1F5F9 !important;">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="text-uppercase fw-bold text-secondary" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                <i class="bi bi-list-check me-1 text-primary"></i> Pasos Operativos a Realizar (@(cp.Steps?.Count ?? 0))
                                            </span>
                                        </div>

                                        @if (cp.Steps != null && cp.Steps.Any())
                                        {
                                            <div class="list-group list-group-flush rounded-3 border">
                                                @foreach (var step in cp.Steps.OrderBy(s => s.StepOrder))
                                                {
                                                    <div class="list-group-item d-flex align-items-start gap-2.5 py-2 px-3 bg-white" style="font-size: 0.82rem;">
                                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 20px; height: 20px; font-size: 0.68rem; font-weight: 700; margin-top: 1px;">
                                                            @step.StepOrder
                                                        </span>
                                                        <div class="flex-grow-1">
                                                            <span class="text-dark fw-medium">@step.Name</span>
                                                            @if (!string.IsNullOrWhiteSpace(step.Instruction) && step.Instruction != step.Name)
                                                            {
                                                                <span class="text-muted d-block small mt-0.5">@step.Instruction</span>
                                                            }
                                                        </div>
                                                        @if (step.IsRequired)
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-0.5 flex-shrink-0" style="font-size: 0.65rem;">
                                                                Obligatorio
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2 py-0.5 flex-shrink-0" style="font-size: 0.65rem;">
                                                                Opcional
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-2 rounded-2 bg-light border text-muted small fst-italic" style="font-size: 0.78rem;">
                                                <i class="bi bi-info-circle me-1"></i> Este checkpoint no requiere validación de sub-pasos manuales. Se valida mediante la resolución del resultado.
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-0 px-4 pb-4" style="background: #F8FAFC;">
                    <button type="button" class="btn btn-dark rounded-pill px-5 shadow-sm fw-semibold" @onclick="() => _showTimelineModal = false">Cerrar Tracking</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: HISTORIAL DE ASIGNACIONES, HANDSHAKES, ACEPTACIONES Y RECHAZOS -->
@if (_showHistoryModal && _selectedPreSale != null)
{
    <div class="modal fade show d-block bg-dark bg-opacity-60" tabindex="-1" role="dialog" style="backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content rounded-4 border-0 shadow-2xl overflow-hidden" style="max-height: 90vh;">
                <!-- Header -->
                <div class="modal-header border-0 pb-3 px-4 pt-4" style="background: #0F172A; color: #FFFFFF;">
                    <div class="w-100">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge rounded-pill px-2.5 py-1" style="background: #1E40AF; color: #DBEAFE; font-size: 0.72rem; letter-spacing: 0.5px;">
                                    <i class="bi bi-clock-history me-1"></i> AUDITORÍA DE DERIVACIONES
                                </span>
                                <span class="badge bg-light text-dark font-monospace rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                                    Pre-Venta #@_selectedPreSale.IdPresale
                                </span>
                            </div>
                            <button type="button" class="btn-close btn-close-white" aria-label="Cerrar" @onclick="() => _showHistoryModal = false"></button>
                        </div>
                        <h5 class="modal-title fw-bold text-white mb-1" style="letter-spacing: -0.2px;">
                            Historial de Asignaciones, Aceptaciones y Llamadas
                        </h5>
                        <p class="small mb-0" style="color: #94A3B8;">
                            Titular: <strong class="text-white">@(string.IsNullOrWhiteSpace(_selectedPreSale.FirstName) ? "Cliente Interesado" : $"{_selectedPreSale.FirstName} {_selectedPreSale.LastName}")</strong> | 
                            Tel: <strong class="text-white">@_selectedPreSale.Phone</strong> | 
                            Propietario Original: <strong class="text-info">@(_selectedPreSale.OwnerUserName ?? $"Asesor #{_selectedPreSale.OwnerUserId}")</strong>
                        </p>
                    </div>
                </div>

                <div class="modal-body px-4 py-3" style="background: #F8FAFC;">
                    <!-- Resumen del Estado de Asignación por Llamada -->
                    <div class="card p-3 rounded-4 mb-3 bg-white border shadow-sm">
                        <span class="text-uppercase fw-bold text-secondary d-block mb-2" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="bi bi-people me-1 text-primary"></i> Asignación Actual por Turno de Llamada
                        </span>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <div class="p-2.5 rounded-3 bg-light border">
                                    <span class="text-muted d-block small fw-bold">1ª Llamada</span>
                                    @if (!string.IsNullOrEmpty(_selectedPreSale.AssignedAdvisor1Name))
                                    {
                                        <strong class="text-dark" style="font-size: 0.85rem;">
                                            <i class="bi bi-person-fill text-primary me-1"></i>@_selectedPreSale.AssignedAdvisor1Name
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Sin asignar</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2.5 rounded-3 bg-light border">
                                    <span class="text-muted d-block small fw-bold">2ª Llamada</span>
                                    @if (!string.IsNullOrEmpty(_selectedPreSale.AssignedAdvisor2Name))
                                    {
                                        <strong class="text-dark" style="font-size: 0.85rem;">
                                            <i class="bi bi-person-fill text-primary me-1"></i>@_selectedPreSale.AssignedAdvisor2Name
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Sin asignar</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2.5 rounded-3 bg-light border">
                                    <span class="text-muted d-block small fw-bold">3ª Llamada</span>
                                    @if (!string.IsNullOrEmpty(_selectedPreSale.AssignedAdvisor3Name))
                                    {
                                        <strong class="text-dark" style="font-size: 0.85rem;">
                                            <i class="bi bi-person-fill text-primary me-1"></i>@_selectedPreSale.AssignedAdvisor3Name
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Sin asignar</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Lista Cronológica / Auditoría -->
                    <div class="card p-3.5 rounded-4 bg-white border shadow-sm">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold text-dark mb-0" style="font-size: 0.88rem;">
                                <i class="bi bi-journal-text text-primary me-1.5"></i> Registro de Eventos y Confirmaciones (@_assignmentHistory.Count)
                            </h6>
                        </div>

                        @if (_isLoadingHistory)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                                <span class="text-muted small">Cargando registro histórico...</span>
                            </div>
                        }
                        else if (!_assignmentHistory.Any())
                        {
                            <div class="text-center py-4 bg-light rounded-3 border">
                                <i class="bi bi-info-circle text-muted display-6 d-block mb-2"></i>
                                <h6 class="fw-bold text-dark mb-1">Sin historial de derivaciones</h6>
                                <p class="text-muted small mb-0">Esta pre-venta ha sido gestionada íntegramente por su propietario original.</p>
                            </div>
                        }
                        else
                        {
                            <div class="timeline-history-list d-flex flex-column gap-2.5">
                                @foreach (var item in _assignmentHistory)
                                {
                                    <div class="p-3 rounded-3 border shadow-xs bg-white" style="border-left-width: 4px !important; border-left-color: @(item.Status == "ACCEPTED" ? "#10B981" : item.Status == "REJECTED" ? "#EF4444" : item.Status == "REQUESTED" ? "#F59E0B" : item.Status == "RETURNED_TO_OWNER" ? "#3B82F6" : item.Status == "CALL_LOG" ? "#1E293B" : "#64748B") !important; border-color: #E2E8F0;">
                                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-1 mb-1.5">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                @if (item.Status == "REQUESTED")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #FEF3C7 !important; color: #78350F !important; border: 1px solid #FCD34D !important; font-size: 0.72rem;">
                                                        <i class="bi bi-hourglass-split me-1 text-warning"></i> SOLICITUD DE DERIVACIÓN
                                                    </span>
                                                    <span class="badge rounded-pill px-2 py-0.5 font-monospace" style="background: #FFFFFF !important; color: #0F172A !important; border: 1px solid #CBD5E1 !important; font-size: 0.68rem;">
                                                        @(item.CallStep switch { 1 => "Para 1ª Llamada", 2 => "Para 2ª Llamada", 3 => "Para 3ª Llamada", _ => $"Turno #{item.CallStep}" })
                                                    </span>
                                                }
                                                else if (item.Status == "ACCEPTED")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #DCFCE7 !important; color: #14532D !important; border: 1px solid #86EFAC !important; font-size: 0.72rem;">
                                                        <i class="bi bi-check-circle-fill me-1" style="color: #16A34A;"></i> DERIVACIÓN ACEPTADA
                                                    </span>
                                                    <span class="badge rounded-pill px-2 py-0.5 font-monospace" style="background: #FFFFFF !important; color: #0F172A !important; border: 1px solid #CBD5E1 !important; font-size: 0.68rem;">
                                                        @(item.CallStep switch { 1 => "1ª Llamada", 2 => "2ª Llamada", 3 => "3ª Llamada", _ => $"Turno #{item.CallStep}" })
                                                    </span>
                                                }
                                                else if (item.Status == "REJECTED")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #FEE2E2 !important; color: #7F1D1D !important; border: 1px solid #FCA5A5 !important; font-size: 0.72rem;">
                                                        <i class="bi bi-x-circle-fill me-1" style="color: #DC2626;"></i> DERIVACIÓN RECHAZADA
                                                    </span>
                                                    <span class="badge rounded-pill px-2 py-0.5 font-monospace" style="background: #FFFFFF !important; color: #0F172A !important; border: 1px solid #CBD5E1 !important; font-size: 0.68rem;">
                                                        @(item.CallStep switch { 1 => "1ª Llamada", 2 => "2ª Llamada", 3 => "3ª Llamada", _ => $"Turno #{item.CallStep}" })
                                                    </span>
                                                }
                                                else if (item.Status == "RETURNED_TO_OWNER")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #DBEAFE !important; color: #1E3A8A !important; border: 1px solid #93C5FD !important; font-size: 0.72rem;">
                                                        <i class="bi bi-arrow-return-left me-1" style="color: #2563EB;"></i> RETORNO AL PROPIETARIO
                                                    </span>
                                                    <span class="badge rounded-pill px-2 py-0.5" style="background: #FFFFFF !important; color: #1E3A8A !important; border: 1px solid #BFDBFE !important; font-size: 0.68rem;">
                                                        Paso Completado
                                                    </span>
                                                }
                                                else if (item.Status == "REVERTED_CONSOLIDATED" || item.Status == "REVERTED_BY_RECEPTOR" || item.Status == "REVERTED")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #E0F2FE !important; color: #0C4A6E !important; border: 1px solid #7DD3FC !important; font-size: 0.72rem;">
                                                        <i class="bi bi-arrow-counterclockwise me-1" style="color: #0284C7;"></i> DEVOLUCIÓN AL DUEÑO
                                                    </span>
                                                    <span class="badge rounded-pill px-2 py-0.5" style="background: #FFFFFF !important; color: #0F172A !important; border: 1px solid #CBD5E1 !important; font-size: 0.68rem;">
                                                        Revertido por Receptor
                                                    </span>
                                                }
                                                else if (item.Status == "CANCELLED_BY_OWNER" || item.Status == "CANCELLED")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #F1F5F9 !important; color: #334155 !important; border: 1px solid #CBD5E1 !important; font-size: 0.72rem;">
                                                        <i class="bi bi-slash-circle me-1"></i> DERIVACIÓN CANCELADA
                                                    </span>
                                                    <span class="badge rounded-pill px-2 py-0.5" style="background: #FFFFFF !important; color: #475569 !important; border: 1px solid #CBD5E1 !important; font-size: 0.68rem;">
                                                        Por el Dueño
                                                    </span>
                                                }
                                                else if (item.Status == "CALL_LOG")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #0F172A !important; color: #FFFFFF !important; border: 1px solid #334155 !important; font-size: 0.72rem;">
                                                        <i class="bi bi-telephone-outbound-fill text-success me-1"></i> GESTIÓN / LLAMADA EJECUTADA
                                                    </span>
                                                    <span class="badge rounded-pill px-2 py-0.5 font-monospace" style="background: #FFFFFF !important; color: #0F172A !important; border: 1px solid #CBD5E1 !important; font-size: 0.68rem;">
                                                        Registro #@item.CallStep
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background: #F1F5F9 !important; color: #0F172A !important; border: 1px solid #CBD5E1 !important; font-size: 0.72rem;">
                                                        @item.Status
                                                    </span>
                                                }
                                            </div>
                                            <span class="text-muted small font-monospace" style="font-size: 0.75rem;">
                                                <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                            </span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 small mt-1" style="color: #0F172A;">
                                            @if (item.Status == "REQUESTED")
                                            {
                                                <span><i class="bi bi-person-circle text-primary me-1"></i><strong>De (Dueño):</strong> @item.FromUserName</span>
                                                <i class="bi bi-arrow-right text-muted"></i>
                                                <span><strong>Para (Receptor):</strong> @item.ToUserName</span>
                                            }
                                            else if (item.Status == "ACCEPTED")
                                             {
                                                <span><i class="bi bi-shield-check text-success me-1"></i><strong>Aceptado por:</strong> @item.ToUserName</span>
                                                <span class="text-muted">(Dueño: @item.FromUserName)</span>
                                            }
                                            else if (item.Status == "REJECTED")
                                            {
                                                <span><i class="bi bi-person-x-fill text-danger me-1"></i><strong>Rechazado por:</strong> @item.FromUserName</span>
                                                <i class="bi bi-arrow-right text-muted"></i>
                                                <span><strong>Retornado al Dueño:</strong> @item.ToUserName</span>
                                            }
                                            else if (item.Status == "RETURNED_TO_OWNER")
                                            {
                                                <span><i class="bi bi-check2-circle text-primary me-1"></i><strong>Ejecutado por:</strong> @item.FromUserName</span>
                                                <i class="bi bi-arrow-right text-muted"></i>
                                                <span><strong>Retornado al Dueño:</strong> @item.ToUserName</span>
                                            }
                                            else if (item.Status == "REVERTED_BY_RECEPTOR" || item.Status == "REVERTED")
                                            {
                                                <span><i class="bi bi-arrow-counterclockwise text-primary me-1"></i><strong>Devuelto por:</strong> @item.FromUserName</span>
                                                <i class="bi bi-arrow-right text-muted"></i>
                                                <span><strong>Al Dueño:</strong> @item.ToUserName</span>
                                            }
                                            else
                                            {
                                                <span><i class="bi bi-person-fill text-secondary me-1"></i><strong>Ejecutado por:</strong> @item.FromUserName</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <div class="mt-2 p-2.5 rounded-2 small" style="@(item.Status == "REJECTED" ? "background: #FEF2F2 !important; border: 1px solid #FECACA !important;" : "background: #F8FAFC !important; border: 1px solid #E2E8F0 !important;")">
                                                <span class="d-block mb-0.5 fw-bold" style="font-size: 0.7rem; color: @(item.Status == "REJECTED" ? "#991B1B" : "#475569") !important;">
                                                    @(item.Status == "REJECTED" ? "MOTIVO DEL RECHAZO:" : item.Status == "CALL_LOG" ? "BITÁCORA / RESULTADO DE GESTIÓN:" : item.Status == "ACCEPTED" ? "CONFIRMACIÓN:" : item.Status == "REQUESTED" ? "INSTRUCCIÓN / CONTEXTO:" : "DETALLE:")
                                                </span>
                                                <span style="color: @(item.Status == "REJECTED" ? "#7F1D1D" : "#0F172A") !important; font-size: 0.82rem;">@item.Notes</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 px-4 pb-4" style="background: #F8FAFC;">
                    <button type="button" class="btn btn-dark rounded-pill px-5 shadow-sm fw-semibold" @onclick="() => _showHistoryModal = false">Cerrar Historial</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL DE VENTA CREADA: FICHA DE CONTRATACIÓN Y CHECKPOINT #16 -->
<!-- ========================================================================= -->
@if (_showVentaCreadaModal)
{
    <div class="venta-modal-overlay">
        <div class="venta-modal-box">
            <!-- Modal Header (Aaply × Acctual Style) -->
            <div class="venta-modal-header">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1.5 flex-wrap">
                        <span class="nyx-badge primary">
                            <i class="bi bi-geo-alt-fill"></i> Etapa 2 · Venta Creada
                        </span>
                        <span class="nyx-badge success">
                            <i class="bi bi-check2-circle"></i> CP #16: Toma de Datos
                        </span>
                        <span class="nyx-badge neutral font-monospace">
                            Pre-Venta #@_ventaForm.IdPresale
                        </span>
                        @if (!string.IsNullOrWhiteSpace(_selectedPreSale?.Phone))
                        {
                            <span class="nyx-badge neutral">
                                <i class="bi bi-telephone-fill"></i> @_selectedPreSale.Phone
                            </span>
                        }
                    </div>
                    <h4 style="font-family: var(--font-display); font-weight: 700; color: var(--nyx-ink); letter-spacing: -0.03em; margin-bottom: 2px;">
                        Ficha de Venta y Formalización de Contrato
                    </h4>
                    <p style="font-size: 0.80rem; color: var(--nyx-smoke); margin-bottom: 0;">
                        Completa los 14 pasos obligatorios del Checkpoint #16 para crear la orden de venta en el sistema.
                    </p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => _showVentaCreadaModal = false" title="Cerrar Ficha de Venta">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Checkpoint Stage Rail (6 Checkpoints de Etapa 2) -->
            <div class="px-4 py-2 border-bottom d-flex align-items-center gap-2 overflow-x-auto" style="background: var(--nyx-paper);">
                <div class="cp-item-pill current-pill active-pill" style="font-size: 0.74rem;">
                    <i class="bi bi-file-earmark-text-fill"></i>
                    <span>CP #16 Ficha Venta</span>
                    <span class="badge bg-white text-primary rounded-pill px-1.5 py-0.2" style="font-size: 0.65rem;">Activo</span>
                </div>
                <i class="bi bi-chevron-right text-muted small" style="opacity: 0.5;"></i>
                <div class="cp-item-pill next-pill" style="font-size: 0.74rem;">
                    <i class="bi bi-shield-check"></i>
                    <span>CP #79 Pre Scoring</span>
                </div>
                <i class="bi bi-chevron-right text-muted small" style="opacity: 0.5;"></i>
                <div class="cp-item-pill next-pill" style="font-size: 0.74rem;">
                    <i class="bi bi-credit-card-2-front"></i>
                    <span>CP #18 Score Cliente</span>
                </div>
                <i class="bi bi-chevron-right text-muted small" style="opacity: 0.5;"></i>
                <div class="cp-item-pill next-pill" style="font-size: 0.74rem;">
                    <i class="bi bi-geo-alt"></i>
                    <span>CP #77 Cobertura</span>
                </div>
                <i class="bi bi-chevron-right text-muted small" style="opacity: 0.5;"></i>
                <div class="cp-item-pill next-pill" style="font-size: 0.74rem;">
                    <i class="bi bi-person-x"></i>
                    <span>CP #78 Robinson</span>
                </div>
                <i class="bi bi-chevron-right text-muted small" style="opacity: 0.5;"></i>
                <div class="cp-item-pill next-pill" style="font-size: 0.74rem;">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>CP #80 Gestión Score</span>
                </div>
            </div>

            <!-- Modal Body (2 Columnas) -->
            <div class="venta-modal-body">
                <div class="row g-3">
                    <!-- Columna Izquierda: Formulario Estructurado -->
                    <div class="col-12 col-lg-7">
                        <!-- 1. Datos del Titular -->
                        <div class="venta-section-card">
                            <div class="venta-section-title">
                                <i class="bi bi-person-badge-fill" style="color: var(--nyx-electric);"></i>
                                <span>1. Datos del Titular del Servicio</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="venta-field-label">Tipo Documento *</label>
                                    <select class="venta-field-input" @bind="_ventaForm.DocType">
                                        <option value="">-- Seleccionar --</option>
                                        @foreach (var opt in _docTypeOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Nº Documento (NIF/NIE) *</label>
                                    <input type="text" class="venta-field-input" placeholder="Ej. 12345678Z" @bind="_ventaForm.DocNumber" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Fecha Nacimiento *</label>
                                    <input type="date" class="venta-field-input" @bind="_ventaForm.BirthDate" />
                                </div>
                                <div class="col-md-6">
                                    <label class="venta-field-label">Nombres del Titular *</label>
                                    <input type="text" class="venta-field-input" placeholder="Nombres" @bind="_ventaForm.FirstName" @bind:event="oninput" />
                                </div>
                                <div class="col-md-6">
                                    <label class="venta-field-label">Apellidos del Titular *</label>
                                    <input type="text" class="venta-field-input" placeholder="Apellidos completos" @bind="_ventaForm.LastName" @bind:event="oninput" />
                                </div>
                                <div class="col-md-8">
                                    <label class="venta-field-label">Correo Electrónico *</label>
                                    <input type="email" class="venta-field-input" placeholder="cliente@correo.es" @bind="_ventaForm.Email" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Tipo Cliente *</label>
                                    <select class="venta-field-input" @bind="_ventaForm.ClientType">
                                        <option value="">-- Seleccionar --</option>
                                        @foreach (var opt in _clientTypeOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Dirección de Instalación (con Auto-Fill por CP) -->
                        <div class="venta-section-card">
                            <div class="venta-section-title">
                                <i class="bi bi-geo-alt-fill" style="color: var(--nyx-coral);"></i>
                                <span>2. Dirección de Instalación (Huella FTTH)</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-8">
                                    <label class="venta-field-label">Calle / Dirección Completa *</label>
                                    <input type="text" class="venta-field-input" placeholder="Ej. Calle Gran Vía, 45" @bind="_ventaForm.StreetAddress" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Nº / Piso / Puerta</label>
                                    <input type="text" class="venta-field-input" placeholder="Nº 45, 3º B" @bind="_ventaForm.StreetNum" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">
                                        Código Postal *
                                        <span class="text-muted" style="font-size: 0.65rem; font-weight: normal;">(Auto-detecta)</span>
                                    </label>
                                    <input type="text" class="venta-field-input" placeholder="28013" value="@_ventaForm.PostalCode" @oninput="OnPostalCodeInput" maxlength="5" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Población / Localidad *</label>
                                    <input type="text" class="venta-field-input" placeholder="Madrid" @bind="_ventaForm.City" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Provincia *</label>
                                    <input type="text" class="venta-field-input" placeholder="Madrid" @bind="_ventaForm.Province" @bind:event="oninput" />
                                </div>
                            </div>
                        </div>

                        <!-- 3. Oferta, Servicios y Portabilidad -->
                        <div class="venta-section-card">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="venta-section-title mb-0 border-0 pb-0">
                                    <i class="bi bi-router-fill" style="color: var(--nyx-electric);"></i>
                                    <span>3. Configuración de Oferta y Servicios</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_selectedPreSale?.Phone))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" style="font-size: 0.70rem; font-weight: 600;" @onclick="CopyLeadPhone" title="Copiar el teléfono registrado en preventa a contacto y móvil">
                                        <i class="bi bi-clipboard me-1"></i> Copiar Teléfono Lead
                                    </button>
                                }
                            </div>
                            <div class="row g-2 pt-2 border-top" style="border-color: rgba(0,0,0,0.04) !important;">
                                <div class="col-md-6">
                                    <label class="venta-field-label">Operador Donante (Actual) *</label>
                                    <select class="venta-field-input" @bind="_ventaForm.CurrentOperator">
                                        <option value="">-- Seleccionar Operador Actual --</option>
                                        @foreach (var opt in _currentOperatorOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="venta-field-label">Operador Destino / Proveedor *</label>
                                    <select class="venta-field-input" @bind="_ventaForm.TargetOperator">
                                        <option value="">-- Seleccionar Operador Destino --</option>
                                        @foreach (var opt in _providerOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Tecnología y Fibra *</label>
                                    <select class="venta-field-input" @bind="_ventaForm.TechSpeed">
                                        <option value="">-- Seleccionar Tarifa / Fibra --</option>
                                        @foreach (var opt in _techSpeedOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Líneas Extra</label>
                                    <select class="venta-field-input" @bind="_ventaForm.ExtraLines">
                                        @foreach (var opt in _extraLinesOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Pack Televisión</label>
                                    <select class="venta-field-input" @bind="_ventaForm.TvPack">
                                        @foreach (var opt in _tvPackOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Teléfono Contacto *</label>
                                    <input type="text" class="venta-field-input" placeholder="912345678" @bind="_ventaForm.ContactPhone" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Móvil a Portar / Alta *</label>
                                    <input type="text" class="venta-field-input" placeholder="600123456" @bind="_ventaForm.MainMobile" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="venta-field-label">Fijo a Portar (Opcional)</label>
                                    <input type="text" class="venta-field-input" placeholder="912345678" @bind="_ventaForm.FixedPhone" @bind:event="oninput" />
                                </div>
                            </div>
                        </div>

                        <!-- 4. Facturación e IBAN (con Auto-Format y Auto-Detect Banco) -->
                        <div class="venta-section-card mb-0">
                            <div class="venta-section-title">
                                <i class="bi bi-credit-card-2-back-fill" style="color: var(--nyx-leaf);"></i>
                                <span>4. Datos Bancarios y Facturación (IBAN)</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-7">
                                    <label class="venta-field-label">
                                        Código IBAN *
                                        <span class="text-muted" style="font-size: 0.65rem; font-weight: normal;">(Formateo automático 4x4)</span>
                                    </label>
                                    <input type="text" class="venta-field-input font-monospace" placeholder="ES91 2100 0418 4502 0005 1332" value="@_ventaForm.Iban" @oninput="OnIbanInput" maxlength="29" />
                                </div>
                                <div class="col-md-5">
                                    <label class="venta-field-label">Entidad Bancaria</label>
                                    <select class="venta-field-input" @bind="_ventaForm.BankName">
                                        <option value="">-- Seleccionar Banco --</option>
                                        @foreach (var opt in _bankOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Columna Derecha: Acctual Invoice Preview + Auditoría de 14 Pasos -->
                    <div class="col-12 col-lg-5 d-flex flex-column gap-3">
                        <!-- Acctual Invoice Preview Card -->
                        <div class="preview-invoice-card">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="eyebrow">Resumen de Contratación</span>
                                <span class="nyx-badge @(IsVentaFormComplete ? "success" : "primary")">
                                    @(IsVentaFormComplete ? "Lista para Cierre" : "En Configuración")
                                </span>
                            </div>
                            
                            <div class="d-flex align-items-baseline gap-2 mb-3">
                                <span class="amount">@CalculateMonthlyQuote().ToString("F2") €</span>
                                <span style="font-size: 0.80rem; color: var(--nyx-smoke);">/ mes (IVA inc.)</span>
                            </div>

                            <div class="d-flex flex-column gap-1 pt-2 border-top" style="border-color: var(--nyx-hairline) !important;">
                                <div class="preview-line-item">
                                    <span class="label">Operador Destino:</span>
                                    <span class="value">@(!string.IsNullOrEmpty(_ventaForm.TargetOperator) ? _ventaForm.TargetOperator : "—")</span>
                                </div>
                                <div class="preview-line-item">
                                    <span class="label">Fibra / Velocidad:</span>
                                    <span class="value">
                                        @if (!string.IsNullOrEmpty(_ventaForm.TechSpeed))
                                        {
                                            var opt = _techSpeedOptions.FirstOrDefault(t => t.Value == _ventaForm.TechSpeed);
                                            <span>@(opt?.Label ?? _ventaForm.TechSpeed)</span>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </span>
                                </div>
                                @if (int.TryParse(_ventaForm.ExtraLines, out int extra) && extra > 0)
                                {
                                    <div class="preview-line-item">
                                        <span class="label">Líneas Móviles Extra:</span>
                                        <span class="value" style="color: var(--nyx-electric);">+@((extra * 10).ToString("F2")) € (@extra líns.)</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_ventaForm.TvPack) && _ventaForm.TvPack != "NONE")
                                {
                                    <div class="preview-line-item">
                                        <span class="label">Pack Televisión:</span>
                                        <span class="value" style="color: var(--nyx-iris);">@_ventaForm.TvPack</span>
                                    </div>
                                }
                                <div class="preview-line-item">
                                    <span class="label">Permanencia:</span>
                                    <span class="value">@(_ventaForm.Permanence == "0" ? "Sin permanencia" : $"{_ventaForm.Permanence} Meses")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Live Checklist Card (14 Validadores Reactivos) -->
                        <div class="venta-section-card mb-0 flex-1">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="eyebrow" style="color: var(--nyx-smoke); font-size: 0.70rem; font-weight: 700;">
                                    <i class="bi bi-shield-check me-1" style="color: var(--nyx-electric);"></i> 14 Validadores en Vivo (CP #16)
                                </span>
                                <span class="nyx-badge @(IsVentaFormComplete ? "success" : "primary") font-monospace">
                                    @CompletedVentaStepsCount / 14 Pasos (@((CompletedVentaStepsCount * 100) / 14)%)
                                </span>
                            </div>

                            <!-- Progress Bar -->
                            <div class="nyx-progress mb-3">
                                <div class="nyx-progress-bar @(IsVentaFormComplete ? "complete" : "")" style="width: @((CompletedVentaStepsCount * 100) / 14)%;"></div>
                            </div>

                            <div class="d-flex flex-column gap-1" style="max-height: 280px; overflow-y: auto;">
                                <div class="venta-chk-item @(Step1_DocValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step1_DocValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step1_DocValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 1: Tipo y Nº Documento (NIF/NIE)</span>
                                </div>
                                <div class="venta-chk-item @(Step2_BirthDateValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step2_BirthDateValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step2_BirthDateValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 2: Fecha de Nacimiento del Titular</span>
                                </div>
                                <div class="venta-chk-item @(Step3_FirstNameValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step3_FirstNameValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step3_FirstNameValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 3: Nombres del Titular</span>
                                </div>
                                <div class="venta-chk-item @(Step4_LastNameValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step4_LastNameValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step4_LastNameValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 4: Apellidos del Titular</span>
                                </div>
                                <div class="venta-chk-item @(Step5_EmailValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step5_EmailValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step5_EmailValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 5: Correo Electrónico Válido</span>
                                </div>
                                <div class="venta-chk-item @(Step6_ClientTypeValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step6_ClientTypeValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step6_ClientTypeValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 6: Tipo de Cliente</span>
                                </div>
                                <div class="venta-chk-item @(Step7_ContractTypeValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step7_ContractTypeValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step7_ContractTypeValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 7: Tipo de Contrato (Portabilidad)</span>
                                </div>
                                <div class="venta-chk-item @(Step8_CurrentOperatorValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step8_CurrentOperatorValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step8_CurrentOperatorValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 8: Operador Donante Actual</span>
                                </div>
                                <div class="venta-chk-item @(Step9_AddressValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step9_AddressValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step9_AddressValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 9: Dirección de Instalación</span>
                                </div>
                                <div class="venta-chk-item @(Step10_PostalCityValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step10_PostalCityValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step10_PostalCityValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 10: Código Postal y Población</span>
                                </div>
                                <div class="venta-chk-item @(Step11_ContactPhoneValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step11_ContactPhoneValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step11_ContactPhoneValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 11: Teléfono de Contacto</span>
                                </div>
                                <div class="venta-chk-item @(Step12_MainMobileValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step12_MainMobileValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step12_MainMobileValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 12: Línea Móvil Principal</span>
                                </div>
                                <div class="venta-chk-item @(Step13_OfferValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step13_OfferValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step13_OfferValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 13: Operador Destino y Tarifa</span>
                                </div>
                                <div class="venta-chk-item @(Step14_IbanValid ? "checked" : "unchecked")">
                                    <span class="venta-chk-icon @(Step14_IbanValid ? "checked" : "unchecked")">
                                        <i class="bi @(Step14_IbanValid ? "bi-check-lg" : "bi-circle")"></i>
                                    </span>
                                    <span>Paso 14: Cuenta Bancaria IBAN</span>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold flex-1" @onclick="() => _showVentaCreadaModal = false">
                                Cancelar
                            </button>
                            <button type="button" class="asesor-cta-btn flex-2 d-inline-flex align-items-center justify-content-center gap-2" style="@(!IsVentaFormComplete ? "opacity: 0.5; cursor: not-allowed;" : "")" disabled="@(!IsVentaFormComplete || _isSaving)" @onclick="SubmitVentaCreadaModal">
                                @if (_isSaving)
                                {
                                    <div class="spinner-border spinner-border-sm text-white" role="status"></div>
                                    <span>Formalizando Venta...</span>
                                }
                                else
                                {
                                    <i class="bi bi-cart-check-fill"></i>
                                    <span>Formalizar Venta (CP #16)</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PreSaleDto> _allPreSales = new();
    private List<PreSaleDto> _filteredPreSales = new();
    private List<SalesOrderViewModel> _orders = new();
    private List<CampaignLookupDto> _campaigns = new();
    private List<AdvisorLookupDto> _advisors = new();
    private List<FullCatalogItemDto> _allCheckpointsCatalog = new();
    private List<StageLookupDto> _flowStages = new();
    private StageLookupDto? _selectedStageForTracking;
    private long _activeLeadStageId = 12;

    private bool _isLoading = true;
    private bool _isSaving = false;
    private int _currentUserId = 101;
    private string _currentUserName = "";
    private System.Threading.Timer? _pollingTimer;

    // Filtros
    private string _filterText = "";
    private long _filterCampaignId = 0;
    private string _filterStage = "";
    private int _filterYear = 0;
    private int _filterMonth = 0;

    // Modales
    private bool _showNewModal = false;
    private bool _isEditing = false;
    private PreSaleDto _currentPreSale = new() { IdCmpg = 1 };

    private bool _showCheckpointModal = false;
    private int _selectedCheckpointId = 0;
    private string _selectedCheckpointName = "";
    private string _checkpointNotes = "";
    private string _targetOperatorInput = "";
    private PreSaleDto? _selectedPreSale;
    private List<CheckpointStepItemDto> _activeExecutionSteps = new();

    // Handshake Modal & Reversion
    private PreSaleDto? _incomingHandshake;
    private bool _showRejectReasonInput = false;
    private string _rejectReason = "Fuera de turno o descanso";

    private bool _showAssignModal = false;
