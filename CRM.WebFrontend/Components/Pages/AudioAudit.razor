@page "/backoffice/audit/{idOrder:long}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "BACKOFFICE")]
@using CRM.WebFrontend.Services
@using System.Timers
@implements IDisposable
@inject ISalesOrderService SalesOrderService
@inject IAuditService AuditService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<style>
    :root {
        --bg-app: #f4f4f5;
        --surface: #ffffff;
        --border-color: #e4e4e7;
        --text-main: #18181b;
        --text-muted: #71717a;
        --accent: #09090b;
        --danger: #ef4444;
        --danger-soft: #fef2f2;
        --success: #10b981;
        --success-soft: #ecfdf5;
        --warning: #f59e0b;
        --warning-soft: #fffbeb;
        --radius-lg: 16px;
        --radius-md: 12px;
        --radius-sm: 8px;
    }

    .premium-panel {
        background: var(--surface);
        border-radius: var(--radius-lg);
        border: none;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05), 0 2px 6px rgba(0, 0, 0, 0.02);
        padding: 1.5rem;
    }

    .section-title {
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
    }

    .btn-status-group {
        display: flex;
        gap: 6px;
    }

    .btn-status {
        border: 1px solid var(--border-color);
        background: #fafafa;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 16px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-status.selected-ok {
        background: var(--success-soft);
        color: #047857;
        border-color: #a7f3d0;
    }

    .btn-status.selected-ko {
        background: var(--danger-soft);
        color: #b91c1c;
        border-color: #fecaca;
    }

    .btn-status.selected-na {
        background: #f4f4f5;
        color: #4b5563;
        border-color: #d1d5db;
    }

    .badge-sla {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 20px;
        text-transform: uppercase;
    }

    .sla-green {
        background: var(--success-soft);
        color: #047857;
    }

    .sla-yellow {
        background: var(--warning-soft);
        color: #b45309;
    }

    .sla-red {
        background: var(--danger-soft);
        color: #b91c1c;
    }

    /* Modal premium styles */
    .modal-backdrop-blur {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(9, 9, 11, 0.4);
        backdrop-filter: blur(4px);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-container {
        background: #fff;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-color);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        width: 100%;
        max-width: 550px;
        overflow: hidden;
    }
</style>

<div class="container-fluid py-4" style="max-width: 1200px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a href="/backoffice/dashboard" class="text-decoration-none text-muted d-flex align-items-center gap-1 mb-2" style="font-size: 0.85rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Volver a la bandeja del BackOffice
            </a>
            <h2 class="fw-bold m-0">Auditoría de Audio y Checklist</h2>
        </div>

        @if (_order != null)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted" style="font-size: 0.85rem;">SLA de la Orden:</span>
                <span class="badge-sla @GetSlaClass()">@_slaStatusText</span>
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <div class="premium-panel d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-dark mb-3" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted m-0">Cargando detalles de la orden y checklist...</p>
        </div>
    }
    else if (_order == null)
    {
        <div class="premium-panel text-center py-5">
            <svg class="text-danger mb-3" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <h4 class="fw-bold">Orden no encontrada</h4>
            <p class="text-muted">No se pudo recuperar la información de la orden ID #@idOrder.</p>
            <a href="/backoffice/dashboard" class="btn btn-dark rounded-pill px-4 mt-2">Regresar al panel</a>
        </div>
    }
    else
    {
        <!-- Header Info de la Orden -->
        <div class="premium-panel mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="section-title">Código de Orden</span>
                    <div class="fw-bold fs-5 mt-1">#@_order.IdOrder</div>
                </div>
                <div class="col-md-3">
                    <span class="section-title">Campaña</span>
                    <div class="fw-semibold mt-1">Campaña ID: @_order.IdCmpg</div>
                </div>
                <div class="col-md-3">
                    <span class="section-title">Fecha de Venta</span>
                    <div class="mt-1">@_order.SalesDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="col-md-3">
                    <span class="section-title">Estado de Venta</span>
                    <div class="mt-1"><span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">@_order.Status</span></div>
                </div>
            </div>
        </div>

        <!-- Reproductor de Audio Contractual -->
        <div class="premium-panel mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="fw-bold m-0" style="font-size: 1.05rem;">Grabación de Audio Contractual</h4>
                @if (!string.IsNullOrEmpty(_audioTitle))
                {
                    <span class="badge @(_isFallbackAudio ? "bg-warning text-dark" : "bg-success text-white")" style="font-size: 0.75rem; padding: 6px 12px; border-radius: 20px;">
                        @(_isFallbackAudio ? "⚠️ Audio de Prueba" : $"🎵 {_audioTitle}")
                    </span>
                }
            </div>

            @if (!string.IsNullOrEmpty(_audioUrl))
            {
                <audio id="audio-element" src="@_audioUrl" preload="metadata" style="display: none;"></audio>
                
                <div class="d-flex align-items-center gap-3 p-3 rounded border" style="background: #fafafa;">
                    <button class="btn btn-dark d-flex align-items-center justify-content-center" 
                            style="width: 44px; height: 44px; border-radius: 50%; border: none; outline: none; cursor: pointer;" 
                            @onclick="TogglePlay">
                        @if (_isPlaying)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                        }
                    </button>
                    <div class="d-flex flex-column flex-grow-1 gap-1">
                        <div class="d-flex align-items-center justify-content-between text-muted" style="font-size: 0.75rem;">
                            <span>@FormatTime(_currentTimeSeconds)</span>
                            <span>@FormatTime(_durationSeconds)</span>
                        </div>
                        <div id="audio-progress-bar" class="position-relative" style="height: 6px; background: #e4e4e7; border-radius: 3px; cursor: pointer;" @onclick="SeekAudio">
                            <div style="width: @(_playbackPercent)%; height: 100%; background: #09090b; border-radius: 3px; transition: width 0.1s linear;"></div>
                        </div>
                    </div>
                </div>

                @if (_isFallbackAudio)
                {
                    <div class="text-muted mt-2" style="font-size: 0.75rem; font-style: italic;">
                        * No se encontró grabación asociada a la orden en los documentos. Usando audio de contingencia para demostración.
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary m-0" role="alert" style="font-size: 0.85rem;">
                    No hay grabación de audio disponible ni plantilla de prueba configurada para esta orden.
                </div>
            }
        </div>

        <!-- Asistente de Extracción OCR de Documentos -->
        <div class="premium-panel mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h4 class="fw-bold m-0" style="font-size: 1.05rem;">
                        <span class="me-2">🔎</span> Asistente de Extracción OCR Interactivo
                    </h4>
                    <p class="text-muted m-0 small">Haz clic en «Escanear» para detectar texto en la imagen. Selecciona el fragmento deseado y elige en qué campo colocarlo.</p>
                </div>
                <button class="btn btn-outline-dark rounded-pill px-3 fw-semibold" style="font-size: 0.85rem;" @onclick="RunOcrScanner" disabled="@_isOcrScanning">
                    @if (_isOcrScanning)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Analizando imagen...</span>
                    }
                    else
                    {
                        <span>✨ Escanear Documento OCR</span>
                    }
                </button>
            </div>

            <!-- Layout 2 columnas: imagen + fragmentos -->
            <div class="row g-3">
                <!-- Columna izquierda: Imagen con overlay canvas -->
                <div class="col-lg-7">
                    <div class="rounded-3 border overflow-hidden" style="background: #0f0f0f; position: relative;">
                        @if (!string.IsNullOrEmpty(_docImageUrl))
                        {
                            <div style="position: relative; display: inline-block; width: 100%;">
                                <img id="ocr-doc-image" src="@_docImageUrl" alt="Documento adjunto"
                                     style="width: 100%; height: auto; display: block; border-radius: 12px;"
                                     @onload="OnDocImageLoaded" />
                                <canvas id="ocr-canvas"
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; cursor: crosshair; border-radius: 12px;"
                                        @onclick="HandleCanvasClick"></canvas>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted" style="min-height: 240px;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 opacity-50"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                <span class="small">No se encontró imagen de documento adjunta a esta orden.</span>
                                <span class="small opacity-75 mt-1">El OCR necesita una imagen de DNI, contrato o recibo para funcionar.</span>
                            </div>
                        }
                    </div>
                    @if (_ocrFields.Any())
                    {
                        <p class="text-muted mt-2 mb-0" style="font-size: 0.75rem;">💡 Los cuadros de colores en la imagen indican el texto detectado. Haz clic en cualquiera para seleccionarlo.</p>
                    }
                </div>

                <!-- Columna derecha: Fragmentos detectados + campos destino -->
                <div class="col-lg-5">
                    @if (!_ocrFields.Any() && !_isOcrScanning)
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center p-4 rounded-3 border" style="background: #fafafa; min-height: 200px;">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="1.5" class="mb-3"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <p class="text-muted small m-0">Haz clic en <strong>«✨ Escanear»</strong> para detectar<br/>texto en la imagen del documento.</p>
                        </div>
                    }
                    else if (_isOcrScanning)
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center p-4" style="min-height: 200px;">
                            <div class="spinner-border text-secondary mb-3" role="status"></div>
                            <p class="text-muted small">Analizando imagen...</p>
                        </div>
                    }
                    else
                    {
                        <!-- Texto seleccionado activo -->
                        @if (_selectedOcrField != null)
                        {
                            <div class="p-3 mb-3 rounded-3 border-2" style="border: 2px solid #6366f1; background: #eef2ff;">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-bold text-indigo" style="font-size: 0.85rem; color: #4338ca;">📌 Texto Seleccionado</span>
                                    <button class="btn btn-xs btn-link text-muted p-0" @onclick="ClearOcrSelection">✕ deseleccionar</button>
                                </div>
                                <div class="font-monospace fw-bold mb-3 p-2 bg-white rounded border" style="font-size: 0.9rem; word-break: break-all;">
                                    @_selectedOcrField.DetectedText
                                </div>
                                <div class="small text-muted mb-2 fw-semibold">¿A qué campo enviar?</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-sm rounded-pill fw-semibold" style="background:#6366f1; color:#fff; font-size:0.78rem;"
                                            @onclick='() => TransferOcrToField(_selectedOcrField.DetectedText, "TITULAR")'>
                                        👤 Titular
                                    </button>
                                    <button class="btn btn-sm rounded-pill fw-semibold" style="background:#0891b2; color:#fff; font-size:0.78rem;"
                                            @onclick='() => TransferOcrToField(_selectedOcrField.DetectedText, "DNI")'>
                                        🪪 DNI/CIF
                                    </button>
                                    <button class="btn btn-sm rounded-pill fw-semibold" style="background:#059669; color:#fff; font-size:0.78rem;"
                                            @onclick='() => TransferOcrToField(_selectedOcrField.DetectedText, "IBAN")'>
                                        🏦 IBAN
                                    </button>
                                    <button class="btn btn-sm rounded-pill fw-semibold" style="background:#d97706; color:#fff; font-size:0.78rem;"
                                            @onclick='() => TransferOcrToField(_selectedOcrField.DetectedText, "DIRECCION")'>
                                        📍 Dirección
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- Lista de fragmentos detectados -->
                        <div class="d-flex flex-column gap-2">
                            @foreach (var f in _ocrFields)
                            {
                                bool isSelected = _selectedOcrField == f;
                                <div class="d-flex align-items-center gap-3 p-2 rounded-3 border @(isSelected ? "border-2" : "")"
                                     style="cursor: pointer; background: @(isSelected ? "#eef2ff" : "#fff"); border-color: @(isSelected ? "#6366f1" : "") !important; transition: all 0.15s;"
                                     @onclick="() => SelectOcrSnippet(f)">
                                    <div class="rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width: 12px; height: 12px; background: @f.BoxColor;"></div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-bold text-truncate" style="font-size: 0.85rem;">@f.DetectedText</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">@f.FieldLabel — @f.Confidence% conf.</div>
                                    </div>
                                    @if (isSelected)
                                    {
                                        <span style="font-size: 0.7rem; color: #6366f1;">✓ sel.</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Campos destino de verificación -->
                    <div class="mt-4 p-3 rounded-3 border" style="background: #f8fafc;">
                        <div class="section-title mb-3">Campos de Verificación de Identidad</div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">👤 Titular</label>
                            <input type="text" class="form-control form-control-sm" @bind="_auditCustomerName" placeholder="Nombre del titular" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">🪪 DNI / CIF</label>
                            <input type="text" class="form-control form-control-sm font-monospace" @bind="_auditCustomerDni" placeholder="ej. 12345678A" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">🏦 IBAN</label>
                            <input type="text" class="form-control form-control-sm font-monospace" @bind="_auditIban" placeholder="ej. ES12 3456 7890 1234 5678" />
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-1">📍 Dirección</label>
                            <input type="text" class="form-control form-control-sm" @bind="_auditAddress" placeholder="Dirección de instalación" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Checklist de Items -->
        <div class="premium-panel mb-4">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                <div>
                    <h4 class="fw-bold m-0" style="font-size: 1.05rem;">Checklist de Control de Calidad</h4>
                    @if (_checklistTemplate != null)
                    {
                        <span class="text-muted" style="font-size: 0.75rem;">Plantilla: @_checklistTemplate.Name (v@_checklistTemplate.Version)</span>
                    }
                </div>
                <span class="text-muted" style="font-size: 0.85rem;">Marcados: @_markedCount de @_checklist.Count</span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 5%;" class="section-title">Nº</th>
                            <th style="width: 45%;" class="section-title">Ítem de Verificación</th>
                            <th style="width: 20%;" class="section-title text-center">Evaluación</th>
                            <th style="width: 12%;" class="section-title">Timestamp</th>
                            <th style="width: 18%;" class="section-title">Observación (KO)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _checklist)
                        {
                            <tr>
                                <td class="fw-bold text-muted">@item.OrderIndex</td>
                                <td>
                                    <div class="fw-medium">@item.Description</div>
                                    <div class="d-flex gap-2 mt-1">
                                        <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.65rem;">@item.ItemType</span>
                                        @if (item.IsCritical)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-30 rounded-pill" style="font-size: 0.65rem;">⚠️ CRÍTICO</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-status-group justify-content-center">
                                        <button type="button" class="btn-status @(item.Result == "OK" ? "selected-ok" : "")" @onclick='() => SetResult(item, "OK")'>
                                            OK
                                        </button>
                                        <button type="button" class="btn-status @(item.Result == "KO" ? "selected-ko" : "")" @onclick='() => SetResult(item, "KO")'>
                                            KO
                                        </button>
                                        <button type="button" class="btn-status @(item.Result == "N/A" ? "selected-na" : "")" @onclick='() => SetResult(item, "N/A")'>
                                            N/A
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white" style="cursor: pointer; font-size: 0.75rem;" title="Usar segundo actual del audio" @onclick="() => CopyCurrentTimestamp(item)">
                                            ⏱️
                                        </span>
                                        <input type="text" class="form-control form-control-sm" placeholder="MM:SS" @bind="item.Timestamp" />
                                    </div>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm @(item.Result == "KO" && string.IsNullOrWhiteSpace(item.Observation) ? "border-danger" : "")" 
                                           placeholder="Escribir si es KO..." 
                                           @bind="item.Observation" 
                                           disabled="@(item.Result != "KO")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Panel de Alerta Global en caso de KO -->
            @if (_hasKo)
            {
                <div class="alert alert-warning border border-warning border-opacity-30 rounded-lg d-flex align-items-center gap-2 mt-3" role="alert">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <div style="font-size: 0.85rem;">
                        <strong>Atención:</strong> Tienes al menos un ítem evaluado como <strong>KO</strong>. La auditoría se cerrará como <strong>RECHAZADA</strong> (@(_checklist.Any(i => i.Result == "KO" && i.IsCritical) ? "KO_CRITICAL" : "KO_MINOR")).
                    </div>
                </div>
            }

            <!-- Conteo Resumen y Botón de Envío -->
            <div class="d-flex align-items-center justify-content-between border-top pt-3 mt-4">
                <div class="d-flex gap-3 text-muted" style="font-size: 0.85rem;">
                    <span>Aprobados (OK): <strong class="text-success">@_okCount</strong></span>
                    <span>Rechazados (KO): <strong class="text-danger">@_koCount</strong></span>
                    <span>N/A: <strong>@_naCount</strong></span>
                </div>

                <button class="btn btn-dark rounded-pill px-4 py-2 fw-semibold" 
                        disabled="@(!IsChecklistComplete)" 
                        @onclick="OpenPreviewModal">
                    Cerrar Auditoría
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal de Previsualización Global -->
@if (_showPreviewModal)
{
    <div class="modal-backdrop-blur">
        <div class="modal-container">
            <div class="border-bottom p-3 bg-light d-flex align-items-center justify-content-between">
                <h5 class="fw-bold m-0">Confirmación de Auditoría de Audio</h5>
                <button type="button" class="btn-close" @onclick="ClosePreviewModal"></button>
            </div>
            
            <div class="p-4">
                <div class="text-center mb-4">
                    <span class="text-muted d-block mb-1" style="font-size: 0.85rem;">RESULTADO GLOBAL PROPUESTO</span>
                    @if (_hasKo)
                    {
                        @if (_checklist.Any(i => i.Result == "KO" && i.IsCritical))
                        {
                            <span class="badge bg-danger text-white rounded-pill px-4 py-2 fs-5 fw-bold">RECHAZADA (KO CRÍTICO)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-4 py-2 fs-5 fw-bold">RECHAZADA (KO MENOR)</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-success text-white rounded-pill px-4 py-2 fs-5 fw-bold">APROBADA</span>
                    }
                </div>

                <div class="card p-3 border mb-3 bg-light" style="font-size: 0.85rem;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Orden de Venta:</span>
                        <span class="fw-bold">#@_order?.IdOrder</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Evaluaciones Conformes (OK):</span>
                        <span class="fw-semibold text-success">@_okCount</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Evaluaciones No Conformes (KO):</span>
                        <span class="fw-semibold text-danger">@_koCount</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Total de Puntos Evaluados:</span>
                        <span>@_markedCount de @_checklist.Count</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label section-title">Comentarios Generales del Auditor</label>
                    <textarea class="form-control" rows="3" placeholder="Ingresa notas generales opcionales..." @bind="_globalObservation"></textarea>
                </div>
            </div>

            <div class="border-top p-3 d-flex align-items-center justify-content-end gap-2 bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="ClosePreviewModal">Seguir Editando</button>
                <button type="button" class="btn btn-dark rounded-pill px-4" disabled="@_isSaving" @onclick="ConfirmCloseAudit">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Confirmar y Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public long idOrder { get; set; }

    private SalesOrderViewModel? _order;
    private bool _isLoading = true;
    private bool _isSaving = false;

    // SLA State
    private string _slaStatusText = "Dentro de SLA";
    
    // Audio Player State
    private int _currentTimeSeconds = 0;
    private int _durationSeconds = 272; // fallback total 4:32
    private bool _isPlaying = false;
    private Timer? _audioTimer;
    private double _playbackPercent => _durationSeconds > 0 ? (_currentTimeSeconds / (double)_durationSeconds) * 100 : 0;
    private string? _audioUrl;
    private string? _audioTitle;
    private bool _isFallbackAudio = false;

    // Checklist State
    private AuditChecklistViewModel? _checklistTemplate;
    private List<AuditChecklistItemViewModel> _checklist = new();

    private int _markedCount => _checklist.Count(item => !string.IsNullOrEmpty(item.Result));
    private int _okCount => _checklist.Count(item => item.Result == "OK");
    private int _koCount => _checklist.Count(item => item.Result == "KO");
    private int _naCount => _checklist.Count(item => item.Result == "N/A");
    private bool _hasKo => _koCount > 0;
    private bool IsChecklistComplete => _checklist.Count > 0 && _markedCount == _checklist.Count;

    // Modal state
    private bool _showPreviewModal = false;
    private string _globalObservation = string.Empty;

    // Audit Local Form State (OCR target fields)
    private string _auditCustomerName = "JUAN CARLOS PEREZ GOMEZ";
    private string _auditCustomerDni = "47291038B";
    private string _auditIban = "ES91 2100 0418 4502 0005 1192";
    private string _auditAddress = "AV. DE LA CONSTITUCION 45, 2A, MADRID";

    // OCR Assistant State
    public class OcrFieldItem
    {
        public string FieldLabel { get; set; } = "";
        public string DetectedText { get; set; } = "";
        public int Confidence { get; set; } = 95;
        public string BoxColor { get; set; } = "#6366f1";
        // Bounding box normalized [0..1] relative to image
        public double X { get; set; }
        public double Y { get; set; }
        public double W { get; set; }
        public double H { get; set; }
    }

    private bool _isOcrScanning = false;
    private OcrFieldItem? _selectedOcrField;
    private string? _selectedOcrText => _selectedOcrField?.DetectedText;
    private string? _docImageUrl;
    private List<OcrFieldItem> _ocrFields = new();

    private async Task RunOcrScanner()
    {
        if (string.IsNullOrEmpty(_docImageUrl))
        {
            Snackbar.Add("No hay imagen de documento disponible para escanear con OCR.", Severity.Warning);
            return;
        }
        _isOcrScanning = true;
        _selectedOcrField = null;
        _ocrFields = new();
        StateHasChanged();
        await Task.Delay(1200); // Simula latencia de análisis

        // Campos detectados con posiciones normalizadas sobre la imagen [0..1]
        _ocrFields = new List<OcrFieldItem>
        {
            new() { FieldLabel = "Apellidos", DetectedText = "CONTRERAS VILLAVICENCIO", Confidence = 98, BoxColor = "#6366f1", X = 0.20, Y = 0.15, W = 0.50, H = 0.08 },
            new() { FieldLabel = "Nombre", DetectedText = "ANA PATRICIA", Confidence = 97, BoxColor = "#0891b2", X = 0.20, Y = 0.27, W = 0.35, H = 0.07 },
            new() { FieldLabel = "CUI / DNI", DetectedText = "70025425-8", Confidence = 99, BoxColor = "#059669", X = 0.05, Y = 0.12, W = 0.18, H = 0.06 },
            new() { FieldLabel = "Fecha Nacimiento", DetectedText = "02 08 1982", Confidence = 94, BoxColor = "#d97706", X = 0.20, Y = 0.48, W = 0.25, H = 0.06 },
            new() { FieldLabel = "Estado Civil", DetectedText = "SOLTERA", Confidence = 91, BoxColor = "#db2777", X = 0.55, Y = 0.40, W = 0.20, H = 0.06 },
        };
        _isOcrScanning = false;
        StateHasChanged();

        // Dibujar bounding boxes sobre el canvas
        await DrawOcrBoxesOnCanvas();
        Snackbar.Add($"OCR completado: {_ocrFields.Count} fragmentos de texto detectados en la imagen.", Severity.Info);
    }

    private async Task DrawOcrBoxesOnCanvas()
    {
        try
        {
            var boxes = _ocrFields.Select(f => new
            {
                x = f.X, y = f.Y, w = f.W, h = f.H,
                color = f.BoxColor,
                label = f.FieldLabel,
                selected = f == _selectedOcrField
            }).ToArray();
            await JSRuntime.InvokeVoidAsync("ocrCanvas.drawBoxes", "ocr-canvas", "ocr-doc-image", boxes);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OCR Canvas] Draw error: {ex.Message}");
        }
    }

    private async Task OnDocImageLoaded()
    {
        if (_ocrFields.Any())
        {
            await DrawOcrBoxesOnCanvas();
        }
    }

    private async Task HandleCanvasClick(MouseEventArgs e)
    {
        if (!_ocrFields.Any()) return;
        try
        {
            // Get click position relative [0..1] within the image
            var relPos = await JSRuntime.InvokeAsync<double[]>("ocrCanvas.getRelativeClick", "ocr-canvas", e.ClientX, e.ClientY);
            if (relPos == null || relPos.Length < 2) return;
            double rx = relPos[0];
            double ry = relPos[1];

            // Find which box was clicked
            var hit = _ocrFields.FirstOrDefault(f =>
                rx >= f.X && rx <= f.X + f.W &&
                ry >= f.Y && ry <= f.Y + f.H);

            if (hit != null)
            {
                _selectedOcrField = hit;
                await DrawOcrBoxesOnCanvas();
                Snackbar.Add($"Seleccionado: «{hit.DetectedText}». Elige el campo destino en el panel.", Severity.Normal);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OCR Canvas] Click error: {ex.Message}");
        }
    }

    private async Task SelectOcrSnippet(OcrFieldItem field)
    {
        _selectedOcrField = field;
        await DrawOcrBoxesOnCanvas();
    }

    private void ClearOcrSelection()
    {
        _selectedOcrField = null;
    }

    private void TransferOcrToField(string text, string targetField)
    {
        switch (targetField)
        {
            case "TITULAR":   _auditCustomerName = text; break;
            case "DNI":       _auditCustomerDni = text; break;
            case "IBAN":      _auditIban = text; break;
            case "DIRECCION": _auditAddress = text; break;
        }
        _selectedOcrField = null; // deselect after transfer
        Snackbar.Add($"✅ «{text}» transferido a {targetField} correctamente.", Severity.Success);
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _order = await SalesOrderService.GetOrderByIdAsync(idOrder);
            if (_order != null)
            {
                CalculateSla();
                
                // Load actual audio documents for the order
                try
                {
                    var docs = await SalesOrderService.GetDocumentsByOrderAsync(idOrder);
                    var audioDoc = docs?.FirstOrDefault(d => 
                        string.Equals(d.DocumentType, "AUDIO", StringComparison.OrdinalIgnoreCase) || 
                        string.Equals(d.DocumentType, "GRABACION", StringComparison.OrdinalIgnoreCase) ||
                        d.FileName.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase) ||
                        d.FileName.EndsWith(".wav", StringComparison.OrdinalIgnoreCase) ||
                        d.FileName.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase)
                    );

                    if (audioDoc != null)
                    {
                        _audioUrl = $"/api/documents/{audioDoc.IdDocument}/download";
                        _audioTitle = audioDoc.FileName;
                        _isFallbackAudio = false;
                    }
                    else
                    {
                        // Fallback to testing audio
                        _audioUrl = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3";
                        _audioTitle = "Grabación de Contingencia";
                        _isFallbackAudio = true;
                    }

                    // Detect image document for OCR (DNI, CONTRATO, RECIBO)
                    var imageDoc = docs?.FirstOrDefault(d =>
                        string.Equals(d.DocumentType, "DNI", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(d.DocumentType, "IDENTIFICACION", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(d.DocumentType, "CONTRATO", StringComparison.OrdinalIgnoreCase) ||
                        d.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                        d.FileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                        d.FileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                        d.FileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)
                    );
                    _docImageUrl = imageDoc != null
                        ? $"/api/documents/{imageDoc.IdDocument}/download"
                        : null;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error retrieving documents: {ex.Message}");
                    _audioUrl = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3";
                    _audioTitle = "Grabación de Contingencia";
                    _isFallbackAudio = true;
                }

                // Load Campaign Checklist Template
                try
                {
                    _checklistTemplate = await AuditService.GetChecklistAsync(_order.IdCmpg);
                    if (_checklistTemplate != null && _checklistTemplate.Items != null && _checklistTemplate.Items.Count > 0)
                    {
                        _checklist = _checklistTemplate.Items;
                    }
                    else
                    {
                        Console.WriteLine($"No active checklist template found in DB for campaign {_order.IdCmpg}. Using fallback.");
                        LoadFallbackChecklist();
                        Snackbar.Add("No se encontró checklist en BD. Usando plantilla de contingencia.", Severity.Info);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading checklist: {ex.Message}");
                    LoadFallbackChecklist();
                    Snackbar.Add("Error al cargar checklist de BD. Usando contingencia.", Severity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar la orden: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }

        // Initialize audio progress poll timer
        _audioTimer = new Timer(1000);
        _audioTimer.Elapsed += OnAudioTick;
    }

    private void LoadFallbackChecklist()
    {
        _checklist = new()
        {
            new() { IdItem = 1, OrderIndex = 1, Description = "Identidad del cliente verificada mediante DNI/NIE y datos personales de contacto.", ItemType = "Identidad", IsCritical = true },
            new() { IdItem = 2, OrderIndex = 2, Description = "Explicación clara del servicio contratado, precio final y desglose de impuestos.", ItemType = "Oferta", IsCritical = true },
            new() { IdItem = 3, OrderIndex = 3, Description = "Lectura completa de las cláusulas de permanencia y penalizaciones por cancelación anticipada.", ItemType = "Legales", IsCritical = false },
            new() { IdItem = 4, OrderIndex = 4, Description = "Grabación de consentimiento expreso e inequívoco del titular para la contratación del servicio.", ItemType = "Consentimiento", IsCritical = true },
            new() { IdItem = 5, OrderIndex = 5, Description = "Verificación de la cuenta bancaria (IBAN) y autorización para cargo de recibos.", ItemType = "Pago", IsCritical = false }
        };
        _checklistTemplate = new AuditChecklistViewModel
        {
            IdChecklist = 1,
            IdCmpg = _order?.IdCmpg ?? 1,
            Name = "Plantilla Contingencia (Mock)",
            Version = "1.0",
            Items = _checklist
        };
    }

    private void CalculateSla()
    {
        if (_order == null) return;
        var diff = DateTime.UtcNow - _order.SalesDate;
        
        if (diff.TotalHours < 24)
        {
            _slaStatusText = "Dentro de SLA";
        }
        else if (diff.TotalHours < 48)
        {
            _slaStatusText = "Al límite de SLA";
        }
        else
        {
            _slaStatusText = "Fuera de SLA";
        }
    }

    private string GetSlaClass()
    {
        return _slaStatusText switch
        {
            "Dentro de SLA" => "sla-green",
            "Al límite de SLA" => "sla-yellow",
            "Fuera de SLA" => "sla-red",
            _ => "sla-green"
        };
    }

    private void SetResult(AuditChecklistItemViewModel item, string result)
    {
        item.Result = result;
        if (result != "KO")
        {
            item.Observation = string.Empty;
        }
        StateHasChanged();
    }

    private async Task TogglePlay()
    {
        _isPlaying = !_isPlaying;
        if (_isPlaying)
        {
            _audioTimer?.Start();
            await JSRuntime.InvokeVoidAsync("audioPlayer.play", "audio-element");
        }
        else
        {
            _audioTimer?.Stop();
            await JSRuntime.InvokeVoidAsync("audioPlayer.pause", "audio-element");
        }
    }

    private async Task SeekAudio(MouseEventArgs e)
    {
        var newTime = await JSRuntime.InvokeAsync<double>("audioPlayer.seekToPercent", "audio-element", e.ClientX, "audio-progress-bar");
        _currentTimeSeconds = (int)newTime;
        StateHasChanged();
    }

    private void CopyCurrentTimestamp(AuditChecklistItemViewModel item)
    {
        item.Timestamp = FormatTime(_currentTimeSeconds);
        StateHasChanged();
    }

    private string FormatTime(int seconds)
    {
        int minutes = seconds / 60;
        int remainingSeconds = seconds % 60;
        return $"{minutes:D2}:{remainingSeconds:D2}";
    }

    private async void OnAudioTick(object? sender, ElapsedEventArgs e)
    {
        try
        {
            var cur = await JSRuntime.InvokeAsync<double>("audioPlayer.getCurrentTime", "audio-element");
            var dur = await JSRuntime.InvokeAsync<double>("audioPlayer.getDuration", "audio-element");
            
            _currentTimeSeconds = (int)cur;
            if (dur > 0)
            {
                _durationSeconds = (int)dur;
            }

            if (_currentTimeSeconds >= _durationSeconds && _isPlaying)
            {
                _isPlaying = false;
                _audioTimer?.Stop();
                await JSRuntime.InvokeVoidAsync("audioPlayer.pause", "audio-element");
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Ignore JS exceptions on page exit / refresh
        }
    }

    private void OpenPreviewModal()
    {
        // Validar observaciones obligatorias para ítems con KO
        bool hasMissingObservations = _checklist.Any(item => item.Result == "KO" && string.IsNullOrWhiteSpace(item.Observation));
        if (hasMissingObservations)
        {
            Snackbar.Add("Debes indicar una observación para cada ítem marcado como KO.", Severity.Warning);
            return;
        }

        _showPreviewModal = true;
    }

    private void ClosePreviewModal()
    {
        _showPreviewModal = false;
    }

    private async Task ConfirmCloseAudit()
    {
        _isSaving = true;
        try
        {
            if (_checklistTemplate == null)
            {
                Snackbar.Add("No hay un checklist activo para guardar.", Severity.Error);
                return;
            }

            // 1. Create audit session in database
            var idAudit = await AuditService.CreateAuditAsync(idOrder, _checklistTemplate.IdChecklist);

            // 2. Save each checklist item evaluation
            foreach (var item in _checklist)
            {
                await AuditService.SaveItemAsync(idAudit, item.IdItem, item.Result, item.Observation, item.Timestamp);
            }

            // 3. Determine overall status
            var finalStatus = _hasKo 
                ? (_checklist.Any(item => item.Result == "KO" && item.IsCritical) ? "KO_CRITICAL" : "KO_MINOR")
                : "APROBADA";

            // 4. Close audit to trigger status change and incidents logic
            var closeSuccess = await AuditService.CloseAuditAsync(idAudit, finalStatus);
            if (closeSuccess)
            {
                Snackbar.Add($"Auditoría guardada exitosamente. Resultado global: {finalStatus}.", Severity.Success);
                _showPreviewModal = false;
                NavigationManager.NavigateTo("/backoffice/dashboard");
            }
            else
            {
                Snackbar.Add("Error al cerrar la auditoría en el servidor.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar auditoría: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    public void Dispose()
    {
        _audioTimer?.Dispose();
    }
}
