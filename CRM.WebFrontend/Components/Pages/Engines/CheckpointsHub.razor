    private async Task MoveStage(long stageId, string direction)
    {
        stageMoveMsg = string.Empty;
        var idx = dbStages.FindIndex(s => s.IdStage == stageId);
        if (idx < 0) return;

        int targetIdx = direction == "up" ? idx - 1 : idx + 1;
        if (targetIdx < 0 || targetIdx >= dbStages.Count)
        {
            stageMoveMsg = "No se puede mover en esa dirección (ya está en el límite).";
            stageMoveIsError = true;
            return;
        }

        var currentStage = dbStages[idx];
        var targetStage = dbStages[targetIdx];

        short newOrderForCurrent = targetStage.OrderIndex;
        short newOrderForTarget = currentStage.OrderIndex;

        if (newOrderForCurrent == newOrderForTarget)
        {
            newOrderForCurrent = direction == "up" ? (short)(targetStage.OrderIndex - 1) : (short)(targetStage.OrderIndex + 1);
            if (newOrderForCurrent < 1) newOrderForCurrent = 1;
        }

        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            var res1 = await Http.PatchAsJsonAsync($"{apiBase}/api/engines/flow/stages/{currentStage.IdStage}/order", new { OrderIndex = newOrderForCurrent });
            var res2 = await Http.PatchAsJsonAsync($"{apiBase}/api/engines/flow/stages/{targetStage.IdStage}/order", new { OrderIndex = newOrderForTarget });

            if (res1.IsSuccessStatusCode && res2.IsSuccessStatusCode)
            {
                await LoadStagesFromDb();
                stageMoveMsg = $"✅ Etapa '{currentStage.Name}' reordenada correctamente.";
                stageMoveIsError = false;
            }
            else
            {
                stageMoveMsg = "Error al guardar el nuevo orden de la etapa.";
                stageMoveIsError = true;
            }
        }
        catch (Exception ex)
        {
            stageMoveMsg = $"Error: {ex.Message}";
            stageMoveIsError = true;
        }
    }

    private async Task CreateStageApi()
    {
        stageFeedback = string.Empty;
        if (string.IsNullOrWhiteSpace(newStageName) || string.IsNullOrWhiteSpace(newStageCode))
        {
            stageFeedback = "Nombre y Código son obligatorios.";
            stageFeedbackIsError = true;
            return;
        }
        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            var payload = new
            {
                IdFlow = dbStages.FirstOrDefault()?.IdFlow ?? 1L,
                StageCode = newStageCode.Trim().ToUpperInvariant(),
                Name = newStageName.Trim(),
                Description = string.IsNullOrWhiteSpace(newStageDescription) ? (string?)null : newStageDescription.Trim(),
                OrderIndex = (short)newStageOrder,
                IsTerminal = newStageIsTerminal,
                SlaHours = newStageSlaHours,
                Portfolio = createStageSelectedPortfolios.Any() ? string.Join(",", createStageSelectedPortfolios) : "GENERAL",
                Campaign = createStageSelectedCampaigns.Any() ? string.Join(",", createStageSelectedCampaigns) : "GENERAL",
                Metadata = "{}"
            };
            var response = await Http.PostAsJsonAsync($"{apiBase}/api/engines/flow/stages", payload);
            if (response.IsSuccessStatusCode)
            {
                stageFeedback = $"✅ Etapa '{newStageName}' creada exitosamente en nyx_flow.stage.";
                stageFeedbackIsError = false;
                newStageName = newStageCode = newStageDescription = string.Empty;
                newStageOrder = 1; newStageSlaHours = null; newStageIsTerminal = false;
                createStageSelectedPortfolios.Clear();
                createStageSelectedCampaigns.Clear();
                await LoadStagesFromDb();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                stageFeedback = $"🛑 Error al crear etapa: {err}";
                stageFeedbackIsError = true;
            }
        }
        catch (Exception ex)
        {
            stageFeedback = $"Error de comunicación: {ex.Message}";
            stageFeedbackIsError = true;
        }
    }

