    private async Task SaveCpEdits()
    {
        if (selectedCp == null) return;
        cpEditMsg = string.Empty;
        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            var payload = new
            {
                name = editCpName.Trim(),
                description = selectedCp.Description,
                origin = editCpOrigin,
                scope = selectedCp.Scope ?? "ENTITY",
                triggerStageId = editCpTriggerStageId > 0 ? (long?)editCpTriggerStageId : null,
                blocksAdvance = editCpBlocks,
                executionOrder = editCpExecutionOrder,
                category = editCpCategory,
                division = editCpDivision,
                approvalJobTitle = editCpApprovalJobTitle,
                satellites = editSelectedSatellites.ToArray(),
                rollbackToCheckpointCode = string.IsNullOrWhiteSpace(editCpRollbackCode) ? null : editCpRollbackCode,
                rollbackToStepOrder = string.IsNullOrWhiteSpace(editCpRollbackCode) ? null : editCpRollbackStep,
                preconditionFact = string.IsNullOrWhiteSpace(editCpPreconditionFact) ? null : editCpPreconditionFact,
                portfolio = editSelectedPortfolios.Any() ? string.Join(",", editSelectedPortfolios) : "GENERAL",
                campaign = editSelectedCampaigns.Any() ? string.Join(",", editSelectedCampaigns) : "GENERAL",
                provider = editCpProvider,
                finalizesCycle = editCpFinalizesCycle,
                targetRoles = selectedCp.TargetRoles ?? "SUPERVISOR,BACKOFFICE"
            };

            var response = await Http.PutAsJsonAsync($"{apiBase}/api/engines/flow/catalogs/{selectedCp.IdCheckpoint}", payload);
            if (response.IsSuccessStatusCode)
            {
                if (editCpTriggerStageId > 0)
                {
                    await Http.PatchAsJsonAsync($"{apiBase}/api/engines/flow/catalogs/{selectedCp.IdCheckpoint}/stage", new { stageId = (long?)editCpTriggerStageId });
                }

                await SaveCheckpointStepsApi(selectedCp.IdCheckpoint, editCpSteps);

                cpEditMsg = "✅ Checkpoint actualizado correctamente con etapa y pasos.";
                cpEditIsError = false;
                await LoadCatalog();
                await Task.Delay(400);
                showEditCpModal = false;
            }
            else
            {
                var errStr = await response.Content.ReadAsStringAsync();
                cpEditMsg = $"🛑 Error: {errStr}";
                cpEditIsError = true;
            }
        }
        catch (Exception ex)
        {
            cpEditMsg = $"Error: {ex.Message}";
            cpEditIsError = true;
        }
    }

