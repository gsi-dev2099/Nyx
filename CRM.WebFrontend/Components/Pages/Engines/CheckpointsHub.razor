                        <label class="form-label small fw-bold text-dark mb-1">Código (Autogenerado)</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control fw-bold text-primary" placeholder="CP_CÓDIGO" @bind="newCpCode" @bind:after='() => isManualCode = true' />
                            <button class="btn btn-outline-secondary" type="button" @onclick='() => { isManualCode = false; GenerateCodeFromName(newCpName); }'>
                                🪄
                            </button>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label small fw-bold text-dark mb-1">Orden Ejecución</label>
                        <input type="number" class="form-control form-control-sm text-center fw-bold" min="1" max="100" @bind="newCpExecutionOrder" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label small fw-bold text-dark mb-1">Categoría</label>
                        <select class="form-select form-select-sm" @bind="newCpCategory">
                            @foreach (var cat in AvailableCategories)
                            {
                                <option value="@cat">📁 @cat</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6 col-sm-3">
                        <label class="form-label small fw-bold text-dark mb-1">División / Área</label>
                        <select class="form-select form-select-sm" @bind="newCpDivision">
                            <option value="GENERAL">🏢 GENERAL</option>
                            @foreach (var div in DivisionsList)
                            {
                                <option value="@div">🏢 @div</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label small fw-bold text-dark mb-1">Cargo Aprobación</label>
                        <select class="form-select form-select-sm" @bind="newCpApprovalJobTitle">
                            <option value="">👤 (Ninguno - Opcional)</option>
                            @foreach (var jt in JobTitlesList)
                            {
                                <option value="@jt">👤 @jt</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label small fw-bold text-dark mb-1">Proveedor Destino</label>
                        <select class="form-select form-select-sm" @bind="newCpProvider">
                            <option value="">🏢 (Ninguno - Opcional)</option>
                            @foreach (var prov in ProvidersList)
                            {
                                <option value="@prov">🏢 @prov</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label small fw-bold text-dark mb-1">Origen Evento</label>
                        <select class="form-select form-select-sm" @bind="newCpOrigin">
                            <option value="INTERNAL">INTERNAL (CRM GSI)</option>
                            <option value="EXTERNAL">EXTERNAL (Proveedor)</option>
                        </select>
                    </div>
                </div>

                <!-- PASOS DEL CHECKPOINT -->
                <div class="mb-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-bold small text-dark">📋 Pasos Secuenciales del Checkpoint</span>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5" style="font-size:0.75rem;" @onclick="AddStepToNew">
                            + Agregar Paso
                        </button>
                    </div>
                    @if (!newCpSteps.Any())
                    {
                        <span class="text-muted small d-block text-center py-2" style="font-size:0.78rem;">No hay pasos definidos aún. Haz clic en '+ Agregar Paso'.</span>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @for (int sIdx = 0; sIdx < newCpSteps.Count; sIdx++)
                            {
                                var stepItem = newCpSteps[sIdx];
                                var stepNum = sIdx + 1;
                                <div class="d-flex align-items-center gap-2 bg-white p-2 rounded border shadow-sm">
                                    <span class="badge bg-dark text-white rounded-circle" style="width:22px; height:22px; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">@stepNum</span>
                                    <input type="text" class="form-control form-control-sm" placeholder="Instrucción / Nombre del paso..." @bind="stepItem.Instruction" />
                                    <div class="form-check form-switch mb-0 ms-1" title="Paso Obligatorio">
                                        <input class="form-check-input" type="checkbox" @bind="stepItem.IsRequired" />
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1" @onclick="() => RemoveStepFromNew(stepItem)" title="Eliminar paso">
                                        🗑️
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-2 mb-2 p-2 bg-light rounded-3 border">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold m-0 text-dark mb-1" style="font-size:11px;">Satélites Involucrados</label>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var sat in SatellitesList)
                            {
                                <span class="badge @(selectedSatellites.Contains(sat) ? "bg-dark text-white" : "bg-white text-muted border") rounded-pill cursor-pointer px-2" style="font-size:10px; cursor:pointer;" @onclick="() => ToggleSatellite(sat)">
                                    @(selectedSatellites.Contains(sat) ? "✓ " : "+ ")@sat
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="p-2 bg-white rounded border text-muted small" style="font-size:0.75rem;">
                            ℹ️ <strong>Cartera y Campaña</strong> son gobernadas directamente a nivel de la <strong>Etapa Nyx</strong> asignada.
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-bold text-dark mb-1">↩ Retrocede Específicamente a Checkpoint</label>
                        <select class="form-select form-select-sm" @bind="newCpRollbackCode">
                            <option value="">(Sin retroceso específico)</option>
                            @foreach (var item in catalogItems.OrderBy(c => c.ExecutionOrder))
                            {
                                <option value="@item.Code">#@item.ExecutionOrder — @item.Code (@item.Name)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label small fw-bold text-dark mb-1">Paso Específico</label>
                        <input type="number" class="form-control form-control-sm text-center" min="1" max="10" @bind="newCpRollbackStep" disabled="@(string.IsNullOrEmpty(newCpRollbackCode))" />
                    </div>
                    <div class="col-6 col-sm-3 d-flex align-items-end gap-3 justify-content-end pb-1">
                        <div class="form-check form-switch small">
                            <input class="form-check-input" type="checkbox" id="checkBlockCreate" @bind="newCpBlocks" />
                            <label class="form-check-label small fw-bold" for="checkBlockCreate">Bloqueante</label>
                        </div>
                        <div class="form-check form-switch small">
                            <input class="form-check-input" type="checkbox" id="checkFinalizeCreate" @bind="newCpFinalizesCycle" />
                            <label class="form-check-label small fw-bold text-danger" for="checkFinalizeCreate">Finaliza</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-4" @onclick="CloseCreateCpModal">Cancelar</button>
                    <button class="btn btn-sm btn-primary fw-bold rounded-pill px-4" @onclick="CreateCheckpointApiModal">💾 Crear Checkpoint</button>
                </div>
            </div>
        </div>
    }
    <!-- MODAL MATRIZ DE CHECKPOINTS DE ETAPA CON FONDO DIFUMINADO -->
    @if (showStageCheckpointsModal && selectedStage != null)
    {
        <div class="modal-backdrop-blur" @onclick="CloseStageCheckpointsModal">
            <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 960px; width: 92vw;">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:36px;height:36px;border-radius:10px;background:#0F172A;display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;">🎯</div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">Matriz de Checkpoints para Etapa: <span class="text-primary">@selectedStage.Name</span></h5>
                            <code class="text-primary small">@selectedStage.StageCode</code>
                            <span class="badge bg-dark rounded-pill ms-2"># Orden @selectedStage.OrderIndex</span>
                            @if (selectedStage.IsTerminal)
                            {
                                <span class="pill pill-red ms-1" style="font-size:9px;">⛔ TERMINAL</span>
                            }
                        </div>
                    </div>
                    <button class="btn-close-circle" @onclick="CloseStageCheckpointsModal">✕</button>
                </div>

                @if (!string.IsNullOrEmpty(stageCpAssignMsg))
                {
                    <div class="mb-3 p-2 rounded small fw-bold @(stageCpAssignIsError ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success")">
                        @stageCpAssignMsg
                    </div>
                }

                <!-- MATRIZ DUAL DE ASIGNACIÓN (TRANSFER BOARD 50% - 50%) -->
                <div class="row g-3">
                    <!-- COLUMNA IZQUIERDA (50%): Checkpoints Disponibles -->
                    <div class="col-12 col-md-6">
                        <div class="border rounded-3 p-3 bg-light h-100 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-dark" style="font-size:13px;">📦 Checkpoints Disponibles (Sin Asignar)</span>
                                @{
                                    var availCps = catalogItems.Where(c => c.TriggerStageId != selectedStage.IdStage)
                                                               .Where(c => string.IsNullOrWhiteSpace(availableCpSearch) || 
                                                                           c.Name.Contains(availableCpSearch, StringComparison.OrdinalIgnoreCase) || 
                                                                           c.Code.Contains(availableCpSearch, StringComparison.OrdinalIgnoreCase))
                                                               .OrderBy(c => c.ExecutionOrder).ToList();
                                }
                                <span class="badge bg-secondary rounded-pill px-2">@availCps.Count</span>
                            </div>

                            <input type="text" class="form-control form-control-sm mb-3" placeholder="🔍 Buscar por nombre o código..." @bind="availableCpSearch" @bind:event="oninput" style="font-size:12px;" />

                            @if (!availCps.Any())
                            {
                                <div class="text-center text-muted small py-5">No hay checkpoints disponibles sin asignar.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2 overflow-auto pe-1" style="max-height:420px;">
                                    @foreach (var cp in availCps)
                                    {
                                        var cpId = cp.IdCheckpoint;
                                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded border bg-white shadow-sm" style="font-size:12px;">
                                            <div class="min-w-0 flex-grow-1 pe-2">
                                                <div class="fw-bold text-dark text-truncate">@cp.Name</div>
                                                <div class="d-flex gap-2 align-items-center mt-1">
                                                    <code class="text-primary fw-semibold" style="font-size:10px;">@cp.Code</code>
                                                    <span class="badge bg-light text-dark border" style="font-size:9px;">🏢 @cp.Division</span>
                                                    @if (!string.IsNullOrEmpty(cp.Campaign) && cp.Campaign != "GENERAL")
                                                    {
                                                        <span class="badge bg-info text-dark" style="font-size:9px;">📣 @cp.Campaign</span>
                                                    }
                                                </div>
                                            </div>
                                            <button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3 fw-bold" style="font-size:11px; white-space:nowrap;"
                                                    @onclick="() => AssignCheckpointToStage(cpId, selectedStage.IdStage)" title="Asignar a esta etapa">
                                                + Asignar ➡
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- COLUMNA DERECHA (50%): Checkpoints Asignados a esta Etapa -->
                    <div class="col-12 col-md-6">
                        <div class="border rounded-3 p-3 bg-white border-primary h-100 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-primary" style="font-size:13px;">🎯 Checkpoints Asignados a @selectedStage.Name</span>
                                @{
                                    var assignedCps = catalogItems.Where(c => c.TriggerStageId == selectedStage.IdStage)
                                                                   .OrderBy(c => c.ExecutionOrder).ToList();
                                }
                                <span class="badge bg-primary rounded-pill px-2">@assignedCps.Count</span>
                            </div>

                            <p class="text-muted small mb-3" style="font-size:11px;">Checkpoints asignados que aplican durante esta etapa.</p>

                            @if (!assignedCps.Any())
                            {
                                <div class="text-center text-muted small py-5">
                                    <div style="font-size:2rem;">🎯</div>
                                    <div class="fw-bold">Sin checkpoints asignados aún.</div>
                                    <div class="mt-1">Haz clic en <strong>+ Asignar ➡</strong> desde el panel de la izquierda.</div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2 overflow-auto pe-1" style="max-height:420px;">
                                    @for (int cpi = 0; cpi < assignedCps.Count; cpi++)
                                    {
                                        var cp = assignedCps[cpi];
                                        var cpId = cp.IdCheckpoint;
                                        var isCpFirst = cpi == 0;
                                        var isCpLast = cpi == assignedCps.Count - 1;
                                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded border bg-primary bg-opacity-10 border-primary" style="font-size:12px;">
                                            <div class="min-w-0 flex-grow-1 pe-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <!-- # Ord Input inside Stage -->
                                                    <input type="number" class="form-control form-control-sm text-center fw-bold px-1"
                                                           style="width:48px; font-size:11px;"
                                                           value="@cp.ExecutionOrder"
                                                           min="1" max="999"
                                                           @onchange='async e => await SetCheckpointExecutionOrderDirect(cpId, e.Value?.ToString())'
                                                           title="Editar orden de ejecución en la etapa" />
                                                    
                                                    <!-- ▲▼ Move Buttons -->
                                                    <div class="d-flex flex-column gap-1">
                                                        <button class="btn btn-outline-secondary rounded px-1 py-0 lh-1" style="font-size:8px; padding: 1px 3px;" disabled="@isCpFirst" @onclick='() => MoveAssignedCheckpoint(cpId, "up", assignedCps)'>▲</button>
                                                        <button class="btn btn-outline-secondary rounded px-1 py-0 lh-1" style="font-size:8px; padding: 1px 3px;" disabled="@isCpLast" @onclick='() => MoveAssignedCheckpoint(cpId, "down", assignedCps)'>▼</button>
                                                    </div>

                                                    <div class="fw-bold text-dark text-truncate ms-1">@cp.Name</div>
                                                </div>
                                                <div class="d-flex gap-2 align-items-center mt-1 ms-1">
                                                    <code class="text-primary fw-semibold" style="font-size:10px;">@cp.Code</code>
                                                    @if (cp.FinalizesCycle) { <span class="pill pill-red" style="font-size:8px;">⛔ FINALIZA</span> }
                                                    else if (cp.BlocksAdvance) { <span class="pill pill-amber" style="font-size:8px;">🔒 BLOQUEA</span> }
                                                    else { <span class="pill pill-outline" style="font-size:8px;">INFO</span> }
                                                    <span class="badge bg-light text-dark border" style="font-size:9px;">🏢 @(string.IsNullOrEmpty(cp.Division) ? "OPERACIONES" : cp.Division)</span>
                                                    @if (!string.IsNullOrEmpty(cp.ApprovalJobTitle))
                                                    {
                                                        <span class="badge bg-light text-dark border" style="font-size:9px;">👤 @cp.ApprovalJobTitle</span>
                                                    }
                                                </div>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger rounded-pill py-1 px-3 fw-bold" style="font-size:11px; white-space:nowrap;"
                                                    @onclick="() => UnassignCheckpointFromStage(cpId)" title="Quitar de esta etapa">
                                                ⬅ Quitar
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-4" @onclick="CloseStageCheckpointsModal">Cerrar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string tab = "etapas";

    // — Catalog —
    private bool loadingCatalog = false;
    private List<CatalogItemVm> catalogItems = new();

    // — Flow instance —
    private bool loadingFlow = false;
    private long flowInstanceId = 0;
    private long actorId = 9;
    private FlowInstanceVm? flowInstance;
    private List<CheckpointInstanceVm> instanceCheckpoints = new();
    private string flowError = string.Empty;
    private string flowSuccess = string.Empty;

    // — Approvals —
    private bool loadingApprovals = false;
    private long approverIdFilter = 9;
    private string approverRoleFilter = "SUPERVISOR";
    private List<ApprovalRequestVm> approvalRequests = new();
    private string approvalMsg = string.Empty;
    private bool approvalMsgIsError = false;

    private class StageVm
    {
        public long IdStage { get; set; }
        public long IdFlow { get; set; }
        public string StageCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public short OrderIndex { get; set; }
        public bool IsTerminal { get; set; }
        public short? SlaHours { get; set; }
        public string Portfolio { get; set; } = "GENERAL";
        public string Campaign { get; set; } = "GENERAL";
    }

    private List<StageVm> dbStages = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStagesFromDb();
        await LoadCatalog();
    }

    private async Task LoadStagesFromDb()
    {
        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            var result = await Http.GetFromJsonAsync<List<StageVm>>($"{apiBase}/api/engines/flow/stages");
            if (result != null && result.Any())
            {
                dbStages = result.OrderBy(s => s.OrderIndex).ToList();
                if (selectedStage == null)
                {
                    selectedStage = dbStages.FirstOrDefault();
                    if (selectedStage != null) SelectStage(selectedStage);
                }
                else
                {
                    var updated = dbStages.FirstOrDefault(s => s.IdStage == selectedStage.IdStage);
                    if (updated != null) selectedStage = updated;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CheckpointsHub] Error loading stages from DB: {ex.Message}");
        }
    }

    private void SetTab(string t) { tab = t; flowError = string.Empty; flowSuccess = string.Empty; approvalMsg = string.Empty; }

    private string GetStageName(long stageId)
    {
        var match = dbStages.FirstOrDefault(s => s.IdStage == stageId);
        return match != null ? match.Name : $"Etapa #{stageId}";
    }

    // ——— Catalog ———
    private async Task LoadCatalog()
    {
        loadingCatalog = true;
        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            var result = await Http.GetFromJsonAsync<List<CatalogItemVm>>($"{apiBase}/api/engines/flow/catalogs");
            catalogItems = result ?? new();
            PopulateLayersFromCatalog();
        }
        catch (Exception ex)
        {
            catalogItems = new();
            PopulateLayersFromCatalog();
            Console.WriteLine($"[CheckpointsHub] Error loading catalog: {ex.Message}");
        }
        finally { loadingCatalog = false; }
    }

    // ——— Flow Instance ———
    private async Task LoadFlowInstance()
    {
        if (flowInstanceId <= 0) return;
        loadingFlow = true; flowError = string.Empty; flowSuccess = string.Empty;
        try
        {
            var apiBase = GetApiBase();
            flowInstance = await Http.GetFromJsonAsync<FlowInstanceVm>($"{apiBase}/api/flow/instances/{flowInstanceId}");
            // Load active checkpoints for this instance
            var cps = await Http.GetFromJsonAsync<List<CheckpointInstanceVm>>($"{apiBase}/api/flow/instances/{flowInstanceId}/checkpoints");
            instanceCheckpoints = cps ?? new();
        }
        catch (Exception ex)
        {
            flowInstance = null;
            instanceCheckpoints = new();
            Console.WriteLine($"[CheckpointsHub] Error loading flow instance: {ex.Message}");
        }
        finally { loadingFlow = false; }
    }

    private async Task AdvanceStage()
    {
        if (flowInstance == null) return;
        flowError = string.Empty; flowSuccess = string.Empty;
        try
        {
            var apiBase = GetApiBase();
            var payload = new { actorId };
            var response = await Http.PostAsJsonAsync($"{apiBase}/api/flow/instances/{flowInstance.IdInstance}/advance", payload);
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<FlowInstanceVm>();
                if (updated != null)
                {
                    flowInstance = updated;
                    flowSuccess = $"Etapa avanzada correctamente → ahora en '{GetStageName(flowInstance.CurrentStageId)}'.";
                    await LoadFlowInstance(); // Reload checkpoints
                }
            }
            else
            {
                var errJson = await response.Content.ReadFromJsonAsync<JsonElement>();
                flowError = errJson.TryGetProperty("error", out var e) ? e.GetString() ?? "Error desconocido." : "Nyx.FlowEngine bloqueó el avance.";
            }
        }
        catch (Exception ex)
        {
            flowError = $"Error de comunicación con Nyx.FlowEngine: {ex.Message}";
        }
    }

    private async Task ResolveCheckpoint(long cpInstanceId, string status)
    {
        try
        {
            var apiBase = GetApiBase();
            var payload = new { status, actorId };
            var response = await Http.PostAsJsonAsync($"{apiBase}/api/flow/checkpoints/instances/{cpInstanceId}/resolve", payload);
            if (response.IsSuccessStatusCode)
            {
                flowSuccess = $"Checkpoint #{cpInstanceId} marcado como {status}.";
                await LoadFlowInstance();
            }
            else
            {
                flowError = $"No se pudo resolver el checkpoint #{cpInstanceId}.";
            }
        }
        catch (Exception ex)
        {
            flowError = ex.Message;
        }
    }

    // ——— Approvals ———
    private async Task LoadApprovals()
    {
        loadingApprovals = true; approvalMsg = string.Empty;
        try
        {
            var apiBase = GetApiBase();
            var url = $"{apiBase}/api/engines/approval/pending?approverId={approverIdFilter}&approverRole={Uri.EscapeDataString(approverRoleFilter)}";
            var result = await Http.GetFromJsonAsync<List<ApprovalRequestVm>>(url);
            approvalRequests = result ?? new();
        }
        catch (Exception ex)
        {
            approvalRequests = new();
            Console.WriteLine($"[CheckpointsHub] Error loading approvals: {ex.Message}");
        }
        finally { loadingApprovals = false; }
    }

    private async Task DecideApproval(long requestId, string decision)
    {
        approvalMsg = string.Empty;
        try
        {
            var apiBase = GetApiBase();
            var payload = new { decidedBy = approverIdFilter, decision, reason = $"Decisión vía Nyx Engines Hub ({approverRoleFilter})" };
            var response = await Http.PostAsJsonAsync($"{apiBase}/api/approval/requests/{requestId}/decide", payload);
            if (response.IsSuccessStatusCode)
            {
                approvalMsgIsError = false;
                approvalMsg = $"✓ Solicitud #{requestId} — decisión '{decision}' registrada exitosamente.";
                await LoadApprovals();
            }
            else
            {
                var errJson = await response.Content.ReadFromJsonAsync<JsonElement>();
                approvalMsgIsError = true;
                approvalMsg = errJson.TryGetProperty("error", out var e) ? $"🛑 SOX/ISO 27001: {e.GetString()}" : "Error al procesar la decisión.";
            }
        }
        catch (Exception ex)
        {
            approvalMsgIsError = true;
            approvalMsg = $"Error de comunicación: {ex.Message}";
        }
    }

    private string GetApiBase()
    {
        // YARP reverse proxy on the WebFrontend routes /api/** → CRM.ApiHub:5068
        // Using NavManager.BaseUri ensures we form a valid absolute URI (e.g. http://localhost:5261)
        return NavManager.BaseUri.TrimEnd('/');
    }

    private async Task EnsureAuthHeader()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var tokenClaim = authState.User.FindFirst("access_token")?.Value;
            if (!string.IsNullOrEmpty(tokenClaim))
            {
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", tokenClaim);
            }
        }
        catch { /* Safe fallback */ }
    }

