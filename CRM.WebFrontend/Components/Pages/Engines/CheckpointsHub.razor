@page "/engines/checkpoints"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Text.Json
@attribute [Authorize(Roles = "ADMIN_CRM")]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Administrador de Capas & Checkpoints — Nyx Engines Hub</PageTitle>

<style>
    .hub-wrap { max-width: 1200px; margin: 0 auto; padding: 24px; }
    .hub-tabs { display: flex; gap: 6px; background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 5px; flex-wrap: wrap; }
    .hub-tab { font-size: 13px; font-weight: 600; color: #64748B; background: none; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; transition: all .15s; }
    .hub-tab.active { background: #0F172A; color: #fff; }
    .hub-tab:not(.active):hover { background: #F1F5F9; }
    .card-panel { background: #fff; border: 1px solid #E2E8F0; border-radius: 16px; padding: 24px; margin-bottom: 20px; box-shadow: 0 4px 14px rgba(15,23,42,0.03); }
    .pill { display: inline-flex; align-items: center; gap: 4px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 14px; white-space: nowrap; }
    .pill-green { background: #E6F4EA; color: #065F46; }
    .pill-red { background: #FEE2E2; color: #991B1B; }
    .pill-amber { background: #FEF3C7; color: #92400E; }
    .pill-violet { background: #F1F5F9; color: #0F172A; }
    .pill-navy { background: #0F172A; color: #fff; }
    .pill-outline { background: transparent; border: 1px solid #CBD5E1; color: #475569; }
    .modal-backdrop-blur {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        padding: 20px;
    }
    .modal-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
        width: 100%; max-width: 620px;
        max-height: 88vh;
        overflow-y: auto;
        padding: 24px; border: 1px solid #E2E8F0;
        animation: modalFadeIn .2s ease-out;
    }
    .modal-card::-webkit-scrollbar { width: 6px; }
    .modal-card::-webkit-scrollbar-track { background: #F1F5F9; border-radius: 10px; }
    .modal-card::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 10px; }
    .modal-card::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
    .btn-close-circle {
        background: #F1F5F9; border: none;
        width: 32px; height: 32px; border-radius: 50%;
        font-weight: 700; color: #64748B; cursor: pointer;
        display: flex; align-items: center; justify-content: center; transition: all .15s;
    }
    .btn-close-circle:hover { background: #E2E8F0; color: #0F172A; }
    @@keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<div class="hub-wrap">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div style="width:42px;height:42px;border-radius:12px;background:#0F172A;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:18px;">G</div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold mb-0 text-dark">Motor de Checkpoints & Aprobaciones</h4>
                    <span class="badge bg-dark text-white px-2 py-1" style="font-size:10px;">MOTOR PRIMARIO NYX</span>
                </div>
                <span class="text-muted small">NYX.FLOWENGINE & APPROVALENGINE · ARQUITECTURA MULTI-CAPA N-TIER · GOBIERNO EN TIEMPO REAL</span>
            </div>
        </div>
        <div class="hub-tabs">
            <button class="hub-tab @(tab == "etapas" ? "active" : "")" @onclick='() => SetTab("etapas")'>🏗️ 1. Etapas & Asignación de Checkpoints</button>
            <button class="hub-tab @(tab == "catalogo" ? "active" : "")" @onclick='() => SetTab("catalogo")'>📦 2. Catálogo & Crear Checkpoints</button>
        </div>
    </div>

    <!-- ========== TAB 1: CATÁLOGO CAPA 1 ========== -->
    @if (tab == "catalogo")
    {
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Catálogo de Checkpoints — Capa 1 (Gobernado por Triple Firma)</h5>
                    <p class="text-muted small mb-0">Datos en vivo desde <code>Nyx.FlowEngine → nyx_flow.checkpoint_catalog</code>. Cada fila activa requirió aprobación de Data, Negocio y Gerencia.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenCreateCpModal">
                        ➕ Nuevo Checkpoint
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="LoadCatalog">↻ Actualizar</button>
                </div>
            </div>

            <!-- BARRA DE FILTROS POR CATEGORÍA, CARTERA Y PROVEEDOR -->
            <div class="p-3 bg-light rounded-3 border mb-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold m-0" style="font-size:11px;">Categoría / Agrupador</label>
                        <select class="form-select form-select-sm" @bind="filterCategory">
                            <option value="TODAS">📁 TODAS LAS CATEGORÍAS</option>
                            @foreach (var cat in AvailableCategories)
                            {
                                <option value="@cat">📁 @cat</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold m-0" style="font-size:11px;">Cartera Comercial</label>
                        <select class="form-select form-select-sm" @bind="filterPortfolio">
                            <option value="TODAS">🌐 TODAS LAS CARTERAS</option>
                            @foreach (var port in AvailablePortfolios)
                            {
                                <option value="@port">🌐 @port</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold m-0" style="font-size:11px;">Proveedor Destino</label>
                        <select class="form-select form-select-sm" @bind="filterProvider">
                            <option value="TODOS">🏢 TODOS LOS PROVEEDORES</option>
                            @foreach (var prov in AvailableProviders)
                            {
                                <option value="@prov">🏢 @prov</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            @if (loadingCatalog)
            {
                <div class="spinner"></div>
            }
            else if (!FilteredCatalogItems.Any())
            {
                <div class="text-center text-muted py-4">No hay checkpoints que coincidan con los filtros seleccionados.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" style="font-size:.875rem;">
                        <thead class="table-light">
                            <tr class="small text-muted" style="user-select:none;">
                                <th @onclick='() => SetSort("ExecutionOrder")' style="cursor:pointer;white-space:nowrap;">@GetSortIcon("ExecutionOrder") # Ord</th>
                                <th @onclick='() => SetSort("Code")' style="cursor:pointer;white-space:nowrap;">@GetSortIcon("Code") Código & Categoría</th>
                                <th @onclick='() => SetSort("Name")' style="cursor:pointer;white-space:nowrap;">@GetSortIcon("Name") Nombre / División & Cargo</th>
                                <th>Satélites Involucrados</th>
                                <th @onclick='() => SetSort("Portfolio")' style="cursor:pointer;white-space:nowrap;">@GetSortIcon("Portfolio") Carteras & Campañas</th>
                                <th>Mecanismo & Retroceso</th>
                                <th @onclick='() => SetSort("Category")' style="cursor:pointer;white-space:nowrap;">@GetSortIcon("Category") Estado / Cat.</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in FilteredCatalogItems)
                            {
                                <tr>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center fw-bold px-1"
                                               style="width:52px; font-size:12px;"
                                               value="@c.ExecutionOrder"
                                               min="1" max="999"
                                               @onchange='async e => await SetCheckpointExecutionOrderDirect(c.IdCheckpoint, e.Value?.ToString())'
                                               title="Editar orden de ejecución" />
                                    </td>
                                    <td>
                                        <code class="text-primary fw-bold">@c.Code</code>
                                        <div class="small text-muted" style="font-size:10px;">📁 @(string.IsNullOrEmpty(c.Category) ? "GENERAL" : c.Category)</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@c.Name</div>
                                        <div class="small text-muted">🏢 @(string.IsNullOrEmpty(c.Division) ? "OPERACIONES" : c.Division) | 👤 @(string.IsNullOrEmpty(c.ApprovalJobTitle) ? "SUPERVISOR" : c.ApprovalJobTitle)</div>
                                    </td>
                                    <td>
                                        @if (c.Satellites != null && c.Satellites.Any())
                                        {
                                            @foreach (var sat in c.Satellites)
                                            {
                                                <span class="badge bg-light text-dark border rounded-pill px-2 me-1 mb-1" style="font-size:10px;">⚡ @sat</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill px-2" style="font-size:10px;">FLOW_ENGINE</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
                                            <span class="badge bg-dark text-white rounded-pill px-2" style="font-size:10px;" title="Cartera Comercial">💼 @(string.IsNullOrEmpty(c.Portfolio) ? "GENERAL" : c.Portfolio)</span>
                                            <span class="badge bg-info text-dark rounded-pill px-2" style="font-size:10px;" title="Campaña CRM">📣 @(string.IsNullOrEmpty(c.Campaign) ? "GENERAL" : c.Campaign)</span>
                                        </div>
                                        <div class="small text-muted" style="font-size:10px;">Prov: <strong>@(string.IsNullOrEmpty(c.Provider) ? "INTERNO" : c.Provider)</strong></div>
                                    </td>
                                    <td>
                                        @if (c.FinalizesCycle)
                                        {
                                            <span class="pill pill-red">⛔ FINALIZA CICLO</span>
                                        }
                                        else if (c.BlocksAdvance)
                                        {
                                            <span class="pill pill-amber">🔒 BLOQUEA AVANCE</span>
                                        }
                                        else
                                        {
                                            <span class="pill pill-outline">INFORMATIVO</span>
                                        }

                                        @if (!string.IsNullOrEmpty(c.RollbackToCheckpointCode))
                                        {
                                            <div class="small text-danger fw-semibold mt-1" style="font-size:10px;">
                                                ↩ Retrocede a: <code>@c.RollbackToCheckpointCode</code> @(c.RollbackToStepOrder.HasValue ? $"(Paso {c.RollbackToStepOrder})" : "")
                                            </div>
                                        }
                                        else if (c.RollbackToStage.HasValue && c.RollbackToStage > 0)
                                        {
                                            <div class="small text-danger fw-semibold mt-1" style="font-size:10px;">
                                                ↩ Retrocede a: Etapa #@c.RollbackToStage
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (c.ApprovalStatus == "ACTIVE" || c.ApprovalStatus == "APPROVED")
                                        {
                                            <span class="pill pill-green">✓ ACTIVO</span>
                                        }
                                        else
                                        {
                                            <span class="pill pill-red">⏳ PROPUESTO</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" style="font-size:11px;" @onclick="() => OpenEditCpModal(c)">
                                            ✏️ Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- ========== VISTA 1: GESTIÓN DE ETAPAS & ASIGNACIÓN DE CHECKPOINTS ========== -->
    @if (tab == "etapas")
    {
        <!-- SECCIÓN SUPERIOR: LISTA DE ETAPAS (ANCHO COMPLETO 100%) -->
        <div class="card-panel mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">🏗️ VISTA 1: Gestión de Etapas & Secuencia del Ciclo de Vida</h5>
                    <p class="text-muted small mb-0">Modifica el orden de ejecución directamente, visualiza sus campañas/carteras y haz clic en cualquier etapa para gestionar sus checkpoints.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenCreateStageModal">
                        ➕ Nueva Etapa
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="LoadStagesFromDb">↻ Actualizar</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(stageMoveMsg))
            {
                <div class="mb-2 small fw-semibold @(stageMoveIsError ? "text-danger" : "text-success")">@stageMoveMsg</div>
            }

            <!-- FORMULARIO NUEVA ETAPA -->
            @if (showCreateStageForm)
            {
                <div class="mb-3 p-3 bg-light rounded-3 border border-primary">
                    <h6 class="fw-bold text-primary mb-2" style="font-size:12px;">➕ Nueva Etapa en <code>nyx_flow.stage</code></h6>
                    @if (!string.IsNullOrEmpty(stageFeedback))
                    {
                        <div class="mb-2 small fw-bold @(stageFeedbackIsError ? "text-danger" : "text-success")">@stageFeedback</div>
                    }
                    <div class="row g-2">
                        <div class="col-12 col-sm-6">
                            <label class="form-label small m-0" style="font-size:11px;">Nombre de Etapa</label>
                            <input type="text" class="form-control form-control-sm" placeholder="ej: Validación Técnica" @bind="newStageName" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label small m-0" style="font-size:11px;">Código (UPPER_SNAKE)</label>
                            <input type="text" class="form-control form-control-sm fw-bold text-primary" placeholder="VAL_TECNICA" @bind="newStageCode" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small m-0" style="font-size:11px;">Descripción (opcional)</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Descripción breve..." @bind="newStageDescription" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small m-0" style="font-size:11px;">Orden #</label>
                            <input type="number" class="form-control form-control-sm text-center" min="1" @bind="newStageOrder" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small m-0" style="font-size:11px;">SLA (horas)</label>
                            <input type="number" class="form-control form-control-sm text-center" min="1" @bind="newStageSlaHours" />
                        </div>
                        <div class="col-4 d-flex align-items-end pb-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkTerminalNew" @bind="newStageIsTerminal" />
                                <label class="form-check-label small fw-bold" for="chkTerminalNew">Terminal</label>
                            </div>
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button class="btn btn-sm btn-primary fw-bold rounded-pill px-4" @onclick="CreateStageApi">✔ Guardar Etapa</button>
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick='() => showCreateStageForm = false'>Cancelar</button>
                        </div>
                    </div>
                </div>
            }

            @if (!dbStages.Any())
            {
                <div class="text-center text-muted py-5">
                    <div style="font-size:2rem;">🏗️</div>
                    <div>Cargando etapas desde <code>nyx_flow.stage</code>...</div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @for (int si = 0; si < dbStages.Count; si++)
                    {
                        var st = dbStages[si];
                        var cpCount = catalogItems.Count(c => c.TriggerStageId == st.IdStage);
                        var isSelected = selectedStage?.IdStage == st.IdStage;
                        var isFirst = si == 0;
                        var isLast = si == dbStages.Count - 1;
                        var capturedId = st.IdStage;
                        var capturedSt = st;
                        var stageCamps = string.IsNullOrEmpty(st.Campaign) ? "TODAS / GENERAL" : st.Campaign;
                        var stagePorts = string.IsNullOrEmpty(st.Portfolio) ? "TODAS / GENERAL" : st.Portfolio;

                        <div class="d-flex align-items-center gap-3 p-3 rounded-3 border @(isSelected ? "border-primary bg-primary bg-opacity-10 shadow-sm" : "bg-white")"
                             style="cursor:pointer; transition:all .15s;"
                             @onclick="() => OpenStageCheckpointsModal(capturedSt)">

                            <!-- Número de orden editable -->
                            <div @onclick:stopPropagation="true" style="min-width:60px;">
                                <label class="form-label text-muted small m-0 d-block text-center" style="font-size:9px;"># ORDEN</label>
                                <input type="number" class="form-control form-control-sm text-center fw-bold px-1"
                                       style="width:56px; font-size:14px;"
                                       value="@st.OrderIndex"
                                       min="1" max="999"
                                       @onchange='async e => await SetStageOrderDirect(capturedId, e.Value?.ToString())'
                                       title="Escribe el número de orden y presiona Enter para reordenar" />
                            </div>

                            <!-- Botones ▲▼ -->
                            <div class="d-flex flex-column gap-1" @onclick:stopPropagation="true">
                                <button class="btn btn-outline-secondary rounded px-1 py-0 lh-1"
                                        style="font-size:10px; line-height:1.2;"
                                        disabled="@isFirst"
                                        @onclick='() => MoveStage(capturedId, "up")'>▲</button>
                                <button class="btn btn-outline-secondary rounded px-1 py-0 lh-1"
                                        style="font-size:10px; line-height:1.2;"
                                        disabled="@isLast"
                                        @onclick='() => MoveStage(capturedId, "down")'>▼</button>
                            </div>

                            <!-- Datos de la etapa -->
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="fw-bold text-dark" style="font-size:15px;">@st.Name</span>
                                    <code class="text-primary fw-bold" style="font-size:11px;">@st.StageCode</code>
                                    @if (st.IsTerminal)
                                    {
                                        <span class="pill pill-red" style="font-size:9px;">⛔ ETAPA TERMINAL</span>
                                    }
                                    @if (st.SlaHours.HasValue)
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size:10px;">⏱ SLA: @(st.SlaHours)h</span>
                                    }
                                </div>
                                <!-- Badges de Campañas y Carteras asociadas -->
                                <div class="d-flex gap-3 align-items-center mt-1 flex-wrap" style="font-size:11px;">
                                    <span class="text-muted">💼 Carteras: <strong class="text-dark">@stagePorts</strong></span>
                                    <span class="text-muted">| 📣 Campañas: <strong class="text-dark">@stageCamps</strong></span>
                                </div>
                            </div>

                            <!-- Acciones y contador Checkpoints -->
                            <div class="d-flex align-items-center gap-2" @onclick:stopPropagation="true">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold"
                                        style="font-size:12px; white-space:nowrap;"
                                        @onclick="() => OpenStageCheckpointsModal(capturedSt)">
                                    🎯 Checkpoints (@cpCount)
                                </button>
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1"
                                        style="font-size:11px; white-space:nowrap;"
                                        @onclick="() => OpenEditStageModal(capturedSt)">
                                    ✏️ Editar Etapa
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }



    <!-- ========== TAB 2: FICHA DE VENTA CAPA 2 ========== -->
    @if (tab == "venta")
    {
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Ficha de Venta Capa 2 — Instancia Operativa en Vivo</h5>
                    <p class="text-muted small mb-0">Introduce el ID de instancia de flujo de <code>Nyx.FlowEngine</code> para inspeccionar su estado y checkpoints activos.</p>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-end mb-4">
                <div>
                    <label class="form-label small fw-semibold mb-1">ID de Instancia de Flujo</label>
                    <input type="number" class="form-control" style="width:180px;" @bind="flowInstanceId" placeholder="Ej: 1" />
                </div>
                <button class="btn btn-primary rounded-pill px-4" @onclick="LoadFlowInstance">Cargar Venta</button>
                <div>
                    <label class="form-label small fw-semibold mb-1">Simular acción como Usuario ID</label>
                    <input type="number" class="form-control" style="width:160px;" @bind="actorId" placeholder="Ej: 101" />
                </div>
            </div>

            @if (loadingFlow)
            {
                <div class="spinner"></div>
            }
            else if (flowInstance != null)
            {
                <!-- Estado actual de la instancia -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <span class="text-muted small">Entidad:</span> <strong>@flowInstance.EntityType.ToUpper() #@flowInstance.EntityId</strong>
                        <span class="ms-3 text-muted small">Instancia:</span> <strong>#@flowInstance.IdInstance</strong>
                    </div>
                    <span class="pill pill-navy px-3 py-2 fs-6">@GetStageName(flowInstance.CurrentStageId)</span>
                </div>

                <!-- Pipeline visual dinámico cargado 100% desde BD nyx_flow.stage -->
                <div class="stage-strip mb-4">
                    @foreach (var st in dbStages)
                    {
                        <div class="stage-dot-wrap">
                            <div class="stage-line"></div>
                            <div class="stage-dot @(st.IdStage < flowInstance.CurrentStageId ? "done" : "") @(st.IdStage == flowInstance.CurrentStageId ? "current" : "")"></div>
                            <div class="stage-label @(st.IdStage == flowInstance.CurrentStageId ? "current" : "")">@st.Name</div>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-dark btn-sm rounded-pill px-3" @onclick="AdvanceStage">
                        → Avanzar Etapa (valida Nyx.FlowEngine)
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(flowError))
                {
                    <div class="alert-blocker mt-3">
                        🛑 <strong>Bloqueado por Nyx.FlowEngine:</strong> @flowError
                    </div>
                }
                @if (!string.IsNullOrEmpty(flowSuccess))
                {
                    <div class="alert-ok mt-3">✓ @flowSuccess</div>
                }

                <!-- Checkpoints activos de la instancia -->
                @if (instanceCheckpoints.Any())
                {
                    <h6 class="fw-bold mt-4 mb-2">Checkpoints Activos (Capa 2 — Instancia)</h6>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:.875rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Estado</th>
                                    <th>Bloquea Avance</th>
                                    <th>Acción de Subsanación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cp in instanceCheckpoints)
                                {
                                    <tr>
                                        <td><code>#@cp.IdCpInstance</code></td>
                                        <td><span class="pill @(cp.Status == "SUBSANADO" || cp.Status == "APPROVED" ? "pill-green" : (cp.Status == "KO" ? "pill-red" : "pill-amber"))">@cp.Status</span></td>
                                        <td><span class="pill pill-amber">🔒 Ver catálogo</span></td>
                                        <td>
                                            @if (cp.Status == "PENDING")
                                            {
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-success rounded-pill px-2 py-0" style="font-size:11px;" @onclick='() => ResolveCheckpoint(cp.IdCpInstance, "SUBSANADO")'>Marcar Subsanado</button>
                                                    <button class="btn btn-sm btn-danger rounded-pill px-2 py-0" style="font-size:11px;" @onclick='() => ResolveCheckpoint(cp.IdCpInstance, "KO")'>Marcar KO</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Resuelto</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted small mt-3">Sin checkpoints activos para esta instancia — la venta puede avanzar libremente.</div>
                }
            }
            else if (flowInstanceId > 0 && !loadingFlow)
            {
                <div class="text-muted text-center py-4">Instancia #@flowInstanceId no encontrada en Nyx.FlowEngine.</div>
            }
        </div>
    }

    <!-- ========== TAB 3: BANDEJA DE APROBACIONES ========== -->
    @if (tab == "aprobaciones")
    {
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">🛡️ Bandeja de Aprobaciones — Datos en Vivo</h5>
                    <p class="text-muted small mb-0">Solicitudes pendientes desde <code>Nyx.ApprovalEngine → nyx_approval</code>. ISO 27001 SOX enforced.</p>
                </div>
                <div class="d-flex gap-2 align-items-end flex-wrap">
                    <div>
                        <label class="form-label small fw-semibold mb-1">ID Aprobador</label>
                        <input type="number" class="form-control form-control-sm" style="width:110px;" @bind="approverIdFilter" />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold mb-1">Rol</label>
                        <select class="form-select form-select-sm" style="width:160px;" @bind="approverRoleFilter">
                            <option value="SUPERVISOR">SUPERVISOR</option>
                            <option value="BACKOFFICE">BACKOFFICE</option>
                            <option value="ADMIN_CRM">ADMIN_CRM</option>
                            <option value="COORDINADOR">COORDINADOR</option>
                        </select>
                    </div>
                    <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="LoadApprovals">Cargar Bandeja</button>
                </div>
            </div>

            @if (loadingApprovals)
            {
                <div class="spinner"></div>
            }
            else if (!approvalRequests.Any())
            {
                <div class="text-center text-muted py-4">Sin solicitudes pendientes para el aprobador ID @approverIdFilter con rol @approverRoleFilter.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" style="font-size:.875rem;">
                        <thead class="table-light">
                            <tr>
                                <th># Req</th>
                                <th>Política</th>
                                <th>Entidad</th>
                                <th>Solicitante</th>
                                <th>Paso Actual</th>
                                <th>Estado</th>
                                <th>Creada</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in approvalRequests)
                            {
                                <tr>
                                    <td class="fw-bold">#@req.IdRequest</td>
                                    <td><span class="pill pill-violet">@req.PolicyCode</span></td>
                                    <td><code class="text-muted">@req.EntityType.ToUpper() #@req.EntityId</code></td>
                                    <td><span class="pill pill-outline">User #@req.RequestedBy</span></td>
                                    <td class="fw-semibold">Paso @req.CurrentStep</td>
                                    <td><span class="pill @(req.Status == "APPROVED" ? "pill-green" : (req.Status == "REJECTED" ? "pill-red" : "pill-amber"))">@req.Status</span></td>
                                    <td class="text-muted small">@req.CreatedAt.ToString("dd/MM/yy HH:mm")</td>
                                    <td>
                                        @if (req.Status == "PENDING" || req.Status == "IN_PROGRESS")
                                        {
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-success rounded-pill px-2 py-0" style="font-size:11px;"
                                                        @onclick='() => DecideApproval(req.IdRequest, "APPROVED")'>
                                                    ✓ Aprobar
                                                </button>
                                                <button class="btn btn-sm btn-danger rounded-pill px-2 py-0" style="font-size:11px;"
                                                        @onclick='() => DecideApproval(req.IdRequest, "REJECTED")'>
                                                    ✗ Rechazar
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Decidido</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (!string.IsNullOrEmpty(approvalMsg))
            {
                <div class="mt-3 @(approvalMsgIsError ? "alert-blocker" : "alert-ok")">
                    @approvalMsg
                </div>
            }
        </div>
    }

    <!-- ========== TAB 3: AUDITORÍA & AUDIO (CAPA 3) ========== -->
    @if (tab == "audio")
    {
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold m-0 text-dark">🎧 Capa 3: Auditoría & Aseguramiento de Calidad de Audio</h5>
                    <p class="text-muted small m-0">Validación previa de grabaciones de audio y declaraciones legales antes del envío a backend.</p>
                </div>
                <span class="pill pill-navy">CAPA 3 ACTIVA</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>ID CHECKPOINT</th>
                            <th>REGLA DE CALIDAD</th>
                            <th>ENTIDAD CRM</th>
                            <th>REGLA DE BLOQUEO</th>
                            <th>ESTADO DE FIRMA</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>CP_AUDIO_AUDIT</code></td>
                            <td>Auditoría de Audio de Llamada Venta</td>
                            <td>AUDIO_RECORDING</td>
                            <td><span class="pill pill-green">NO BLOQUEANTE</span></td>
                            <td><span class="pill pill-green">ACTIVE</span></td>
                        </tr>
                        <tr>
                            <td><code>CP_AUDIO_CONSENT</code></td>
                            <td>Verificación de Consentimiento Expreso</td>
                            <td>AUDIO_RECORDING</td>
                            <td><span class="pill pill-red">BLOQUEA ACTIVACIÓN</span></td>
                            <td><span class="pill pill-green">ACTIVE</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ========== TAB 4: CORTES PROVEEDOR (CAPA 4) ========== -->
    @if (tab == "cortes")
    {
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold m-0 text-dark">💰 Capa 4: Cortes Contables & Habilitación Comercial</h5>
                    <p class="text-muted small m-0">Supervisión de lotes de facturación, comisiones y reglas de habilitación de proveedores externos.</p>
                </div>
                <span class="pill pill-navy">CAPA 4 ACTIVA</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>ID CHECKPOINT</th>
                            <th>ÁMBITO COMERCIAL</th>
                            <th>ENTIDAD CRM</th>
                            <th>TIPO DE REGULACIÓN</th>
                            <th>ESTADO</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>CP_PROV_CUTOFF</code></td>
                            <td>Corte Diario de Proveedor HFC/FTTH</td>
                            <td>ACTIVATION_BATCH</td>
                            <td><span class="pill pill-red">BLOQUEANTE OPERATIVO</span></td>
                            <td><span class="pill pill-green">ACTIVE</span></td>
                        </tr>
                        <tr>
                            <td><code>CP_COMMISSION_SETTLE</code></td>
                            <td>Liquidación de Bonos Comisionables</td>
                            <td>COMMISSION_BATCH</td>
                            <td><span class="pill pill-amber">REQUIERE SUPERVISIÓN</span></td>
                            <td><span class="pill pill-green">ACTIVE</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ========== TAB 5: GESTOR DINÁMICO N-CAPAS (+NUEVA CAPA) ========== -->
    @if (tab == "gestor_capas")
    {
        <div class="card-panel mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold m-0 text-dark">⚙️ Gestor Dinámico de Capas del Motor Nyx</h5>
                    <p class="text-muted small m-0">Arquitectura N-Capas escalable: Agrega y configura nuevas capas de gobierno dinámicamente.</p>
                </div>
                <span class="badge bg-dark text-white rounded-pill px-3 py-2">N-TIER SCALABLE</span>
            </div>

            <!-- Formulario para Agregar Nueva Capa -->
            <div class="bg-light p-3 rounded-4 border mb-4">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Registrar Nueva Capa en el Motor</h6>
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold">Nombre de la Capa</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ej: Capa 5: Postventa & Garantías" @bind="newLayerName" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-bold">Ámbito de Aplicación</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ej: POSTSALES_SERVICE" @bind="newLayerScope" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-bold">Entidad Target CRM</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ej: CLAIM_TICKET" @bind="newLayerEntity" />
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <button class="btn btn-sm btn-dark w-100 fw-bold rounded-pill" @onclick="AddCustomLayer">
                            + Crear Capa
                        </button>
                    </div>
                </div>
            </div>

            <!-- Lista de Capas Registradas -->
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>ID CAPA</th>
                            <th>NOMBRE DE CAPA</th>
                            <th>ÁMBITO</th>
                            <th>ENTIDAD CRM DESTINO</th>
                            <th>REGLAS ACTIVAS</th>
                            <th>TIPO</th>
                            <th class="text-end">ACCIONES DE GESTIÓN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var layer in customLayers)
                        {
                            <tr class="@(selectedLayerId == layer.IdLayer ? "table-active" : "")">
                                <td><code>CAPA_@layer.IdLayer</code></td>
                                <td class="fw-bold text-dark">@layer.Name</td>
                                <td><span class="pill pill-violet">@layer.Scope</span></td>
                                <td><code>@layer.TargetEntity</code></td>
                                <td><span class="badge bg-secondary rounded-pill px-2">@layer.RuleCount Reglas</span></td>
                                <td>
                                    @if (layer.IsSystem)
                                    {
                                        <span class="pill pill-navy">SISTEMA BASE</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-green">DINÁMICA N-CAPA</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm @(selectedLayerId == layer.IdLayer ? "btn-dark" : "btn-outline-dark") rounded-pill px-3 py-1" style="font-size:11px;" @onclick="() => SelectLayer(layer.IdLayer)">
                                            <i class="bi bi-sliders me-1"></i> @(selectedLayerId == layer.IdLayer ? "Seleccionada" : "Administrar Flujos")
                                        </button>
                                        @if (!layer.IsSystem)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" style="font-size:11px;" @onclick="() => DeleteCustomLayer(layer.IdLayer)" title="Eliminar Capa Dinámica">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light text-muted border rounded-pill px-2 py-1" style="font-size:11px;" disabled title="Las capas base de sistema están protegidas contra eliminación accidental.">
                                                <i class="bi bi-lock-fill"></i> Protegida
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PANEL EDITOR DE CHECKPOINTS Y TASKS DE LA CAPA SELECCIONADA -->
            @{
                var selLayer = customLayers.FirstOrDefault(c => c.IdLayer == selectedLayerId) ?? customLayers.First();
            }
            <div class="bg-white border rounded-4 p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold text-dark m-0"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Gestor de Checkpoints & Tasks de: <strong>@selLayer.Name</strong></h6>
                        <p class="text-muted small m-0">Registra y conecta reglas de negocio a la entidad <code>@selLayer.TargetEntity</code> consumiendo <code>POST /api/engines/flow/catalogs</code>.</p>
                    </div>
                    <span class="pill pill-navy">CAPA SELECCIONADA #@selLayer.IdLayer</span>
                </div>

                <!-- Formulario Avanzado de Configuración por API -->
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <h6 class="fw-bold text-dark mb-3" style="font-size:13px;"><i class="bi bi-gear-fill me-1 text-primary"></i> + Configurar y Registrar Nuevo Checkpoint en la Capa (Vía API)</h6>

                    <!-- Fila 1: Nombre, Código (Autogenerado), Orden de Ejecución, Categoría -->
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Nombre del Checkpoint</label>
                            <input type="text" class="form-control form-control-sm" placeholder="ej: Verificación de Ficha Técnica" value="@newCpName" @oninput='e => GenerateCodeFromName(e.Value?.ToString() ?? "")' />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Código (Autogenerado)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control fw-bold text-primary" placeholder="CP_CÓDIGO" @bind="newCpCode" @bind:after='() => isManualCode = true' />
                                <button class="btn btn-outline-secondary" type="button" title="Regenerar desde nombre" @onclick='() => { isManualCode = false; GenerateCodeFromName(newCpName); }'>
                                    <i class="bi bi-magic"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Orden Ejecución</label>
                            <input type="number" class="form-control form-control-sm text-center fw-bold" min="1" max="100" @bind="newCpExecutionOrder" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Categoría / Agrupador</label>
                            <select class="form-select form-select-sm" @bind="newCpCategory">
                                @foreach (var cat in AvailableCategories)
                                {
                                    <option value="@cat">📁 @cat</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Fila 2: División / Área, Cargo para Aprobación, Origen, Proveedor Destino -->
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">División / Área</label>
                            <select class="form-select form-select-sm" @bind="newCpDivision">
                                @foreach (var div in AvailableDivisions)
                                {
                                    <option value="@div">🏢 @div</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Cargo de Aprobación</label>
                            <select class="form-select form-select-sm" @bind="newCpApprovalJobTitle">
                                <option value="SUPERVISOR">👤 SUPERVISOR</option>
                                <option value="JEFE_OPERACIONES">👤 JEFE DE OPERACIONES</option>
                                <option value="BACKOFFICE">👤 BACKOFFICE ANALYST</option>
                                <option value="COORDINADOR">👤 COORDINADOR GENERAL</option>
                                <option value="GERENTE_DIVISION">👤 GERENTE DE DIVISIÓN</option>
                                <option value="GERENCIA_GENERAL">👤 GERENCIA GENERAL</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Proveedor Destino</label>
                            <select class="form-select form-select-sm" @bind="newCpProvider">
                                @foreach (var prov in AvailableProviders)
                                {
                                    <option value="@prov">🏢 @prov</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Origen del Evento</label>
                            <select class="form-select form-select-sm" @bind="newCpOrigin">
                                <option value="INTERNAL">INTERNAL (CRM GSI)</option>
                                <option value="EXTERNAL">EXTERNAL (Proveedor)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Fila 3: Seleccionadores Múltiples (Satélites, Carteras, Campañas) -->
                    <div class="row g-2 mb-2 p-2 bg-white rounded-3 border">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold m-0 text-dark mb-1" style="font-size:11px;">Satélites Involucrados</label>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var sat in new[] { "FLOW_ENGINE", "API_HUB", "APPROVAL_ENGINE", "SLA_ENGINE", "DIALER", "AGENDO", "WIKITY" })
                                {
                                    <span class="badge @(selectedSatellites.Contains(sat) ? "bg-dark text-white" : "bg-light text-muted border") rounded-pill cursor-pointer px-2" style="font-size:10px; cursor:pointer;" @onclick="() => ToggleSatellite(sat)">
                                        @(selectedSatellites.Contains(sat) ? "✓ " : "+ ")@sat
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold m-0 text-dark mb-1" style="font-size:11px;">Carteras Afectadas (Múltiple)</label>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var port in AvailablePortfolios)
                                {
                                    <span class="badge @(selectedPortfolios.Contains(port) ? "bg-primary text-white" : "bg-light text-muted border") rounded-pill cursor-pointer px-2" style="font-size:10px; cursor:pointer;" @onclick="() => TogglePortfolio(port)">
                                        @(selectedPortfolios.Contains(port) ? "✓ " : "+ ")@port
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold m-0 text-dark mb-1" style="font-size:11px;">Campañas CRM (Múltiple)</label>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var camp in AvailableCampaigns)
                                {
                                    <span class="badge @(selectedCampaigns.Contains(camp) ? "bg-info text-dark" : "bg-light text-muted border") rounded-pill cursor-pointer px-2" style="font-size:10px; cursor:pointer;" @onclick="() => ToggleCampaign(camp)">
                                        @(selectedCampaigns.Contains(camp) ? "✓ " : "+ ")@camp
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Fila 4: Retroceso Específico (Checkpoint y Paso) + Condición Previa Hecho de Venta + Switches -->
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">↩ Retrocede Especificamente a Checkpoint (Si está mal)</label>
                            <select class="form-select form-select-sm" @bind="newCpRollbackCode">
                                <option value="">(Sin retroceso a Checkpoint específico)</option>
                                @foreach (var item in catalogItems)
                                {
                                    <option value="@item.Code">@item.Code — @item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">Paso Específico</label>
                            <input type="number" class="form-control form-control-sm text-center" min="1" max="10" @bind="newCpRollbackStep" disabled="@(string.IsNullOrEmpty(newCpRollbackCode))" />
                        </div>
                        <div class="col-8 col-md-3">
                            <label class="form-label small fw-semibold m-0" style="font-size:11px;">❓ Condición Previa (Hecho Venta)</label>
                            <input type="text" class="form-control form-control-sm" placeholder="ej: huboCorreccionDatos" @bind="newCpPreconditionFact" />
                        </div>
                        <div class="col-12 col-md-3 d-flex align-items-end gap-3 justify-content-end">
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" id="checkBlock" @bind="newCpBlocks" />
                                <label class="form-check-input-label small fw-bold" for="checkBlock">Bloqueante</label>
                            </div>
                            <div class="form-check form-switch small">
