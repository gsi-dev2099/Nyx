    private async Task CreateCheckpointApi()
    {
        if (string.IsNullOrWhiteSpace(newCpCode) || string.IsNullOrWhiteSpace(newCpName))
        {
            cpCreateIsError = true;
            cpCreateFeedback = "El código y el nombre del checkpoint son requeridos.";
            return;
        }

        try
        {
            await EnsureAuthHeader();
            var payload = new
            {
                code = newCpCode.Trim().ToUpper(),
                name = newCpName.Trim(),
                origin = newCpOrigin,
                scope = newCpScope,
                triggerStageId = newCpTriggerStageId > 0 ? (long?)newCpTriggerStageId : null,
                blocksAdvance = newCpBlocks,
                category = newCpCategory,
                division = newCpDivision,
                approvalJobTitle = newCpApprovalJobTitle,
                satellites = selectedSatellites.ToArray(),
                executionOrder = newCpExecutionOrder,
                rollbackToCheckpointCode = string.IsNullOrWhiteSpace(newCpRollbackCode) ? null : newCpRollbackCode,
                rollbackToStepOrder = string.IsNullOrWhiteSpace(newCpRollbackCode) ? null : (int?)newCpRollbackStep,
                preconditionFact = string.IsNullOrWhiteSpace(newCpPreconditionFact) ? null : newCpPreconditionFact.Trim(),
                portfolio = string.Join(",", selectedPortfolios),
                campaign = string.Join(",", selectedCampaigns),
                provider = newCpProvider,
                targetRoles = newCpTargetRoles.Trim(),
                finalizesCycle = newCpFinalizesCycle,
                approvalStatus = "ACTIVE"
            };

            var response = await Http.PostAsJsonAsync($"{GetApiBase()}/api/engines/flow/catalogs", payload);
            if (response.IsSuccessStatusCode)
            {
                var createdCp = await response.Content.ReadFromJsonAsync<CatalogItemVm>();
                if (createdCp != null && createdCp.IdCheckpoint > 0)
                {
                    if (newCpTriggerStageId > 0)
                    {
                        await Http.PatchAsJsonAsync($"{GetApiBase()}/api/engines/flow/catalogs/{createdCp.IdCheckpoint}/stage", new { stageId = (long?)newCpTriggerStageId });
                    }
                    await SaveCheckpointStepsApi(createdCp.IdCheckpoint, newCpSteps);
                }

                cpCreateIsError = false;
                cpCreateFeedback = $"✓ Checkpoint '{newCpCode}' creado exitosamente en la API.";
                newCpCode = ""; newCpName = ""; newCpSteps.Clear(); newCpTriggerStageId = 0;
                await LoadCatalog();
            }
            else
            {
                var errContent = await response.Content.ReadAsStringAsync();
                cpCreateIsError = true;
                cpCreateFeedback = $"🛑 Error {(int)response.StatusCode}: {(string.IsNullOrWhiteSpace(errContent) ? "No se pudo registrar el checkpoint mediante la API." : errContent)}";
            }
        }
        catch (Exception ex)
        {
            cpCreateIsError = true;
            cpCreateFeedback = $"Error consumiendo API: {ex.Message}";
        }
    }

    private void AddCustomLayer()
    {
        if (string.IsNullOrWhiteSpace(newLayerName)) return;
        var nextId = customLayers.Any() ? customLayers.Max(c => c.IdLayer) + 1 : 1;
        customLayers.Add(new DynamicLayerVm {
            IdLayer = nextId,
            Name = newLayerName.Trim(),
            Scope = string.IsNullOrWhiteSpace(newLayerScope) ? "CUSTOM_TIER" : newLayerScope.Trim().ToUpper(),
            TargetEntity = string.IsNullOrWhiteSpace(newLayerEntity) ? "CRM_ENTITY" : newLayerEntity.Trim().ToUpper(),
            RuleCount = 1,
            IsSystem = false
        });
        newLayerName = ""; newLayerScope = ""; newLayerEntity = "";
    }

