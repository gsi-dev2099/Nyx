    private IEnumerable<CatalogItemVm> FilteredCatalogItems
    {
        get
        {
            var q = catalogItems
                .Where(c => filterCategory == "TODAS" || c.Category == filterCategory)
                .Where(c => filterPortfolio == "TODAS" || c.Portfolio.Contains(filterPortfolio))
                .Where(c => filterProvider == "TODOS" || c.Provider == filterProvider);

            return (sortColumn, sortAscending) switch
            {
                ("ExecutionOrder", true)  => q.OrderBy(c => c.ExecutionOrder).ThenBy(c => c.IdCheckpoint),
                ("ExecutionOrder", false) => q.OrderByDescending(c => c.ExecutionOrder).ThenByDescending(c => c.IdCheckpoint),
                ("Code",           true)  => q.OrderBy(c => c.Code),
                ("Code",           false) => q.OrderByDescending(c => c.Code),
                ("Name",           true)  => q.OrderBy(c => c.Name),
                ("Name",           false) => q.OrderByDescending(c => c.Name),
                ("Portfolio",      true)  => q.OrderBy(c => c.Portfolio),
                ("Portfolio",      false) => q.OrderByDescending(c => c.Portfolio),
                ("Category",       true)  => q.OrderBy(c => c.Category),
                ("Category",       false) => q.OrderByDescending(c => c.Category),
                _                         => q.OrderBy(c => c.ExecutionOrder).ThenBy(c => c.IdCheckpoint)
            };
        }
    }

