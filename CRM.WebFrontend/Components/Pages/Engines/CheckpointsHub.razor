    private async Task<List<CheckpointStepItemVm>> LoadCheckpointSteps(long checkpointId)
    {
        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            var steps = await Http.GetFromJsonAsync<List<CheckpointStepItemVm>>($"{apiBase}/api/engines/flow/catalogs/{checkpointId}/steps");
            if (steps != null)
            {
                foreach (var s in steps)
                {
                    if (string.IsNullOrWhiteSpace(s.Instruction)) s.Instruction = s.Name;
                }
            }
            return steps ?? new List<CheckpointStepItemVm>();
        }
        catch
        {
            return new List<CheckpointStepItemVm>();
        }
    }

    private async Task SaveCheckpointStepsApi(long checkpointId, List<CheckpointStepItemVm> steps)
    {
        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            short order = 1;
            foreach (var s in steps)
            {
                s.IdCheckpoint = checkpointId;
                s.StepOrder = order++;
                if (string.IsNullOrWhiteSpace(s.Name)) s.Name = s.Instruction;
                if (string.IsNullOrWhiteSpace(s.Instruction)) s.Instruction = s.Name;
            }
            await Http.PostAsJsonAsync($"{apiBase}/api/engines/flow/catalogs/{checkpointId}/steps", steps);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving checkpoint steps: {ex.Message}");
        }
    }

