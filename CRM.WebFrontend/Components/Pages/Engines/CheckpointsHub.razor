    private void GenerateCodeFromName(string nameValue)
    {
        newCpName = nameValue;
        if (!isManualCode && !string.IsNullOrWhiteSpace(nameValue))
        {
            var cleanName = System.Text.RegularExpressions.Regex.Replace(nameValue.ToUpper().Trim(), @"[^A-Z0-9]+", "_").Trim('_');
            newCpCode = $"CP_{cleanName}";
        }
    }

