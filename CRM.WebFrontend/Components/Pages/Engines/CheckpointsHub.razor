    private async Task SetCheckpointExecutionOrderDirect(long checkpointId, string? rawValue)
    {
        if (!int.TryParse(rawValue, out var newOrder) || newOrder < 1) return;
        var cp = catalogItems.FirstOrDefault(c => c.IdCheckpoint == checkpointId);
        if (cp == null) return;
        try
        {
            await EnsureAuthHeader();
            var apiBase = GetApiBase();
            var payload = new
            {
                name = cp.Name,
                description = cp.Description,
                origin = cp.Origin,
                scope = cp.Scope ?? "ENTITY",
                blocksAdvance = cp.BlocksAdvance,
                executionOrder = newOrder,
                category = cp.Category,
                division = cp.Division,
                approvalJobTitle = string.IsNullOrWhiteSpace(cp.ApprovalJobTitle) ? null : cp.ApprovalJobTitle,
                satellites = cp.Satellites ?? Array.Empty<string>(),
                rollbackToCheckpointCode = cp.RollbackToCheckpointCode,
                rollbackToStepOrder = cp.RollbackToStepOrder,
                preconditionFact = cp.PreconditionFact,
                portfolio = cp.Portfolio,
                campaign = cp.Campaign,
                provider = string.IsNullOrWhiteSpace(cp.Provider) ? null : cp.Provider,
                finalizesCycle = cp.FinalizesCycle,
                targetRoles = "SUPERVISOR,BACKOFFICE"
            };
            var response = await Http.PutAsJsonAsync($"{apiBase}/api/engines/flow/catalogs/{checkpointId}", payload);
            if (response.IsSuccessStatusCode)
            {
                await LoadCatalog();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating CP execution order: {ex.Message}");
        }
    }

    private async Task MoveAssignedCheckpoint(long checkpointId, string direction, List<CatalogItemVm> assignedList)
    {
        var idx = assignedList.FindIndex(c => c.IdCheckpoint == checkpointId);
        if (idx < 0) return;
        int targetIdx = direction == "up" ? idx - 1 : idx + 1;
        if (targetIdx < 0 || targetIdx >= assignedList.Count) return;

        var currentCp = assignedList[idx];
        var targetCp = assignedList[targetIdx];

        int newOrderForCurrent = targetCp.ExecutionOrder;
        int newOrderForTarget = currentCp.ExecutionOrder;

        if (newOrderForCurrent == newOrderForTarget)
        {
            newOrderForCurrent = direction == "up" ? Math.Max(1, targetCp.ExecutionOrder - 1) : targetCp.ExecutionOrder + 1;
        }

        await SetCheckpointExecutionOrderDirect(currentCp.IdCheckpoint, newOrderForCurrent.ToString());
        await SetCheckpointExecutionOrderDirect(targetCp.IdCheckpoint, newOrderForTarget.ToString());
    }

