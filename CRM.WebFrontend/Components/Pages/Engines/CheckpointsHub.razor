    private MarkupString GetSortIcon(string column)
    {
        if (sortColumn != column) return new MarkupString("<span style='opacity:.35;font-size:10px;'>⇅</span>");
        return sortAscending
            ? new MarkupString("<span style='color:#0F172A;font-size:11px;'>▲</span>")
            : new MarkupString("<span style='color:#0F172A;font-size:11px;'>▼</span>");
