    private List<DynamicLayerVm> customLayers = new();

    private void PopulateLayersFromCatalog()
    {
        var layers = new List<DynamicLayerVm>
        {
            new() { IdLayer = 1, Name = "Capa 1: Catálogo Institucional", Scope = "GLOBAL", TargetEntity = "ORDER_POLICY", RuleCount = catalogItems.Count(c => c.Scope == "GLOBAL" || c.Scope == "ENTITY"), IsSystem = true },
            new() { IdLayer = 2, Name = "Capa 2: Instancia Ficha Venta", Scope = "SALES_ORDER", TargetEntity = "ORDER", RuleCount = catalogItems.Count(c => c.Scope == "ORDER" || c.Scope == "SALES_ORDER"), IsSystem = true }
        };

        var customScopes = catalogItems
            .Select(c => c.Scope)
            .Where(s => s != "GLOBAL" && s != "ENTITY" && s != "ORDER" && s != "SALES_ORDER" && !string.IsNullOrEmpty(s))
            .Distinct();

        int layerIdx = 3;
        foreach (var scope in customScopes)
        {
            layers.Add(new DynamicLayerVm
            {
                IdLayer = layerIdx++,
                Name = $"Capa {layerIdx - 1}: {scope}",
                Scope = scope,
                TargetEntity = scope,
                RuleCount = catalogItems.Count(c => c.Scope == scope),
                IsSystem = false
            });
        }

        customLayers = layers;
    }

