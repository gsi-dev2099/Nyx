@code {
    [Parameter]
    public long Id { get; set; }

    // Etapas cargadas 100% desde nyx_flow.stage vía /api/engines/flow/stages
    private List<StageVmDetail> _stageObjects = new();
    private List<string> _stages = new();

    private string GetCampaignNameById(long idCmpg)
    {
        return idCmpg switch
        {
            1 => "TELECOM PRODUCCION",
            2 => "PORTABILIDAD MÓVIL",
            3 => "ALARMAS Y SEGURIDAD",
            4 => "MULTICARTERA PRODUCCION",
            _ => "GENERAL"
        };
    }

    private static long ResolveFlowId(long idCmpg)
    {
        if (idCmpg is >= 1 and <= 5) return 2; // Telecom (Vodafone, Lowi, Yoigo, MasMovil, Orange)
        return 1;
    }

    private List<string> GetStagesForCurrentOrder()
    {
        if (_order == null || !_stageObjects.Any()) return _stages.Any() ? _stages : new List<string> { "Preventa", "Venta Creada", "Gestión Inicial", "Validación Interna", "Envío Proveedor", "Validación Externa", "Firma", "Tramitación", "Activación", "Postventa", "Cerrada" };

        var flowId = ResolveFlowId(_order.IdCmpg);
        var filtered = _stageObjects
            .Where(s => s.IdFlow == flowId)
            .OrderBy(s => s.OrderIndex)
            .Select(s => s.Name)
            .ToList();

        if (!filtered.Any())
        {
            filtered = _stageObjects.Where(s => s.IdFlow == 1).OrderBy(s => s.OrderIndex).Select(s => s.Name).ToList();
        }

        return filtered.Any() ? filtered : _stages;
    }

    private int _currentFlowStageIndex = -1;

    private int GetCurrentStageIndex()
    {
        if (_currentFlowStageIndex >= 0) return _currentFlowStageIndex;
        if (_order == null) return 0;
        var orderStages = GetStagesForCurrentOrder();
        if (!orderStages.Any()) return 0;

        var flowId = ResolveFlowId(_order.IdCmpg);

        if (!string.IsNullOrEmpty(_order.Status))
        {
            var matchObj = _stageObjects.FirstOrDefault(s =>
                s.IdFlow == flowId && (
                s.StageCode.Equals(_order.Status, StringComparison.OrdinalIgnoreCase) ||
                s.Name.Equals(_order.Status, StringComparison.OrdinalIgnoreCase)));
            if (matchObj != null)
            {
                var idx = orderStages.IndexOf(matchObj.Name);
                if (idx >= 0) return idx;
            }
        }

        if (_order.IdStatus == 1) return 0;
        if (_order.IdStatus == 2) return Math.Min(1, orderStages.Count - 1);
        if (_order.IdStatus == 3) return Math.Min(2, orderStages.Count - 1);
        if (_order.IdStatus >= 4) return orderStages.Count - 1;

        return 0;
    }

    private SalesOrderViewModel? _order;
    private FormTemplateViewModel? _template;
    private List<FormFieldViewModel> _fields = new();
    private List<OrderDataViewModel> _savedData = new();
    private List<TimelineItemViewModel> _timeline = new();
    private List<OrderDocumentViewModel> _documents = new();
    
    private AlternateProfileViewModel _alternateProfile = new();
    private bool _showAlternate = false;

    private Dictionary<long, string> _fieldValues = new();
    private Dictionary<long, string> _validationErrors = new();
    private string _timelineFilter = "ALL";

    private bool _showFormDetailsModal = false;
    private bool _showTimelineModal = false;

    private void OpenTimelineModal()
    {
        _showTimelineModal = true;
    }

    private void CloseTimelineModal()
    {
        _showTimelineModal = false;
    }
    private TimelineItemViewModel? _selectedEventForModal = null;
    private List<KeyValuePair<string, string>> _selectedEventFields = new();

    private IEnumerable<TimelineItemViewModel> FilteredTimeline => _timelineFilter switch
    {
        "STATUS" => _timeline.Where(e => e.EventType == "STATUS_CHANGE" || e.EventType == "CUSTODY_TRANSFER"),
        "DOCS" => _timeline.Where(e => e.EventType == "DOCUMENT_UPLOADED" || e.EventType == "DOCUMENT_VERIFIED"),
        "FORM" => _timeline.Where(e => e.EventType == "FORM_DATA_UPDATED"),
        _ => _timeline
    };

    private void SetTimelineFilter(string filter)
    {
        _timelineFilter = filter;
    }

    private void OpenFormDetailsModal(TimelineItemViewModel evt)
    {
        _selectedEventForModal = evt;
        _selectedEventFields.Clear();

        if (!string.IsNullOrEmpty(evt.DetailsJson))
        {
            try
            {
                using var doc = JsonDocument.Parse(evt.DetailsJson);
                if (doc.RootElement.TryGetProperty("summary", out var summaryProp))
                {
                    var summaryStr = summaryProp.GetString();
                    if (!string.IsNullOrEmpty(summaryStr))
                    {
                        var pairs = summaryStr.Split(" | ", StringSplitOptions.RemoveEmptyEntries);
                        foreach (var p in pairs)
                        {
                            var parts = p.Split(":", 2);
                            if (parts.Length == 2)
                            {
                                _selectedEventFields.Add(new KeyValuePair<string, string>(parts[0].Trim(), parts[1].Trim()));
                            }
                            else
                            {
                                _selectedEventFields.Add(new KeyValuePair<string, string>("Dato", p.Trim()));
                            }
                        }
                    }
                }
            }
            catch {}
        }

        // Fallback: si no hay summary en el evento específico, usar los datos guardados en la orden
        if (!_selectedEventFields.Any() && _savedData.Any())
        {
            foreach (var d in _savedData)
            {
                var field = _fields.FirstOrDefault(f => f.IdFld == d.IdFld);
                string label = field != null ? field.Label : $"Campo #{d.IdFld}";
                string val = !string.IsNullOrEmpty(d.ValueText) ? d.ValueText : (!string.IsNullOrEmpty(d.ValueJson) ? d.ValueJson : "-");
                _selectedEventFields.Add(new KeyValuePair<string, string>(label, val));
            }
        }

        _showFormDetailsModal = true;
    }

    private void CloseFormDetailsModal()
    {
        _showFormDetailsModal = false;
        _selectedEventForModal = null;
        _selectedEventFields.Clear();
    }

    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isUploading = false;
    private bool _isEditable = false;
    private bool _isCustodied = false;
    private long _currentUserId;

    // Drag & Drop State
    private bool _dragEnter = false;
    private string _selectedDocType = "DNI";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var subClaim = user.FindFirst("id_user") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier) ?? user.FindFirst("sub");
        if (subClaim != null && long.TryParse(subClaim.Value, out var parsedId))
        {
            _currentUserId = parsedId;
        }

        if (_currentUserId == -999) _currentUserId = 101;
        else if (_currentUserId == -998) _currentUserId = 9;
        else if (_currentUserId == -1000) _currentUserId = 237;

        await LoadStagesFromApi();
        await LoadOrderDetails();
    }

    private async Task LoadStagesFromApi()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var stageVms = await client.GetFromJsonAsync<List<StageVmDetail>>("/api/engines/flow/stages");
            if (stageVms != null && stageVms.Any())
            {
                _stageObjects = stageVms.OrderBy(s => s.IdFlow).ThenBy(s => s.OrderIndex).ToList();
                _stages = _stageObjects.Where(s => s.IdFlow == 1).Select(s => s.Name).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AsesorOrderDetail] Error cargando etapas desde BD: {ex.Message}");
        }
    }

    private class StageVmDetail
    {
        [System.Text.Json.Serialization.JsonPropertyName("idStage")]
        public long IdStage { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("idFlow")]
        public long IdFlow { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("stageCode")]
        public string StageCode { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("orderIndex")]
        public int OrderIndex { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("isTerminal")]
        public bool IsTerminal { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("portfolio")]
        public string Portfolio { get; set; } = "GENERAL";

        [System.Text.Json.Serialization.JsonPropertyName("campaign")]
        public string Campaign { get; set; } = "GENERAL";
    }

    public class FlowInstanceApiDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("idInstance")]
        public long IdInstance { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("idFlow")]
        public long IdFlow { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("currentStageId")]
        public long CurrentStageId { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("status")]
        public string Status { get; set; } = "ACTIVE";
    }

    private UiContextDto? _flowUiContext;

    private async Task ReloadFlowContextAsync()
    {
        if (_order == null) return;
        try
        {
            _flowUiContext = await FlowEngineClient.GetUiContextByEntityAsync("order", _order.IdOrder, _currentUserId);
            if (_flowUiContext != null)
            {
                _isCustodied = _flowUiContext.Ownership.IsMyTurn;
                _isEditable = !_flowUiContext.UiHints.IsReadOnly;
                _currentFlowStageIndex = Math.Max(0, (int)_flowUiContext.CurrentStage.OrderIndex - 1);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AsesorOrderDetail] Error loading flow UI context: {ex.Message}");
        }
    }

    private async Task HandleFlowActionExecuted(ExecuteActionResultDto result)
    {
        if (result.UpdatedUiContext != null)
        {
            _flowUiContext = result.UpdatedUiContext;
            _isCustodied = _flowUiContext.Ownership.IsMyTurn;
            _isEditable = !_flowUiContext.UiHints.IsReadOnly;
            _currentFlowStageIndex = Math.Max(0, (int)_flowUiContext.CurrentStage.OrderIndex - 1);
        }
        await LoadOrderDetails();
    }

    private async Task LoadOrderDetails()
    {
        _isLoading = true;
        try
        {
            // 1. Cargar la Orden
            _order = await SalesOrderService.GetOrderByIdAsync(Id);
            if (_order != null)
            {
                // Consultar contexto dinámico en Nyx.FlowEngine (Zero-Logic UI Contract)
                await ReloadFlowContextAsync();

                // Si no se obtuvo contexto de flujo remoto, aplicar fallback básico
                if (_flowUiContext == null)
                {
                    _isCustodied = _order.CustodyUserId == _currentUserId || _order.IdUser == _currentUserId;
                    _isEditable = _order.IdStatus == 1 && _isCustodied;
                }

                // 2. Cargar plantilla de formulario y campos
                var templates = await SalesOrderService.GetTemplatesAsync(_order.IdCmpg, 1);
                _template = templates.FirstOrDefault();
                if (_template != null)
                {
                    var fieldsList = await SalesOrderService.GetFieldsAsync(_template.IdForm);
                    _fields = fieldsList.OrderBy(f => f.OrderIndex).ToList();
                    
                    // Cargar datos previos guardados
                    var dataList = await SalesOrderService.GetOrderDataAsync(_order.IdOrder);
                    _savedData = dataList.ToList();
                    
                    // Llenar valores actuales
                    _fieldValues.Clear();
                    foreach (var field in _fields)
                    {
                        var match = _savedData.FirstOrDefault(d => d.IdFld == field.IdFld);
                        _fieldValues[field.IdFld] = match?.ValueText ?? string.Empty;
                    }
                }

                // 3. Cargar Historial
                var historyList = await SalesOrderService.GetOrderHistoryAsync(_order.IdOrder);
                _timeline = historyList.ToList();

                // 4. Cargar Documentos
                var docsList = await SalesOrderService.GetDocumentsByOrderAsync(_order.IdOrder);
                _documents = docsList.ToList();

                // 5. Cargar perfil alterno
                var alternate = await SalesOrderService.GetAlternateProfileAsync(_order.IdOrder);
                if (alternate != null)
                {
                    _alternateProfile = alternate;
                    _showAlternate = true;
                    if (!string.IsNullOrEmpty(alternate.AlternateData))
                    {
                        try
                        {
                            var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(alternate.AlternateData);
                            if (dict != null)
                            {
                                _altHolderName = dict.TryGetValue("NombreTitularAlterno", out string? v1) ? v1 : string.Empty;
                                _altHolderDni  = dict.TryGetValue("DniAlterno",     out string? v2) ? v2 : string.Empty;
                                _altPhone      = dict.TryGetValue("TelefonoAlterno",  out string? v3) ? v3 : string.Empty;
                                _altAddress    = dict.TryGetValue("DireccionAlterna", out string? v4) ? v4 : string.Empty;
                            }
                        }
                        catch {}
                    }
                }
                else
                {
                    _alternateProfile = new AlternateProfileViewModel { IdOrder = _order.IdOrder };
                    _showAlternate = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading order details: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetFieldValue(long idFld)
    {
        return _fieldValues.TryGetValue(idFld, out var val) ? val : string.Empty;
    }

    private void OnFieldChanged(FormFieldViewModel field, string? value)
    {
        _fieldValues[field.IdFld] = value ?? string.Empty;
        ValidateField(field, value);
    }

    private bool ValidateField(FormFieldViewModel field, string? value)
    {
        _validationErrors.Remove(field.IdFld);
        
        if (field.IsRequired && string.IsNullOrWhiteSpace(value))
        {
            _validationErrors[field.IdFld] = "Este campo es requerido.";
            return false;
        }
        
        if (!string.IsNullOrWhiteSpace(value))
        {
            // Validaciones específicas
            if (field.ValidationType == "DNI_ES" || field.FieldKey.Equals("dni", StringComparison.OrdinalIgnoreCase) || field.FieldKey.Equals("dni_cliente", StringComparison.OrdinalIgnoreCase))
            {
                if (!ValidationHelper.ValidateDni(value))
                {
                    _validationErrors[field.IdFld] = "DNI/NIE no es válido (ej: 12345678Z).";
                    return false;
                }
            }
            else if (field.ValidationType == "IBAN" || field.FieldKey.Equals("iban", StringComparison.OrdinalIgnoreCase))
            {
                if (!ValidationHelper.ValidateIban(value))
                {
                    _validationErrors[field.IdFld] = "IBAN no es válido (ej: ES1234...).";
                    return false;
                }
            }
            else if (field.ValidationType == "PHONE_ES" || field.FieldKey.Equals("telefono", StringComparison.OrdinalIgnoreCase) || field.FieldKey.Equals("telefono_cliente", StringComparison.OrdinalIgnoreCase))
            {
                if (!ValidationHelper.ValidatePhone(value))
                {
                    _validationErrors[field.IdFld] = "Teléfono no es válido (ej: 600000000).";
                    return false;
                }
            }
            else if (!string.IsNullOrEmpty(field.ValidationRegex))
            {
                try
                {
                    if (!Regex.IsMatch(value, field.ValidationRegex))
                    {
                        _validationErrors[field.IdFld] = "Formato inválido.";
                        return false;
                    }
                }
                catch {}
            }
        }
        return true;
    }

    private List<string> GetOptions(string? optionsJson)
    {
        if (string.IsNullOrWhiteSpace(optionsJson)) return new List<string>();
        try
        {
            // Reemplazar comillas simples con dobles si viene en formato no estandarizado
            var cleanedJson = optionsJson.Replace("'", "\"");
            return JsonSerializer.Deserialize<List<string>>(cleanedJson) ?? new List<string>();
        }
        catch
        {
            // Split simple por coma como fallback
            return optionsJson.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        }
    }

    private async Task SavePartialDraft()
    {
        if (_order == null || _template == null || !_isEditable) return;
        await PerformSave(isDraftMode: true);
    }

    private async Task SaveForm()
    {
        if (_order == null || _template == null || !_isEditable) return;

        // Validar todos los campos antes de guardar completo
        bool hasErrors = false;
        foreach (var field in _fields)
        {
            var val = GetFieldValue(field.IdFld);
            if (!ValidateField(field, val))
            {
                hasErrors = true;
            }
        }

        if (hasErrors)
        {
            Snackbar.Add("Por favor corrige los errores del formulario para envío final o usa 'Guardar Borrador Parcial'.", Severity.Error);
            return;
        }

        await PerformSave(isDraftMode: false);
    }

    private async Task PerformSave(bool isDraftMode)
    {
        _isSaving = true;
        try
        {
            var dataToSave = _fields.Select(f => new OrderDataViewModel
            {
                IdFld = f.IdFld,
                IdOrder = _order!.IdOrder,
                SourceFormId = _template!.IdForm,
                ValueText = GetFieldValue(f.IdFld),
                FieldStatus = "PENDING"
            });

            var (success, errorMessage) = await SalesOrderService.SaveOrderDataWithDetailsAsync(_order!.IdOrder, _template!.IdForm, dataToSave);
            if (success)
            {
                var msg = isDraftMode ? "Borrador parcial guardado exitosamente." : "Ficha de venta guardada exitosamente.";
                Snackbar.Add(msg, Severity.Success);
                await LoadOrderDetails();
            }
            else
            {
                Snackbar.Add($"Error al guardar: {errorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }


    private void ToggleAlternate(ChangeEventArgs e)
    {
        _showAlternate = (bool)(e.Value ?? false);
    }

    private string _altHolderName = string.Empty;
    private string _altHolderDni = string.Empty;
    private string _altPhone = string.Empty;
    private string _altAddress = string.Empty;

    private async Task SaveAlternateProfileFields()
    {
        if (_order == null || !_isEditable) return;
        _isSaving = true;
        try
        {
            var dict = new Dictionary<string, string>
            {
                { "TitularAlterno", _altHolderName },
                { "DniAlterno", _altHolderDni },
                { "TelefonoAlterno", _altPhone },
                { "DireccionAlterna", _altAddress }
            };

            _alternateProfile.AlternateType = "FICHA_ALTERNA";
            _alternateProfile.AlternateData = JsonSerializer.Serialize(dict);
            _alternateProfile.OriginalData = JsonSerializer.Serialize(new { Info = "Datos base de la orden" });

            var success = await SalesOrderService.SaveAlternateProfileAsync(_order.IdOrder, _alternateProfile);
            if (success)
            {
                Snackbar.Add("Ficha alternas guardada exitosamente.", Severity.Success);
                await LoadOrderDetails();
            }
            else
            {
                Snackbar.Add("Error al guardar la ficha alterna.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Drag & Drop Operations
    private void OnDragEnter() { _dragEnter = true; }
    private void OnDragLeave() { _dragEnter = false; }
    private void OnDragOver() { _dragEnter = true; }

    private async Task OnDrop(DragEventArgs e)
    {
        _dragEnter = false;
        // La carga directa por DragEventArgs.DataTransfer requiere JSInterop en Blazor tradicional,
        // por lo que vinculamos la interactividad usando el InputFile superpuesto de forma transparente.
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (_order == null || !_isEditable) return;
        
        _isUploading = true;
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
                var bytes = ms.ToArray();

                var success = await SalesOrderService.UploadDocumentAsync(
                    _order.IdOrder, 
                    _selectedDocType, 
                    file.Name, 
                    bytes, 
                    file.ContentType
                );

                if (success)
                {
                    Snackbar.Add("Documento cargado correctamente.", Severity.Success);
                    await LoadOrderDetails();
                }
                else
                {
                    Snackbar.Add("Error al subir el documento.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error en la carga: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task DownloadDocument(OrderDocumentViewModel doc)
    {
        try
        {
            var result = await SalesOrderService.DownloadDocumentAsync(doc.IdDocument);
            if (result.HasValue)
            {
                var base64 = Convert.ToBase64String(result.Value.Bytes);
                var fileName = !string.IsNullOrEmpty(result.Value.FileName) ? result.Value.FileName : doc.FileName;
                await JSRuntime.InvokeVoidAsync("eval", $@"
                    (function() {{
                        const link = document.createElement('a');
                        link.href = 'data:{result.Value.ContentType};base64,{base64}';
                        link.download = '{fileName}';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    }})()
                ");
            }
            else
            {
                Snackbar.Add("No se pudo descargar el documento.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al descargar: {ex.Message}", Severity.Error);
        }
    }

    private async Task SendToSupervisor()
    {
        if (_order == null || !_isEditable || _order.IdStatus != 1) return;
        
        _isSaving = true;
        try
        {
            // Usamos el ID 2 como estado genérico "Enviado a supervisor" o "En validación"
            var success = await SalesOrderService.UpdateOrderStatusAsync(_order.IdOrder, 2, comment: "Enviado para revisión por supervisor");
            if (success)
            {
                Snackbar.Add("Orden enviada a supervisor exitosamente.", Severity.Success);
                await LoadOrderDetails();
            }
            else
            {
                Snackbar.Add("Error al enviar la orden a supervisor.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private List<OrderCheckpointVm> _orderCheckpoints = new();

    private async Task ReloadCheckpointsAsync()
    {
        if (_order == null) return;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var flowInst = await client.GetFromJsonAsync<FlowInstanceWithCheckpointsApiDto>($"/api/engines/flow/instances/by-entity/order/{_order.IdOrder}");
            if (flowInst?.CheckpointInstances != null)
            {
                var catalog = await client.GetFromJsonAsync<List<CheckpointCatalogApiDto>>("/api/engines/flow/checkpoints/catalog");
                var catalogDict = catalog?.ToDictionary(c => c.IdCheckpoint) ?? new();

                var list = new List<OrderCheckpointVm>();
                foreach (var ci in flowInst.CheckpointInstances)
                {
                    catalogDict.TryGetValue(ci.IdCheckpoint, out var catDef);
                    var vm = new OrderCheckpointVm
                    {
                        IdCpInstance = ci.IdCpInstance,
                        IdCheckpoint = ci.IdCheckpoint,
                        Code = catDef?.Code ?? $"CP-{ci.IdCheckpoint}",
                        Name = catDef?.Name ?? $"Checkpoint #{ci.IdCheckpoint}",
                        Description = catDef?.Description,
                        Status = ci.Status ?? "PENDING",
                        BlocksAdvance = catDef?.BlocksAdvance ?? false
                    };

                    try
                    {
                        var stepsProgress = await client.GetFromJsonAsync<List<StepProgressApiDto>>($"/api/engines/flow/checkpoints/instances/{ci.IdCpInstance}/steps");
                        if (stepsProgress != null && stepsProgress.Any())
                        {
                            vm.Steps = stepsProgress.Select(s => new OrderCheckpointStepVm
                            {
                                IdStep = s.IdStep,
                                StepName = s.StepName ?? $"Paso #{s.IdStep}",
                                IsCompleted = s.IsCompleted
                            }).ToList();
                        }
                    }
                    catch { }

                    list.Add(vm);
                }
                _orderCheckpoints = list;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AsesorOrderDetail] Error loading checkpoints: {ex.Message}");
        }
    }

    private async Task ToggleStepAsync(OrderCheckpointVm cp, OrderCheckpointStepVm step, bool isChecked)
    {
        step.IsCompleted = isChecked;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var payload = new { isCompleted = isChecked, actorId = _order?.IdUser ?? 1 };
            var response = await client.PostAsJsonAsync($"/api/engines/flow/checkpoints/instances/{cp.IdCpInstance}/steps/{step.IdStep}/toggle", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Paso '{step.StepName}' actualizado.", Severity.Success);
                await ReloadCheckpointsAsync();
            }
            else
            {
                step.IsCompleted = !isChecked;
                Snackbar.Add("Error al actualizar el estado del paso.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            step.IsCompleted = !isChecked;
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

