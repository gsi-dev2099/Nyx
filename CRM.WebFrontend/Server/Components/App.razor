<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <!-- Importar la tipografía Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/dashboard.css"]" />
    <link rel="stylesheet" href="@Assets["css/galaxy-theme.css"]" />
    <link rel="stylesheet" href="@Assets["CRM.WebFrontend.styles.css"]" />
    
    <!-- MudBlazor Styles & Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/themeManager.js"]"></script>
    <script src="@Assets["js/galaxy-theme.js"]"></script>
    <script>
        document.addEventListener("click", function(e) {
            var logoBtn = e.target.closest(".logo-g");
            if (logoBtn) {
                e.preventDefault();
                var sidebar = document.querySelector(".custom-sidebar");
                if (sidebar) {
                    sidebar.classList.toggle("expanded");
                }
            }
        });

        window.audioPlayer = {
            play: function(id) {
                var audio = document.getElementById(id);
                if (audio) {
                    audio.play().catch(function(err) {
                        console.warn("Playback prevented or failed:", err);
                    });
                }
            },
            pause: function(id) {
                var audio = document.getElementById(id);
                if (audio) audio.pause();
            },
            setCurrentTime: function(id, seconds) {
                var audio = document.getElementById(id);
                if (audio) audio.currentTime = seconds;
            },
            getCurrentTime: function(id) {
                var audio = document.getElementById(id);
                return audio ? audio.currentTime || 0 : 0;
            },
            getDuration: function(id) {
                var audio = document.getElementById(id);
                return audio ? audio.duration || 0 : 0;
            },
            seekToPercent: function(id, clientX, progressBarId) {
                var audio = document.getElementById(id);
                var bar = document.getElementById(progressBarId);
                if (audio && bar && audio.duration) {
                    var rect = bar.getBoundingClientRect();
                    var offsetX = clientX - rect.left;
                    var percent = offsetX / rect.width;
                    if (percent < 0) percent = 0;
                    if (percent > 1) percent = 1;
                    audio.currentTime = percent * audio.duration;
                    return audio.currentTime;
                }
                return 0;
            }
        };

        window.ocrCanvas = {
            drawBoxes: function(canvasId, imgId, boxes) {
                var canvas = document.getElementById(canvasId);
                var img = document.getElementById(imgId);
                if (!canvas || !img) return;

                // Sync canvas pixel dimensions to rendered image dimensions
                var rect = img.getBoundingClientRect();
                canvas.width = img.naturalWidth || rect.width;
                canvas.height = img.naturalHeight || rect.height;

                var ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                var W = canvas.width;
                var H = canvas.height;

                boxes.forEach(function(box) {
                    var x = box.x * W;
                    var y = box.y * H;
                    var w = box.w * W;
                    var h = box.h * H;

                    // Draw semi-transparent fill
                    ctx.fillStyle = box.color + (box.selected ? '44' : '28');
                    ctx.fillRect(x, y, w, h);

                    // Draw border (thicker + glow if selected)
                    ctx.strokeStyle = box.color;
                    ctx.lineWidth = box.selected ? 3 : 1.5;
                    ctx.setLineDash(box.selected ? [] : [5, 3]);
                    ctx.strokeRect(x, y, w, h);
                    ctx.setLineDash([]);

                    // Draw label tag above box
                    ctx.fillStyle = box.color;
                    var labelX = x;
                    var labelY = y - 4;
                    var fontSize = Math.max(10, Math.min(13, W * 0.018));
                    ctx.font = 'bold ' + fontSize + 'px system-ui, sans-serif';
                    var textW = ctx.measureText(box.label).width + 8;
                    ctx.fillRect(labelX, labelY - fontSize - 2, textW, fontSize + 4);
                    ctx.fillStyle = '#ffffff';
                    ctx.fillText(box.label, labelX + 4, labelY - 2);
                });
            },

            getRelativeClick: function(canvasId, clientX, clientY) {
                var canvas = document.getElementById(canvasId);
                if (!canvas) return [0, 0];
                var rect = canvas.getBoundingClientRect();
                var rx = (clientX - rect.left) / rect.width;
                var ry = (clientY - rect.top) / rect.height;
                return [Math.max(0, Math.min(1, rx)), Math.max(0, Math.min(1, ry))];
            }
        };
    </script>
</body>

</html>
